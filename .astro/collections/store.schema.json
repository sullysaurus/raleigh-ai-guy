{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "preview": {
      "type": "string"
    },
    "checkout": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "alt"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "price",
    "preview",
    "checkout",
    "license",
    "highlights",
    "description",
    "image"
  ]
}