# Server-only Stripe credentials used by the Netlify Checkout function.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_ZIMZOOM_PRICE_ID=price_replace_me

# Optional: prefill and lock the client's email in Stripe Checkout.
STRIPE_ZIMZOOM_CUSTOMER_EMAIL=

# Protects private acquisition metrics returned by the Netlify Function.
OPS_DASHBOARD_KEY=

# Optional live acquisition sources. Add only the services you use.
CALENDLY_ACCESS_TOKEN=
NETLIFY_ACCESS_TOKEN=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
SMARTLEAD_API_KEY=
SMARTLEAD_WEBHOOK_SECRET=

# Optional comma-separated campaign IDs. Without this, active campaigns are used.
SMARTLEAD_CAMPAIGN_IDS=
