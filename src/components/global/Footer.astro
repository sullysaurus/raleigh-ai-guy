---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const year = new Date().getFullYear();
const links = [
  { text: "About", href: "/about/" },
  { text: "Work", href: "/projects/" },
  { text: "Writing", href: "/blog/" },
  { text: "Workshops", href: "/ai-workshops/" },
  { text: "Privacy", href: "/privacy/" },
  { text: "LinkedIn", href: "https://www.linkedin.com/in/danny-sullivan-raleigh/" },
];
---

<footer class="mt-auto">
  <Wrapper class="py-12 sm:py-16">
    <div class="grid gap-10 border-t border-black/10 pt-6 sm:grid-cols-[1fr_auto]">
      <div>
        <p class="flex items-center gap-2 text-sm font-semibold"><span class="size-2 rounded-full bg-[var(--brand-orange)]" aria-hidden="true"></span>Raleigh AI Guy</p>
        <p class="mt-2 max-w-sm text-sm leading-6 text-base-500">Practical AI systems for small businesses and teams in Raleigh.</p>
        <a href="mailto:hello@raleighaiguy.com" class="mt-4 inline-block text-sm font-medium underline decoration-black/20 underline-offset-4 hover:decoration-black">hello@raleighaiguy.com</a>
      </div>
      <nav class="grid grid-cols-2 gap-x-8 gap-y-2" aria-label="Footer navigation">
        {links.map((link) => <a href={link.href} class="text-sm text-base-500 hover:text-black">{link.text}</a>)}
      </nav>
    </div>
    <p class="mt-10 text-xs text-base-400">© {year} Danny Sullivan · Raleigh, North Carolina</p>
  </Wrapper>
</footer>
