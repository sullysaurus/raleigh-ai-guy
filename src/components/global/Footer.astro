---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const year = new Date().getFullYear();
const links = [
  { text: "About", href: "/about/" },
  { text: "Work", href: "/projects/" },
  { text: "Writing", href: "/blog/" },
  { text: "Workshops", href: "/ai-workshops/" },
  { text: "Contact", href: "/contact/" },
  { text: "Privacy", href: "/privacy/" },
  { text: "LinkedIn", href: "https://www.linkedin.com/in/danny-sullivan-raleigh/" },
];
---

<footer class="mt-auto bg-[var(--brand-forest)] text-[var(--brand-paper)]">
  <Wrapper variant="wide" class="py-12 sm:py-16">
    <div class="grid gap-10 border-t border-white/15 pt-6 sm:grid-cols-[1fr_auto]">
      <div>
        <a href="/" aria-label="Raleigh AI Guy home" class="inline-block">
          <img src="/brand/raleigh-ai-guy-header-mark.png" alt="Raleigh AI Guy" width="192" height="192" class="size-24 bg-[var(--brand-paper)]" loading="lazy" />
        </a>
        <p class="mt-3 max-w-sm text-sm leading-6 text-white/65">Practical AI education and systems for small businesses and teams in Raleigh.</p>
        <a href="mailto:hello@raleighaiguy.com" class="mt-5 inline-block text-sm font-medium underline decoration-white/25 underline-offset-4 hover:decoration-white">hello@raleighaiguy.com</a>
      </div>
      <nav class="grid grid-cols-2 gap-x-8 gap-y-2" aria-label="Footer navigation">
        {links.map((link) => <a href={link.href} class="text-sm text-white/60 hover:text-white">{link.text}</a>)}
      </nav>
    </div>
    <p class="font-utility mt-12 text-[.65rem] uppercase tracking-[.1em] text-white/40">© {year} Danny Sullivan · Raleigh, North Carolina</p>
  </Wrapper>
</footer>
