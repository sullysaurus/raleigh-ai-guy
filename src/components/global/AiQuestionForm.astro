---
interface Props {
  source?: string;
  compact?: boolean;
}

const {
  source = "ai_answers_page",
  compact = false,
} = Astro.props;

---

<form
  name="two-minute-ai-question"
  method="POST"
  action="/ai-question-thank-you/"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  data-ai-question-form
  class:list={[
    "text-left text-[var(--brand-ink)]",
    compact ? "space-y-4" : "space-y-5",
  ]}
>
  <input type="hidden" name="form-name" value="two-minute-ai-question" />
  <input type="hidden" name="subject" data-remove-prefix value="New two-minute AI question from %{formName}" />
  <input type="hidden" name="source" value={source} />
  <p class="absolute -left-[10000px] size-px overflow-hidden" aria-hidden="true">
    <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <label class="block text-sm font-semibold">
    What is your biggest AI bottleneck, problem, or question?
    <span class="mt-1 block font-normal leading-5 text-black/55">A sentence or two is plenty. Tell me what you are trying to accomplish and where you get stuck.</span>
    <textarea class="brand-field" name="question" rows={compact ? 4 : 5} maxlength="1500" placeholder="I keep trying to use AI for…" required></textarea>
  </label>

  <div class:list={["grid gap-4", compact ? "" : "sm:grid-cols-2"]}>
    <label class="block text-sm font-semibold">
      Which tool are you using?
      <select class="brand-field" name="tool">
        <option value="Not sure">Not sure yet</option>
        <option value="Claude">Claude</option>
        <option value="ChatGPT">ChatGPT</option>
        <option value="Gemini">Gemini</option>
        <option value="Microsoft Copilot">Microsoft Copilot</option>
        <option value="Other">Something else</option>
      </select>
    </label>

    <label class="block text-sm font-semibold">
      Where should I send the video?
      <input class="brand-field" type="email" name="email" autocomplete="email" placeholder="you@yourbusiness.com" required />
    </label>
  </div>

  <label class="grid grid-cols-[1.15rem_1fr] gap-3 text-xs leading-5 text-black/65">
    <input class="brand-checkbox" type="checkbox" name="library_permission" value="yes" />
    <span>You may anonymize my question and add the answer to the public Two-Minute AI Answers library. My name, email, and business details will not be published.</span>
  </label>

  <button type="submit" class="brand-button min-h-12 w-full">
    Send Danny my question <span class="ml-3">→</span>
  </button>
  <p class="text-center text-xs leading-5 text-black/50">A real answer from me—not an automated chatbot.</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-ai-question-form]").forEach((form) => {
    if (form.dataset.trackingReady === "true") return;
    form.dataset.trackingReady = "true";
    form.addEventListener("submit", () => {
      const tool = form.querySelector<HTMLSelectElement>('[name="tool"]')?.value || "Unknown";
      const libraryPermission = form.querySelector<HTMLInputElement>('[name="library_permission"]')?.checked || false;
      const source = form.querySelector<HTMLInputElement>('[name="source"]')?.value || "unknown";
      window.posthog?.capture("ai_question_submitted", {
        source,
        tool,
        library_permission: libraryPermission,
      });
    });
  });
</script>
