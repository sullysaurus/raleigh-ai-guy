---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const currentPath = Astro.url.pathname;
const links = [
  { text: "About", href: "/about/" },
  { text: "Work", href: "/projects/" },
  { text: "Writing", href: "/blog/" },
  { text: "Workshops", href: "/ai-workshops/" },
];
---

<header>
  <Wrapper class="pt-8 sm:pt-12">
    <div class="flex items-center justify-between gap-5 border-b border-black/10 pb-5">
      <a href="/" class="text-sm font-semibold tracking-tight" aria-label="Raleigh AI Guy home">Raleigh AI Guy</a>
      <div class="flex items-center gap-4">
        <a href="mailto:hello@raleighaiguy.com" class="hidden text-sm font-medium text-base-500 hover:text-black sm:block">Email me</a>
        <details class="group relative">
          <summary class="cursor-pointer list-none text-sm font-medium text-base-500 hover:text-black">Menu</summary>
          <nav class="absolute right-0 top-full z-40 mt-3 w-40 rounded-xl border border-black/10 bg-white p-4 shadow-sm" aria-label="Main navigation">
            <div class="space-y-3">
              {links.map((link) => (
                <a href={link.href} aria-current={currentPath.startsWith(link.href) ? "page" : undefined} class="block text-sm font-medium text-base-500 hover:text-black aria-[current=page]:text-black">{link.text}</a>
              ))}
              <a href="mailto:hello@raleighaiguy.com" class="block text-sm font-medium text-base-500 hover:text-black sm:hidden">Email me</a>
            </div>
          </nav>
        </details>
      </div>
    </div>
  </Wrapper>
</header>
