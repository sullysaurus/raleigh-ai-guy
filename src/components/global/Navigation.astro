---
import ThemeToggle from "@/components/assets/ThemeToggle.astro";

const currentPath = Astro.url.pathname;
const links = [
  { text: "About", href: "/about/" },
  { text: "Blog", href: "/blog/" },
  { text: "Ventures", href: "/ventures/" },
  { text: "Tools", href: "/tools/" },
  { text: "Workshops", href: "/ai-workshops/" },
];
---

<header class="site-header mx-auto flex min-h-20 w-full max-w-[1320px] items-center justify-between gap-5 border-b border-black/10 bg-white px-5 text-black dark:border-white/10 dark:bg-base-950 dark:text-white sm:px-8">
  <a href="/" class="flex shrink-0 items-center gap-3" aria-label="Danny Sullivan home">
    <span class="grid size-9 place-items-center rounded-full bg-black text-xs font-semibold text-white dark:bg-white dark:text-black">DS</span>
    <span class="text-sm font-medium">Danny Sullivan <span class="hidden text-base-500 lg:inline dark:text-base-400">· Raleigh, NC</span></span>
  </a>

  <nav class="hidden items-center gap-6 md:flex" aria-label="Main navigation">
    {links.map((link) => <a href={link.href} aria-current={currentPath.startsWith(link.href) ? "page" : undefined} class="text-sm text-base-600 transition hover:text-black aria-[current=page]:font-medium aria-[current=page]:text-black dark:text-base-300 dark:hover:text-white dark:aria-[current=page]:text-white">{link.text}</a>)}
  </nav>

  <div class="flex items-center gap-3">
    <ThemeToggle class="grid size-9 place-items-center rounded-full border border-black/10 dark:border-white/15 [&_svg]:size-4" />
    <a href="/free-ai-review/" class="border-2 border-black bg-[#d7ef6f] px-4 py-2.5 text-xs font-semibold text-black shadow-[3px_3px_0_#151515] transition hover:-translate-y-0.5 dark:border-white dark:shadow-[3px_3px_0_#f4f1e8]">Free AI review</a>
  </div>
</header>

<nav class="mx-auto flex w-full max-w-[1320px] gap-5 overflow-x-auto border-b border-black/10 bg-white px-5 py-3 text-sm text-base-600 dark:border-white/10 dark:bg-base-950 dark:text-base-300 md:hidden" aria-label="Mobile navigation">
  {links.map((link) => <a href={link.href} aria-current={currentPath.startsWith(link.href) ? "page" : undefined} class="shrink-0 aria-[current=page]:text-black dark:aria-[current=page]:text-white">{link.text}</a>)}
</nav>
