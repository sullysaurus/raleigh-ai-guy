---
import ThemeToggle from "@/components/assets/ThemeToggle.astro";

const navLinks = [
  { text: "Work", href: "/projects/" },
  { text: "Ventures", href: "/ventures/" },
  { text: "Notes", href: "/blog/" },
  { text: "About", href: "/about/" },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Danny Sullivan home">
    <span class="brand-mark">DS</span>
    <span><strong>Danny</strong><small>Sullivan · Raleigh, NC</small></span>
  </a>

  <nav aria-label="Primary navigation">
    {navLinks.map((link) => <a href={link.href}>{link.text}</a>)}
  </nav>

  <div class="header-actions">
    <ThemeToggle class="theme-toggle" />
    <a class="start-link" href="/work-with-me/">Start something <span>↗</span></a>
  </div>
</header>

<style>
  .site-header { width:min(100% - 40px,1320px); min-height:90px; margin-inline:auto; display:grid; grid-template-columns:1fr auto 1fr; gap:2rem; align-items:center; border-bottom:1px solid color-mix(in srgb,currentColor 25%,transparent); color:#11110f; }
  :global(.dark) .site-header { color:#f0ebdd; }
  .brand { display:flex; align-items:center; gap:.75rem; justify-self:start; }
  .brand-mark { display:grid; place-items:center; width:2.6rem; height:2.6rem; border-radius:50%; background:#ff4b36; color:white; font-family:"Anybody",sans-serif; font-size:.9rem; font-weight:900; transform:rotate(-7deg); transition:transform .25s; }
  .brand:hover .brand-mark { transform:rotate(7deg); }
  .brand>span:last-child { display:flex; flex-direction:column; line-height:1; }
  .brand strong { font-family:"Anybody",sans-serif; font-size:1.05rem; font-weight:850; text-transform:uppercase; }
  .brand small { margin-top:.25rem; font-size:.52rem; font-weight:750; letter-spacing:.13em; text-transform:uppercase; }
  nav { display:flex; gap:clamp(1.25rem,3vw,3rem); }
  nav a { position:relative; font-size:.7rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  nav a::after { content:""; position:absolute; left:0; right:100%; bottom:-.35rem; height:2px; background:#2947ff; transition:right .2s; }
  nav a:hover::after { right:0; }
  .header-actions { justify-self:end; display:flex; align-items:center; gap:1rem; }
  .theme-toggle { display:grid; place-items:center; width:2.25rem; height:2.25rem; border:1px solid currentColor; border-radius:50%; cursor:pointer; }
  .theme-toggle :global(svg) { width:1rem; height:1rem; }
  .start-link { display:flex; align-items:center; gap:1rem; padding:.8rem 1rem; background:#11110f; color:#f0ebdd; font-size:.68rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; box-shadow:4px 4px 0 #2947ff; transition:transform .2s; }
  :global(.dark) .start-link { color:#11110f; background:#f0ebdd; }
  .start-link:hover { transform:translate(-2px,-2px); }
  @media (max-width:700px) {
    .site-header { width:min(100% - 28px,1320px); min-height:76px; grid-template-columns:1fr auto; }
    nav { display:none; }
    .brand small { display:none; }
    .start-link { padding:.7rem .8rem; }
    .start-link span { display:none; }
  }
</style>
