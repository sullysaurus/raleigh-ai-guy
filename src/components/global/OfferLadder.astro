---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

interface Props {
  compact?: boolean;
  surface?: "canvas" | "paper" | "soft";
}

const { compact = false, surface = "canvas" } = Astro.props;
const surfaceClass = surface === "paper" ? "bg-[var(--brand-paper)]" : surface === "soft" ? "bg-[var(--brand-surface-soft)]" : "";

const offers = [
  {
    number: "01",
    stage: "Find the opportunity",
    title: "AI Opportunity Assessment",
    price: "$997 one-time",
    fit: "You know AI could help, but you do not know which problem deserves attention first.",
    outcome: "A prioritized roadmap showing where time, money, and customer opportunities are being lost—and the smallest useful next step.",
    threshold: "Best for a business that suspects one recurring problem is costing at least 5–10 hours a month or several thousand dollars a year.",
    href: "/ai-opportunity-assessment/",
    cta: "Explore the assessment",
  },
  {
    number: "02",
    stage: "Prove the improvement",
    title: "Focused AI Improvement",
    price: "$2,000 one-time",
    fit: "You have one repeated workflow that is slow, inconsistent, or too dependent on manual effort.",
    outcome: "One improved workflow, a human-review plan, clear documentation, and a result the business can measure.",
    threshold: "We only build when the baseline indicates the improvement can reasonably recover 5–10+ hours a month or protect several thousand dollars in annual value.",
    href: "/services/#focused-improvement",
    cta: "Improve one workflow",
  },
  {
    number: "03",
    stage: "Build the capability",
    title: "Ongoing AI Partner",
    price: "$2,000–$5,000 / month",
    fit: "You want sustained progress without hiring a full-time AI leader or collecting disconnected experiments.",
    outcome: "A prioritized backlog, regular working sessions, team education, focused builds, and improvements that compound over time.",
    threshold: "Best for businesses with enough recurring opportunities to create value comfortably above the monthly investment—not one isolated task.",
    href: "/services/#ongoing-partner",
    cta: "Explore a partnership",
  },
];
---

<section class={surfaceClass}>
  <Wrapper variant="wide" class:list={[compact ? "py-14 sm:py-18" : "py-16 sm:py-24"]}>
    <div class="grid gap-8 border-b border-black/10 pb-8 sm:grid-cols-[1fr_auto] sm:items-end">
      <div>
        <p class="field-label">A clear way forward</p>
        <h2 class="font-editorial mt-4 max-w-3xl text-4xl leading-none sm:text-5xl">Find it. Prove it. Build on what works.</h2>
      </div>
      <p class="max-w-sm text-sm leading-6 text-base-600">You do not have to choose the technology. Each stage determines what the business needs next.</p>
    </div>

    <ol class="mt-10 grid gap-px border border-black/10 bg-black/10 lg:grid-cols-3">
      {offers.map((offer) => (
        <li class="flex min-h-[27rem] flex-col bg-[var(--brand-paper)] p-7 sm:p-8">
          <div class="flex items-center justify-between gap-4">
            <span class="field-label text-[var(--brand-orange)]">{offer.number}</span>
            <span class="field-label">{offer.stage}</span>
          </div>
          <h3 class="font-editorial mt-10 text-4xl leading-[.98]">{offer.title}</h3>
          <p class="font-utility mt-4 text-[.7rem] font-semibold uppercase tracking-[.1em] text-[var(--brand-orange)]">{offer.price}</p>
          <div class="mt-7 border-t border-black/10 pt-5">
            <p class="field-label">When you need it</p>
            <p class="mt-2 text-sm leading-6 text-base-600">{offer.fit}</p>
          </div>
          <div class="mt-5">
            <p class="field-label">What changes</p>
            <p class="mt-2 text-sm leading-6 text-base-600">{offer.outcome}</p>
          </div>
          <div class="mt-5 border-l-2 border-[var(--brand-orange)] pl-4">
            <p class="field-label">The fit test</p>
            <p class="mt-2 text-sm leading-6 text-base-600">{offer.threshold}</p>
          </div>
          <a href={offer.href} class="mt-8 inline-flex text-sm font-semibold underline decoration-black/20 underline-offset-4 lg:mt-auto lg:pt-8">{offer.cta} →</a>
        </li>
      ))}
    </ol>

  </Wrapper>
</section>
