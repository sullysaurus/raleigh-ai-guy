---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = "Ready when you are",
  title,
  description,
  ctaLabel = "Start the conversation",
  ctaHref = "/contact/",
} = Astro.props;
---

<section class="bg-[var(--brand-orange)]">
  <Wrapper variant="wide" class="grid gap-7 py-10 sm:grid-cols-[1fr_auto] sm:items-end sm:py-12">
    <div>
      <p class="field-label text-black/60">{eyebrow}</p>
      <h2 class="font-editorial mt-3 max-w-3xl text-4xl leading-[.98] tracking-[-.035em] sm:text-5xl">{title}</h2>
      {description && <p class="mt-4 max-w-2xl text-sm leading-6 text-black/65">{description}</p>}
    </div>
    <a href={ctaHref} class="inline-flex min-h-12 items-center justify-center bg-[var(--brand-ink)] px-5 text-sm font-semibold text-[var(--brand-paper)] transition-transform hover:-translate-y-0.5">{ctaLabel} →</a>
  </Wrapper>
</section>
