---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="pt-12 lg:py-32 xl:py-54">
    <Text
      tag="h1"
      variant="textBase"
      class="text-black dark:text-white font-medium"
    >
      I build products that streamline work
      <br />
      and help companies grow revenue
    </Text>
  </Wrapper>
  <Wrapper variant="standard" class="py-12">
    <div class="border-t dark:border-white/10 border-black/10 pt-2">
      <Text
        tag="h1"
        variant="textBase"
        class="text-black dark:text-white font-medium"
      >
        Intro
      </Text>
      <Text
        tag="p"
        variant="textSM"
        class="2xl:text-base mt-8 dark:text-base-400 text-base-500"
      >
        I build at the intersection of AI, product, and content. I’m an AI Product
        Engineer at
        <a
          href="https://gametime.co"
          class="text-black underline decoration-black/20 underline-offset-4 hover:decoration-black dark:text-white dark:decoration-white/20 dark:hover:decoration-white"
          >Gametime</a
        >, where I build AI tools and product systems that help fans better
        understand venues, seats, and live event experiences before they buy.
        Before that, I spent nearly five years at Pluralsight across content
        strategy, AI tooling, and generative AI education, creating hands-on
        courses and labs before moving into a Creative Technologist role building
        internal AI tools for content teams. My background spans full-stack
        development, curriculum engineering, growth marketing, and product
        strategy, so I think about AI as both a technical system and a user
        experience. Based in Raleigh, NC, I help businesses turn ambiguous ideas
        and manual workflows into practical automations, tools, pipelines, and
        product features.
      </Text>
    </div>
  </Wrapper>
</section>
