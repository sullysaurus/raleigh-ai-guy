---
import Button from "@/components/fundations/elements/Button.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="overflow-hidden">
  <Wrapper variant="standard" class="pt-12 pb-16 lg:pt-28 lg:pb-24">
    <div class="relative border-t border-black/10 pt-6 dark:border-white/10">
      <Text
        tag="p"
        variant="textXS"
        class="font-medium uppercase tracking-wide text-base-500 dark:text-base-400"
      >
        AI Product Engineer · AI educator · Raleigh, NC
      </Text>
      <Text
        tag="h1"
        variant="displayLG"
        class="mt-5 max-w-xl text-balance font-medium text-black dark:text-white"
      >
        I build practical AI products—and help teams learn how to use them.
      </Text>
      <Text
        tag="p"
        variant="textSM"
        class="mt-7 max-w-lg text-base-500 dark:text-base-400 2xl:text-base"
      >
        I turn emerging AI capabilities into useful products, clearer
        workflows, and learning experiences people can apply to their work.
      </Text>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button
          href="/projects/"
          variant="default"
          size="medium"
          title="View Danny Sullivan's projects"
        >
          Explore my work
        </Button>
        <Button
          href="/ai-workshops/"
          variant="muted"
          size="medium"
          title="Learn about AI workshops for small businesses"
        >
          Book a free lunch & learn
        </Button>
      </div>
    </div>
  </Wrapper>
</section>
