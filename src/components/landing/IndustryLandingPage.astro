---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import type { IndustryLandingPage } from "@/data/industryLandingPages";
import { Image } from "astro:assets";
import profileImage from "../../../danny.jpeg";

interface Props {
  page: IndustryLandingPage;
}

const { page } = Astro.props;
const bookingUrl = `https://calendly.com/hello-raleighaiguy/30min?utm_source=raleighaiguy&utm_medium=industry-landing-page&utm_campaign=${encodeURIComponent(page.slug)}`;
const emailUrl = `mailto:hello@raleighaiguy.com?subject=${encodeURIComponent(`Workflow call — ${page.shortName}`)}`;

const steps = [
  ["Show me the work", "On a short call, you walk me through the current process. I ask questions, find the strongest leverage point, and agree on one result worth proving."],
  ["I build the proof", "If the opportunity is a fit, I build a focused working version in one week. The scope stays deliberately small and measurable."],
  ["You see the return", "You see the workflow in action and what it could save or earn. Then you decide whether a full implementation and monthly partnership make sense."],
];
---

<BaseLayout pageTitle={page.pageTitle} pageDescription={page.pageDescription}>
  <section class="overflow-hidden border-b border-black/10">
    <Wrapper variant="wide" class="py-10 sm:py-16 lg:py-20">
      <div class="grid items-end gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="field-reveal lg:col-span-8">
          <p class="field-label flex items-center gap-2">
            <span class="size-2 shrink-0 rounded-full bg-[var(--brand-orange)]" aria-hidden="true"></span>
            {page.eyebrow}
          </p>
          <h1 class="font-editorial mt-7 max-w-5xl text-[clamp(3.25rem,7.5vw,6.8rem)] font-medium leading-[.86] tracking-[-.055em] text-black">
            {page.headline}<br /><em class="font-normal text-[var(--brand-orange)]">{page.headlineAccent}</em>
          </h1>
          <p class="mt-8 max-w-2xl text-lg leading-8 text-base-600 sm:text-xl">{page.intro}</p>
          <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
            <a href={bookingUrl} class="site-cta">Book a 20-minute workflow call →</a>
            <a href="#proof" class="text-sm font-semibold underline decoration-black/25 underline-offset-4 hover:decoration-black">See what the proof could include</a>
          </div>
          <p class="font-utility mt-5 text-[.62rem] uppercase tracking-[.1em] text-base-500">One workflow · One-week proof · No upfront build fee</p>
        </div>

        <aside class="field-reveal field-reveal-delay lg:col-span-4">
          <div class="border border-black/15 bg-[var(--brand-paper)] shadow-[10px_10px_0_var(--brand-orange)]">
            <figure class="overflow-hidden border-b border-black/15 bg-[var(--brand-paper)]">
              <Image
                src={page.heroImage}
                alt={page.heroImageAlt}
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 360px, calc(100vw - 3rem)"
                loading="eager"
                quality={86}
                class="aspect-[4/3] h-auto w-full object-cover"
              />
            </figure>
            <div class="p-6 sm:p-7">
              <p class="field-label">A typical handoff</p>
              <ol class="mt-6 space-y-0">
                {page.workflow.map((item, index) => (
                  <li class="relative flex items-center gap-4 pb-6 last:pb-0">
                    {index < page.workflow.length - 1 && <span class="absolute left-[.68rem] top-7 h-[calc(100%-1rem)] w-px bg-black/15" aria-hidden="true"></span>}
                    <span class="relative z-10 grid size-[1.4rem] shrink-0 place-items-center rounded-full border border-black/20 bg-[var(--brand-paper)] font-utility text-[.55rem] text-base-500">{index + 1}</span>
                    <span class="text-sm font-semibold">{item}</span>
                  </li>
                ))}
              </ol>
              <p class="mt-7 border-t border-black/10 pt-5 text-xs leading-5 text-base-500">The opportunity usually lives between the steps—not inside another disconnected tool.</p>
            </div>
          </div>
        </aside>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-forest)] text-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="field-label text-white/45">Where the work gets stuck</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.94] tracking-[-.04em] sm:text-6xl">{page.frictionTitle}</h2>
          <p class="mt-6 max-w-lg text-base leading-7 text-white/60">{page.frictionIntro}</p>
        </div>
        <div class="border-t border-white/15 lg:col-span-7">
          {page.frictions.map((friction, index) => (
            <article class="grid gap-3 border-b border-white/15 py-6 sm:grid-cols-[3rem_12rem_1fr] sm:gap-6">
              <span class="field-label text-[var(--brand-orange)]">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="font-semibold">{friction.title}</h3>
              <p class="text-sm leading-6 text-white/55">{friction.body}</p>
            </article>
          ))}
        </div>
      </div>
    </Wrapper>
  </section>

  <section id="proof" class="scroll-mt-6 bg-[var(--brand-surface-soft)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="max-w-3xl">
        <p class="field-label">What the first proof could look like</p>
        <h2 class="font-editorial mt-5 text-5xl leading-[.94] tracking-[-.04em] sm:text-6xl">{page.proofTitle}</h2>
        <p class="mt-6 text-base leading-7 text-base-600">{page.proofIntro}</p>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {page.proofIdeas.map((idea, index) => (
          <article class="group relative min-h-72 overflow-hidden border border-black/15 bg-[var(--brand-paper)] p-6 transition-transform duration-200 hover:-translate-y-1 sm:p-7">
            <span class="font-editorial absolute -right-2 -top-7 text-[8rem] leading-none text-black/[.035]" aria-hidden="true">{index + 1}</span>
            <p class="field-label text-[var(--brand-orange)]">{idea.label}</p>
            <h3 class="font-editorial mt-16 text-4xl leading-[.95] tracking-[-.03em]">{idea.title}</h3>
            <p class="mt-5 text-sm leading-6 text-base-600">{idea.body}</p>
          </article>
        ))}
      </div>
      <p class="font-utility mt-6 text-[.6rem] uppercase leading-5 tracking-[.09em] text-base-500">Examples, not a predetermined package. The first call determines the highest-value starting point.</p>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="field-label">How the offer works</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.94] tracking-[-.04em] sm:text-6xl">One call. One week. Clear value.</h2>
          <p class="mt-6 text-sm leading-6 text-base-600">No paid assessment. No AI homework. No large project before you can see whether the idea works.</p>
        </div>
        <ol class="border-t border-black/15 lg:col-span-8">
          {steps.map(([title, body], index) => (
            <li class="grid gap-4 border-b border-black/15 py-7 sm:grid-cols-[3rem_12rem_1fr] sm:gap-6">
              <span class="field-label text-[var(--brand-orange)]">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="font-semibold">{title}</h3>
              <p class="text-sm leading-6 text-base-600">{body}</p>
            </li>
          ))}
        </ol>
      </div>
    </Wrapper>
  </section>

  <section id="meet-danny" class="scroll-mt-6 border-y border-black/10 bg-[var(--brand-surface-soft)]">
    <Wrapper variant="wide" class="py-14 sm:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="relative w-44 sm:w-52 lg:col-span-3 lg:w-full lg:max-w-[14rem]">
          <div class="absolute -right-3 -top-3 h-full w-full bg-[var(--brand-orange)]" aria-hidden="true"></div>
          <Image
            src={profileImage}
            alt="Danny Sullivan"
            widths={[176, 352, 528]}
            sizes="(min-width: 1024px) 224px, 176px"
            loading="lazy"
            class="relative aspect-square w-full object-cover grayscale"
          />
        </div>

        <div class="lg:col-span-8 lg:col-start-5">
          <p class="field-label">Who does the work</p>
          <h2 class="font-editorial mt-5 max-w-3xl text-5xl leading-[.94] tracking-[-.04em] sm:text-6xl">You work directly with me.</h2>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-base-600">I’m Danny Sullivan, a Raleigh-based AI product engineer, educator, and former service-business owner. From the first call through the working proof, I handle the questions, the build, and the follow-through myself.</p>

          <div class="mt-8 grid gap-px border border-black/10 bg-black/10 sm:grid-cols-3">
            <div class="bg-[var(--brand-paper)] p-5">
              <p class="field-label text-[var(--brand-orange)]">Build</p>
              <p class="mt-3 text-sm font-semibold leading-6">Production AI systems for real customer experiences</p>
            </div>
            <div class="bg-[var(--brand-paper)] p-5">
              <p class="field-label text-[var(--brand-orange)]">Teach</p>
              <p class="mt-3 text-sm font-semibold leading-6">28 AI and software courses and labs</p>
            </div>
            <div class="bg-[var(--brand-paper)] p-5">
              <p class="field-label text-[var(--brand-orange)]">Operate</p>
              <p class="mt-3 text-sm font-semibold leading-6">Built, ran, and sold a Raleigh service business</p>
            </div>
          </div>

          <a href="/about/" class="mt-7 inline-flex text-sm font-semibold underline decoration-black/25 underline-offset-4 hover:decoration-black">More about my background →</a>
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="border-y border-black/10 bg-[var(--brand-bg)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="field-label">Who this is for</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.94] tracking-[-.04em] sm:text-6xl">The proof should create a business case—not just a demo.</h2>
        </div>
        <div class="lg:col-span-7">
          <ul class="border-t border-black/15">
            {page.fitSignals.map((signal) => (
              <li class="grid grid-cols-[1.5rem_1fr] gap-4 border-b border-black/15 py-5 text-base font-semibold">
                <span class="text-[var(--brand-orange)]">✓</span><span>{signal}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm leading-6 text-base-600">If the numbers, access, or opportunity are not there, I will tell you before either of us spends a week on the wrong problem.</p>
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-forest)] text-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="field-label text-white/45">A real operations example</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.94] tracking-[-.04em] sm:text-6xl">Four scattered systems became one clear command center.</h2>
        </div>
        <div class="lg:col-span-7">
          <p class="text-lg leading-8 text-white/70">Zim Zoom’s events, capacity, staffing, payments, metrics, and approvals were spread across separate tools and manual handoffs. I built an owner-focused command center in days so the work could be seen and managed in one place.</p>
          <p class="mt-6 text-sm leading-6 text-white/55">Different industry. Same operating pattern: valuable information scattered across people and systems, with an owner or office team doing the connecting by hand.</p>
          <a href="/projects/zimzoom-photo-booth/" class="mt-8 inline-flex text-sm font-semibold underline decoration-white/25 underline-offset-4 hover:decoration-white">See the working example →</a>
        </div>
      </div>
    </Wrapper>
  </section>

  <section id="book-call" class="scroll-mt-6 bg-[var(--brand-orange)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="field-label text-black/55">Book a workflow call</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.92] tracking-[-.045em] sm:text-7xl">Bring me one repetitive process.</h2>
          <p class="mt-6 max-w-lg text-base leading-7 text-black/70">{page.formPrompt} Pick a time and give me the short version. We’ll use the call to decide whether there is a useful, measurable place to start.</p>
          <p class="font-utility mt-7 text-[.6rem] uppercase tracking-[.1em] text-black/55">20 minutes · Directly with Danny · No obligation</p>
        </div>

        <div class="lg:col-span-7">
          <p class="field-label text-black/55">What happens on the call</p>
          <ol class="mt-5 border-t border-black/20">
            <li class="grid gap-3 border-b border-black/20 py-6 sm:grid-cols-[3rem_12rem_1fr] sm:gap-6">
              <span class="field-label text-black/45">01</span>
              <h3 class="font-semibold">Identify one workflow</h3>
              <p class="text-sm leading-6 text-black/65">Walk through the repetitive process, where it stalls, and who has to keep it moving.</p>
            </li>
            <li class="grid gap-3 border-b border-black/20 py-6 sm:grid-cols-[3rem_12rem_1fr] sm:gap-6">
              <span class="field-label text-black/45">02</span>
              <h3 class="font-semibold">Estimate the value</h3>
              <p class="text-sm leading-6 text-black/65">Put a rough number on the time, capacity, or revenue a better workflow could recover.</p>
            </li>
            <li class="grid gap-3 border-b border-black/20 py-6 sm:grid-cols-[3rem_12rem_1fr] sm:gap-6">
              <span class="field-label text-black/45">03</span>
              <h3 class="font-semibold">Decide on the proof</h3>
              <p class="text-sm leading-6 text-black/65">Leave knowing whether a focused one-week proof makes sense and what it should demonstrate.</p>
            </li>
          </ol>

          <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
            <a href={bookingUrl} class="inline-flex min-h-12 items-center justify-center bg-[var(--brand-ink)] px-5 text-sm font-semibold text-[var(--brand-paper)] transition-transform hover:-translate-y-0.5">Book a 20-minute workflow call →</a>
            <a href={emailUrl} class="text-sm font-semibold underline decoration-black/25 underline-offset-4 hover:decoration-black">Prefer email?</a>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
