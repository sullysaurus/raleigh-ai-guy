---
import Seo from "@/components/fundations/head/Seo.astro";
import Meta from "@/components/fundations/head/Meta.astro";
import Fonts from "@/components/fundations/head/Fonts.astro";
import Favicons from "@/components/fundations/head/Favicons.astro";
import FuseJs from "@/components/fundations/scripts/FuseJS.astro";
// Scripts
import FuseJS from "@/components/fundations/scripts/FuseJS.astro";
import ToggleLocalStorage from "@/components/fundations/scripts/ToggleLocalStorage.astro";

interface Props {
  pageTitle?: string;
  pageDescription?: string;
  noindex?: boolean;
}

const { pageTitle, pageDescription, noindex } = Astro.props;
const siteName = "Danny Sullivan";
const defaultDescription =
  "I build products that streamline work and help companies grow revenue.";
const title = pageTitle ? `${pageTitle} | ${siteName}` : siteName;
const description = pageDescription ?? defaultDescription;
const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://dannysullivan.ai"
).toString();
const siteUrl = new URL("/", Astro.site ?? "https://dannysullivan.ai").toString();
const image = new URL("/og-image.png", siteUrl).toString();
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}#person`,
      name: siteName,
      url: siteUrl,
      sameAs: ["https://www.linkedin.com/in/danny-sullivan-raleigh/"],
      jobTitle: "Product Engineer",
      description: defaultDescription,
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: siteName,
      url: siteUrl,
      publisher: { "@id": `${siteUrl}#person` },
    },
  ],
};
---

<Meta author={siteName} />
<Seo
  title={title}
  description={description}
  canonical={canonical}
  siteName={siteName}
  image={image}
  noindex={noindex}
/>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<Fonts />
<Favicons />
<!-- Scripts -->
<FuseJS/>
<ToggleLocalStorage/>
