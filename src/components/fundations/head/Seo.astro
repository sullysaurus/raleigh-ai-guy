---
import { AstroSeo } from "@lexingtonthemes/seo";

interface Props {
  title: string;
  description: string;
  canonical: string;
  siteName: string;
  image: string;
  noindex?: boolean;
}

const { title, description, canonical, siteName, image, noindex } = Astro.props;
const robots = noindex ? "noindex, nofollow" : "index, follow";
---

<AstroSeo
  title={title}
  description={description}
  canonical={canonical}
  openGraph={{
    url: canonical,
    title,
    description,
    images: [
      {
        url: image,
        width: 1200,
        height: 630,
        alt: `${siteName} social preview`,
        type: "image/png",
      },
    ],
    site_name: siteName,
    type: "website",
    locale: "en_US",
  }}
  twitter={{
    cardType: "summary_large_image",
  }}
/>

<!-- Additional SEO -->
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
