---
const {
  size,
  variant,
  gapSize,
  class: className,
  href,
  type: buttonType = "button",
  ...rest
} = Astro.props;

// Variant styles
const variantClasses = {
  default: [
    "text-white",
    "bg-black",
    "hover:bg-base-800",
    "focus:ring-white",
  ],
  muted: [
    "text-black",
    "bg-base-100",
    "hover:bg-base-200",
    "focus:ring-black",
  ],
};
// Combined size and padding styles
const sizeClasses = {
  small: ["h-8", "text-sm", "font-medium", "px-3", "py-3.5"],
  medium: ["h-9", "text-sm", "font-medium", "px-4", "py-4"],
};

// Gap styles
const gapClasses = {
  small: "gap-2",
  medium: "gap-4",
};
const gapClass = gapClasses[gapSize] || "";

// Additional user-provided classes
const additionalClasses = className ? className.split(" ") : [];

const classList = [
  "flex",
  "rounded-none",
  "uppercase",
  "tracking-wider",
  "cursor-pointer",
  "items-center",
  "justify-center",
  "duration-200",
  "focus:ring-2",
  "focus:ring-offset-2",
  gapClass,
  ...(variant ? variantClasses[variant] || [] : []), // Variant classes
  ...(size ? sizeClasses[size] || [] : []), // Size classes
  ...additionalClasses, // User-provided classes
];
---

{
  href ? (
    <a href={href} class:list={classList} {...rest}>
      <slot name="left-icon" />
      <slot />
      <slot name="right-icon" />
    </a>
  ) : (
    <button type={buttonType} class:list={classList} {...rest}>
      <slot name="left-icon" />
      <slot />
      <slot name="right-icon" />
    </button>
  )
}
