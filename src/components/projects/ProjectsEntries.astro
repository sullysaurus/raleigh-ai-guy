---
// Assets
import { Image } from "astro:assets";
import Text from "@/components/fundations/elements/Text.astro";

const { url, title, subtitle, image, imageAlt, status } = {
  url: "/projects/" + Astro.props.post.id,
  title: Astro.props.post.data.title,
  subtitle: Astro.props.post.data.subtitle,
  image: Astro.props.post.data.image.url,
  imageAlt: Astro.props.post.data.image.alt,
  status: Astro.props.post.data.status,
};
const imageWidth = typeof image === "string" ? 500 : image.width;
const imageHeight = typeof image === "string" ? 500 : image.height;
const isPortraitImage = imageHeight > imageWidth;
const imageFrameClass = isPortraitImage
  ? "overflow-hidden border border-black/10 bg-[var(--brand-paper)] p-5 sm:p-7"
  : "overflow-hidden border border-black/10 bg-[var(--brand-paper)] p-2";
const imageClass = isPortraitImage
  ? "mx-auto max-h-[420px] w-auto max-w-full object-contain"
  : "h-auto w-full object-contain";
---

<article class="group relative flex h-full flex-col">
  <a
    href={url}
    title={`Read more: ${title}`}
    aria-label={`Read project: ${title}`}
    class="absolute inset-0 z-10"></a>

  <div class={imageFrameClass}>
    <Image width={imageWidth} height={imageHeight} class={imageClass} alt={imageAlt} src={image} />
  </div>

  <div class="relative z-0 mt-5 flex h-full flex-col">
    <p class="field-label">{status === "ongoing" ? "Ongoing partnership" : "Focused project"}</p>
    <Text
      tag="h2"
      variant="displaySM"
      class="font-editorial mt-3 font-medium text-black group-hover:text-[var(--brand-orange)]"
    >
      {title}
    </Text>
    <div class="mt-4">
      <Text tag="p" variant="textSM" class="text-base-500">
        {subtitle}
      </Text>
      <Text
        tag="span"
        variant="textSM"
        class="mt-5 flex font-medium text-base-500 group-hover:text-black"
      >
        &rarr; Read more
      </Text>
    </div>
  </div>
</article>
