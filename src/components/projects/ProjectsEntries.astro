---
// Assets
import { Image } from "astro:assets";
import Text from "@/components/fundations/elements/Text.astro";

const { url, title, subtitle, image, imageAlt } = {
  url: "/projects/" + Astro.props.post.id,
  title: Astro.props.post.data.title,
  subtitle: Astro.props.post.data.subtitle,
  image: Astro.props.post.data.image.url,
  imageAlt: Astro.props.post.data.image.alt,
};
const imageWidth = typeof image === "string" ? 500 : image.width;
const imageHeight = typeof image === "string" ? 500 : image.height;
const isPortraitImage = imageHeight > imageWidth;
const imageFrameClass = isPortraitImage
  ? "border-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-lavender)] p-6 shadow-[6px_6px_0_var(--editorial-shadow)]    sm:p-8 lg:p-10"
  : "border-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-blue)] p-8 shadow-[6px_6px_0_var(--editorial-shadow)]    lg:p-12";
const imageClass = isPortraitImage
  ? "mx-auto max-h-[420px] w-auto max-w-full rounded-2xl object-contain"
  : "w-full rounded object-cover";
---

<article class="h-full flex flex-col py-8 relative group">
  <a
    href={url}
    title={`Read more: ${title}`}
    aria-label={`Read project: ${title}`}
    class="absolute inset-0 z-10"></a>

  <div class={imageFrameClass}>
    <Image
      width={imageWidth}
      height={imageHeight}
      class={imageClass}
      alt={imageAlt}
      src={image}
    />
  </div>

  <div
    class="grid grid-cols-1 gap-4 md:grid-cols-3 justify-between h-full mt-4 relative z-0"
  >
    <Text
      tag="h2"
      variant="textBase"
      class="text-black dark:text-white font-medium group-hover:text-black/70 dark:group-hover:text-white/70"
    >
      {title}
    </Text>
    <div class="md:col-span-2">
      <Text tag="p" variant="textSM" class="text-base-500 dark:text-base-400">
        {subtitle}
      </Text>
      <Text
        tag="span"
        variant="textSM"
        class="text-base-500 group-hover:text-black dark:text-base-400 dark:group-hover:text-white font-medium mt-4 flex"
      >
        &rarr; Read more
      </Text>
    </div>
  </div>
</article>
