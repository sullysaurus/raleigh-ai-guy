---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  current?: string;
}

const {
  title,
  description,
  eyebrow = "Internal operations",
  current = "overview",
} = Astro.props;

const groups = [
  {
    label: "Pipeline",
    links: [{ id: "outreach", label: "Realtor Outreach", href: "/ops/outreach-crm/" }],
  },
];
---

<BaseLayout pageTitle={`${title} — Operations`} pageDescription={description} noindex minimal>
  <div class="ops-app">
    <aside class="ops-rail" aria-label="Operations navigation">
      <a class="ops-mark" href="/ops/outreach-crm/" aria-label="Outreach CRM">
        <span>DS</span>
        <strong>Field<br />Office</strong>
      </a>

      <nav>
        {groups.map((group) => (
          <section>
            <p>{group.label}</p>
            {group.links.map((link) => (
              <a href={link.href} aria-current={current === link.id ? "page" : undefined}>
                <span></span>{link.label}
              </a>
            ))}
          </section>
        ))}
      </nav>

      <div class="ops-rail-note">
        <span>NOINDEX</span>
        <p>Internal, but not access-controlled.</p>
      </div>
    </aside>

    <div class="ops-workspace">
      <header class="ops-mobile-bar">
        <a href="/ops/outreach-crm/" class="ops-mobile-mark">DS / Field Office</a>
        <details>
          <summary>Navigate</summary>
          <nav>
            {groups.flatMap((group) => group.links).map((link) => (
              <a href={link.href} aria-current={current === link.id ? "page" : undefined}>{link.label}</a>
            ))}
          </nav>
        </details>
      </header>

      <header class="ops-page-head">
        <div>
          <p>{eyebrow}</p>
          <h1>{title}</h1>
        </div>
        <p class="ops-page-description">{description}</p>
      </header>

      <main class="ops-content"><slot /></main>
    </div>
  </div>

</BaseLayout>
