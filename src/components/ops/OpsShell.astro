---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  current?: string;
}

const {
  title,
  description,
  eyebrow = "Internal operations",
  current = "overview",
} = Astro.props;

const groups = [
  {
    label: "Workspace",
    links: [{ id: "overview", label: "Operations home", href: "/ops/" }],
  },
  {
    label: "AI for Business",
    links: [
      { id: "aifb", label: "Launch cockpit", href: "/ops/ai-for-business/" },
      { id: "launch", label: "Launch plan", href: "/ops/ai-for-business/launch/" },
      { id: "event", label: "Event format", href: "/ops/ai-for-business/event/" },
      { id: "promotion", label: "Promotion", href: "/ops/ai-for-business/promotion/" },
      { id: "leads", label: "Leads & follow-up", href: "/ops/ai-for-business/leads/" },
      { id: "venues", label: "Venues & partners", href: "/ops/ai-for-business/venues/" },
      { id: "scoreboard", label: "Scoreboard", href: "/ops/ai-for-business/scoreboard/" },
    ],
  },
  {
    label: "AI Assessment",
    links: [
      { id: "assessment", label: "Assessment playbook", href: "/ops/ai-assessment-playbook/" },
      { id: "report", label: "Report builder", href: "/ops/assessment-report-template/" },
    ],
  },
];
---

<BaseLayout pageTitle={`${title} — Operations`} pageDescription={description} noindex minimal>
  <div class="ops-app">
    <aside class="ops-rail" aria-label="Operations navigation">
      <a class="ops-mark" href="/ops/" aria-label="Operations home">
        <span>DS</span>
        <strong>Field<br />Office</strong>
      </a>

      <nav>
        {groups.map((group) => (
          <section>
            <p>{group.label}</p>
            {group.links.map((link) => (
              <a href={link.href} aria-current={current === link.id ? "page" : undefined}>
                <span></span>{link.label}
              </a>
            ))}
          </section>
        ))}
      </nav>

      <div class="ops-rail-note">
        <span>NOINDEX</span>
        <p>Internal, but not access-controlled.</p>
      </div>
    </aside>

    <div class="ops-workspace">
      <header class="ops-mobile-bar">
        <a href="/ops/" class="ops-mobile-mark">DS / Field Office</a>
        <details>
          <summary>Navigate</summary>
          <nav>
            {groups.flatMap((group) => group.links).map((link) => (
              <a href={link.href} aria-current={current === link.id ? "page" : undefined}>{link.label}</a>
            ))}
          </nav>
        </details>
      </header>

      <header class="ops-page-head">
        <div>
          <p>{eyebrow}</p>
          <h1>{title}</h1>
        </div>
        <p class="ops-page-description">{description}</p>
      </header>

      <main class="ops-content"><slot /></main>
    </div>
  </div>

  <script>
    const pageKey = `ops:${window.location.pathname}`;

    document.querySelectorAll<HTMLInputElement>(".ops-app input[type='checkbox']").forEach((checkbox, index) => {
      checkbox.disabled = false;
      const key = `${pageKey}:check:${index}`;
      checkbox.checked = window.localStorage.getItem(key) === "1";
      checkbox.addEventListener("change", () => {
        window.localStorage.setItem(key, checkbox.checked ? "1" : "0");
      });
    });

    document.querySelectorAll<HTMLElement>(".ops-document pre").forEach((pre) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "ops-copy-button";
      button.textContent = "Copy";
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(pre.textContent || "");
        button.textContent = "Copied";
        window.setTimeout(() => (button.textContent = "Copy"), 1400);
      });
      pre.before(button);
    });
  </script>
</BaseLayout>

<style>
  :global(body) { background: #f2f0e9; }

  .ops-app {
    --ops-paper: #f2f0e9;
    --ops-sheet: #fbfaf6;
    --ops-ink: #171914;
    --ops-muted: #6e7068;
    --ops-faint: #92948c;
    --ops-line: rgb(23 25 20 / 11%);
    --ops-line-strong: rgb(23 25 20 / 20%);
    --ops-signal: #d9fa67;
    --ops-deadline: #ef6b3b;
    min-height: 100svh;
    color: var(--ops-ink);
    background: var(--ops-paper);
    font-family: "Instrument Sans", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .ops-rail {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 20;
    display: flex;
    width: 14.5rem;
    flex-direction: column;
    border-right: 1px solid var(--ops-line);
    padding: 1.5rem 1rem;
    background: var(--ops-paper);
  }

  .ops-mark { display: flex; align-items: center; gap: .75rem; padding: .25rem; }
  .ops-mark > span { display: grid; width: 2rem; height: 2rem; place-items: center; background: var(--ops-ink); color: var(--ops-paper); font-size: .68rem; font-weight: 750; }
  .ops-mark strong { font-family: "Anybody", sans-serif; font-size: .78rem; font-weight: 750; line-height: .9; letter-spacing: -.02em; text-transform: uppercase; }
  .ops-rail nav { margin-top: 2.5rem; }
  .ops-rail nav section + section { margin-top: 1.75rem; }
  .ops-rail nav p { margin: 0 0 .5rem .75rem; color: var(--ops-faint); font-size: .62rem; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; }
  .ops-rail nav a { display: flex; min-height: 2.25rem; align-items: center; gap: .6rem; padding: .45rem .7rem; color: var(--ops-muted); font-size: .78rem; font-weight: 520; transition: color 140ms ease, background-color 140ms ease; }
  .ops-rail nav a > span { width: .35rem; height: .35rem; border-radius: 50%; background: transparent; }
  .ops-rail nav a:hover { color: var(--ops-ink); background: rgb(23 25 20 / 4%); }
  .ops-rail nav a[aria-current="page"] { color: var(--ops-ink); background: var(--ops-sheet); font-weight: 680; }
  .ops-rail nav a[aria-current="page"] > span { background: var(--ops-deadline); }
  .ops-rail-note { margin-top: auto; border-top: 1px solid var(--ops-line); padding: 1rem .75rem 0; }
  .ops-rail-note span { color: var(--ops-deadline); font-size: .6rem; font-weight: 750; letter-spacing: .12em; }
  .ops-rail-note p { margin-top: .35rem; color: var(--ops-faint); font-size: .68rem; line-height: 1.4; }

  .ops-workspace { margin-left: 14.5rem; min-width: 0; }
  .ops-page-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 25rem); gap: 3rem; align-items: end; max-width: 76rem; margin-inline: auto; padding: 4.5rem 3rem 2.5rem; }
  .ops-page-head > div > p { color: var(--ops-deadline); font-size: .65rem; font-weight: 750; letter-spacing: .14em; text-transform: uppercase; }
  .ops-page-head h1 { max-width: 50rem; margin-top: .75rem; font-family: "Anybody", sans-serif; font-size: clamp(2.4rem, 5vw, 4.75rem); font-weight: 720; line-height: .92; letter-spacing: -.055em; text-wrap: balance; }
  .ops-page-description { max-width: 25rem; color: var(--ops-muted); font-size: .9rem; line-height: 1.55; text-wrap: pretty; }
  .ops-content { max-width: 76rem; margin-inline: auto; padding: 0 3rem 5rem; }
  .ops-mobile-bar { display: none; }

  :global(.ops-copy-button) { display: block; min-height: 2.25rem; margin: 1rem 0 -.5rem auto; border: 1px solid var(--ops-line-strong); padding: .45rem .8rem; color: var(--ops-muted); background: var(--ops-sheet); font-size: .68rem; font-weight: 700; transition: color 140ms ease, background-color 140ms ease, transform 120ms ease; }
  :global(.ops-copy-button:hover) { color: var(--ops-ink); background: var(--ops-signal); }
  :global(.ops-copy-button:active) { transform: scale(.97); }
  :global(.ops-app a:focus-visible), :global(.ops-app button:focus-visible), :global(.ops-app summary:focus-visible), :global(.ops-app input:focus-visible) { outline: 2px solid #2947ff; outline-offset: 3px; }

  @media (max-width: 960px) {
    .ops-rail { display: none; }
    .ops-workspace { margin-left: 0; }
    .ops-mobile-bar { position: sticky; top: 0; z-index: 30; display: flex; min-height: 3.5rem; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--ops-line); padding: .5rem 1.25rem; background: rgb(242 240 233 / 94%); backdrop-filter: blur(14px); }
    .ops-mobile-mark { font-family: "Anybody", sans-serif; font-size: .72rem; font-weight: 720; text-transform: uppercase; }
    .ops-mobile-bar details { position: relative; }
    .ops-mobile-bar summary { display: grid; min-height: 2.5rem; cursor: pointer; place-items: center; border: 1px solid var(--ops-line-strong); padding-inline: .8rem; font-size: .72rem; font-weight: 650; list-style: none; }
    .ops-mobile-bar summary::-webkit-details-marker { display: none; }
    .ops-mobile-bar nav { position: absolute; top: calc(100% + .5rem); right: 0; display: grid; width: min(20rem, calc(100vw - 2.5rem)); border: 1px solid var(--ops-line-strong); padding: .5rem; background: var(--ops-sheet); box-shadow: 0 18px 50px rgb(23 25 20 / 12%); }
    .ops-mobile-bar nav a { min-height: 2.6rem; padding: .65rem .75rem; color: var(--ops-muted); font-size: .78rem; }
    .ops-mobile-bar nav a[aria-current="page"] { color: var(--ops-ink); background: var(--ops-signal); font-weight: 680; }
    .ops-page-head { padding-top: 3.5rem; }
  }

  @media (max-width: 680px) {
    .ops-page-head { grid-template-columns: 1fr; gap: 1.25rem; padding: 3rem 1.25rem 2rem; }
    .ops-page-head h1 { font-size: clamp(2.35rem, 13vw, 4rem); }
    .ops-page-description { font-size: .84rem; }
    .ops-content { padding: 0 1.25rem 4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ops-app * { scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
  }
</style>
