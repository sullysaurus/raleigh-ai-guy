---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  current?: string;
}

const {
  title,
  description,
  eyebrow = "Internal operations",
  current = "overview",
} = Astro.props;

const groups = [
  {
    label: "Acquisition",
    links: [
      { id: "acquisition", label: "Outbound Pipeline", href: "/ops/acquisition/" },
      { id: "outreach", label: "Realtor Outreach", href: "/ops/outreach-crm/" },
    ],
  },
];
---

<BaseLayout pageTitle={`${title} — Operations`} pageDescription={description} noindex minimal>
  <div class="ops-app">
    <aside class="ops-rail" aria-label="Operations navigation">
      <a class="ops-mark" href="/ops/acquisition/" aria-label="Raleigh AI Guy operations">
        <span>RA</span>
        <strong>Field<br />Office</strong>
      </a>

      <nav>
        {groups.map((group) => (
          <section>
            <p>{group.label}</p>
            {group.links.map((link) => (
              <a href={link.href} aria-current={current === link.id ? "page" : undefined}>
                <span></span>{link.label}
              </a>
            ))}
          </section>
        ))}
      </nav>

      <div class="ops-rail-note">
        <span>NOINDEX</span>
        <p>Internal, but not access-controlled.</p>
      </div>
    </aside>

    <div class="ops-workspace">
      <header class="ops-mobile-bar">
        <a href="/ops/acquisition/" class="ops-mobile-mark">RA / Field Office</a>
        <details>
          <summary>Navigate</summary>
          <nav>
            {groups.flatMap((group) => group.links).map((link) => (
              <a href={link.href} aria-current={current === link.id ? "page" : undefined}>{link.label}</a>
            ))}
          </nav>
        </details>
      </header>

      <header class="ops-page-head">
        <div>
          <p>{eyebrow}</p>
          <h1>{title}</h1>
        </div>
        <p class="ops-page-description">{description}</p>
      </header>

      <main class="ops-content"><slot /></main>
    </div>
  </div>

</BaseLayout>

<style is:global>
  .ops-app { min-height: 100svh; background: #eeece4; color: #18211c; }
  .ops-rail { position: fixed; inset: 0 auto 0 0; z-index: 20; display: flex; width: 15.5rem; flex-direction: column; border-right: 1px solid rgb(24 33 28 / 16%); background: #172d26; color: #f6f2e7; }
  .ops-mark { display: flex; min-height: 8.25rem; align-items: center; gap: 1rem; border-bottom: 1px solid rgb(246 242 231 / 14%); padding: 1.5rem; text-decoration: none; }
  .ops-mark > span { display: grid; width: 2.75rem; height: 2.75rem; place-items: center; border: 1px solid #ef6b42; border-radius: 999px; color: #ef6b42; font: 600 .72rem/1 "IBM Plex Mono", monospace; letter-spacing: .08em; }
  .ops-mark strong { color: #f6f2e7; font: 500 1.28rem/.94 "Newsreader", serif; }
  .ops-rail nav { padding: 1.75rem 1rem; }
  .ops-rail nav section + section { margin-top: 2rem; }
  .ops-rail nav p { padding-inline: .65rem; color: rgb(246 242 231 / 48%); font: 500 .62rem/1.4 "IBM Plex Mono", monospace; letter-spacing: .14em; text-transform: uppercase; }
  .ops-rail nav a { display: flex; align-items: center; gap: .7rem; margin-top: .45rem; border-radius: .35rem; padding: .72rem .65rem; color: rgb(246 242 231 / 68%); font-size: .82rem; text-decoration: none; transition: color 160ms ease, background 160ms ease; }
  .ops-rail nav a span { width: .38rem; height: .38rem; border: 1px solid currentColor; border-radius: 999px; }
  .ops-rail nav a:hover { color: #fffdf7; background: rgb(255 255 255 / 6%); }
  .ops-rail nav a[aria-current="page"] { color: #fffdf7; background: rgb(255 255 255 / 9%); }
  .ops-rail nav a[aria-current="page"] span { border-color: #ef6b42; background: #ef6b42; }
  .ops-rail-note { margin: auto 1.5rem 1.5rem; border-top: 1px solid rgb(246 242 231 / 14%); padding-top: 1.1rem; }
  .ops-rail-note span { color: #ef6b42; font: 600 .58rem/1 "IBM Plex Mono", monospace; letter-spacing: .15em; }
  .ops-rail-note p { margin-top: .55rem; color: rgb(246 242 231 / 46%); font-size: .7rem; line-height: 1.45; }
  .ops-workspace { min-height: 100svh; margin-left: 15.5rem; }
  .ops-mobile-bar { display: none; }
  .ops-page-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 30rem); align-items: end; gap: 3rem; border-bottom: 1px solid rgb(24 33 28 / 16%); padding: 2.4rem clamp(1.25rem, 4vw, 4rem) 2rem; }
  .ops-page-head > div > p { color: #b54a2e; font: 600 .62rem/1.4 "IBM Plex Mono", monospace; letter-spacing: .14em; text-transform: uppercase; }
  .ops-page-head h1 { margin-top: .55rem; font: 500 clamp(2.25rem, 4.5vw, 4.6rem)/.9 "Newsreader", serif; letter-spacing: -.04em; }
  .ops-page-description { color: #657069; font-size: .82rem; line-height: 1.65; }
  .ops-content { padding: clamp(1.25rem, 3.5vw, 3.5rem) clamp(1.25rem, 4vw, 4rem) 5rem; }

  @media (max-width: 900px) {
    .ops-rail { display: none; }
    .ops-workspace { margin-left: 0; }
    .ops-mobile-bar { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgb(24 33 28 / 16%); padding: .9rem 1.25rem; background: #172d26; color: #f6f2e7; }
    .ops-mobile-mark { color: inherit; font: 600 .68rem/1 "IBM Plex Mono", monospace; letter-spacing: .08em; text-decoration: none; }
    .ops-mobile-bar summary { cursor: pointer; font-size: .72rem; }
    .ops-mobile-bar details { position: relative; }
    .ops-mobile-bar details nav { position: absolute; top: 2rem; right: 0; z-index: 30; display: grid; width: 13rem; gap: .25rem; border: 1px solid rgb(246 242 231 / 15%); border-radius: .4rem; padding: .5rem; background: #172d26; box-shadow: 0 1rem 2rem rgb(0 0 0 / 20%); }
    .ops-mobile-bar details nav a { border-radius: .25rem; padding: .65rem; color: rgb(246 242 231 / 75%); font-size: .75rem; text-decoration: none; }
    .ops-mobile-bar details nav a[aria-current="page"] { color: #fffdf7; background: rgb(255 255 255 / 9%); }
    .ops-page-head { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
