---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  current: "overview" | "clients" | "expenses";
  eyebrow?: string;
}

const { title, description, current, eyebrow = "Private operating system" } = Astro.props;
const links = [
  { id: "overview", label: "Overview", href: "/admin/" },
  { id: "clients", label: "Clients", href: "/clients/" },
  { id: "expenses", label: "Expenses", href: "/admin/expenses/" },
];
---

<BaseLayout pageTitle={`${title} — Admin`} pageDescription={description} noindex minimal>
  <div class="admin-root">
    <section id="admin-session-check" class="admin-session-check" aria-live="polite"><span></span><p>Opening private admin…</p></section>
    <section id="admin-gate" class="admin-gate" aria-labelledby="admin-gate-title" hidden>
      <form id="admin-login-form" class="admin-gate-card">
        <span class="admin-gate-index">PRIVATE / ADMIN</span>
        <div class="admin-gate-mark" aria-hidden="true">RA</div>
        <p>Raleigh AI Guy · Back office</p>
        <h1 id="admin-gate-title">Open admin.</h1>
        <label for="admin-key">Dashboard password</label>
        <div class="admin-password-row">
          <input id="admin-key" name="dashboardKey" type="password" autocomplete="current-password" required />
          <button type="submit">Unlock →</button>
        </div>
        <span id="admin-login-error" class="admin-login-error" role="alert"></span>
      </form>
    </section>

    <div id="admin-app" class="admin-app" hidden>
      <aside class="admin-rail">
        <a href="/admin/" class="admin-mark"><span>RA</span><strong>Admin<br />Office</strong></a>
        <nav aria-label="Admin navigation">
          <p>Business</p>
          {links.map((link) => <a href={link.href} aria-current={current === link.id ? "page" : undefined}><span></span>{link.label}</a>)}
        </nav>
        <div class="admin-rail-foot"><span>NOINDEX</span><button id="admin-sign-out" type="button">Lock office</button></div>
      </aside>

      <div class="admin-workspace">
        <header class="admin-mobile-head">
          <a href="/admin/">RA / Admin Office</a>
          <nav>{links.map((link) => <a href={link.href} aria-current={current === link.id ? "page" : undefined}>{link.label}</a>)}</nav>
        </header>
        <header class="admin-page-head">
          <div><p>{eyebrow}</p><h1>{title}</h1></div>
          <p>{description}</p>
        </header>
        <main class="admin-content"><slot /></main>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const gate = document.querySelector("#admin-gate");
  const sessionCheck = document.querySelector("#admin-session-check");
  const app = document.querySelector("#admin-app");
  const form = document.querySelector("#admin-login-form");
  const error = document.querySelector("#admin-login-error");

  const readJson = async (response) => {
    const text = await response.text();
    try { return JSON.parse(text); }
    catch { throw new Error("The admin service returned an invalid response."); }
  };

  const unlock = () => {
    sessionCheck.hidden = true;
    gate.hidden = true;
    app.hidden = false;
    window.dispatchEvent(new CustomEvent("admin:ready"));
  };

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    error.textContent = "";
    const button = form.querySelector("button");
    button.disabled = true;
    try {
      const key = new FormData(form).get("dashboardKey");
      const response = await fetch("/.netlify/functions/ops-session", { method: "POST", headers: { "x-ops-key": String(key || "") } });
      const payload = await readJson(response);
      if (!response.ok || !payload.authenticated) throw new Error(payload.error || "That password did not work.");
      form.reset();
      unlock();
    } catch (problem) {
      error.textContent = problem instanceof Error ? problem.message : "Could not unlock admin.";
    } finally { button.disabled = false; }
  });

  document.querySelector("#admin-sign-out").addEventListener("click", async () => {
    await fetch("/.netlify/functions/ops-session", { method: "DELETE" });
    window.location.reload();
  });

  (async () => {
    try {
      const response = await fetch("/.netlify/functions/ops-session");
      const payload = await readJson(response);
      if (response.ok && payload.authenticated) { unlock(); return; }
    } catch {}
    sessionCheck.hidden = true;
    gate.hidden = false;
  })();
</script>

<style is:global>
  .admin-root { min-height: 100svh; color: #17130f; background: #eee8d6; }
  .admin-session-check { display: grid; min-height: 100svh; place-items: center; align-content: center; gap: 1rem; color: rgb(247 241 223 / 62%); background: #17130f; font-size: .65rem; letter-spacing: .08em; text-transform: uppercase; }
  .admin-session-check[hidden] { display: none; }
  .admin-session-check span { width: 2rem; height: 2rem; border: 2px solid rgb(247 241 223 / 18%); border-top-color: #f43e8d; border-radius: 999px; animation: admin-spin 700ms linear infinite; }
  .admin-gate { display: grid; min-height: 100svh; place-items: center; padding: 1.5rem; color: #f7f1df; background: #17130f; background-image: linear-gradient(rgb(247 241 223 / 4%) 1px, transparent 1px), linear-gradient(90deg, rgb(247 241 223 / 4%) 1px, transparent 1px); background-size: 34px 34px; }
  .admin-gate-card { position: relative; width: min(100%, 35rem); border: 1px solid rgb(247 241 223 / 28%); padding: clamp(2rem, 7vw, 4.5rem); background: #201a16; box-shadow: 14px 14px 0 #f43e8d; animation: admin-rise 500ms cubic-bezier(.22,1,.36,1) both; }
  .admin-gate-index { position: absolute; top: 1rem; right: 1rem; color: rgb(247 241 223 / 40%); font-size: .58rem; letter-spacing: .12em; }
  .admin-gate-mark { display: grid; width: 3.5rem; height: 3.5rem; place-items: center; border: 2px solid #f0df55; border-radius: 999px; color: #f0df55; font-size: .78rem; font-weight: 700; }
  .admin-gate-card > p { margin-top: 2.25rem; color: #f43e8d; font-size: .63rem; letter-spacing: .12em; text-transform: uppercase; }
  .admin-gate-card h1 { margin-block: .5rem 2rem; font-size: clamp(4rem, 13vw, 6.5rem); line-height: .82; }
  .admin-gate-card label { display: block; color: rgb(247 241 223 / 55%); font-size: .62rem; letter-spacing: .09em; text-transform: uppercase; }
  .admin-password-row { display: grid; grid-template-columns: 1fr auto; margin-top: .55rem; }
  .admin-password-row input { min-width: 0; border: 1px solid rgb(247 241 223 / 35%); border-radius: 0; color: #f7f1df; background: transparent; }
  .admin-password-row button { border: 1px solid #f0df55; padding-inline: 1rem; color: #17130f; background: #f0df55; font-size: .68rem; font-weight: 700; text-transform: uppercase; }
  .admin-login-error { display: block; min-height: 1.3rem; margin-top: .65rem; color: #f43e8d; font-size: .7rem; }
  .admin-app { min-height: 100svh; }
  .admin-rail { position: fixed; inset: 0 auto 0 0; z-index: 20; display: flex; width: 14.5rem; flex-direction: column; color: #f7f1df; background: #17130f; }
  .admin-mark { display: flex; align-items: center; gap: .9rem; border-bottom: 1px solid rgb(247 241 223 / 15%); padding: 1.6rem; color: inherit; text-decoration: none; }
  .admin-mark span { display: grid; width: 2.7rem; height: 2.7rem; place-items: center; border: 1px solid #f43e8d; border-radius: 999px; color: #f43e8d; font-size: .68rem; font-weight: 700; }
  .admin-mark strong { font-family: "Newsreader", serif; font-size: 1.25rem; line-height: .88; }
  .admin-rail nav { padding: 2rem 1rem; }
  .admin-rail nav p { padding-inline: .65rem; color: rgb(247 241 223 / 38%); font-size: .58rem; letter-spacing: .14em; text-transform: uppercase; }
  .admin-rail nav a { display: flex; align-items: center; gap: .7rem; margin-top: .45rem; padding: .72rem .65rem; color: rgb(247 241 223 / 62%); font-size: .72rem; text-decoration: none; }
  .admin-rail nav a span { width: .38rem; height: .38rem; border: 1px solid currentColor; border-radius: 999px; }
  .admin-rail nav a[aria-current="page"] { color: #f7f1df; background: rgb(247 241 223 / 8%); }
  .admin-rail nav a[aria-current="page"] span { border-color: #f0df55; background: #f0df55; }
  .admin-rail-foot { display: flex; align-items: center; justify-content: space-between; margin: auto 1.5rem 1.5rem; border-top: 1px solid rgb(247 241 223 / 14%); padding-top: 1rem; }
  .admin-rail-foot span { color: #f43e8d; font-size: .56rem; letter-spacing: .12em; }
  .admin-rail-foot button { color: rgb(247 241 223 / 50%); font-size: .62rem; text-decoration: underline; text-underline-offset: 3px; }
  .admin-workspace { min-height: 100svh; margin-left: 14.5rem; }
  .admin-mobile-head { display: none; }
  .admin-page-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 28rem); align-items: end; gap: 3rem; border-bottom: 2px solid #17130f; padding: 1.6rem clamp(1.25rem, 4vw, 3.5rem); }
  .admin-page-head > div > p { color: #f43e8d; font-size: .61rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .admin-page-head h1 { margin-top: .2rem; font-size: clamp(3rem, 6vw, 5rem); line-height: .86; }
  .admin-page-head > p { color: #655b4d; font-size: .75rem; line-height: 1.65; }
  .admin-content { padding: clamp(1.5rem, 4vw, 3.5rem); }
  .admin-button { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; border: 2px solid #17130f; padding-inline: 1rem; color: #f7f1df; background: #17130f; box-shadow: 4px 4px 0 #f43e8d; font-size: .68rem; font-weight: 700; text-decoration: none; text-transform: uppercase; transition: transform 140ms ease, box-shadow 140ms ease; }
  .admin-button:hover { transform: translate(2px,2px); box-shadow: 2px 2px 0 #f43e8d; }
  @keyframes admin-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes admin-spin { to { rotate: 360deg; } }
  @media (max-width: 820px) {
    .admin-rail { display: none; }
    .admin-workspace { margin-left: 0; }
    .admin-mobile-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; overflow-x: auto; padding: 1rem 1.25rem; color: #f7f1df; background: #17130f; }
    .admin-mobile-head > a { flex: 0 0 auto; color: inherit; font-size: .65rem; font-weight: 700; text-decoration: none; }
    .admin-mobile-head nav { display: flex; gap: .8rem; }
    .admin-mobile-head nav a { color: rgb(247 241 223 / 60%); font-size: .62rem; text-decoration: none; }
    .admin-mobile-head nav a[aria-current="page"] { color: #f0df55; }
    .admin-page-head { grid-template-columns: 1fr; gap: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .admin-gate-card { animation: none; } .admin-session-check span { animation-duration: 2s; } }
</style>
