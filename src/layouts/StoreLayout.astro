---
//Assets
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "./BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const { frontmatter, previous, next } = Astro.props;
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="pt-12 lg:py-32 xl:py-54">
      <Text
        tag="h1"
        variant="textBase"
        class="text-black dark:text-white font-medium"
      >
        {frontmatter.title}
      </Text>
    </Wrapper>
    <Wrapper variant="standard" class="py-12">
      <div class="border-t dark:border-white/10 border-black/10 pt-2">
        <Text
          tag="p"
          variant="textSM"
          class="2xl:text-base dark:text-base-400 text-base-500"
        >
          {frontmatter.description}
        </Text>
      </div>
      <div class="bg-black/5 dark:bg-white/5 rounded-xl p-8 mt-8">
        <Image
          width="1000"
          height="1000"
          src={frontmatter.image.url}
          alt={frontmatter.image.alt}
          class="object-cover object-top"
        />
      </div>
      <div class="mt-10 flex flex-col gap-3 md:flex-row">
        <Text
          tag="a"
          variant="textSM"
          href={frontmatter.checkout}
          class="text-base-500 hover:text-black dark:text-base-400 dark:hover:text-white font-medium"
        >
          &rarr; Buy for ${frontmatter.price}</Text
        >
        <div class="hidden lg:block h-6 w-px bg-base-200"></div>
        <Text
          tag="a"
          variant="textSM"
          class="text-base-500 hover:text-black dark:text-base-400 dark:hover:text-white font-medium"
          href={frontmatter.preview}>&#x2197 Preview</Text
        >
      </div>
      <div class="mt-10 border-t dark:border-white/20 border-black/10 pt-10">
        <Text
          tag="h3"
          variant="textBase"
          class="font-medium text-black dark:text-white">Highlights</Text
        >

        <ul role="list" class="list-disc list-inside mt-4">
          <!-- Dynamically render highlights -->
          {
            frontmatter.highlights.map((highlight) => (
              <li>
                <Text
                  variant="textSM"
                  tag="span"
                  class="text-base-500 dark:text-base-400 2xl:text-base"
                >
                  {highlight}
                </Text>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="mt-10 border-t dark:border-white/20 border-black/10 pt-10">
        <Text
          tag="h3"
          variant="textBase"
          class="font-medium text-black dark:text-white">License</Text
        >
        <Text
          variant="textSM"
          tag="p"
          class="text-base-500 mt-4 dark:text-base-400 2xl:text-base"
        >
          {frontmatter.license}
        </Text>
      </div>
      <nav
        class="flex flex-col md:flex-row lg:justify-between gap-4 lg:items-center relative text-xs mt-24"
      >
        <div>
          {
            previous && (
              <a href={`/projects/${previous.id}`} class="hover:opacity-80 ">
                <span class="block  text-black dark:text-white font-medium uppercase">
                  Previous:
                </span>
                <span class="block  text-base-600 dark:text-base-400 text-balance">
                  {previous.data.title}
                </span>
              </a>
            )
          }
        </div>
        <div>
          {
            next && (
              <a
                href={`/projects/${next.id}`}
                class=" hover:opacity-80 text-right"
              >
                <span class="block  text-black dark:text-white font-medium uppercase ">
                  Next:
                </span>
                <span class="block  text-base-600 dark:text-base-400 text-balance">
                  {next.data.title}
                </span>
              </a>
            )
          }
        </div>
      </nav>
    </Wrapper>
  </section>
</BaseLayout>
