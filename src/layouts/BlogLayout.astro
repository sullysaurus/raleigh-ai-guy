---
// Assets
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Retrieve all posts from the "posts" collection, which returns an unsorted array of post objects
const { frontmatter, readingTime, previous, next } = Astro.props;
import { getCollection } from "astro:content";
import BlogCard2 from "@/components/blog/BlogCard2.astro";
const allPostsUnsorted = await getCollection("posts");
const postImage = frontmatter.image.url;
const postImageWidth = typeof postImage === "string" ? 1200 : postImage.width;
const postImageHeight =
  typeof postImage === "string" ? 675 : postImage.height;
// Sort the posts in descending order by publication date (newest to oldest)
const allPosts = allPostsUnsorted.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
const publishedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "2-digit",
  timeZone: "UTC",
}).format(frontmatter.pubDate);
const publishedDateTime = frontmatter.pubDate.toISOString().slice(0, 10);
---

<BaseLayout pageTitle={frontmatter.title} pageDescription={frontmatter.description}>
  <section>
    <Wrapper variant="standard" class="pt-12 xl:pt-54">
      <Text
        tag="h1"
        variant="textBase"
        class="text-black dark:text-white font-medium"
      >
        {frontmatter.title}
      </Text>
      <Text
        tag="p"
        variant="textSM"
        class="text-base-500 text-balance mt-4 dark:text-base-400"
      >
        {frontmatter.description}
      </Text>
      <Image
        width={postImageWidth}
        height={postImageHeight}
        src={postImage}
        alt={frontmatter.image.alt}
        class="mt-2 h-auto w-full rounded-xl"
      />
    </Wrapper>
  </section>
  <section>
    <Wrapper variant="standard" class="pb-12">
      <div class="border-t dark:border-white/10 border-black/10 pt-2 mt-2">
        <div class="flex gap-4 items-start justify-between">
          <div class="flex items-center gap-x-3">
            <div class="flex flex-col text-base-500 dark:text-base-400">
              <Text tag="span" variant="textXS" class="font-medium">
                <time datetime={publishedDateTime}>
                  Written on {publishedDate}
                </time>
                <span>·</span>
                <span>{readingTime}</span>
              </Text>
              {
                frontmatter.author && (
                  <Text tag="span" variant="textXS" class="font-medium">
                    by {frontmatter.author}
                  </Text>
                )
              }
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-1">
            {
              frontmatter.tags.map((tag) => (
                <>
                  <Text
                    tag="a"
                    variant="textSM"
                    title={tag}
                    aria-label={tag}
                    href={`/blog/tags/${tag}`}
                    class="text-base-500 hover:text-black dark:text-base-400 dark:hover:text-white font-medium"
                  >
                    {tag}
                  </Text>
                </>
              ))
            }
          </div>
        </div>
      </div>
      <Wrapper variant="prose" class="mt-12">
        <slot />
      </Wrapper>
      {
        (previous || next) && (
          <nav class="flex flex-col md:flex-row lg:justify-between gap-4 lg:items-center relative text-xs mt-16">
            <div>
              {previous && (
                <a
                  href={`/blog/posts/${previous.id}`}
                  class="hover:opacity-80 "
                >
                  <span class="block  text-black dark:text-white font-medium uppercase">
                    Previous:
                  </span>
                  <span class="block  text-base-600 dark:text-base-400 text-balance">
                    {previous.data.title}
                  </span>
                </a>
              )}
            </div>

            <div>
              {next && (
                <a
                  href={`/blog/posts/${next.id}`}
                  class=" hover:opacity-80 text-right"
                >
                  <span class="block  text-black dark:text-white font-medium uppercase ">
                    Next:
                  </span>
                  <span class="block  text-base-600 dark:text-base-400 text-balance">
                    {next.data.title}
                  </span>
                </a>
              )}
            </div>
          </nav>
        )
      }
    </Wrapper>
  </section>
  <section>
    <Wrapper variant="standard" class="pt-8 pb-12 lg:pt-20 lg:pb-28">
      <div
        class="gap-2 sm:flex sm:items-center sm:justify-between border-t dark:border-white/10 border-black/10 pt-2"
      >
        <Text
          tag="h3"
          variant="textBase"
          class="text-black dark:text-white font-medium"
        >
          Latest blog posts
        </Text>
        <div class="">
          <Text
            tag="a"
            variant="textSM"
            href="/blog/"
            aria-label="See all blog posts"
            title="See all blog posts"
            class="text-base-500 hover:text-black dark:text-base-400 dark:hover:text-white font-medium"
            >See all posts
          </Text>
        </div>
      </div>
      <div class="mt-8 flex flex-col">
        {allPosts.slice(0, 2).map((post) => <BlogCard2 post={post} />)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
