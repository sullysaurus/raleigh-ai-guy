---
import BaseLayout from "./BaseLayout.astro";
import { getImage } from "astro:assets";
import AiQuestionForm from "@/components/global/AiQuestionForm.astro";

const { frontmatter, readingTime, previous, next } = Astro.props;
const date = frontmatter.pubDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const socialImage = await getImage({
  src: frontmatter.image.url,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpeg",
  quality: 82,
});
---

<BaseLayout
  pageTitle={frontmatter.title}
  pageDescription={frontmatter.description}
  socialImage={socialImage.src}
  socialImageAlt={frontmatter.image.alt}
  socialImageWidth={1200}
  socialImageHeight={630}
>
  <article class="brand-page">
    <header class="brand-page-header"><div class="mx-auto max-w-5xl px-5 pb-16 pt-16 sm:px-8 sm:pb-24 sm:pt-24">
      <a href="/blog/" class="brand-back-link">← Practical AI guides</a>
      <h1 class="brand-display mt-8">{frontmatter.title}</h1>
      <p class="brand-copy brand-copy-lead mt-6 max-w-3xl">{frontmatter.description}</p>
      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 text-xs text-base-400">
        <time datetime={frontmatter.pubDate.toISOString().slice(0, 10)}>{date}</time><span>{readingTime}</span>
        {frontmatter.tags.map((tag) => <a href={`/blog/tags/${tag}`} class="hover:text-black">#{tag}</a>)}
      </div>
    </div></header>

    <div class="mx-auto grid max-w-7xl justify-center gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-[9rem_minmax(0,60rem)] lg:gap-16">
      <aside class="text-xs leading-5 text-base-400"><span class="block font-medium uppercase tracking-wide">Written by</span><a href="/about/" class="mt-2 block text-black hover:underline">Danny Sullivan</a><span class="mt-1 block">Raleigh AI Guy<br />Raleigh, NC</span></aside>
      <div class="prose post-body min-w-0 max-w-none prose-headings:font-sans prose-headings:font-semibold prose-headings:tracking-tight prose-pre:max-w-full prose-pre:overflow-x-auto prose-a:text-black prose-a:underline prose-a:decoration-base-300 prose-a:underline-offset-4 prose-strong:text-black"><slot /></div>
    </div>

    {(previous || next) && <nav class="mx-auto grid max-w-5xl gap-4 px-5 sm:grid-cols-2 sm:px-8" aria-label="More articles">
      {previous ? <a href={`/blog/posts/${previous.id}`} class="brand-panel brand-card-interactive flex min-h-24 items-center p-6 text-sm font-medium">← {previous.data.title}</a> : <span></span>}
      {next && <a href={`/blog/posts/${next.id}`} class="brand-panel brand-card-interactive flex min-h-24 items-center justify-end p-6 text-right text-sm font-medium">{next.data.title} →</a>}
    </nav>}

    <section class="brand-dark-section mt-20 border-y">
      <div class="mx-auto grid max-w-5xl gap-8 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[.8fr_1.2fr] lg:items-start lg:gap-14">
        <div>
          <p class="brand-eyebrow">Two-Minute AI Answers</p>
          <h2 class="brand-section-title mt-4">Send me the part that is stuck.</h2>
          <p class="brand-copy mt-5">I will record a personalized two-minute answer today and send it directly to you.</p>
          <a href="/ai-answers/" class="brand-text-link mt-5">Browse the answer library →</a>
        </div>
        <div class="brand-form-panel p-5 sm:p-6">
          <AiQuestionForm source="blog_post_footer" compact />
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
