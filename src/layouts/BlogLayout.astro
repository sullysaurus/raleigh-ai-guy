---
import BaseLayout from "./BaseLayout.astro";
import { getImage, Image } from "astro:assets";
import ContactBand from "@/components/global/ContactBand.astro";

const { frontmatter, readingTime, previous, next } = Astro.props;
const date = frontmatter.pubDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const socialImage = await getImage({
  src: frontmatter.image.url,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpeg",
  quality: 82,
});
---

<BaseLayout
  pageTitle={frontmatter.title}
  pageDescription={frontmatter.description}
  socialImage={socialImage.src}
  socialImageAlt={frontmatter.image.alt}
  socialImageWidth={1200}
  socialImageHeight={630}
>
  <article class="brand-page">
    <header><div class="mx-auto max-w-6xl px-6 py-14 sm:px-8 sm:py-20 lg:px-10">
      <a href="/blog/" class="field-label hover:text-black">← Field notes</a>
      <h1 class="font-editorial mt-7 max-w-5xl text-5xl font-medium leading-[.94] tracking-[-.045em] sm:text-7xl">{frontmatter.title}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-base-600">{frontmatter.description}</p>
      <div class="font-utility mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 text-[.65rem] uppercase tracking-[.06em] text-base-500">
        <time datetime={frontmatter.pubDate.toISOString().slice(0, 10)}>{date}</time><span>{readingTime}</span>
        {frontmatter.tags.map((tag) => <a href={`/blog/tags/${tag}`} class="hover:text-black">{tag.replaceAll("-", " ")}</a>)}
      </div>
      <div class="mt-10 overflow-hidden border border-black/10 bg-[#f7f1e4]">
        <Image src={frontmatter.image.url} alt={frontmatter.image.alt} widths={[768, 1200, 1600]} sizes="(min-width: 1024px) 1120px, 100vw" loading="eager" class="aspect-[1200/630] h-auto w-full object-cover" />
      </div>
    </div></header>

    <div class="border-y border-black/10 bg-[var(--brand-paper)]">
      <div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 sm:px-8 sm:py-16 lg:grid-cols-[10rem_minmax(0,46rem)] lg:justify-center lg:gap-16 lg:px-10">
        <aside class="field-label"><span class="block text-[var(--brand-orange)]">Written by</span><a href="/about/" class="mt-3 block font-sans text-sm font-semibold normal-case tracking-normal text-black hover:underline">Danny Sullivan</a><span class="mt-1 block font-sans text-xs font-normal normal-case tracking-normal text-base-500">Raleigh AI Guy<br />Raleigh, NC</span></aside>
        <div class="prose post-body min-w-0 max-w-none prose-headings:font-serif prose-headings:font-medium prose-headings:tracking-tight prose-pre:max-w-full prose-pre:overflow-x-auto prose-a:text-black prose-a:underline prose-a:decoration-base-300 prose-a:underline-offset-4 prose-strong:text-black"><slot /></div>
      </div>
    </div>

    {(previous || next) && <nav class="mx-auto grid max-w-6xl gap-px bg-black/10 px-6 sm:grid-cols-2 sm:px-8 lg:px-10" aria-label="More articles">
      {previous ? <a href={`/blog/posts/${previous.id}`} class="flex min-h-28 items-center bg-[var(--brand-bg)] p-6 text-sm font-semibold">← {previous.data.title}</a> : <span class="bg-[var(--brand-bg)]"></span>}
      {next && <a href={`/blog/posts/${next.id}`} class="flex min-h-28 items-center justify-end bg-[var(--brand-bg)] p-6 text-right text-sm font-semibold">{next.data.title} →</a>}
    </nav>}

    <ContactBand eyebrow="Have a question?" title="Send me the part that is stuck." description="I’ll reply personally with the most useful next step I can offer." />
  </article>
</BaseLayout>
