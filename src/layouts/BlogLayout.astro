---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";

const { frontmatter, readingTime, previous, next } = Astro.props;
const image = frontmatter.image.url;
const date = frontmatter.pubDate.toLocaleDateString("en-US", { month:"long", day:"2-digit", year:"numeric", timeZone:"UTC" });
---

<BaseLayout pageTitle={frontmatter.title} pageDescription={frontmatter.description}>
  <article class="note-detail">
    <header class="note-hero shell">
      <p><span></span> Field note · {readingTime}</p>
      <h1>{frontmatter.title}</h1>
      <div>
        <p>{frontmatter.description}</p>
        <time datetime={frontmatter.pubDate.toISOString().slice(0,10)}>{date}</time>
        <nav>{frontmatter.tags.map((tag) => <a href={`/blog/tags/${tag}`}>#{tag}</a>)}</nav>
      </div>
    </header>

    <div class="note-art shell">
      <Image src={image} alt={frontmatter.image.alt} width={image.width} height={image.height} loading="eager" />
    </div>

    <div class="note-body shell">
      <aside><span>READING NOW</span><a href="/blog/">All notes ↗</a></aside>
      <div class="prose"><slot /></div>
    </div>

    {(previous || next) && <nav class="note-nav shell">
      {previous && <a href={`/blog/posts/${previous.id}`}>← {previous.data.title}</a>}
      {next && <a href={`/blog/posts/${next.id}`}>{next.data.title} →</a>}
    </nav>}
  </article>
</BaseLayout>

<style>
  .note-detail { --ink:#11110f; --paper:#f0ebdd; --blue:#2947ff; color:var(--ink); }
  :global(.dark) .note-detail { --ink:#f0ebdd; --paper:#11110f; }
  .shell { width:min(100% - 40px,1320px); margin-inline:auto; }
  .note-hero { min-height:65svh; display:grid; grid-template-columns:1fr minmax(260px,.34fr); gap:2rem 6rem; align-content:center; padding:5rem 0; }
  .note-hero>p { grid-column:1/-1; display:flex; align-items:center; gap:.75rem; font-size:.67rem; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
  .note-hero>p span { width:2.5rem; height:2px; background:#ff4b36; }
  h1 { align-self:end; font-family:"Anybody"; font-size:clamp(4rem,8vw,8rem); font-weight:850; line-height:.82; letter-spacing:-.05em; text-transform:uppercase; }
  .note-hero>div { align-self:end; }
  .note-hero>div>p { font-size:1.05rem; line-height:1.6; }
  time { display:block; margin:1.5rem 0; font-size:.65rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .note-hero nav { display:flex; gap:.4rem; flex-wrap:wrap; }
  .note-hero nav a { padding:.35rem .55rem; border:1px solid currentColor; font-size:.6rem; }
  .note-art { padding:clamp(1rem,3vw,3rem); background:#101114; box-shadow:12px 12px 0 var(--blue); }
  .note-art img { width:100%; max-height:70svh; object-fit:cover; }
  .note-body { display:grid; grid-template-columns:.25fr minmax(0,.75fr); gap:clamp(3rem,8vw,9rem); padding:clamp(6rem,10vw,10rem) 0; }
  aside { display:flex; flex-direction:column; gap:1rem; align-items:flex-start; font-size:.62rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  aside span { color:var(--blue); }
  aside a { border-bottom:1px solid currentColor; }
  .prose { max-width:760px; padding:0; font-size:1rem; line-height:1.75; }
  .prose :global(h2) { font-size:clamp(2.2rem,4vw,4rem); line-height:.95; }
  .note-nav { display:flex; justify-content:space-between; gap:2rem; padding-bottom:8rem; font-size:.75rem; font-weight:800; text-transform:uppercase; }
  .note-nav a { border-bottom:1px solid currentColor; }
  @media(max-width:700px) {
    .shell { width:min(100% - 28px,1320px); }
    .note-hero,.note-body { grid-template-columns:1fr; min-height:auto; }
    .note-hero { padding:4rem 0; }
    .note-body { gap:2.5rem; }
    aside { flex-direction:row; justify-content:space-between; }
  }
</style>
