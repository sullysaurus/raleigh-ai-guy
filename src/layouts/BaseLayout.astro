---
// Fundations
import "../styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
// Components
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";

interface Props {
  pageTitle?: string;
  pageDescription?: string;
  noindex?: boolean;
  minimal?: boolean;
}

const { pageTitle, pageDescription, noindex, minimal = false } = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead
      pageTitle={pageTitle}
      pageDescription={pageDescription}
      noindex={noindex}
    />
  </head>
  <body id="top" class="flex min-h-svh flex-col bg-white dark:bg-base-950">
    {!minimal && <Navigation />}
    <main class="grow"><slot /></main>
    {!minimal && <Footer />}
  </body>
</html>
