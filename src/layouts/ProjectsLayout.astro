---
import BaseLayout from "./BaseLayout.astro";
import { getImage, Image } from "astro:assets";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const { frontmatter, previous, next } = Astro.props;
const projectStatus = frontmatter.status === "ongoing" ? "Partnership started" : "Launched";
const projectDate = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }).format(frontmatter.pubDate);
const projectDateTime = frontmatter.pubDate.toISOString().slice(0, 10);
const projectImage = frontmatter.image.url;
const projectImageWidth = typeof projectImage === "string" ? 1200 : projectImage.width;
const projectImageHeight = typeof projectImage === "string" ? 900 : projectImage.height;
const isPortraitImage = projectImageHeight > projectImageWidth;
const imageFrameClass = isPortraitImage ? "bg-[var(--brand-paper)] p-5 sm:p-8" : "bg-[var(--brand-paper)] p-2 sm:p-3";
const projectImageClass = isPortraitImage ? "mx-auto max-h-[760px] w-auto max-w-full object-contain" : "mx-auto w-full object-contain";
const caseStudyCover = frontmatter.caseStudyCover;
const socialImage = await getImage({
  src: projectImage,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpeg",
  quality: 82,
});
---

<BaseLayout
  pageTitle={frontmatter.title}
  pageDescription={frontmatter.subtitle}
  socialImage={socialImage.src}
  socialImageAlt={frontmatter.image.alt}
  socialImageWidth={1200}
  socialImageHeight={630}
>
  <section class="brand-page">
    <Wrapper variant="wide" class="pb-20 pt-12 sm:pt-16">
      <a href="/projects/" class="field-label hover:text-black">← Selected work</a>
      <div class="mt-8 grid gap-8 border-t border-black/10 pt-8 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-7">
          <h1 class="font-editorial text-5xl font-medium leading-[.95] tracking-[-.045em] text-black sm:text-7xl">{frontmatter.title}</h1>
        </div>
        <div class="lg:col-span-5 lg:pt-2">
          <p class="text-base leading-7 text-base-600">{frontmatter.subtitle}</p>
          <div class="font-utility mt-6 flex flex-wrap items-center justify-between gap-5 text-[.65rem] uppercase tracking-[.08em] text-base-500"><p>{projectStatus} <time datetime={projectDateTime}>{projectDate}</time></p><a href={frontmatter.live} class="font-sans text-sm font-semibold normal-case tracking-normal text-black underline decoration-black/20 underline-offset-4">Visit project →</a></div>
        </div>
      </div>
      {caseStudyCover ? (
        <div class="mt-10 overflow-hidden border border-black/10 bg-[#f5f5f5] p-2 sm:p-3"><img src={caseStudyCover.url} alt={caseStudyCover.alt} width="1440" height="1644" loading="eager" class="mx-auto w-full object-contain" /></div>
      ) : (
        <div class:list={["mt-10 border border-black/10", imageFrameClass]}><Image width={projectImageWidth} height={projectImageHeight} src={projectImage} alt={frontmatter.image.alt} class={projectImageClass} /></div>
      )}
      <div class="mt-14 grid gap-8 lg:grid-cols-[10rem_minmax(0,46rem)] lg:justify-center lg:gap-14">
        <aside class="field-label"><span class="block text-[var(--brand-orange)]">Project notes</span><span class="mt-3 block normal-case tracking-normal text-base-500">Strategy, decisions, and what changed.</span></aside>
        <div class="prose post-body min-w-0 max-w-none prose-headings:font-serif prose-headings:font-medium prose-headings:tracking-tight prose-a:text-black prose-strong:text-black"><slot /></div>
      </div>
      {(previous || next) && <nav class="mt-24 flex flex-col gap-6 border-t border-black/10 pt-6 text-xs md:flex-row md:justify-between">
        <div>{previous && <a href={`/projects/${previous.id}`} class="hover:opacity-70"><span class="block font-medium uppercase text-black">Previous</span><span class="mt-1 block text-base-500">{previous.data.title}</span></a>}</div>
        <div>{next && <a href={`/projects/${next.id}`} class="text-right hover:opacity-70"><span class="block font-medium uppercase text-black">Next</span><span class="mt-1 block text-base-500">{next.data.title}</span></a>}</div>
      </nav>}
    </Wrapper>
  </section>
</BaseLayout>
