---
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const { frontmatter, previous, next } = Astro.props;
const projectDate = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }).format(frontmatter.pubDate);
const projectDateTime = frontmatter.pubDate.toISOString().slice(0, 10);
const projectImage = frontmatter.image.url;
const projectImageWidth = typeof projectImage === "string" ? 1200 : projectImage.width;
const projectImageHeight = typeof projectImage === "string" ? 900 : projectImage.height;
const isPortraitImage = projectImageHeight > projectImageWidth;
const imageFrameClass = isPortraitImage ? "mt-8 bg-black/5 p-6 dark:bg-white/5 sm:p-10 lg:p-14" : "mt-8 bg-black/5 p-8 dark:bg-white/5 lg:p-16";
const projectImageClass = isPortraitImage ? "mx-auto max-h-[760px] w-auto max-w-full rounded-[2rem] object-contain shadow-sm" : "mx-auto w-full rounded-xl object-contain";
---

<BaseLayout pageTitle={frontmatter.title} pageDescription={frontmatter.subtitle}>
  <section class="bg-white text-black dark:bg-base-950 dark:text-white">
    <Wrapper variant="standard" class="pt-12 lg:py-32 xl:py-44">
      <Text tag="h1" variant="displayXS" class="max-w-4xl text-balance font-medium text-black dark:text-white">{frontmatter.title}</Text>
    </Wrapper>
    <Wrapper variant="standard" class="pb-20 pt-12">
      <div class="border-t border-black/10 pt-4 dark:border-white/10">
        <Text tag="p" variant="textSM" class="mt-2 max-w-2xl text-base-500 dark:text-base-400 2xl:text-base">{frontmatter.subtitle}</Text>
        <div class="mt-8 flex items-center justify-between gap-6"><Text tag="p" variant="textXS" class="text-base-500 dark:text-base-400">Launched <time datetime={projectDateTime}>{projectDate}</time></Text><Text tag="a" variant="textSM" href={frontmatter.live} class="font-medium text-black hover:text-base-500 dark:text-white dark:hover:text-base-400">Visit project →</Text></div>
      </div>
      <div class={imageFrameClass}><Image width={projectImageWidth} height={projectImageHeight} src={projectImage} alt={frontmatter.image.alt} class={projectImageClass} /></div>
      <Wrapper variant="prose" class="mt-12"><slot /></Wrapper>
      {(previous || next) && <nav class="mt-24 flex flex-col gap-6 border-t border-black/10 pt-6 text-xs dark:border-white/10 md:flex-row md:justify-between">
        <div>{previous && <a href={`/projects/${previous.id}`} class="hover:opacity-70"><span class="block font-medium uppercase text-black dark:text-white">Previous</span><span class="mt-1 block text-base-500 dark:text-base-400">{previous.data.title}</span></a>}</div>
        <div>{next && <a href={`/projects/${next.id}`} class="text-right hover:opacity-70"><span class="block font-medium uppercase text-black dark:text-white">Next</span><span class="mt-1 block text-base-500 dark:text-base-400">{next.data.title}</span></a>}</div>
      </nav>}
    </Wrapper>
  </section>
</BaseLayout>
