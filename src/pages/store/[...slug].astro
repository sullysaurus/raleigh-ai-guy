---
import { getCollection, render } from 'astro:content';
import StoreLayout from '../../layouts/StoreLayout.astro';

export async function getStaticPaths() {
  const store = await getCollection('store');
  return store.map(page => ({
    params: { slug: page.id },
    props: { page },
    trailingSlash: false,
  }));
}

const { page } = Astro.props;

// Fetch all valid store entries
const allStore = await getCollection('store');
const validStore = allStore.filter(item => item.data?.title);

// Keep original order or optionally sort alphabetically
const sorted = validStore; // or: validStore.sort((a, b) => a.data.title.localeCompare(b.data.title))

// Find index, previous, and next
const index = sorted.findIndex(item => item.id === page.id);
const previous = sorted[index - 1] || null;
const next = sorted[index + 1] || null;

const { Content } = await render(page);
---

<StoreLayout frontmatter={page.data} previous={previous} next={next}>
  <Content />
</StoreLayout>
