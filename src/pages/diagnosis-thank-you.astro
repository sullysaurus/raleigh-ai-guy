---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Diagnosis Request Received" pageDescription="Danny Sullivan has received your AI diagnosis application." noindex>
  <div class="grid min-h-[70svh] place-items-center bg-[var(--brand-bg)] px-5 text-[var(--brand-text)]">
    <section class="w-full max-w-2xl text-center">
      <span class="mx-auto grid size-12 place-items-center rounded-full bg-[var(--brand-orange)] text-xl text-[var(--brand-ink)]">✓</span>
      <p class="mt-7 text-xs font-bold uppercase tracking-[.16em] text-base-500">Diagnosis request received</p>
      <h1 class="mt-5 font-sans text-4xl font-bold tracking-[-.04em] sm:text-6xl">I’ll review the workflow personally.</h1>
      <p class="mx-auto mt-6 max-w-xl text-base leading-7 text-[var(--brand-muted)]">I’ll reply by email with any questions and the next step. If the diagnosis is a fit, that email will include payment and scheduling options. You have not been charged.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4"><a href="/" class="brand-button">Back to the site →</a><a href="/blog/" class="social-chip">Read the field guide</a></div>
    </section>
  </div>
</BaseLayout>
