---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const colorSections = [
  {
    title: "Base",
    colors: [
      {
        name: "White",
        swatchClass: "bg-white border border-black/10 dark:border-white/5",
      },
      {
        name: "Black",
        swatchClass: "bg-black border border-black/10 dark:border-white/5",
      },
    ],
  },
  {
    title: "Accent",
    colors: [
      {
        name: "Base 50",
        swatchClass: "bg-base-50 border border-black/10 dark:border-white/5",
      },
      { name: "Base 100", swatchClass: "bg-base-100" },
      { name: "Base 200", swatchClass: "bg-base-200" },
      { name: "Base 300", swatchClass: "bg-base-300" },
      { name: "Base 400", swatchClass: "bg-base-400" },
      { name: "Base 500", swatchClass: "bg-base-500" },
      { name: "Base 600", swatchClass: "bg-base-600" },
      { name: "Base 700", swatchClass: "bg-base-700" },
      { name: "Base 800", swatchClass: "bg-base-800" },
      { name: "Base 900", swatchClass: "bg-base-900" },
      { name: "Base 950", swatchClass: "bg-base-950" },
    ],
  },
];
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="pt-12 lg:py-32 xl:py-54">
      <Text
        tag="h1"
        variant="textBase"
        class="text-black dark:text-white font-medium"
      >
        Colors
      </Text>
    </Wrapper>
    <Wrapper variant="standard" class="py-12">
      <div class="border-t dark:border-white/10 border-black/10 pt-2">
        <Text
          tag="h1"
          variant="textBase"
          class="text-black dark:text-white font-medium"
        >
          Colors used on Simplexity
        </Text>
      </div>
      <div class="mt-8 space-y-8 text-base-500 dark:text-base-400">
        {
          colorSections.map((section) => (
            <div class="flex flex-col gap-4">
              <Text
                tag="h3"
                variant="textBase"
                class="text-black dark:text-white font-medium"
              >
                {section.title}
              </Text>
              <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                {section.colors.map((color) => (
                  <div class="flex items-center gap-4">
                    <div class={`p-6 rounded-lg ${color.swatchClass}`} />
                    <span class="text-sm text-base-500">{color.name} </span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
