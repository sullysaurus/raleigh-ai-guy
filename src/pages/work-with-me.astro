---
import BaseLayout from "@/layouts/BaseLayout.astro";

const fieldClass = "mt-2 w-full rounded-none border border-black/15 bg-white px-4 py-3 text-sm text-black outline-none transition placeholder:text-base-400 hover:border-black/30 focus:border-black focus:ring-2 focus:ring-black/10 dark:border-white/15 dark:bg-base-950 dark:text-white dark:hover:border-white/30 dark:focus:border-white dark:focus:ring-white/10";
---

<BaseLayout
  pageTitle="Apply for a Raleigh AI Tools Assessment"
  pageDescription="Apply for Danny Sullivan’s $999 AI Tools Assessment for Raleigh-area small businesses. Find at least five hours of weekly opportunity or receive a refund."
>
  <div class="min-h-svh bg-base-50 text-black dark:bg-base-950 dark:text-white">
    <div class="mx-auto max-w-5xl px-5 py-14 sm:px-8 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-[1fr_17rem] lg:gap-20">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.14em] text-base-500 dark:text-base-400">Assessment application · About 5 minutes</p>
          <h1 class="mt-5 max-w-2xl font-sans text-4xl font-semibold leading-tight tracking-[-0.03em] sm:text-5xl">Tell me where the work piles up.</h1>
          <p class="mt-6 max-w-2xl text-base leading-7 text-base-600 dark:text-base-300">You do not need to know which AI tool you want—or whether AI is even the answer. I will use these details to decide whether the assessment can create real value for your business.</p>
        </div>
        <aside class="border border-black/10 bg-white p-5 dark:border-white/10 dark:bg-base-900">
          <p class="text-xs font-medium uppercase tracking-wide text-base-500 dark:text-base-400">The offer</p>
          <strong class="mt-4 block text-3xl font-semibold">$999</strong>
          <p class="mt-2 text-sm leading-6 text-base-500 dark:text-base-400">45-minute discovery, written recommendations, four-day plan, and 30-minute review.</p>
          <p class="mt-4 border-t border-black/10 pt-4 text-xs leading-5 text-base-500 dark:border-white/10 dark:text-base-400">Five hours of weekly opportunity—or a full refund.</p>
        </aside>
      </div>

      <form name="ai-tools-assessment" method="POST" action="/thank-you/" data-netlify="true" data-netlify-honeypot="bot-field" class="mt-14 space-y-6">
        <input type="hidden" name="form-name" value="ai-tools-assessment" />
        <input type="hidden" name="subject" data-remove-prefix value="New AI assessment application from %{formName}" />
        <p class="absolute -left-[10000px] size-px overflow-hidden" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

        <section class="border border-black/10 bg-white p-5 dark:border-white/10 dark:bg-base-900 sm:p-8">
          <div class="grid gap-8 sm:grid-cols-[3rem_1fr]">
            <span class="text-sm text-base-400">01</span>
            <fieldset><legend class="text-lg font-medium">You and the business</legend><p class="mt-2 text-sm text-base-500 dark:text-base-400">Enough context to know whether the assessment fits.</p>
              <div class="mt-7 grid gap-5 sm:grid-cols-2">
                <label class="text-sm font-medium">Your name <span class="text-base-400">*</span><input class={fieldClass} type="text" name="name" autocomplete="name" required /></label>
                <label class="text-sm font-medium">Work email <span class="text-base-400">*</span><input class={fieldClass} type="email" name="email" autocomplete="email" required /></label>
                <label class="text-sm font-medium">Company <span class="text-base-400">*</span><input class={fieldClass} type="text" name="company" autocomplete="organization" required /></label>
                <label class="text-sm font-medium">Your role <span class="text-base-400">*</span><input class={fieldClass} type="text" name="role" autocomplete="organization-title" required /></label>
                <label class="text-sm font-medium">Team size <span class="text-base-400">*</span><select class={fieldClass} name="team_size" required><option value="">Choose one</option><option>Just me</option><option>2–5</option><option>6–10</option><option>11–20</option><option>21–50</option><option>51+</option></select></label>
                <label class="text-sm font-medium">Business location <span class="text-base-400">*</span><input class={fieldClass} type="text" name="location" required placeholder="Raleigh, Cary, Durham…" /></label>
              </div>
            </fieldset>
          </div>
        </section>

        <section class="border border-black/10 bg-white p-5 dark:border-white/10 dark:bg-base-900 sm:p-8">
          <div class="grid gap-8 sm:grid-cols-[3rem_1fr]">
            <span class="text-sm text-base-400">02</span>
            <fieldset><legend class="text-lg font-medium">Where the time goes</legend><p class="mt-2 text-sm text-base-500 dark:text-base-400">Plain language is perfect. Specific examples are most useful.</p>
              <div class="mt-7 space-y-6">
                <label class="block text-sm font-medium">Walk me through a typical workday. <span class="text-base-400">*</span><span class="mt-1 block font-normal text-base-500 dark:text-base-400">What do you touch, check, send, copy, approve, or chase?</span><textarea class={fieldClass} name="typical_day" rows="5" maxlength="1800" required></textarea></label>
                <label class="block text-sm font-medium">Which tasks do you dread doing? <span class="text-base-400">*</span><textarea class={fieldClass} name="dreaded_tasks" rows="4" maxlength="1400" required></textarea></label>
                <label class="block text-sm font-medium">Where does work pile up or wait on someone? <span class="text-base-400">*</span><textarea class={fieldClass} name="work_pileup" rows="4" maxlength="1400" required></textarea></label>
                <label class="block text-sm font-medium">If you could delete one process, what would it be? <span class="text-base-400">*</span><textarea class={fieldClass} name="magic_wand" rows="4" maxlength="1400" required></textarea></label>
              </div>
            </fieldset>
          </div>
        </section>

        <section class="border border-black/10 bg-white p-5 dark:border-white/10 dark:bg-base-900 sm:p-8">
          <div class="grid gap-8 sm:grid-cols-[3rem_1fr]">
            <span class="text-sm text-base-400">03</span>
            <fieldset><legend class="text-lg font-medium">What you have tried</legend><p class="mt-2 text-sm text-base-500 dark:text-base-400">This keeps the recommendations realistic.</p>
              <div class="mt-7 space-y-6">
                <label class="block text-sm font-medium">What have you already tried to automate or improve?<span class="mt-1 block font-normal text-base-500 dark:text-base-400">What worked, what failed, and why did it stall?</span><textarea class={fieldClass} name="past_attempts" rows="4" maxlength="1400"></textarea></label>
                <label class="block text-sm font-medium">Which tools does your team use today?<span class="mt-1 block font-normal text-base-500 dark:text-base-400">Email, spreadsheets, CRM, project management, AI, industry software—everything counts.</span><textarea class={fieldClass} name="current_tools" rows="4" maxlength="1400"></textarea></label>
                <label class="block text-sm font-medium">What would make this assessment an obvious win? <span class="text-base-400">*</span><textarea class={fieldClass} name="success" rows="4" maxlength="1400" required></textarea></label>
              </div>
            </fieldset>
          </div>
        </section>

        <section class="border border-black/10 bg-white p-5 dark:border-white/10 dark:bg-base-900 sm:p-8">
          <div class="grid gap-8 sm:grid-cols-[3rem_1fr]">
            <span class="text-sm text-base-400">04</span>
            <fieldset><legend class="text-lg font-medium">Final details</legend>
              <div class="mt-7 grid gap-5 sm:grid-cols-2"><label class="text-sm font-medium">Preferred timing<select class={fieldClass} name="timeline"><option>As soon as possible</option><option>Within 30 days</option><option>Within 2–3 months</option><option>Just exploring</option></select></label><label class="text-sm font-medium">Approximate annual revenue<select class={fieldClass} name="revenue"><option value="">Prefer not to say</option><option>Under $500K</option><option>$500K–$1M</option><option>$1M–$5M</option><option>$5M+</option></select></label></div>
              <label class="mt-7 flex items-start gap-3 text-sm leading-6"><input type="checkbox" name="recording_consent" value="yes" required class="mt-1 rounded-none border-black/20 text-black focus:ring-black dark:border-white/20 dark:bg-base-950 dark:text-white" /><span>I understand the discovery call will be recorded and transcribed for the assessment. <span class="text-base-400">*</span></span></label>
            </fieldset>
          </div>
        </section>

        <div class="flex flex-col gap-6 bg-black p-6 text-white dark:bg-white dark:text-black sm:flex-row sm:items-center sm:justify-between sm:p-8">
          <div><strong class="text-base font-medium">Ready when you are.</strong><p class="mt-2 max-w-lg text-sm leading-6 text-white/60 dark:text-black/60">I will review the application personally and email you with the next step. Applying does not commit you to purchase.</p></div>
          <button type="submit" class="min-h-12 shrink-0 bg-[#ddff73] px-5 text-sm font-medium text-black transition hover:bg-[#e6ff95]">Send my application <span class="ml-2">→</span></button>
        </div>
      </form>
    </div>

  </div>
</BaseLayout>
