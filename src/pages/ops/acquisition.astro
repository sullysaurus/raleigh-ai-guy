  document.querySelector("#enrich-candidates")!.addEventListener("click", async () => {
    const selected = candidates.filter((lead) => selectedIds.has(lead.id) && !lead.email);
    if (!selected.length || !window.confirm(`Reveal work emails for ${selected.length} selected lead${selected.length === 1 ? "" : "s"}? Apollo may use enrichment credits.`)) return;
    const button = document.querySelector<HTMLButtonElement>("#enrich-candidates")!; button.disabled = true; button.textContent = "Revealing…";
    try {
      const payload = await workbenchApi("enrich", { leads: selected });
      const enriched = (payload.leads || []).map(clean); mergeLocal(enriched);
      candidates = candidates.map((candidate) => enriched.find((lead) => lead.apolloId === candidate.apolloId) || candidate);
      save("Apollo enrichment saved", { type: "enrich", title: "Apollo enrichment completed", detail: `${enriched.length} candidates processed` }); renderCandidates();
    } catch (error) { notifyWorkbench(error instanceof Error ? error.message : "Apollo enrichment failed"); }
    finally { button.textContent = "Reveal selected emails"; updateSelection(); }
  });
  document.querySelector("#verify-candidates")!.addEventListener("click", async () => {
    const selected = candidates.filter((lead) => selectedIds.has(lead.id) && lead.email);
    if (!selected.length || !window.confirm(`Use ${selected.length} ZeroBounce credit${selected.length === 1 ? "" : "s"} to verify these emails?`)) return;
    const button = document.querySelector<HTMLButtonElement>("#verify-candidates")!; button.disabled = true; button.textContent = "Verifying…";
    try { hydrateRemoteState(await workbenchApi("verify", { leads: selected })); notifyWorkbench("ZeroBounce verification complete"); }
    catch (error) { notifyWorkbench(error instanceof Error ? error.message : "Verification failed"); }
    finally { button.textContent = "Verify selected"; updateSelection(); }
  });
  document.querySelector("#verify-pipeline")!.addEventListener("click", async () => {
    const selected = prospects.filter((lead) => selectedIds.has(lead.id) && lead.email && lead.emailStatus !== "valid");
    if (!selected.length) { notifyWorkbench("Select at least one unverified pipeline email"); return; }
    if (!window.confirm(`Use ${selected.length} ZeroBounce credit${selected.length === 1 ? "" : "s"} to verify the selected pipeline emails?`)) return;
    try { hydrateRemoteState(await workbenchApi("verify", { leads: selected })); notifyWorkbench("Pipeline verification complete"); }
    catch (error) { notifyWorkbench(error instanceof Error ? error.message : "Verification failed"); }
  });
  document.querySelector("#approve-candidates")!.addEventListener("click", () => {
    const approved = prospects.filter((lead) => selectedIds.has(lead.id) && lead.emailStatus === "valid" && !["Outreach", "Replied", "Meeting", "Proof", "Customer"].includes(lead.stage));
    if (!approved.length) { notifyWorkbench("Only ZeroBounce-valid leads can be approved"); return; }
    approved.forEach((lead) => Object.assign(lead, { stage: "Approved", approvedAt: new Date().toISOString(), nextAction: "Send to Smartlead", updatedAt: new Date().toISOString() }));
    save(`${approved.length} lead${approved.length === 1 ? "" : "s"} approved`, { type: "approval", title: `${approved.length} lead${approved.length === 1 ? "" : "s"} approved`, detail: "Ready for Smartlead handoff" });
  });
  document.querySelector("#send-smartlead")!.addEventListener("click", async () => {
    const campaignId = Number(document.querySelector<HTMLSelectElement>("#handoff-campaign")!.value);
    const ids = prospects.filter((lead) => selectedIds.has(lead.id) && lead.stage === "Approved").map((lead) => lead.id);
    if (!ids.length) { notifyWorkbench("Select approved leads first"); return; }
    if (!campaignId) { notifyWorkbench("Choose a Smartlead campaign"); return; }
    if (!window.confirm(`Send ${ids.length} approved lead${ids.length === 1 ? "" : "s"} to the selected Smartlead campaign?`)) return;
    const button = document.querySelector<HTMLButtonElement>("#send-smartlead")!; button.disabled = true; button.textContent = "Sending…";
    try { const payload = await workbenchApi("handoff", { ids, campaignId }); hydrateRemoteState(payload.state); selectedIds.clear(); notifyWorkbench(`${payload.result.added_count || 0} leads added to Smartlead`); }
    catch (error) { notifyWorkbench(error instanceof Error ? error.message : "Smartlead handoff failed"); }
    finally { button.disabled = false; button.textContent = "Send approved to Smartlead"; }
  });
  document.querySelector("#queue-realtor-campaign")!.addEventListener("click", async () => {
    if (!window.confirm("Create this campaign and its four-email sequence as a DRAFT in Smartlead? It will not be activated or connected to a sender.")) return;
    const button = document.querySelector<HTMLButtonElement>("#queue-realtor-campaign")!;
    button.disabled = true; button.textContent = "Queuing draft…";
    try {
      const payload = await workbenchApi("queue_realtor_campaign");
      workbenchStatus.realtorCampaign = payload.campaign;
      if (!workbenchStatus.campaigns.some((campaign) => campaign.id === payload.campaign.id)) workbenchStatus.campaigns.push(payload.campaign);
      paintWorkbenchStatus();
      notifyWorkbench(payload.created ? "Realtor campaign drafted in Smartlead" : "Realtor campaign was already queued");
    } catch (error) { notifyWorkbench(error instanceof Error ? error.message : "Could not queue the campaign"); paintWorkbenchStatus(); }
  });
  search.addEventListener("input", render); filter.addEventListener("change", render);
  document.querySelector("#add-prospect")!.addEventListener("click", () => { prospectForm.reset(); prospectDialog.showModal(); });
  document.querySelector("#import-pipeline")!.addEventListener("click", () => { importJson.value = ""; document.querySelector("#import-error")!.textContent = ""; importDialog.showModal(); });
  document.querySelector("#sync-smartlead")!.addEventListener("click", syncSmartlead);
  document.querySelector("#sync-services")!.addEventListener("click", () => {
    const key = sessionStorage.getItem("raleigh-ai-guy:ops-key");
    if (key) syncServices(key); else { dashboardKey.value = ""; connectionError.textContent = ""; connectionDialog.showModal(); }
  });
  document.querySelectorAll("[data-close-prospect]").forEach((el) => el.addEventListener("click", () => prospectDialog.close()));
  document.querySelectorAll("[data-close-import]").forEach((el) => el.addEventListener("click", () => importDialog.close()));
  document.querySelectorAll("[data-close-connection]").forEach((el) => el.addEventListener("click", () => connectionDialog.close()));
  document.querySelectorAll("[data-close-detail]").forEach((el) => el.addEventListener("click", () => detailDialog.close()));
  connectionForm.addEventListener("submit", (event) => { event.preventDefault(); syncServices(dashboardKey.value); });
  prospectForm.addEventListener("submit", (event) => {
    event.preventDefault(); const data = new FormData(prospectForm);
    prospects.push(clean({ company: String(data.get("company") || ""), contact: String(data.get("contact") || ""), email: String(data.get("email") || ""), industry: String(data.get("industry") || ""), score: Number(data.get("score") || 0), stage: String(data.get("stage") || "Research") as Stage, workflow: String(data.get("workflow") || ""), nextAction: String(data.get("nextAction") || "") }));
    const prospect = prospects.at(-1)!;
    prospectDialog.close(); save("Prospect added", { type: "created", title: `${prospect.company} added`, detail: prospect.nextAction, prospectId: prospect.id });
  });
  detailForm.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(detailForm); const prospect = prospects.find((item) => item.id === String(data.get("id")));
    if (!prospect) return;
    Object.assign(prospect, clean({ ...prospect, company: String(data.get("company") || ""), contact: String(data.get("contact") || ""), email: String(data.get("email") || ""), industry: String(data.get("industry") || ""), stage: String(data.get("stage") || "Research") as Stage, score: Number(data.get("score") || 0), workflow: String(data.get("workflow") || ""), nextAction: String(data.get("nextAction") || ""), nextActionDate: String(data.get("nextActionDate") || ""), mrr: Number(data.get("mrr") || 0), campaign: String(data.get("campaign") || ""), notes: String(data.get("notes") || ""), updatedAt: new Date().toISOString() }));
    detailDialog.close(); save("Account saved", { type: "updated", title: `${prospect.company} updated`, detail: `${prospect.stage} · ${prospect.nextAction}`, prospectId: prospect.id });
  });
  document.querySelector("#delete-prospect")!.addEventListener("click", () => {
    const prospectId = (detailForm.elements.namedItem("id") as HTMLInputElement).value;
    const prospect = prospects.find((item) => item.id === prospectId);
    if (!prospect || !window.confirm(`Remove ${prospect.company} from the pipeline?`)) return;
    prospects = prospects.filter((item) => item.id !== prospectId); detailDialog.close();
    save("Prospect removed", { type: "deleted", title: `${prospect.company} removed`, detail: prospect.contact });
  });
  importForm.addEventListener("submit", (event) => {
    event.preventDefault();
    try {
      const payload = JSON.parse(importJson.value);
      const incoming = Array.isArray(payload) ? payload : payload.prospects;
      if (!Array.isArray(incoming)) throw new Error("Paste a prospect array or a pipeline package.");
      incoming.map(clean).filter((p) => p.company && p.contact).forEach((record) => {
        const found = prospects.find((p) => (record.email && p.email.toLowerCase() === record.email.toLowerCase()) || (p.company.toLowerCase() === record.company.toLowerCase() && p.contact.toLowerCase() === record.contact.toLowerCase()));
        if (found) Object.assign(found, record, { id: found.id }); else prospects.push(record);
      });
      if (!Array.isArray(payload) && payload.campaign && typeof payload.campaign === "object") localStorage.setItem(campaignKey, JSON.stringify(payload.campaign));
      importDialog.close(); save("Pipeline imported", { type: "import", title: "Pipeline import completed", detail: `${incoming.length} records processed` });
    } catch (error) { document.querySelector("#import-error")!.textContent = error instanceof Error ? error.message : "Could not import that data."; }
  });
  document.querySelector("#export-pipeline")!.addEventListener("click", () => {
    let campaign = {};
    try { campaign = JSON.parse(localStorage.getItem(campaignKey) || "{}"); } catch {}
    const payload = { prospects, campaign, exportedAt: new Date().toISOString() };
    const link = document.createElement("a"); link.href = URL.createObjectURL(new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" })); link.download = `raleigh-ai-guy-pipeline-${new Date().toISOString().slice(0, 10)}.json`; link.click(); URL.revokeObjectURL(link.href);
  });
  render();
  const savedOpsKey = sessionStorage.getItem("raleigh-ai-guy:ops-key");
  if (savedOpsKey) syncServices(savedOpsKey);
  window.setInterval(() => {
    const key = sessionStorage.getItem("raleigh-ai-guy:ops-key");
    if (key && !document.querySelector("dialog[open]")) loadRemote(key).catch(() => {});
  }, 30000);
</script>

