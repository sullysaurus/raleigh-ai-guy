  async function loadRemote(key: string, migrate = false) {
    const response = await fetch("/.netlify/functions/acquisition-data", { headers: { "x-ops-key": key } });
    const payload = await readJson(response);
    if (!response.ok) throw new Error(payload.error || "Could not load the command center.");
    if (migrate && (!payload.prospects || payload.prospects.length === 0) && prospects.length) {
      await persistRemote(key);
    } else {
      prospects = (payload.prospects || []).map(clean);
      activities = Array.isArray(payload.activities) ? payload.activities : [];
      localStorage.setItem(storageKey, JSON.stringify(prospects));
      render();
    }
    document.querySelector("#storage-state")!.textContent = "Saved securely in Netlify · Smartlead replies update automatically.";
  }
  async function syncServices(key: string) {
