---
import OpsShell from "@/components/ops/OpsShell.astro";
const seedJson = "[]";
---

<OpsShell
  title="Outbound Control Room"
  description="One quiet place to move Raleigh businesses from researched account to reply, working proof, and recurring revenue—with live signals from the services already in the stack."
  eyebrow="Raleigh AI Guy · Acquisition system"
  current="acquisition"
>
  <script id="seed-acquisition" type="application/json" set:html={seedJson}></script>
  <section class="command-strip" aria-labelledby="today-title">
    <div class="command-signal"><span></span><strong>LIVE</strong></div>
    <div>
      <p>Today’s operating brief</p>
      <h2 id="today-title"><span id="attention-count">0</span> next moves need attention.</h2>
    </div>
    <div class="command-meta">
      <span id="campaign-state">No active campaign</span>
      <strong id="today-label">Today</strong>
    </div>
  </section>

  <section class="scoreboard" aria-label="Acquisition scoreboard">
    <article>
      <p>Prospects</p><strong id="prospect-count">0</strong><span>Researched and scored</span>
    </article>
    <article>
      <p>In outreach</p><strong id="outreach-count">0</strong><span id="outreach-note">Active sequences</span>
    </article>
    <article class="accent-card">
      <p>Replies</p><strong id="reply-count">0</strong><span id="reply-note">Human responses</span>
    </article>
    <article>
      <p>Meetings</p><strong id="meeting-count">0</strong><span>Discovery booked</span>
    </article>
    <article>
      <p>Proofs</p><strong id="proof-count">0</strong><span>Working builds</span>
    </article>
    <article class="revenue-card">
      <p>MRR</p><strong id="mrr-total">$0</strong><span>Closed revenue</span>
    </article>
  </section>

  <section class="pipeline-map" aria-labelledby="pipeline-map-title">
    <header>
      <div><p>Conversion path</p><h2 id="pipeline-map-title">From evidence to revenue.</h2></div>
      <p id="conversion-note">Add your first prospects to establish a baseline.</p>
    </header>
    <div class="stage-track" id="stage-track"></div>
  </section>

  <section class="health-grid" aria-label="System health">
    <article class="health-panel">
      <header><div><p>Sending infrastructure</p><h2>Domain health</h2></div><span class="status-pill status-good">Protected</span></header>
      <dl>
        <div><dt>Sending domain</dt><dd>raleighaiguy.net</dd></div>
        <div><dt>Primary domain</dt><dd>Protected from outbound</dd></div>
        <div><dt>Daily ceiling</dt><dd id="sending-ceiling">5 messages</dd></div>
        <div><dt>Open / click tracking</dt><dd id="tracking-state">Disabled</dd></div>
      </dl>
    </article>
    <article class="health-panel campaign-panel">
      <header><div><p>Current batch</p><h2 id="batch-name">No campaign loaded</h2></div><span id="batch-status" class="status-pill">Draft</span></header>
      <div class="campaign-progress"><span id="campaign-progress-bar"></span></div>
      <div class="campaign-stats">
        <span><strong id="batch-leads">0</strong> leads</span>
        <span><strong id="batch-sent">0</strong> sent</span>
        <span><strong id="batch-bounced">0</strong> bounced</span>
      </div>
    </article>
  </section>

  <section class="integration-panel" aria-labelledby="integration-title">
    <header>
      <div><p>Live connections</p><h2 id="integration-title">The services behind the funnel.</h2></div>
      <div class="integration-actions">
        <span id="last-synced">Not synced</span>
        <button id="sync-services" class="button-primary" type="button">Connect live data</button>
      </div>
    </header>
    <div class="integration-grid">
      <article data-service="smartlead"><span></span><div><strong>Smartlead</strong><p>Campaigns, sends, and replies</p></div><em>Waiting</em></article>
      <article data-workbench-service="apollo"><span></span><div><strong>Apollo</strong><p>Company and decision-maker search</p></div><em>Not connected</em></article>
      <article data-workbench-service="zeroBounce"><span></span><div><strong>ZeroBounce</strong><p>Pre-send email verification</p></div><em>Not connected</em></article>
      <article data-workbench-service="hubspot"><span></span><div><strong>HubSpot</strong><p>Future CRM system of record</p></div><em>Planned</em></article>
      <article data-workbench-service="n8n"><span></span><div><strong>n8n</strong><p>Future workflow orchestration</p></div><em>Planned</em></article>
      <article data-service="stripe"><span></span><div><strong>Stripe</strong><p>Active MRR and subscriptions</p></div><em>Waiting</em></article>
      <article data-service="calendly"><span></span><div><strong>Calendly</strong><p>Upcoming workflow calls</p></div><em>Waiting</em></article>
      <article data-service="netlifyForms"><span></span><div><strong>Netlify Forms</strong><p>New inbound leads</p></div><em>Waiting</em></article>
      <article data-service="posthog"><span></span><div><strong>PostHog</strong><p>Visitors and pageviews</p></div><em>Waiting</em></article>
      <article data-service="netlifyDeploy"><span></span><div><strong>Netlify Deploy</strong><p>Production build health</p></div><em>Waiting</em></article>
      <article class="tracking-service connected"><span></span><div><strong>Google Analytics</strong><p>Site-wide tracking is active</p></div><em>Tracking</em></article>
      <article data-service="clay" class="warning"><span></span><div><strong>Clay</strong><p>Future enrichment and research</p></div><em>Planned</em></article>
    </div>
    <p id="live-summary" class="live-summary">Live metrics remain locked until you enter the private dashboard key.</p>
  </section>

  <section class="campaign-queue" aria-labelledby="campaign-queue-title">
    <header>
      <div><p>Campaign queue · Hold for domain approval</p><h2 id="campaign-queue-title">Free AI lunch & learn for Raleigh realtors.</h2></div>
      <span id="realtor-campaign-state">Ready to draft</span>
    </header>
    <div class="campaign-brief-grid">
      <article><span>Audience</span><strong>Broker-owners, team leads, office managers</strong><p>Raleigh and the Triangle · teams with 10–100 agents</p></article>
      <article><span>Offer</span><strong>30-minute practical AI session</strong><p>Five workflows, useful templates, no sales pitch</p></article>
      <article><span>Ask</span><strong>“Would this be useful for your office?”</strong><p>Reply-first CTA · no calendar link in cold email</p></article>
      <article><span>Cadence</span><strong>4 touches across 15 days</strong><p>Tuesday–Thursday · 9:15 AM–2:45 PM ET</p></article>
    </div>
    <details class="campaign-copy">
      <summary>Review the four-email sequence</summary>
      <ol>
        <li><span>Day 0 · team training</span><p>A practical, office-level AI walkthrough with five workflows for listing copy, follow-up, market updates, and weekly content.</p></li>
        <li><span>Day 4 · hands-on angle</span><p>Agents leave with prompts and templates they can use the same day.</p></li>
        <li><span>Day 8 · no paid tools required</span><p>The session works with tools agents likely already have.</p></li>
        <li><span>Day 15 · close the loop</span><p>A respectful “later” option, then no more follow-up.</p></li>
      </ol>
    </details>
    <footer>
      <div><span class="hold-dot"></span><p><strong>Launch hold:</strong> approve the sending domain, confirm who covers lunch, attach the sender, then add only ZeroBounce-valid leads.</p></div>
      <button id="queue-realtor-campaign" class="button-primary" type="button" disabled>Queue draft in Smartlead</button>
    </footer>
  </section>

  <section class="lead-workbench" aria-labelledby="workbench-title">
    <header>
      <div><p>Prospecting workbench</p><h2 id="workbench-title">Find. Verify. Qualify. Send.</h2></div>
      <span id="workbench-status">Unlock the command center to inspect providers.</span>
    </header>
    <div class="workbench-flow" aria-label="Lead processing stages">
      <article><span>01</span><strong>Apollo</strong><p>Find Raleigh decision-makers</p></article>
      <article><span>02</span><strong>ZeroBounce</strong><p>Block unsafe addresses</p></article>
      <article><span>03</span><strong>Qualification</strong><p>Score fit with reasons</p></article>
      <article><span>04</span><strong>Smartlead</strong><p>Send only after approval</p></article>
    </div>
    <form id="lead-search-form" class="lead-search-form">
      <label><span>Market</span><input name="location" value="Raleigh, North Carolina" /></label>
      <label><span>Industry</span><input name="industry" value="specialty contractor" /></label>
      <label class="titles-field"><span>Decision-maker titles</span><input name="titles" value="owner, founder, president, operations manager, general manager" /></label>
      <label><span>Team size</span><select name="employeeRange"><option value="2,50">2–50</option><option value="2,200" selected>2–200</option><option value="11,500">11–500</option></select></label>
      <button class="button-primary" type="submit" disabled>Search Apollo</button>
    </form>
    <div class="candidate-toolbar">
      <div><strong id="candidate-count">No search run</strong><span id="selection-count">0 selected</span></div>
      <div>
        <button id="enrich-candidates" class="button-secondary" type="button" disabled>Reveal selected emails</button>
        <button id="verify-candidates" class="button-secondary" type="button" disabled>Verify selected</button>
        <button id="approve-candidates" class="button-secondary" type="button" disabled>Approve selected</button>
      </div>
    </div>
    <div id="candidate-results" class="candidate-results"></div>
    <p id="candidate-empty" class="candidate-empty">Connect Apollo to search for new prospects. Existing pipeline emails can still be verified with ZeroBounce.</p>
    <footer class="handoff-bar">
      <div><span>Approved handoff</span><strong>Only ZeroBounce-valid leads can enter Smartlead.</strong></div>
      <label><span class="sr-only">Smartlead campaign</span><select id="handoff-campaign"><option value="">Choose campaign</option></select></label>
      <button id="verify-pipeline" class="button-secondary" type="button">Verify selected pipeline emails</button>
      <button id="send-smartlead" class="button-primary" type="button">Send approved to Smartlead</button>
    </footer>
  </section>

  <section class="ledger-controls" aria-label="Pipeline controls">
    <label>
      <span>Search pipeline</span>
      <input id="pipeline-search" type="search" placeholder="Company, contact, email…" autocomplete="off" />
    </label>
    <label>
      <span>Stage</span>
      <select id="stage-filter"><option value="all">All stages</option></select>
    </label>
    <div class="control-actions">
      <button id="import-pipeline" class="button-secondary" type="button">Import</button>
      <button id="sync-smartlead" class="button-secondary" type="button">Pull Smartlead leads</button>
      <button id="add-prospect" class="button-primary" type="button">Add prospect</button>
    </div>
  </section>

  <p class="privacy-note"><span></span><span id="storage-state">Working locally until the command center is unlocked.</span></p>

  <section class="action-grid" aria-label="Lead response desk">
    <article class="reply-desk">
      <header><div><p>Response desk</p><h2>Replies that need a human.</h2></div><strong id="hot-count">0 open</strong></header>
      <div id="reply-queue" class="reply-queue"></div>
      <p id="empty-replies" class="empty-desk">No unanswered replies. New Smartlead responses will land here automatically.</p>
    </article>
    <article class="activity-desk">
      <header><div><p>Live wire</p><h2>Recent activity</h2></div><span id="activity-state">Waiting for sync</span></header>
      <ol id="activity-feed" class="activity-feed"></ol>
      <p id="empty-activity" class="empty-desk">Activity from Smartlead and your pipeline changes will appear here.</p>
    </article>
  </section>

  <section class="pipeline-ledger" aria-labelledby="ledger-title">
    <header>
      <div><p>Account ledger</p><h2 id="ledger-title">Every account. One next move.</h2></div>
      <button id="export-pipeline" type="button">Export JSON</button>
    </header>
    <div class="ledger-head" aria-hidden="true">
      <span>Account</span><span>Stage</span><span>Signal</span><span>Next move</span><span></span>
    </div>
    <div id="pipeline-list" class="pipeline-list"></div>
    <div id="empty-pipeline" class="empty-pipeline">
      <span>00</span>
      <div><strong>No accounts in this view.</strong><p>Import a batch or add a prospect manually.</p></div>
    </div>
  </section>

  <dialog id="prospect-dialog" class="pipeline-dialog">
    <form id="prospect-form" method="dialog">
      <header><div><p>New account</p><h2>Add a prospect</h2></div><button type="button" data-close-prospect aria-label="Close">×</button></header>
      <div class="form-grid">
        <label><span>Company *</span><input name="company" required autocomplete="organization" /></label>
        <label><span>Contact *</span><input name="contact" required autocomplete="name" /></label>
        <label><span>Email</span><input name="email" type="email" autocomplete="email" /></label>
        <label><span>Industry</span><input name="industry" placeholder="Specialty contractors" /></label>
        <label><span>Score</span><input name="score" type="number" min="0" max="100" value="70" /></label>
        <label><span>Stage</span><select name="stage" data-stage-select></select></label>
        <label class="span-two"><span>Workflow hypothesis</span><textarea name="workflow" rows="3"></textarea></label>
        <label class="span-two"><span>Next move</span><input name="nextAction" placeholder="Verify email, review copy, reply…" /></label>
      </div>
      <footer><button type="button" data-close-prospect class="button-secondary">Cancel</button><button type="submit" class="button-primary">Add to pipeline</button></footer>
    </form>
  </dialog>

  <dialog id="import-dialog" class="pipeline-dialog">
    <form id="import-form" method="dialog">
      <header><div><p>Private import</p><h2>Load pipeline data</h2></div><button type="button" data-close-import aria-label="Close">×</button></header>
      <p class="dialog-copy">Paste an exported prospect array, or a package with prospects and campaign details. Records merge by email or company and contact.</p>
      <textarea id="import-json" rows="13" spellcheck="false" placeholder='{"prospects":[{"company":"Example Co","contact":"Alex"}],"campaign":{"name":"Batch 01","status":"Active"}}'></textarea>
      <p id="import-error" class="import-error" role="alert"></p>
      <footer><button type="button" data-close-import class="button-secondary">Cancel</button><button type="submit" class="button-primary">Import records</button></footer>
    </form>
  </dialog>

  <dialog id="detail-dialog" class="pipeline-dialog detail-dialog">
    <form id="detail-form" method="dialog">
      <header><div><p>Account file</p><h2 id="detail-title">Lead details</h2></div><button type="button" data-close-detail aria-label="Close">×</button></header>
      <input name="id" type="hidden" />
      <div class="form-grid">
        <label><span>Company *</span><input name="company" required /></label>
        <label><span>Contact *</span><input name="contact" required /></label>
        <label><span>Email</span><input name="email" type="email" /></label>
        <label><span>Industry</span><input name="industry" /></label>
        <label><span>Stage</span><select name="stage" data-stage-select></select></label>
        <label><span>Score</span><input name="score" type="number" min="0" max="100" /></label>
        <label class="span-two"><span>Workflow hypothesis</span><textarea name="workflow" rows="3"></textarea></label>
        <label><span>Next move</span><input name="nextAction" /></label>
        <label><span>Due date</span><input name="nextActionDate" type="date" /></label>
        <label><span>Monthly revenue</span><input name="mrr" type="number" min="0" /></label>
        <label><span>Campaign</span><input name="campaign" /></label>
        <label class="span-two"><span>Notes</span><textarea name="notes" rows="4"></textarea></label>
      </div>
      <section id="reply-context" class="reply-context" hidden><p>Latest reply</p><strong id="reply-subject"></strong><blockquote id="reply-body"></blockquote></section>
      <footer><button id="delete-prospect" type="button" class="button-danger">Delete</button><span></span><button type="button" data-close-detail class="button-secondary">Cancel</button><button type="submit" class="button-primary">Save account</button></footer>
    </form>
  </dialog>

  <dialog id="connection-dialog" class="pipeline-dialog connection-dialog">
    <form id="connection-form" method="dialog">
      <header><div><p>Private connection</p><h2>Unlock live metrics</h2></div><button type="button" data-close-connection aria-label="Close">×</button></header>
      <p class="dialog-copy">Enter the value configured as <code>OPS_DASHBOARD_KEY</code> in Netlify. It stays in this browser tab and is never embedded in the site.</p>
      <label class="connection-field"><span>Dashboard key</span><input id="dashboard-key" type="password" required autocomplete="current-password" /></label>
      <p id="connection-error" class="import-error" role="alert"></p>
      <footer><button type="button" data-close-connection class="button-secondary">Cancel</button><button type="submit" class="button-primary">Connect services</button></footer>
    </form>
  </dialog>

  <div id="pipeline-toast" class="pipeline-toast" role="status" aria-live="polite">Saved</div>
</OpsShell>

<script>
  const stages = ["Research", "Verified", "Approved", "Outreach", "Replied", "Meeting", "Proof", "Customer", "Nurture", "Closed"] as const;
  type Stage = typeof stages[number];
  type Prospect = {
    id: string; company: string; contact: string; email: string; industry: string;
    score: number; stage: Stage; verified: boolean; campaign: string; sent: number;
    bounced: boolean; lastTouch: string; nextAction: string; nextActionDate: string;
    workflow: string; mrr: number; notes: string; campaignId: number | null; smartleadId: number | null;
    replySubject: string; replyBody: string; replyAt: string; source: string; updatedAt: string;
    title: string; location: string; domain: string; website: string; linkedin: string; employeeCount: number;
    apolloId: string; emailStatus: string; emailSubStatus: string; scoreReasons: string[]; approvedAt: string;
  };
  type Activity = { id: string; type: string; title: string; detail: string; prospectId?: string; at: string };
  type ServiceState = { status: string; [key: string]: string | number };
  type LiveServices = Record<string, ServiceState>;
  type CampaignOption = { id: number; name: string; status: string };
  type WorkbenchStatus = { apollo: boolean; zeroBounce: boolean; smartlead: boolean; hubspot: boolean; n8n: boolean; clay: boolean; campaigns: CampaignOption[]; realtorCampaign: CampaignOption | null };

  const storageKey = "raleigh-ai-guy:acquisition:v1";
  const campaignKey = "raleigh-ai-guy:campaign:v1";
  const list = document.querySelector<HTMLDivElement>("#pipeline-list")!;
  const empty = document.querySelector<HTMLDivElement>("#empty-pipeline")!;
  const search = document.querySelector<HTMLInputElement>("#pipeline-search")!;
  const filter = document.querySelector<HTMLSelectElement>("#stage-filter")!;
  const prospectDialog = document.querySelector<HTMLDialogElement>("#prospect-dialog")!;
  const importDialog = document.querySelector<HTMLDialogElement>("#import-dialog")!;
  const connectionDialog = document.querySelector<HTMLDialogElement>("#connection-dialog")!;
  const detailDialog = document.querySelector<HTMLDialogElement>("#detail-dialog")!;
  const prospectForm = document.querySelector<HTMLFormElement>("#prospect-form")!;
  const importForm = document.querySelector<HTMLFormElement>("#import-form")!;
  const connectionForm = document.querySelector<HTMLFormElement>("#connection-form")!;
  const detailForm = document.querySelector<HTMLFormElement>("#detail-form")!;
  const importJson = document.querySelector<HTMLTextAreaElement>("#import-json")!;
  const toast = document.querySelector<HTMLDivElement>("#pipeline-toast")!;
  const dashboardKey = document.querySelector<HTMLInputElement>("#dashboard-key")!;
  const connectionError = document.querySelector<HTMLParagraphElement>("#connection-error")!;
  let prospects = loadProspects();
  let activities: Activity[] = [];
  let liveServices: LiveServices = {};
  let workbenchStatus: WorkbenchStatus = { apollo: false, zeroBounce: false, smartlead: false, hubspot: false, n8n: false, clay: false, campaigns: [], realtorCampaign: null };
  let candidates: Prospect[] = [];
  const selectedIds = new Set<string>();
  let toastTimer = 0;
  let persistTimer = 0;

  stages.forEach((stage) => {
    filter.add(new Option(stage, stage));
    document.querySelectorAll<HTMLSelectElement>("[data-stage-select]").forEach((select) => select.add(new Option(stage, stage)));
  });

  function id() { return typeof crypto.randomUUID === "function" ? crypto.randomUUID() : `${Date.now()}-${Math.random()}`; }
  function clean(value: Partial<Prospect>): Prospect {
    const requestedStage = String(value.stage || "Research") as Stage;
    return {
      id: String(value.id || id()), company: String(value.company || "").trim(), contact: String(value.contact || "").trim(),
      email: String(value.email || "").trim(), industry: String(value.industry || "Unclassified").trim(),
      score: Math.min(100, Math.max(0, Number(value.score || 0))), stage: stages.includes(requestedStage) ? requestedStage : "Research",
      verified: Boolean(value.verified), campaign: String(value.campaign || "").trim(), sent: Math.max(0, Number(value.sent || 0)),
      bounced: Boolean(value.bounced), lastTouch: String(value.lastTouch || ""), nextAction: String(value.nextAction || "Research account").trim(),
      nextActionDate: String(value.nextActionDate || ""), workflow: String(value.workflow || "").trim(), mrr: Math.max(0, Number(value.mrr || 0)),
      notes: String(value.notes || "").trim(), campaignId: value.campaignId == null ? null : Number(value.campaignId),
      smartleadId: value.smartleadId == null ? null : Number(value.smartleadId), replySubject: String(value.replySubject || "").trim(),
      replyBody: String(value.replyBody || "").trim(), replyAt: String(value.replyAt || ""), source: String(value.source || "Manual"),
      title: String(value.title || "").trim(), location: String(value.location || "").trim(), domain: String(value.domain || "").trim().toLowerCase(),
      website: String(value.website || "").trim(), linkedin: String(value.linkedin || "").trim(), employeeCount: Math.max(0, Number(value.employeeCount || 0)),
      apolloId: String(value.apolloId || ""), emailStatus: String(value.emailStatus || "unverified"), emailSubStatus: String(value.emailSubStatus || ""),
      scoreReasons: Array.isArray(value.scoreReasons) ? value.scoreReasons.map(String).slice(0, 8) : [], approvedAt: String(value.approvedAt || ""),
      updatedAt: String(value.updatedAt || new Date().toISOString()),
    };
  }
  function loadProspects(): Prospect[] {
    try {
      const stored = localStorage.getItem(storageKey);
      if (stored) return JSON.parse(stored).map(clean);
      const seed = document.querySelector<HTMLScriptElement>("#seed-acquisition")?.textContent || "[]";
      return JSON.parse(seed).map(clean);
    } catch { return []; }
  }
  function save(message = "Pipeline saved", activity?: Omit<Activity, "id" | "at">) {
    localStorage.setItem(storageKey, JSON.stringify(prospects));
    if (activity) activities.unshift({ ...activity, id: id(), at: new Date().toISOString() });
    render();
    toast.textContent = message; toast.classList.add("visible");
    window.clearTimeout(toastTimer); toastTimer = window.setTimeout(() => toast.classList.remove("visible"), 1600);
    const key = sessionStorage.getItem("raleigh-ai-guy:ops-key");
    if (key) {
      window.clearTimeout(persistTimer);
      persistTimer = window.setTimeout(() => persistRemote(key), 350);
    }
  }
  async function persistRemote(key: string) {
    const state = document.querySelector("#storage-state")!;
    state.textContent = "Saving to the private command center…";
    try {
      const response = await fetch("/.netlify/functions/acquisition-data", { method: "PUT", headers: { "content-type": "application/json", "x-ops-key": key }, body: JSON.stringify({ prospects, activities, replace: true }) });
      if (!response.ok) throw new Error("Save failed");
      state.textContent = "Saved securely in Netlify · Smartlead replies update automatically.";
    } catch { state.textContent = "Cloud save failed. Your latest edits are still safe in this browser."; }
  }
  async function workbenchApi(action: string, payload: Record<string, unknown> = {}) {
    const key = sessionStorage.getItem("raleigh-ai-guy:ops-key");
    if (!key) { connectionDialog.showModal(); throw new Error("Unlock the command center first"); }
    const response = await fetch("/.netlify/functions/lead-workbench", { method: "POST", headers: { "content-type": "application/json", "x-ops-key": key }, body: JSON.stringify({ action, ...payload }) });
    const body = await readJson(response);
    if (!response.ok) throw new Error(body.error || "Lead workbench request failed");
    return body;
  }
  async function readJson(response: Response) {
    const text = await response.text();
    try { return JSON.parse(text); }
    catch {
      const local = ["localhost", "127.0.0.1"].includes(window.location.hostname);
      throw new Error(local ? "Local functions are unavailable in Astro dev. Run `npx netlify dev` or use the production command center." : `Service returned an invalid response (HTTP ${response.status}).`);
    }
  }
  function mergeLocal(incoming: Prospect[]) {
    incoming.map(clean).forEach((record) => {
      const found = prospects.find((prospect) => (record.email && prospect.email === record.email) || (record.apolloId && prospect.apolloId === record.apolloId));
      if (found) Object.assign(found, record, { id: found.id }); else prospects.push(record);
    });
  }
  function paintWorkbenchStatus() {
