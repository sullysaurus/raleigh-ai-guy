---
import OpsShell from "@/components/ops/OpsShell.astro";
import { realtorProspects } from "@/data/realtorProspects";

const statusMap: Record<string, string> = {
  Research: "Research", "Ready to DM": "Approved", "Invite sent": "Outreach",
  Connected: "Outreach", "DM sent": "Outreach", "Follow-up due": "Outreach",
  Replied: "Replied", "Discovery booked": "Meeting", "Free build": "Proof",
  Nurture: "Nurture", "Not a fit": "Closed",
};
const seededProspects = realtorProspects.map((contact) => ({
  id: contact.id,
  company: contact.organization,
  contact: contact.name,
  email: contact.email,
  industry: contact.segment || "Real estate",
  score: contact.fitScore,
  stage: statusMap[contact.status] || "Research",
  verified: contact.status === "Ready to DM" || contact.status === "Connected",
  lastTouch: contact.lastContact,
  nextAction: contact.nextFollowUp ? "Follow up" : contact.status === "Research" ? "Verify research" : "Review next move",
  nextActionDate: contact.nextFollowUp,
  workflow: contact.automationIdea,
  notes: contact.notes,
}));
const seedJson = JSON.stringify(seededProspects).replaceAll("<", "\\u003c");
---

<OpsShell
  title="Outbound Control Room"
  description="One quiet place to move Raleigh businesses from researched account to reply, working proof, and recurring revenue—with live signals from the services already in the stack."
  eyebrow="Raleigh AI Guy · Acquisition system"
  current="acquisition"
>
  <script id="seed-acquisition" type="application/json" set:html={seedJson}></script>
  <section class="command-strip" aria-labelledby="today-title">
    <div class="command-signal"><span></span><strong>LIVE</strong></div>
    <div>
      <p>Today’s operating brief</p>
      <h2 id="today-title"><span id="attention-count">0</span> next moves need attention.</h2>
    </div>
    <div class="command-meta">
      <span id="campaign-state">No active campaign</span>
      <strong id="today-label">Today</strong>
    </div>
  </section>

  <section class="scoreboard" aria-label="Acquisition scoreboard">
    <article>
      <p>Prospects</p><strong id="prospect-count">0</strong><span>Researched and scored</span>
    </article>
    <article>
      <p>In outreach</p><strong id="outreach-count">0</strong><span id="outreach-note">Active sequences</span>
    </article>
    <article class="accent-card">
      <p>Replies</p><strong id="reply-count">0</strong><span id="reply-note">Human responses</span>
    </article>
    <article>
      <p>Meetings</p><strong id="meeting-count">0</strong><span>Discovery booked</span>
    </article>
    <article>
      <p>Proofs</p><strong id="proof-count">0</strong><span>Working builds</span>
    </article>
    <article class="revenue-card">
      <p>MRR</p><strong id="mrr-total">$0</strong><span>Closed revenue</span>
    </article>
  </section>

  <section class="pipeline-map" aria-labelledby="pipeline-map-title">
    <header>
      <div><p>Conversion path</p><h2 id="pipeline-map-title">From evidence to revenue.</h2></div>
      <p id="conversion-note">Add your first prospects to establish a baseline.</p>
    </header>
    <div class="stage-track" id="stage-track"></div>
  </section>

  <section class="health-grid" aria-label="System health">
    <article class="health-panel">
      <header><div><p>Sending infrastructure</p><h2>Domain health</h2></div><span class="status-pill status-good">Protected</span></header>
      <dl>
        <div><dt>Sending domain</dt><dd>raleighaiguy.net</dd></div>
        <div><dt>Primary domain</dt><dd>Protected from outbound</dd></div>
        <div><dt>Daily ceiling</dt><dd id="sending-ceiling">5 messages</dd></div>
        <div><dt>Open / click tracking</dt><dd id="tracking-state">Disabled</dd></div>
      </dl>
    </article>
    <article class="health-panel campaign-panel">
      <header><div><p>Current batch</p><h2 id="batch-name">No campaign loaded</h2></div><span id="batch-status" class="status-pill">Draft</span></header>
      <div class="campaign-progress"><span id="campaign-progress-bar"></span></div>
      <div class="campaign-stats">
        <span><strong id="batch-leads">0</strong> leads</span>
        <span><strong id="batch-sent">0</strong> sent</span>
        <span><strong id="batch-bounced">0</strong> bounced</span>
      </div>
    </article>
  </section>

  <section class="integration-panel" aria-labelledby="integration-title">
    <header>
      <div><p>Live connections</p><h2 id="integration-title">The services behind the funnel.</h2></div>
      <div class="integration-actions">
        <span id="last-synced">Not synced</span>
        <button id="sync-services" class="button-primary" type="button">Connect live data</button>
      </div>
    </header>
    <div class="integration-grid">
      <article data-service="smartlead"><span></span><div><strong>Smartlead</strong><p>Campaigns, sends, and replies</p></div><em>Waiting</em></article>
      <article data-service="stripe"><span></span><div><strong>Stripe</strong><p>Active MRR and subscriptions</p></div><em>Waiting</em></article>
      <article data-service="calendly"><span></span><div><strong>Calendly</strong><p>Upcoming workflow calls</p></div><em>Waiting</em></article>
      <article data-service="netlifyForms"><span></span><div><strong>Netlify Forms</strong><p>New inbound leads</p></div><em>Waiting</em></article>
      <article data-service="posthog"><span></span><div><strong>PostHog</strong><p>Visitors and pageviews</p></div><em>Waiting</em></article>
      <article data-service="netlifyDeploy"><span></span><div><strong>Netlify Deploy</strong><p>Production build health</p></div><em>Waiting</em></article>
      <article class="tracking-service connected"><span></span><div><strong>Google Analytics</strong><p>Site-wide tracking is active</p></div><em>Tracking</em></article>
      <article data-service="clay" class="warning"><span></span><div><strong>Clay</strong><p>Future enrichment and research</p></div><em>Planned</em></article>
    </div>
    <p id="live-summary" class="live-summary">Live metrics remain locked until you enter the private dashboard key.</p>
  </section>

  <section class="ledger-controls" aria-label="Pipeline controls">
    <label>
      <span>Search pipeline</span>
      <input id="pipeline-search" type="search" placeholder="Company, contact, email…" autocomplete="off" />
    </label>
    <label>
      <span>Stage</span>
      <select id="stage-filter"><option value="all">All stages</option></select>
    </label>
    <div class="control-actions">
      <button id="import-pipeline" class="button-secondary" type="button">Import</button>
      <button id="add-prospect" class="button-primary" type="button">Add prospect</button>
    </div>
  </section>

  <p class="privacy-note"><span></span>Prospect edits stay in this browser. Live integrations return aggregate metrics only through a key-protected server function.</p>

  <section class="pipeline-ledger" aria-labelledby="ledger-title">
    <header>
      <div><p>Account ledger</p><h2 id="ledger-title">Every account. One next move.</h2></div>
      <button id="export-pipeline" type="button">Export JSON</button>
    </header>
    <div class="ledger-head" aria-hidden="true">
      <span>Account</span><span>Stage</span><span>Signal</span><span>Next move</span><span></span>
    </div>
    <div id="pipeline-list" class="pipeline-list"></div>
    <div id="empty-pipeline" class="empty-pipeline">
      <span>00</span>
      <div><strong>No accounts in this view.</strong><p>Import a batch or add a prospect manually.</p></div>
    </div>
  </section>

  <dialog id="prospect-dialog" class="pipeline-dialog">
    <form id="prospect-form" method="dialog">
      <header><div><p>New account</p><h2>Add a prospect</h2></div><button type="button" data-close-prospect aria-label="Close">×</button></header>
      <div class="form-grid">
        <label><span>Company *</span><input name="company" required autocomplete="organization" /></label>
        <label><span>Contact *</span><input name="contact" required autocomplete="name" /></label>
        <label><span>Email</span><input name="email" type="email" autocomplete="email" /></label>
        <label><span>Industry</span><input name="industry" placeholder="Specialty contractors" /></label>
        <label><span>Score</span><input name="score" type="number" min="0" max="100" value="70" /></label>
        <label><span>Stage</span><select name="stage" data-stage-select></select></label>
        <label class="span-two"><span>Workflow hypothesis</span><textarea name="workflow" rows="3"></textarea></label>
        <label class="span-two"><span>Next move</span><input name="nextAction" placeholder="Verify email, review copy, reply…" /></label>
      </div>
      <footer><button type="button" data-close-prospect class="button-secondary">Cancel</button><button type="submit" class="button-primary">Add to pipeline</button></footer>
    </form>
  </dialog>

  <dialog id="import-dialog" class="pipeline-dialog">
    <form id="import-form" method="dialog">
      <header><div><p>Private import</p><h2>Load pipeline data</h2></div><button type="button" data-close-import aria-label="Close">×</button></header>
      <p class="dialog-copy">Paste an exported prospect array, or a package with prospects and campaign details. Records merge by email or company and contact.</p>
      <textarea id="import-json" rows="13" spellcheck="false" placeholder='{"prospects":[{"company":"Example Co","contact":"Alex"}],"campaign":{"name":"Batch 01","status":"Active"}}'></textarea>
      <p id="import-error" class="import-error" role="alert"></p>
      <footer><button type="button" data-close-import class="button-secondary">Cancel</button><button type="submit" class="button-primary">Import records</button></footer>
    </form>
  </dialog>

  <dialog id="connection-dialog" class="pipeline-dialog connection-dialog">
    <form id="connection-form" method="dialog">
      <header><div><p>Private connection</p><h2>Unlock live metrics</h2></div><button type="button" data-close-connection aria-label="Close">×</button></header>
      <p class="dialog-copy">Enter the value configured as <code>OPS_DASHBOARD_KEY</code> in Netlify. It stays in this browser tab and is never embedded in the site.</p>
      <label class="connection-field"><span>Dashboard key</span><input id="dashboard-key" type="password" required autocomplete="current-password" /></label>
      <p id="connection-error" class="import-error" role="alert"></p>
      <footer><button type="button" data-close-connection class="button-secondary">Cancel</button><button type="submit" class="button-primary">Connect services</button></footer>
    </form>
  </dialog>

  <div id="pipeline-toast" class="pipeline-toast" role="status" aria-live="polite">Saved</div>
</OpsShell>

<script>
  const stages = ["Research", "Verified", "Approved", "Outreach", "Replied", "Meeting", "Proof", "Customer", "Nurture", "Closed"] as const;
  type Stage = typeof stages[number];
  type Prospect = {
    id: string; company: string; contact: string; email: string; industry: string;
    score: number; stage: Stage; verified: boolean; campaign: string; sent: number;
    bounced: boolean; lastTouch: string; nextAction: string; nextActionDate: string;
    workflow: string; mrr: number; notes: string;
  };
  type ServiceState = { status: string; [key: string]: string | number };
  type LiveServices = Record<string, ServiceState>;

  const storageKey = "raleigh-ai-guy:acquisition:v1";
  const campaignKey = "raleigh-ai-guy:campaign:v1";
  const list = document.querySelector<HTMLDivElement>("#pipeline-list")!;
  const empty = document.querySelector<HTMLDivElement>("#empty-pipeline")!;
  const search = document.querySelector<HTMLInputElement>("#pipeline-search")!;
  const filter = document.querySelector<HTMLSelectElement>("#stage-filter")!;
  const prospectDialog = document.querySelector<HTMLDialogElement>("#prospect-dialog")!;
  const importDialog = document.querySelector<HTMLDialogElement>("#import-dialog")!;
  const connectionDialog = document.querySelector<HTMLDialogElement>("#connection-dialog")!;
  const prospectForm = document.querySelector<HTMLFormElement>("#prospect-form")!;
  const importForm = document.querySelector<HTMLFormElement>("#import-form")!;
  const connectionForm = document.querySelector<HTMLFormElement>("#connection-form")!;
  const importJson = document.querySelector<HTMLTextAreaElement>("#import-json")!;
  const toast = document.querySelector<HTMLDivElement>("#pipeline-toast")!;
  const dashboardKey = document.querySelector<HTMLInputElement>("#dashboard-key")!;
  const connectionError = document.querySelector<HTMLParagraphElement>("#connection-error")!;
  let prospects = loadProspects();
  let liveServices: LiveServices = {};
  let toastTimer = 0;

  stages.forEach((stage) => {
    filter.add(new Option(stage, stage));
    document.querySelectorAll<HTMLSelectElement>("[data-stage-select]").forEach((select) => select.add(new Option(stage, stage)));
  });

  function id() { return typeof crypto.randomUUID === "function" ? crypto.randomUUID() : `${Date.now()}-${Math.random()}`; }
  function clean(value: Partial<Prospect>): Prospect {
    const requestedStage = String(value.stage || "Research") as Stage;
    return {
      id: String(value.id || id()), company: String(value.company || "").trim(), contact: String(value.contact || "").trim(),
      email: String(value.email || "").trim(), industry: String(value.industry || "Unclassified").trim(),
      score: Math.min(100, Math.max(0, Number(value.score || 0))), stage: stages.includes(requestedStage) ? requestedStage : "Research",
      verified: Boolean(value.verified), campaign: String(value.campaign || "").trim(), sent: Math.max(0, Number(value.sent || 0)),
      bounced: Boolean(value.bounced), lastTouch: String(value.lastTouch || ""), nextAction: String(value.nextAction || "Research account").trim(),
      nextActionDate: String(value.nextActionDate || ""), workflow: String(value.workflow || "").trim(), mrr: Math.max(0, Number(value.mrr || 0)),
      notes: String(value.notes || "").trim(),
    };
  }
  function loadProspects(): Prospect[] {
    try {
      const stored = localStorage.getItem(storageKey);
      if (stored) return JSON.parse(stored).map(clean);
      const seed = document.querySelector<HTMLScriptElement>("#seed-acquisition")?.textContent || "[]";
      return JSON.parse(seed).map(clean);
    } catch { return []; }
  }
  function save(message = "Pipeline saved") {
    localStorage.setItem(storageKey, JSON.stringify(prospects));
    render();
    toast.textContent = message; toast.classList.add("visible");
    window.clearTimeout(toastTimer); toastTimer = window.setTimeout(() => toast.classList.remove("visible"), 1600);
  }
  function esc(value: string) {
    return value.replace(/[&<>'"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#039;", '"': "&quot;" })[char]!);
  }
  function due(prospect: Prospect) {
    return Boolean(prospect.nextAction && (!prospect.nextActionDate || prospect.nextActionDate <= new Date().toISOString().slice(0, 10)) && !["Customer", "Closed", "Nurture"].includes(prospect.stage));
  }
  function render() {
    const query = search.value.toLowerCase().trim();
    const visible = prospects.filter((p) => (filter.value === "all" || p.stage === filter.value) && [p.company, p.contact, p.email, p.industry].join(" ").toLowerCase().includes(query));
    list.innerHTML = visible.map((p) => {
      const stageIndex = stages.indexOf(p.stage);
      const signal = p.bounced ? "Bounced" : p.verified ? `Verified · ${p.score}` : `Score ${p.score}`;
      return `<article class="ledger-row" data-id="${esc(p.id)}">
        <div class="account-cell"><span>${esc(p.company.slice(0, 2).toUpperCase())}</span><div><strong>${esc(p.company)}</strong><p>${esc(p.contact)}${p.email ? ` · ${esc(p.email)}` : ""}</p></div></div>
        <label class="stage-cell"><span class="sr-only">Stage</span><select data-field="stage">${stages.map((stage) => `<option ${stage === p.stage ? "selected" : ""}>${stage}</option>`).join("")}</select></label>
        <div class="signal-cell ${p.bounced ? "danger" : p.verified ? "good" : ""}"><span></span>${esc(signal)}</div>
        <div class="action-cell"><strong>${esc(p.nextAction || "No next move")}</strong><p>${p.nextActionDate ? esc(p.nextActionDate) : esc(p.workflow || p.industry)}</p></div>
        <div class="row-actions"><button type="button" data-back ${stageIndex <= 0 ? "disabled" : ""} aria-label="Move back">←</button><button type="button" data-forward ${stageIndex >= stages.length - 1 ? "disabled" : ""} aria-label="Move forward">→</button></div>
      </article>`;
    }).join("");
    empty.hidden = visible.length > 0;

    const count = (wanted: Stage[]) => prospects.filter((p) => wanted.includes(p.stage)).length;
    document.querySelector("#prospect-count")!.textContent = String(prospects.length);
    const smartlead = liveServices.smartlead;
    const smartleadConnected = smartlead?.status === "connected";
    document.querySelector("#outreach-count")!.textContent = String(smartleadConnected ? Number(smartlead.sent || 0) : count(["Outreach"]));
    document.querySelector("#reply-count")!.textContent = String(smartleadConnected ? Number(smartlead.replied || 0) : count(["Replied", "Meeting", "Proof", "Customer"]));
    document.querySelector("#outreach-note")!.textContent = smartleadConnected ? "Emails sent by Smartlead" : "Active sequences";
    document.querySelector("#reply-note")!.textContent = smartleadConnected ? "Smartlead replies" : "Human responses";
    const calendlyMeetings = liveServices.calendly?.status === "connected" ? Number(liveServices.calendly.upcoming || 0) : null;
    document.querySelector("#meeting-count")!.textContent = String(calendlyMeetings ?? count(["Meeting"]));
    document.querySelector("#proof-count")!.textContent = String(count(["Proof"]));
    const stripeMrr = liveServices.stripe?.status === "connected" ? Number(liveServices.stripe.mrr || 0) : null;
    document.querySelector("#mrr-total")!.textContent = `$${(stripeMrr ?? prospects.reduce((sum, p) => sum + p.mrr, 0)).toLocaleString()}`;
    document.querySelector("#attention-count")!.textContent = String(prospects.filter(due).length);
    document.querySelector("#today-label")!.textContent = new Intl.DateTimeFormat("en-US", { weekday: "short", month: "short", day: "numeric" }).format(new Date());

    const activeStages = stages.slice(0, 8);
    document.querySelector("#stage-track")!.innerHTML = activeStages.map((stage, index) => `<article><span>${String(index + 1).padStart(2, "0")}</span><strong>${stage}</strong><p>${count([stage])}</p></article>`).join("");
    const customers = count(["Customer"]); const meetings = count(["Meeting", "Proof", "Customer"]);
    document.querySelector("#conversion-note")!.textContent = prospects.length ? `${Math.round((meetings / prospects.length) * 100)}% reached a meeting · ${customers} customers` : "Add your first prospects to establish a baseline.";
    renderCampaign();
  }

  const serviceLabels: Record<string, (service: ServiceState) => string> = {
    smartlead: (service) => service.status === "connected" ? `${service.sent || 0} sent · ${service.replied || 0} replies` : statusLabel(service.status),
    stripe: (service) => service.status === "connected" ? `$${Number(service.mrr || 0).toLocaleString()} MRR` : statusLabel(service.status),
    calendly: (service) => service.status === "connected" ? `${service.upcoming || 0} upcoming` : statusLabel(service.status),
    netlifyForms: (service) => service.status === "connected" ? `${service.leads30d || 0} leads · 30d` : statusLabel(service.status),
    posthog: (service) => service.status === "connected" ? `${service.visitors30d || 0} visitors · 30d` : statusLabel(service.status),
    netlifyDeploy: (service) => service.status === "connected" ? `Live · ${service.commit || "ready"}` : statusLabel(service.status),
    clay: (service) => statusLabel(service.status),
  };
  function statusLabel(status: string) {
    if (status === "not_configured") return "Needs credential";
    if (status === "tracking_only") return "Tracking only";
    if (status === "planned") return "Planned";
    if (status === "permission_required") return "Needs read permission";
    if (status === "error") return "Connection error";
    return status || "Unavailable";
  }
  function paintServices() {
    Object.entries(liveServices).forEach(([name, service]) => {
      const card = document.querySelector<HTMLElement>(`[data-service="${name}"]`);
      if (!card) return;
      card.classList.toggle("connected", service.status === "connected");
      card.classList.toggle("warning", ["not_configured", "tracking_only", "planned", "permission_required"].includes(service.status));
      card.classList.toggle("failed", service.status === "error");
      card.querySelector("em")!.textContent = serviceLabels[name]?.(service) || statusLabel(service.status);
    });
    const stripe = liveServices.stripe;
    const smartlead = liveServices.smartlead;
    const calendly = liveServices.calendly;
    const forms = liveServices.netlifyForms;
    const posthog = liveServices.posthog;
    const parts = [
      smartlead?.status === "connected" ? `${smartlead.sent || 0} Smartlead sends and ${smartlead.replied || 0} replies` : "",
      stripe?.status === "connected" ? `$${Number(stripe.mrr || 0).toLocaleString()} active MRR` : "",
      calendly?.status === "connected" ? `${calendly.upcoming || 0} upcoming calls` : "",
      forms?.status === "connected" ? `${forms.leads30d || 0} form leads in 30 days` : "",
      posthog?.status === "connected" ? `${posthog.visitors30d || 0} visitors in 30 days` : "",
    ].filter(Boolean);
    document.querySelector("#live-summary")!.textContent = parts.length ? parts.join(" · ") : "Connected. Add the credentials marked above to unlock more live metrics.";
    render();
  }
  async function syncServices(key: string) {
    const button = document.querySelector<HTMLButtonElement>("#sync-services")!;
    button.disabled = true; button.textContent = "Syncing…"; connectionError.textContent = "";
    try {
      const response = await fetch("/.netlify/functions/acquisition-summary", { headers: { "x-ops-key": key } });
      const payload = await response.json();
      if (!response.ok) throw new Error(payload.error || "Could not connect to live services.");
      sessionStorage.setItem("raleigh-ai-guy:ops-key", key);
      liveServices = payload.services || {};
      document.querySelector("#last-synced")!.textContent = `Synced ${new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }).format(new Date(payload.generatedAt))}`;
      button.textContent = "Sync again";
      connectionDialog.close();
      paintServices();
      window.posthog?.capture?.("ops_services_synced", { connected: Object.values(liveServices).filter((service) => service.status === "connected").length });
    } catch (error) {
      connectionError.textContent = error instanceof Error ? error.message : "Could not connect to live services.";
      if (!connectionDialog.open) connectionDialog.showModal();
      button.textContent = "Connect live data";
    } finally { button.disabled = false; }
  }
  function renderCampaign() {
    const smartlead = liveServices.smartlead;
    if (smartlead?.status === "connected") {
      const leads = Number(smartlead.leads || 0);
      const sent = Number(smartlead.sent || 0);
      const bounced = Number(smartlead.bounced || 0);
      const progress = leads ? Math.min(100, Math.round((sent / leads) * 100)) : 0;
      document.querySelector("#batch-name")!.textContent = String(smartlead.campaignName || "Smartlead campaign");
      document.querySelector("#batch-status")!.textContent = String(smartlead.campaignStatus || "Active");
      document.querySelector("#campaign-state")!.textContent = `${smartlead.campaigns || 0} Smartlead campaign${Number(smartlead.campaigns || 0) === 1 ? "" : "s"} active`;
      document.querySelector("#batch-leads")!.textContent = String(leads);
      document.querySelector("#batch-sent")!.textContent = String(sent);
      document.querySelector("#batch-bounced")!.textContent = String(bounced);
      document.querySelector("#sending-ceiling")!.textContent = `${smartlead.maxDaily || 0} leads / day`;
      const tracking = [smartlead.openTracking ? "opens" : "", smartlead.clickTracking ? "clicks" : ""].filter(Boolean);
      document.querySelector("#tracking-state")!.textContent = tracking.length ? `${tracking.join(" + ")} enabled` : "Disabled";
      (document.querySelector("#campaign-progress-bar") as HTMLElement).style.width = `${progress}%`;
      return;
    }
    let campaign: { name?: string; status?: string; leads?: number; sent?: number; bounced?: number } = {};
    try { campaign = JSON.parse(localStorage.getItem(campaignKey) || "{}"); } catch {}
    const leads = Number(campaign.leads || prospects.filter((p) => p.campaign).length);
    const sent = Number(campaign.sent || prospects.reduce((sum, p) => sum + p.sent, 0));
    const bounced = Number(campaign.bounced || prospects.filter((p) => p.bounced).length);
    const progress = leads ? Math.min(100, Math.round((prospects.filter((p) => p.sent > 0).length / leads) * 100)) : 0;
    document.querySelector("#batch-name")!.textContent = campaign.name || "No campaign loaded";
    document.querySelector("#batch-status")!.textContent = campaign.status || "Draft";
    document.querySelector("#campaign-state")!.textContent = campaign.status === "Active" ? "Campaign active" : "No active campaign";
    document.querySelector("#batch-leads")!.textContent = String(leads);
    document.querySelector("#batch-sent")!.textContent = String(sent);
    document.querySelector("#batch-bounced")!.textContent = String(bounced);
    (document.querySelector("#campaign-progress-bar") as HTMLElement).style.width = `${progress}%`;
  }

  list.addEventListener("change", (event) => {
    const target = event.target as HTMLSelectElement;
    const row = target.closest<HTMLElement>("[data-id]"); const prospect = prospects.find((p) => p.id === row?.dataset.id);
    if (prospect && target.dataset.field === "stage") { prospect.stage = target.value as Stage; save("Stage updated"); window.posthog?.capture?.("ops_pipeline_stage_changed", { stage: prospect.stage }); }
  });
  list.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button");
    const row = button?.closest<HTMLElement>("[data-id]"); const prospect = prospects.find((p) => p.id === row?.dataset.id);
    if (!button || !prospect) return;
    const current = stages.indexOf(prospect.stage);
    if (button.hasAttribute("data-forward") && current < stages.length - 1) prospect.stage = stages[current + 1];
    if (button.hasAttribute("data-back") && current > 0) prospect.stage = stages[current - 1];
    save("Stage updated");
  });
  search.addEventListener("input", render); filter.addEventListener("change", render);
  document.querySelector("#add-prospect")!.addEventListener("click", () => { prospectForm.reset(); prospectDialog.showModal(); });
  document.querySelector("#import-pipeline")!.addEventListener("click", () => { importJson.value = ""; document.querySelector("#import-error")!.textContent = ""; importDialog.showModal(); });
  document.querySelector("#sync-services")!.addEventListener("click", () => {
    const key = sessionStorage.getItem("raleigh-ai-guy:ops-key");
    if (key) syncServices(key); else { dashboardKey.value = ""; connectionError.textContent = ""; connectionDialog.showModal(); }
  });
  document.querySelectorAll("[data-close-prospect]").forEach((el) => el.addEventListener("click", () => prospectDialog.close()));
  document.querySelectorAll("[data-close-import]").forEach((el) => el.addEventListener("click", () => importDialog.close()));
  document.querySelectorAll("[data-close-connection]").forEach((el) => el.addEventListener("click", () => connectionDialog.close()));
  connectionForm.addEventListener("submit", (event) => { event.preventDefault(); syncServices(dashboardKey.value); });
  prospectForm.addEventListener("submit", (event) => {
    event.preventDefault(); const data = new FormData(prospectForm);
    prospects.push(clean({ company: String(data.get("company") || ""), contact: String(data.get("contact") || ""), email: String(data.get("email") || ""), industry: String(data.get("industry") || ""), score: Number(data.get("score") || 0), stage: String(data.get("stage") || "Research") as Stage, workflow: String(data.get("workflow") || ""), nextAction: String(data.get("nextAction") || "") }));
    prospectDialog.close(); save("Prospect added");
  });
  importForm.addEventListener("submit", (event) => {
    event.preventDefault();
    try {
      const payload = JSON.parse(importJson.value);
      const incoming = Array.isArray(payload) ? payload : payload.prospects;
      if (!Array.isArray(incoming)) throw new Error("Paste a prospect array or a pipeline package.");
      incoming.map(clean).filter((p) => p.company && p.contact).forEach((record) => {
        const found = prospects.find((p) => (record.email && p.email.toLowerCase() === record.email.toLowerCase()) || (p.company.toLowerCase() === record.company.toLowerCase() && p.contact.toLowerCase() === record.contact.toLowerCase()));
        if (found) Object.assign(found, record, { id: found.id }); else prospects.push(record);
      });
      if (!Array.isArray(payload) && payload.campaign && typeof payload.campaign === "object") localStorage.setItem(campaignKey, JSON.stringify(payload.campaign));
      importDialog.close(); save("Pipeline imported");
    } catch (error) { document.querySelector("#import-error")!.textContent = error instanceof Error ? error.message : "Could not import that data."; }
  });
  document.querySelector("#export-pipeline")!.addEventListener("click", () => {
    let campaign = {};
    try { campaign = JSON.parse(localStorage.getItem(campaignKey) || "{}"); } catch {}
    const payload = { prospects, campaign, exportedAt: new Date().toISOString() };
    const link = document.createElement("a"); link.href = URL.createObjectURL(new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" })); link.download = `raleigh-ai-guy-pipeline-${new Date().toISOString().slice(0, 10)}.json`; link.click(); URL.revokeObjectURL(link.href);
  });
  render();
  const savedOpsKey = sessionStorage.getItem("raleigh-ai-guy:ops-key");
  if (savedOpsKey) syncServices(savedOpsKey);
</script>

