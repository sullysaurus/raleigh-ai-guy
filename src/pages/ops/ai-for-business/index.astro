---
import OpsShell from "@/components/ops/OpsShell.astro";

const actions = [
  ["Send venue pitch", "Email Raleigh Founded and submit the booking form.", "Today", "/ops/ai-for-business/venues/"],
  ["Call if unanswered", "Use the evening-event precedent and confirm all three dates.", "Jul 23", "/ops/ai-for-business/venues/"],
  ["Draft Luma", "Load the final copy and registration questions; wait to publish for the venue.", "This week", "/ops/ai-for-business/promotion/"],
  ["Warm the channels", "Join the seven target groups and contribute before promotion begins.", "This week", "/ops/ai-for-business/promotion/"],
  ["Invite ten owners", "Personal outreach is the highest-yield registration channel.", "This week", "/ops/ai-for-business/promotion/"],
];

const events = [
  { number: "01", date: "Aug 26", goal: "15–20 in room", topic: "AI catches missed leads", state: "Launch" },
  { number: "02", date: "Sep 23", goal: "Repeat + improve", topic: "Finance workflow guest", state: "Build" },
  { number: "03", date: "Oct 28", goal: "25+ in room", topic: "AI content guest", state: "Rock" },
];
---

<OpsShell
  title="AI for Business Raleigh"
  description="Launch and operate the monthly meetup from one place. The August 26 event is the current constraint; venue first, promotion second."
  eyebrow="Q3/Q4 Rock · Launch cockpit"
  current="aifb"
>
  <section class="command-row" aria-label="Launch status">
    <article class="next-move">
      <div class="status-line"><span class="status-dot"></span><strong>Critical path</strong><time datetime="2026-07-27">Decision by Jul 27</time></div>
      <p class="kicker">Next move</p>
      <h2>Lock the room.</h2>
      <p>Raleigh Founded is the first call. If there is no firm yes by Monday, activate The Loading Dock without extending the negotiation.</p>
      <div class="action-links">
        <a class="primary-action" href="mailto:info@raleighfounded.com?subject=Monthly%20event%20idea%3A%2025-50%20Raleigh%20business%20owners%20in%20your%20space">Open venue email <span>↗</span></a>
        <a href="tel:+19193006917">Call 919-300-6917</a>
        <a href="/ops/ai-for-business/venues/">Pitch copy</a>
      </div>
    </article>

    <aside class="countdown" aria-label="Countdown to event one">
      <p>Event 01</p>
      <strong data-countdown>36</strong>
      <span>days to launch</span>
      <div><time datetime="2026-08-26T17:30:00-04:00">Wed · Aug 26 · 5:30 PM</time></div>
    </aside>
  </section>

  <section class="runway" aria-labelledby="runway-title">
    <header><div><p>Fourth-Wednesday runway</p><h2 id="runway-title">Three rooms. One closed client.</h2></div><a href="/ops/ai-for-business/scoreboard/">Open scoreboard →</a></header>
    <ol>
      {events.map((event, index) => (
        <li class:list={{ active: index === 0 }}>
          <div class="event-marker"><span>{event.number}</span><i></i></div>
          <div class="event-date"><strong>{event.date}</strong><span>{event.state}</span></div>
          <div class="event-detail"><strong>{event.topic}</strong><span>{event.goal}</span></div>
        </li>
      ))}
    </ol>
  </section>

  <div class="work-grid">
    <section class="action-queue" aria-labelledby="actions-title">
      <header><div><p>Week of July 20</p><h2 id="actions-title">Five moves before Friday.</h2></div><span>0 / 5</span></header>
      <ol>
        {actions.map(([title, body, due, href], index) => (
          <li>
            <label>
              <input type="checkbox" aria-label={`Mark ${title} complete`} />
              <span class="action-number">0{index + 1}</span>
              <span class="action-copy"><strong>{title}</strong><small>{body}</small></span>
            </label>
            <div><time>{due}</time><a href={href}>Open →</a></div>
          </li>
        ))}
      </ol>
    </section>

    <aside class="readiness" aria-labelledby="readiness-title">
      <p>Launch gates</p>
      <h2 id="readiness-title">What unlocks promotion?</h2>
      <dl>
        <div><dt>Venue</dt><dd class="blocked">Blocked</dd></div>
        <div><dt>Luma draft</dt><dd>Ready to build</dd></div>
        <div><dt>Event copy</dt><dd class="ready">Ready</dd></div>
        <div><dt>Lead capture</dt><dd class="ready">Ready</dd></div>
        <div><dt>Assessment page</dt><dd class="blocked">Missing</dd></div>
      </dl>
      <p class="readiness-note">Publish Luma by <strong>July 29</strong>. The public $999 assessment page must be live before the first event.</p>
    </aside>
  </div>

  <nav class="reference-grid" aria-label="AI for Business reference sections">
    <a href="/ops/ai-for-business/launch/"><span>01</span><strong>Launch plan</strong><small>Decisions, timeline, budget</small></a>
    <a href="/ops/ai-for-business/event/"><span>02</span><strong>Event format</strong><small>Run of show, demo, speakers</small></a>
    <a href="/ops/ai-for-business/promotion/"><span>03</span><strong>Promotion</strong><small>Luma, posts, channels</small></a>
    <a href="/ops/ai-for-business/leads/"><span>04</span><strong>Lead system</strong><small>Scoring and follow-up</small></a>
  </nav>

  <script>
    const countdown = document.querySelector<HTMLElement>("[data-countdown]");
    if (countdown) {
      const eventDate = new Date("2026-08-26T17:30:00-04:00").getTime();
      countdown.textContent = String(Math.max(0, Math.ceil((eventDate - Date.now()) / 86400000)));
    }

    const actionSection = document.querySelector<HTMLElement>(".action-queue");
    const actionTotal = actionSection?.querySelector<HTMLElement>("header > span");
    const actionChecks = [...(actionSection?.querySelectorAll<HTMLInputElement>("input[type='checkbox']") || [])];
    const updateTotal = () => {
      if (actionTotal) actionTotal.textContent = `${actionChecks.filter((item) => item.checked).length} / ${actionChecks.length}`;
    };
    actionChecks.forEach((item) => item.addEventListener("change", updateTotal));
    window.setTimeout(updateTotal, 0);
  </script>
</OpsShell>

<style>
  .command-row { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; border-top: 1px solid var(--ops-line-strong); border-bottom: 1px solid var(--ops-line-strong); background: var(--ops-sheet); }
  .next-move { padding: 2rem; }
  .status-line { display: flex; align-items: center; gap: .55rem; color: var(--ops-muted); font-size: .68rem; }
  .status-line strong { color: var(--ops-ink); font-weight: 700; }
  .status-line time { margin-left: auto; color: var(--ops-deadline); font-weight: 680; }
  .status-dot { width: .5rem; height: .5rem; border-radius: 50%; background: var(--ops-deadline); box-shadow: 0 0 0 4px rgb(239 107 59 / 12%); }
  .kicker, .runway header p, .action-queue header p, .readiness > p:first-child { margin-top: 3rem; color: var(--ops-faint); font-size: .62rem; font-weight: 720; letter-spacing: .12em; text-transform: uppercase; }
  .next-move h2 { margin-top: .4rem; font-family: "Anybody", sans-serif; font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 720; line-height: .9; letter-spacing: -.055em; }
  .next-move > p:not(.kicker) { max-width: 44rem; margin-top: 1rem; color: var(--ops-muted); font-size: .88rem; line-height: 1.6; }
  .action-links { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; margin-top: 1.75rem; }
  .action-links a { min-height: 2.75rem; padding: .75rem 0; font-size: .76rem; font-weight: 680; text-decoration: underline; text-decoration-color: var(--ops-line-strong); text-underline-offset: 4px; }
  .action-links .primary-action { display: inline-flex; align-items: center; gap: 1.5rem; padding-inline: 1rem; color: var(--ops-ink); background: var(--ops-signal); text-decoration: none; transition: transform 120ms ease; }
  .action-links .primary-action:active { transform: scale(.97); }
  .countdown { display: flex; flex-direction: column; justify-content: center; border-left: 1px solid var(--ops-line-strong); padding: 1.5rem; background: var(--ops-signal); }
  .countdown > p { font-size: .65rem; font-weight: 740; letter-spacing: .12em; text-transform: uppercase; }
  .countdown > strong { margin-top: 2.5rem; font-family: "Anybody", sans-serif; font-size: 6rem; font-weight: 760; line-height: .7; letter-spacing: -.08em; font-variant-numeric: tabular-nums; }
  .countdown > span { margin-top: .8rem; font-size: .76rem; font-weight: 650; }
  .countdown > div { margin-top: auto; border-top: 1px solid rgb(23 25 20 / 20%); padding-top: 1rem; font-size: .68rem; font-weight: 680; }

  .runway { padding: 4rem 0; }
  .runway > header, .action-queue > header { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .runway header p, .action-queue header p { margin-top: 0; }
  .runway h2, .action-queue h2, .readiness h2 { margin-top: .4rem; font-family: "Anybody", sans-serif; font-size: 1.65rem; font-weight: 690; line-height: 1; letter-spacing: -.035em; }
  .runway header a { color: var(--ops-muted); font-size: .72rem; font-weight: 650; }
  .runway ol { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 2rem; }
  .runway li { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; min-height: 9rem; border-top: 1px solid var(--ops-line-strong); padding: 1.25rem 1.5rem 1.25rem 0; }
  .runway li:not(:last-child) { margin-right: 1.5rem; }
  .event-marker { display: flex; flex-direction: column; align-items: center; gap: .75rem; }
  .event-marker span { display: grid; width: 2rem; height: 2rem; place-items: center; border: 1px solid var(--ops-line-strong); border-radius: 50%; color: var(--ops-faint); font-size: .65rem; font-weight: 720; }
  .active .event-marker span { border-color: var(--ops-ink); color: var(--ops-ink); background: var(--ops-signal); }
  .event-marker i { width: 1px; flex: 1; background: var(--ops-line); }
  .event-date strong, .event-date span, .event-detail strong, .event-detail span { display: block; }
  .event-date strong { font-family: "Anybody", sans-serif; font-size: 1.8rem; line-height: 1; letter-spacing: -.04em; }
  .event-date span { margin-top: .35rem; color: var(--ops-deadline); font-size: .62rem; font-weight: 720; text-transform: uppercase; }
  .event-detail { grid-column: 2; align-self: end; }
  .event-detail strong { font-size: .78rem; font-weight: 670; }
  .event-detail span { margin-top: .25rem; color: var(--ops-faint); font-size: .68rem; }

  .work-grid { display: grid; grid-template-columns: minmax(0, 1fr) 19rem; gap: 1px; background: var(--ops-line-strong); }
  .action-queue, .readiness { background: var(--ops-sheet); }
  .action-queue { padding: 2rem; }
  .action-queue header > span { color: var(--ops-faint); font-size: .7rem; font-weight: 720; font-variant-numeric: tabular-nums; }
  .action-queue ol { margin-top: 2rem; border-top: 1px solid var(--ops-line); }
  .action-queue li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; align-items: center; border-bottom: 1px solid var(--ops-line); padding: 1rem 0; }
  .action-queue label { display: grid; grid-template-columns: 1.1rem 1.5rem minmax(0, 1fr); gap: .8rem; align-items: start; cursor: pointer; }
  .action-queue input { width: 1.1rem; height: 1.1rem; margin: .05rem 0 0; border: 1px solid var(--ops-line-strong); border-radius: 0; color: var(--ops-ink); background: var(--ops-paper); }
  .action-queue input:checked { background-color: var(--ops-signal); background-image: none; box-shadow: inset 0 0 0 3px var(--ops-sheet); }
  .action-number { color: var(--ops-faint); font-size: .65rem; font-weight: 680; }
  .action-copy strong, .action-copy small { display: block; }
  .action-copy strong { font-size: .82rem; font-weight: 680; }
  .action-copy small { margin-top: .25rem; color: var(--ops-muted); font-size: .72rem; line-height: 1.45; }
  .action-queue li > div { text-align: right; }
  .action-queue li > div time, .action-queue li > div a { display: block; font-size: .64rem; }
  .action-queue li > div time { color: var(--ops-deadline); font-weight: 680; }
  .action-queue li > div a { margin-top: .3rem; color: var(--ops-faint); }
  .action-queue input:checked ~ .action-copy { opacity: .45; text-decoration: line-through; }
  .readiness { padding: 2rem 1.5rem; }
  .readiness > p:first-child { margin-top: 0; }
  .readiness dl { margin-top: 2rem; }
  .readiness dl div { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--ops-line); padding: .75rem 0; font-size: .7rem; }
  .readiness dt { color: var(--ops-muted); }
  .readiness dd { color: var(--ops-faint); font-weight: 650; }
  .readiness dd.ready { color: #4b6813; }
  .readiness dd.blocked { color: var(--ops-deadline); }
  .readiness-note { margin-top: 2rem; padding: 1rem; background: var(--ops-paper); color: var(--ops-muted); font-size: .72rem; line-height: 1.5; }
  .readiness-note strong { color: var(--ops-ink); }
  .reference-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin-top: 4rem; background: var(--ops-line-strong); }
  .reference-grid a { min-height: 10rem; padding: 1.25rem; background: var(--ops-sheet); transition: background-color 140ms ease; }
  .reference-grid a:hover { background: var(--ops-signal); }
  .reference-grid span, .reference-grid strong, .reference-grid small { display: block; }
  .reference-grid span { color: var(--ops-deadline); font-size: .62rem; font-weight: 720; }
  .reference-grid strong { margin-top: 2.75rem; font-family: "Anybody", sans-serif; font-size: 1.05rem; font-weight: 680; }
  .reference-grid small { margin-top: .4rem; color: var(--ops-muted); font-size: .68rem; }

  @media (max-width: 800px) {
    .command-row, .work-grid { grid-template-columns: 1fr; }
    .countdown { min-height: 15rem; border-top: 1px solid var(--ops-line-strong); border-left: 0; }
    .countdown > strong { margin-top: 2rem; }
    .runway ol { grid-template-columns: 1fr; }
    .runway li:not(:last-child) { margin-right: 0; }
    .reference-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 520px) {
    .next-move, .action-queue { padding: 1.5rem 1.25rem; }
    .status-line { flex-wrap: wrap; }
    .status-line time { width: 100%; margin: .25rem 0 0 1.05rem; }
    .action-links { align-items: stretch; flex-direction: column; }
    .action-links a { width: 100%; }
    .runway { padding: 3rem 0; }
    .runway > header { align-items: start; flex-direction: column; gap: 1rem; }
    .action-queue li { grid-template-columns: 1fr; }
    .action-queue li > div { display: flex; gap: 1rem; padding-left: 3.4rem; text-align: left; }
    .action-queue li > div a { margin-top: 0; }
    .reference-grid { grid-template-columns: 1fr; }
  }
</style>
