---
import OpsShell from "@/components/ops/OpsShell.astro";

const systems = [
  {
    code: "ROCK 01",
    title: "AI for Business Raleigh",
    description: "Launch three monthly rooms, generate qualified conversations, and close one measurable client by October 31.",
    href: "/ops/ai-for-business/",
    action: "Open launch cockpit",
    status: "Venue pending",
    tone: "deadline",
  },
  {
    code: "OFFER 01",
    title: "AI Assessment",
    description: "Discover costly friction, verify tools, calculate credible opportunity, and turn the recommendation into a concrete first move.",
    href: "/ops/ai-assessment-playbook/",
    action: "Open field manual",
    status: "Ready to deliver",
    tone: "ready",
  },
  {
    code: "OUTPUT 01",
    title: "Client report builder",
    description: "Complete the six-page assessment report in the browser, then print or save a clean client-ready PDF.",
    href: "/ops/assessment-report-template/",
    action: "Build a report",
    status: "Template ready",
    tone: "ready",
  },
];
---

<OpsShell title="Operations" description="The internal field office for launching the Raleigh event series and delivering the AI Assessment offer." eyebrow="Danny Sullivan · Field office" current="overview">
  <section class="ops-brief">
    <div>
      <p>Current operating constraint</p>
      <h2>Secure the August 26 venue.</h2>
    </div>
    <p>Venue confirmation unlocks Luma, calendar submissions, public promotion, and the first registration milestone.</p>
    <a href="/ops/ai-for-business/">Go to the Rock <span>→</span></a>
  </section>

  <section class="system-list" aria-labelledby="systems-title">
    <header><p>Active systems</p><h2 id="systems-title">Run the work.</h2></header>
    <div>
      {systems.map((system, index) => (
        <a href={system.href} class="system-row">
          <span class="system-index">0{index + 1}</span>
          <span class="system-copy"><small>{system.code}</small><strong>{system.title}</strong><p>{system.description}</p></span>
          <span class:list={["system-state", system.tone]}><i></i>{system.status}</span>
          <span class="system-action">{system.action} <i>→</i></span>
        </a>
      ))}
    </div>
  </section>

  <section class="operating-loop" aria-labelledby="loop-title">
    <header><p>Shared operating loop</p><h2 id="loop-title">Listen. Prescribe. Prove. Repeat.</h2></header>
    <ol>
      <li><span>01</span><strong>Listen in the room</strong><p>Use registration answers, share-outs, and review calls to capture the problem in the owner’s language.</p></li>
      <li><span>02</span><strong>Prescribe the smallest move</strong><p>Start with one useful recommendation. Expand only when the broader assessment or implementation is justified.</p></li>
      <li><span>03</span><strong>Prove the outcome</strong><p>Track booked reviews, assessments, workshops, client work, and the source that created each opportunity.</p></li>
      <li><span>04</span><strong>Feed the next room</strong><p>Turn working examples, objections, and client results into the next event’s demo and promotion.</p></li>
    </ol>
  </section>
</OpsShell>

<style>
  .ops-brief { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(15rem, .8fr) auto; gap: 2rem; align-items: end; border-top: 1px solid var(--ops-line-strong); border-bottom: 1px solid var(--ops-line-strong); padding: 2rem; background: var(--ops-signal); }
  .ops-brief > div > p, .system-list > header p, .operating-loop > header p { color: rgb(23 25 20 / 55%); font-size: .62rem; font-weight: 720; letter-spacing: .12em; text-transform: uppercase; }
  .ops-brief h2 { margin-top: .5rem; font-family: "Anybody", sans-serif; font-size: clamp(1.8rem, 4vw, 3.25rem); font-weight: 710; line-height: .94; letter-spacing: -.045em; }
  .ops-brief > p { color: rgb(23 25 20 / 68%); font-size: .78rem; line-height: 1.5; }
  .ops-brief > a { display: inline-flex; min-height: 2.75rem; align-items: center; gap: 2rem; border: 1px solid rgb(23 25 20 / 22%); padding: .75rem 1rem; font-size: .72rem; font-weight: 680; transition: background-color 140ms ease, transform 120ms ease; }
  .ops-brief > a:hover { background: var(--ops-sheet); }
  .ops-brief > a:active { transform: scale(.97); }

  .system-list, .operating-loop { padding: 4rem 0; }
  .system-list > header, .operating-loop > header { display: grid; grid-template-columns: 12rem 1fr; align-items: end; margin-bottom: 2rem; }
  .system-list > header p, .operating-loop > header p { color: var(--ops-faint); }
  .system-list > header h2, .operating-loop > header h2 { font-family: "Anybody", sans-serif; font-size: 1.75rem; font-weight: 690; line-height: 1; letter-spacing: -.04em; }
  .system-list > div { border-top: 1px solid var(--ops-line-strong); }
  .system-row { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr) 9rem 10rem; gap: 1.5rem; align-items: center; border-bottom: 1px solid var(--ops-line); padding: 1.5rem 0; transition: background-color 140ms ease; }
  .system-row:hover { background: var(--ops-sheet); }
  .system-index { color: var(--ops-faint); font-size: .65rem; font-weight: 700; }
  .system-copy small, .system-copy strong, .system-copy p { display: block; }
  .system-copy small { color: var(--ops-deadline); font-size: .58rem; font-weight: 720; letter-spacing: .1em; }
  .system-copy strong { margin-top: .35rem; font-family: "Anybody", sans-serif; font-size: 1.25rem; font-weight: 680; letter-spacing: -.025em; }
  .system-copy p { max-width: 43rem; margin-top: .45rem; color: var(--ops-muted); font-size: .74rem; line-height: 1.5; }
  .system-state { display: flex; align-items: center; gap: .5rem; color: var(--ops-muted); font-size: .66rem; font-weight: 650; }
  .system-state i { width: .45rem; height: .45rem; border-radius: 50%; background: var(--ops-faint); }
  .system-state.ready i { background: #789d21; }
  .system-state.deadline { color: var(--ops-deadline); }
  .system-state.deadline i { background: var(--ops-deadline); }
  .system-action { color: var(--ops-muted); font-size: .68rem; font-weight: 650; text-align: right; }
  .system-action i { margin-left: .5rem; font-style: normal; }

  .operating-loop { border-top: 1px solid var(--ops-line-strong); }
  .operating-loop ol { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--ops-line-strong); }
  .operating-loop li { min-height: 14rem; padding: 1.25rem; background: var(--ops-sheet); }
  .operating-loop li > span { color: var(--ops-deadline); font-size: .62rem; font-weight: 720; }
  .operating-loop li > strong { display: block; margin-top: 3.5rem; font-family: "Anybody", sans-serif; font-size: 1.05rem; font-weight: 680; line-height: 1.1; }
  .operating-loop li > p { margin-top: .75rem; color: var(--ops-muted); font-size: .7rem; line-height: 1.5; }

  @media (max-width: 900px) {
    .ops-brief { grid-template-columns: 1fr 1fr; }
    .ops-brief > a { width: fit-content; }
    .system-row { grid-template-columns: 2rem minmax(0, 1fr) 9rem; }
    .system-action { display: none; }
    .operating-loop ol { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 620px) {
    .ops-brief { grid-template-columns: 1fr; padding: 1.5rem 1.25rem; }
    .system-list > header, .operating-loop > header { grid-template-columns: 1fr; gap: .5rem; }
    .system-row { grid-template-columns: 1.5rem minmax(0, 1fr); gap: .75rem; }
    .system-state { grid-column: 2; }
    .operating-loop ol { grid-template-columns: 1fr; }
    .operating-loop li { min-height: 11rem; }
  }
</style>
