text-transform:uppercase;opacity:.55}.pipeline p{font-size:.77rem}.pipeline input,.qa-list input{width:1.2rem;height:1.2rem;border:1px solid;border-radius:0;color:var(--orange)}.callout{padding:1rem;color:#111;background:var(--green);border:2px solid #111;font-size:.8rem}.question-list{margin-top:2rem;border-top:1px solid}.question-list li{display:grid;grid-template-columns:3rem 1fr;padding:1rem 0;border-bottom:1px solid}.question-list span{color:var(--orange);font-weight:850}.question-list p{font-family:"Anybody";font-size:1.4rem;font-weight:750;text-transform:uppercase}.probe-grid,.review-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:2rem}.probe-grid article,.review-grid article{padding:1.5rem;border:2px solid}.probe-grid h3,.review-grid h3,.qa-list h3,.concierge-check h3,.weekly-cadence h3{font-size:1.4rem;font-weight:850}.probe-grid ul,.review-grid ol,.concierge-check ol{margin-top:1rem}.probe-grid li,.review-grid li,.concierge-check li{padding:.45rem 0;border-top:1px solid;font-size:.75rem}.prompt-block{position:relative;color:#eee;background:#111}.prompt-block button{position:absolute;top:1rem;right:1rem;padding:.6rem .8rem;color:#111;background:var(--green);font-size:.58rem;font-weight:850;text-transform:uppercase}.prompt-block pre{overflow:auto;padding:4rem 1.5rem 1.5rem;font-size:.74rem;line-height:1.6;white-space:pre-wrap}.qa-list{display:grid;gap:.7rem;margin-top:1.5rem;padding:1.5rem;border:2px solid}.qa-list h3{margin-bottom:.5rem}.qa-list label{display:flex;gap:.7rem;align-items:start;font-size:.75rem}.report-link{display:flex;justify-content:space-between;gap:2rem;align-items:end;padding:2rem;color:#fff;background:#2348ff}.report-link strong{font-family:"Anybody";font-size:2rem;text-transform:uppercase}.report-link p{margin-top:.4rem;font-size:.75rem;opacity:.7}.report-link a{flex:0 0 auto;padding:1rem;color:#111;background:var(--green);box-shadow:4px 4px 0 #111;font-size:.65rem;font-weight:850;text-transform:uppercase}.report-pages{display:grid;grid-template-columns:1fr 1fr;margin-top:2rem;border-top:1px solid}.report-pages li{display:grid;grid-template-columns:2rem 1fr;gap:.5rem;padding:1rem;border-bottom:1px solid;font-size:.75rem}.report-pages li:nth-child(odd){border-right:1px solid}.report-pages span{color:var(--orange);font-weight:850}.review-grid{grid-template-columns:repeat(3,1fr)}.review-grid article>span{color:var(--orange);font-size:.58rem;font-weight:850}.review-grid h3{margin:2rem 0 1rem}.review-grid p{font-size:.76rem;line-height:1.5}.expansion-grid,.growth-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.expansion-grid article,.growth-grid article{min-height:250px;padding:1.3rem;border:2px solid}.expansion-grid article>span,.growth-grid span{color:var(--orange);font-size:.58rem;font-weight:850}.expansion-grid h3,.growth-grid h3{margin:2.5rem 0 .7rem;font-size:1.55rem;font-weight:850}.expansion-grid p,.growth-grid p{font-size:.75rem;line-height:1.55}.expansion-grid small{display:block;margin-top:1rem;font-size:.58rem;opacity:.6}.expansion-grid .featured{color:#111;background:var(--green);border-color:#111;box-shadow:6px 6px 0 #111}.concierge-check,.weekly-cadence{margin-top:2rem;padding:1.5rem;color:#fff;background:#111}.concierge-check li{border-color:#ffffff45}.growth-grid article{min-height:220px}.weekly-cadence>div{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1rem}.weekly-cadence label{display:flex;justify-content:space-between;align-items:center;gap:.5rem;padding:.7rem;border:1px solid #ffffff45;font-size:.65rem;text-transform:uppercase}.weekly-cadence input{width:4rem;border:0;border-bottom:1px solid #fff;border-radius:0;background:transparent;color:#fff;text-align:right}
  @media(max-width:760px){.shell{width:min(100% - 28px,1180px)}.probe-grid,.review-grid,.expansion-grid,.growth-grid,.weekly-cadence>div{grid-template-columns:1fr}.report-link{align-items:start;flex-direction:column}.report-pages{grid-template-columns:1fr}.report-pages li:nth-child(odd){border-right:0}.section-title{grid-template-columns:2rem 1fr}.ops-header h1{font-size:clamp(3.7rem,17vw,6rem)}}
</style>

<!-- Uses the shared site tokens in global.css. Keep future internal pages on this system. -->
<style>
  :global(body) { background: var(--site-bg); }

  .ops-page {
    --ink: var(--site-ink);
    --paper: var(--site-bg);
    --orange: var(--site-accent);
    --green: var(--site-accent);
    color: var(--site-ink);
    background: var(--site-bg);
  }

  .shell { width: min(calc(100% - 2.5rem), 72rem); }
  .ops-header { padding: 5rem 0 4rem; }
  .ops-header > p,
  .section-title p { color: var(--site-muted); font-size: .75rem; font-weight: 600; letter-spacing: .14em; }
  .ops-header h1,
  .section-title h2,
  .ops-page h3 { text-transform: none; }
  .ops-header h1 { max-width: 58rem; margin: 1.25rem 0 3rem; font-size: clamp(3.5rem, 8vw, 7rem); font-weight: 650; line-height: .95; letter-spacing: -.055em; }
  .ops-header h1 em { display: inline; color: inherit; font-style: normal; }
  .ops-header h1 em::after { display: inline-block; width: .28em; height: .28em; margin-left: .12em; border-radius: 999px; background: var(--site-accent); content: ""; vertical-align: .13em; }
  .ops-header > div { gap: .75rem 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--site-line); }
  .ops-header > div span { color: var(--site-muted); font-size: .7rem; font-weight: 600; }
  .ops-header > div strong { font-size: .8rem; font-weight: 600; text-transform: none; }

  .jump-nav { top: 0; gap: 0; width: 100%; padding: 0 max(1.25rem, calc((100% - 72rem) / 2)); border-block: 1px solid var(--site-line); background: color-mix(in srgb, var(--site-bg) 94%, transparent); }
  .jump-nav a { padding: 1rem .9rem; border-right: 1px solid var(--site-line); color: var(--site-muted); background: transparent; font-size: .7rem; font-weight: 600; }
  .jump-nav a:first-child { border-left: 1px solid var(--site-line); }
  .jump-nav a:hover { color: var(--site-ink); background: color-mix(in srgb, var(--site-accent) 28%, transparent); }

  .ops-page main > section { padding: 5rem 0; border-top: 1px solid var(--site-line); }
  .section-title { grid-template-columns: 2.5rem 1fr; gap: 1.25rem; margin-bottom: 2.5rem; }
  .section-title > span { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: 999px; color: #12161d; background: var(--site-accent); font-size: .7rem; font-weight: 700; }
  .section-title h2 { margin-top: .5rem; font-size: clamp(2.4rem, 5vw, 4.5rem); font-weight: 650; line-height: 1; letter-spacing: -.04em; }

  .pipeline,
  .question-list,
  .report-pages { border-color: var(--site-line); }
  .pipeline li,
  .question-list li,
  .report-pages li { border-color: var(--site-line); }
  .pipeline li > span,
  .question-list span,
  .report-pages span,
  .review-grid article > span,
  .expansion-grid article > span,
  .growth-grid span { color: var(--site-muted); }
  .pipeline strong { font-size: 1.25rem; font-weight: 650; text-transform: none; }
  .pipeline small { color: var(--site-muted); font-size: .7rem; font-weight: 600; }
  .pipeline p { color: var(--site-muted); font-size: .9rem; line-height: 1.6; }
  .pipeline input,
  .qa-list input { color: #12161d; accent-color: var(--site-accent); }

  .callout { padding: 1.25rem; border: 0; color: #12161d; background: var(--site-accent); font-size: .9rem; line-height: 1.6; }
  .question-list p { font-size: 1.2rem; font-weight: 600; line-height: 1.4; text-transform: none; }

  .probe-grid article,
  .review-grid article,
  .qa-list,
  .expansion-grid article,
  .growth-grid article { border: 1px solid var(--site-line); background: var(--site-surface); }
  .probe-grid h3,
  .review-grid h3,
  .qa-list h3,
  .concierge-check h3,
  .weekly-cadence h3 { font-size: 1.3rem; font-weight: 650; }
  .probe-grid li,
  .review-grid li,
  .concierge-check li { border-color: var(--site-line); color: var(--site-muted); font-size: .85rem; line-height: 1.5; }

  .prompt-block { border: 1px solid var(--site-line); color: #fafafa; background: #12161d; }
  .prompt-block button { color: #12161d; background: var(--site-accent); font-size: .7rem; font-weight: 700; }
  .prompt-block pre { font-size: .8rem; line-height: 1.7; }
  .qa-list label { color: var(--site-muted); font-size: .85rem; line-height: 1.5; }

  .report-link { padding: 2rem; color: #fafafa; background: #12161d; }
  .report-link strong { font-size: 1.75rem; font-weight: 650; text-transform: none; }
  .report-link p { font-size: .85rem; }
  .report-link a { padding: 1rem 1.25rem; box-shadow: none; color: #12161d; background: var(--site-accent); font-size: .75rem; font-weight: 700; }
  .report-pages li { font-size: .85rem; line-height: 1.5; }

  .review-grid h3,
  .expansion-grid h3,
  .growth-grid h3 { margin: 2rem 0 .75rem; font-size: 1.4rem; font-weight: 650; }
  .review-grid p,
  .expansion-grid p,
  .growth-grid p { color: var(--site-muted); font-size: .85rem; line-height: 1.6; }
  .expansion-grid article,
  .growth-grid article { min-height: 220px; }
  .expansion-grid .featured { border: 0; box-shadow: none; color: #12161d; background: var(--site-accent); }
  .expansion-grid .featured p { color: rgb(18 22 29 / 70%); }

  .concierge-check,
  .weekly-cadence { color: #fafafa; background: #12161d; }
  .weekly-cadence label { border-color: rgb(255 255 255 / 18%); font-size: .7rem; }

  @media (max-width: 760px) {
    .shell { width: min(calc(100% - 2rem), 72rem); }
    .ops-header { padding-block: 3.5rem 3rem; }
    .ops-header h1 { font-size: clamp(3rem, 15vw, 5rem); }
    .jump-nav { padding-inline: 1rem; }
    .ops-page main > section { padding-block: 4rem; }
  }
</style>
