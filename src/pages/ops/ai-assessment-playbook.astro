---
import BaseLayout from "@/layouts/BaseLayout.astro";

const discoveryQuestions = [
  "Walk me through yesterday from the moment you started work.",
  "Which tasks do you dread doing—even when they are not difficult?",
  "Where does work pile up, wait for approval, or get handed off badly?",
  "What have you tried to automate or delegate before? Why did it fail?",
  "If you could wave a magic wand and delete one process, what would it be?",
  "Which questions, emails, or documents do you create over and over?",
  "Where do you copy the same information between tools?",
  "What work still depends entirely on you?",
];

const acquisition = [
  ["Existing network", "List 50 Raleigh business owners, operators, vendors, and former colleagues. Send ten personal notes each week."],
  ["Cold outreach", "Research one visible workflow problem before contacting a business. Offer one useful observation, not a generic AI pitch."],
  ["Door knocking", "Visit owner-led local businesses with a one-page explanation and a relevant example for their industry."],
  ["Referral partners", "Build reciprocal relationships with accountants, MSPs, fractional operators, agencies, and business brokers."],
  ["Workshops", "Run a practical, co-branded AI session with a coworking space, chamber, trade group, or referral partner."],
  ["AI office hours", "Host free monthly office hours. Answer real questions, record patterns, and invite qualified owners to an assessment."],
  ["Post the wins", "Publish one useful answer, prompt, workflow, or anonymized result at a time. Build a Raleigh-specific body of proof."],
];
---

<BaseLayout pageTitle="AI Assessment Operations Playbook" pageDescription="Internal fulfillment and growth playbook for Danny Sullivan's AI Tools Assessment." noindex>
  <div class="ops-page">
    <header class="ops-header shell">
      <a href="/ops/" class="mb-8 inline-flex items-center text-xs font-medium uppercase tracking-wide text-base-500 transition hover:text-black dark:text-base-400 dark:hover:text-white">← Operations dashboard</a>
      <p>Internal operations · Noindex</p>
      <h1>AI Tools Assessment<br /><em>field manual.</em></h1>
      <div><span>Offer</span><strong>$999</strong><span>Guarantee</span><strong>5+ hours/week</strong><span>Ideal client</span><strong>Raleigh · 2–20 employees</strong></div>
    </header>

    <nav class="jump-nav shell" aria-label="Playbook sections">
      <a href="#pipeline">Pipeline</a><a href="#discovery">Discovery</a><a href="#analysis">Analysis</a><a href="#report">Report</a><a href="#review">Review</a><a href="#expansion">Expansion</a><a href="#growth">Growth</a>
    </nav>

    <main class="shell">
      <section id="pipeline">
        <div class="section-title"><span>01</span><div><p>Operating sequence</p><h2>One client. Four phases.</h2></div></div>
        <ol class="pipeline">
          <li><span>01</span><div><strong>Discovery call</strong><small>45 minutes · recorded and transcribed</small><p>Probe for pain. Do not prescribe yet.</p></div><input type="checkbox" aria-label="Discovery complete" /></li>
          <li><span>02</span><div><strong>AI analysis + research</strong><small>60–90 minutes internal</small><p>Extract bottlenecks, research tools, verify fit, and quantify time.</p></div><input type="checkbox" aria-label="Analysis complete" /></li>
          <li><span>03</span><div><strong>Assessment report</strong><small>Use the printable template</small><p>Package the quick wins, recommendations, four-day plan, and ROI.</p></div><input type="checkbox" aria-label="Report complete" /></li>
          <li><span>04</span><div><strong>Review call</strong><small>30 minutes · report sent in advance</small><p>Walk through the prescription and ask the three closing questions.</p></div><input type="checkbox" aria-label="Review complete" /></li>
        </ol>
      </section>

      <section id="discovery">
        <div class="section-title"><span>02</span><div><p>Phase one</p><h2>Discovery script.</h2></div></div>
        <div class="callout"><strong>Rule:</strong> Ask, probe, and quantify. Do not solve the problem live. Record only with explicit consent.</div>
        <ol class="question-list">{discoveryQuestions.map((question, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{question}</p></li>)}</ol>
        <div class="probe-grid">
          <article><h3>For every pain point, ask:</h3><ul><li>How often does this happen?</li><li>Who touches it?</li><li>How long does it take?</li><li>What happens when it is late or wrong?</li><li>Where does the source information live?</li></ul></article>
          <article><h3>Before ending, confirm:</h3><ul><li>The top two pain points in their words</li><li>Current tools and constraints</li><li>Hourly value or cost assumption</li><li>Who can approve a tool</li><li>Review call date</li></ul></article>
        </div>
      </section>

      <section id="analysis">
        <div class="section-title"><span>03</span><div><p>Phase two</p><h2>Analysis prompt.</h2></div></div>
        <div class="prompt-block">
          <button type="button" data-copy="#analysis-prompt">Copy prompt</button>
          <pre id="analysis-prompt">You are analyzing a discovery-call transcript for a small-business AI Tools Assessment.

Business context:
- Company: [COMPANY]
- Industry: [INDUSTRY]
- Team size: [TEAM SIZE]
- Current tools: [TOOLS]
- Constraints: [BUDGET / SECURITY / ADOPTION]

Read the attached transcript and:
1. Identify every repeated, manual, slow, error-prone, or owner-dependent workflow.
2. Quote or closely paraphrase the evidence for each pain point.
3. Estimate current weekly time using only transcript evidence. Mark assumptions clearly.
4. Research off-the-shelf software or AI tools that fit this specific business size and tool stack.
5. For each candidate, provide price, setup effort, integrations, privacy considerations, and source links.
6. Rank options by impact and effort. Prefer simple tools the client can use immediately.
7. Recommend 3–7 tools or workflows that together create at least five credible hours of weekly opportunity.
8. Reject enterprise-scale, fragile, duplicative, or unjustifiably expensive solutions.
9. Produce a four-day plan requiring no more than ten minutes per day.
10. Calculate monthly value using documented time estimates and the agreed hourly-value assumption.

Do not invent savings, features, prices, or integrations. Flag anything that requires human verification.</pre>
        </div>
        <div class="qa-list"><h3>Human QA before the report</h3><label><input type="checkbox" />Every tool still exists and is actively supported.</label><label><input type="checkbox" />Pricing and plan limits were checked at the primary source.</label><label><input type="checkbox" />The tool fits a 2–20 person team.</label><label><input type="checkbox" />Security and data-handling risks are named.</label><label><input type="checkbox" />No two recommendations solve the same problem unnecessarily.</label><label><input type="checkbox" />Every savings estimate traces back to the call.</label><label><input type="checkbox" />The total credible opportunity is at least five hours/week—or issue the refund.</label></div>
      </section>

      <section id="report">
        <div class="section-title"><span>04</span><div><p>Phase three</p><h2>Build the report.</h2></div></div>
        <div class="report-link"><div><strong>Six-page client template</strong><p>Fill it in, print it to PDF, and send it before the review call.</p></div><a href="/ops/assessment-report-template/">Open report builder <span>↗</span></a></div>
        <ol class="report-pages"><li><span>01</span>Cover: client, date, business type, primary focus</li><li><span>02</span>Executive summary + effort/impact matrix</li><li><span>03</span>Three to seven recommendations</li><li><span>04</span>Four-day quick-start plan</li><li><span>05</span>Financial impact and calculation assumptions</li><li><span>06</span>Next steps and review-call decisions</li></ol>
      </section>

      <section id="review">
        <div class="section-title"><span>05</span><div><p>Phase four</p><h2>Review and close.</h2></div></div>
        <div class="review-grid">
          <article><span>BEFORE</span><h3>Send the report early.</h3><p>Give the client enough time to scan it. Open the call by restating the two pains and the total opportunity.</p></article>
          <article><span>DURING</span><h3>Walk through the logic.</h3><p>For each item: “You told me X. I recommend Y because Z. Here is the first step and the expected impact.”</p></article>
          <article><span>AFTER</span><h3>Ask three questions.</h3><ol><li>Which recommendation feels most urgent?</li><li>Do you want to do this yourself or would you like my help?</li><li>What is your timeline?</li></ol></article>
        </div>
      </section>

      <section id="expansion">
        <div class="section-title"><span>06</span><div><p>Expansion menu</p><h2>$999 is the door.</h2></div></div>
        <div class="expansion-grid">
          <article><span>01</span><h3>Process redesign</h3><p>Map the current process, remove waste, and deliver a future-state blueprint before automating.</p><small>Podcast reference: $3K–$3.5K</small></article>
          <article><span>02</span><h3>Simple automation</h3><p>Build a narrow, reliable Zapier, Make, or n8n flow with a clear input and output.</p><small>Podcast example: $1.5K</small></article>
          <article><span>03</span><h3>Knowledge system</h3><p>Turn trusted company information into a searchable, governed assistant for staff or customers.</p></article>
          <article><span>04</span><h3>Custom workflow</h3><p>Build and document a company-specific AI skill, reference set, and team workflow.</p></article>
          <article><span>05</span><h3>Team training</h3><p>Train the team on the recommended tools, responsible usage, and the exact workflows chosen.</p></article>
          <article class="featured"><span>06 · RECOMMENDED</span><h3>AI concierge</h3><p>Two 45-minute working sessions each month, async questions, and a visible inventory of completed improvements.</p><small>Use AOA: Audit → Optimize → Automate</small></article>
        </div>
        <div class="concierge-check"><h3>Concierge onboarding</h3><ol><li>Define the specific 90-day win.</li><li>Connect tools and create context files.</li><li>Set global instructions and safe-use rules.</li><li>Demonstrate scheduled tasks and reusable skills.</li><li>Maintain a client hub of every completed improvement.</li></ol></div>
      </section>

      <section id="growth">
        <div class="section-title"><span>07</span><div><p>Client acquisition</p><h2>Become Raleigh’s AI guy.</h2></div></div>
        <div class="growth-grid">{acquisition.map(([title, body], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
        <div class="weekly-cadence"><h3>Simple weekly scorecard</h3><div><label>Personal outreach <input type="number" min="0" placeholder="10" /></label><label>Cold/local outreach <input type="number" min="0" placeholder="10" /></label><label>Partner follow-ups <input type="number" min="0" placeholder="5" /></label><label>Useful public posts <input type="number" min="0" placeholder="3" /></label><label>Office hours/workshops <input type="number" min="0" placeholder="1" /></label><label>Assessments sold <input type="number" min="0" placeholder="1" /></label></div></div>
      </section>
    </main>
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const target = document.querySelector(button.dataset.copy || "");
        if (!target) return;
        await navigator.clipboard.writeText(target.textContent || "");
        button.textContent = "Copied";
        window.setTimeout(() => (button.textContent = "Copy prompt"), 1500);
      });
    });
  </script>
</BaseLayout>

<style>
