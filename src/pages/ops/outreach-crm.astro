---
import OpsShell from "@/components/ops/OpsShell.astro";
import { realtorProspects } from "@/data/realtorProspects";

const seedJson = JSON.stringify(realtorProspects).replaceAll("<", "\\u003c");
---

<OpsShell
  title="Realtor Outreach"
  description="A focused Raleigh pipeline for finding one painful workflow, earning a reply, and turning the right conversation into a useful free build."
  eyebrow="Growth · Free automation pipeline"
  current="outreach"
>
  <script id="seed-contacts" type="application/json" set:html={seedJson}></script>

  <section class="crm-status" aria-labelledby="crm-status-title">
    <div>
      <p>Next-action queue</p>
      <h2 id="crm-status-title"><span id="attention-count">0</span> people are ready for a move.</h2>
    </div>
    <p id="pipeline-summary">Loading the Raleigh realtor pipeline…</p>
  </section>

  <section class="crm-scoreboard" aria-label="Outreach scoreboard">
    <article><span>Priority targets</span><strong id="priority-count">0</strong><p>Fit score 88+</p></article>
    <article><span>DMs sent</span><strong id="sent-count">0</strong><p>Target: 5 / week</p></article>
    <article><span>Replies</span><strong id="reply-count">0</strong><p>Useful pain named</p></article>
    <article><span>Free builds</span><strong id="build-count">0</strong><p>One at a time</p></article>
  </section>

  <details class="outreach-playbook">
    <summary><span>Outreach playbook</span><strong>Who to contact, what to send, and when to build</strong></summary>
    <div class="playbook-grid">
      <article>
        <p>01 · Target</p>
        <h2>Founder-led teams with visible repetition.</h2>
        <ul>
          <li>3–15 agents or a small operating team</li>
          <li>Active listings, content, reviews, or hiring</li>
          <li>Team leader still close to day-to-day work</li>
          <li>Enough volume to repeat; small enough to decide</li>
        </ul>
      </article>
      <article class="pitch-card">
        <div><p>02 · Connection DM</p><button type="button" data-copy-target="dm-copy">Copy</button></div>
        <blockquote id="dm-copy">Hi [First name]—thanks for connecting. I noticed [specific observation about their team]. Quick, genuine cold pitch: I build AI automations used in startup workflows that support millions in GMV, and I’m spending time with Raleigh business owners to learn which repetitive work is actually worth removing. In real estate, what’s one task you wish were already handled every week—lead follow-up, listing prep, client updates, admin, or something else? If one comes to mind, I’d be happy to build a small version for free. No catch—I’m looking for a real workflow and honest feedback on whether the result is useful.</blockquote>
      </article>
      <article>
        <p>03 · Cadence</p>
        <ol><li><strong>Day 0</strong> Connect with a real observation.</li><li><strong>Day 1</strong> Send the question-led DM.</li><li><strong>Day 5</strong> Offer 2–3 examples, not “checking in.”</li><li><strong>Day 12</strong> Close the loop politely.</li></ol>
      </article>
      <article>
        <p>04 · Free-build gate</p>
        <h2>Build only when the workflow is narrow.</h2>
        <ul><li>Occurs at least weekly</li><li>Has a clear input and output</li><li>Can be tested without sensitive client data</li><li>Has one owner and a 7-day validation path</li></ul>
      </article>
    </div>
  </details>

  <section class="crm-controls" aria-label="CRM controls">
    <label class="crm-search">
      <span>Find a contact</span>
      <input id="contact-search" type="search" placeholder="Name, company, email…" autocomplete="off" />
    </label>
    <label>
      <span>Show</span>
      <select id="status-filter">
        <option value="all">All statuses</option>
        <option value="Research">Research</option>
        <option value="Ready to DM">Ready to DM</option>
        <option value="Connected">Connected</option>
        <option value="DM sent">DM sent</option>
        <option value="Follow-up due">Follow-up due</option>
        <option value="Replied">Replied</option>
        <option value="Discovery booked">Discovery booked</option>
        <option value="Free build">Free build</option>
        <option value="Nurture">Nurture</option>
        <option value="Not a fit">Not a fit</option>
      </select>
    </label>
    <div class="crm-actions">
      <button id="add-contact" type="button" class="secondary-action">Add contact</button>
      <button id="import-contacts" type="button" class="secondary-action">Import</button>
      <button id="export-contacts" type="button" class="primary-action">Export CSV</button>
    </div>
  </section>

  <p class="local-note"><span></span>Saved only in this browser. Nothing is sent to a server.</p>

  <section class="crm-ledger" aria-labelledby="ledger-title">
    <header>
      <div><p>Relationship ledger</p><h2 id="ledger-title">People and next moves.</h2></div>
      <span id="visible-count">0 contacts</span>
    </header>
    <div class="ledger-head" aria-hidden="true">
      <span>Contact</span><span>Fit</span><span>Status</span><span>Next move</span><span></span>
    </div>
    <div id="contact-list" class="contact-list"></div>
    <div id="empty-state" class="empty-state">
      <span>00</span>
      <div><strong>No contacts here yet.</strong><p>Add one manually or import the outreach you have already sent.</p></div>
    </div>
  </section>

  <dialog id="contact-dialog" class="crm-dialog">
    <form id="contact-form" method="dialog">
      <header><div><p>New relationship</p><h2>Add a contact</h2></div><button type="button" data-close-dialog aria-label="Close">×</button></header>
      <div class="form-grid">
        <label><span>Organization *</span><input name="organization" required autocomplete="organization" /></label>
        <label><span>Contact name *</span><input name="name" required autocomplete="name" /></label>
        <label><span>Role</span><input name="role" autocomplete="organization-title" /></label>
        <label><span>Email</span><input name="email" type="email" autocomplete="email" /></label>
        <label><span>LinkedIn URL</span><input name="linkedinUrl" type="url" placeholder="https://linkedin.com/in/…" /></label>
        <label><span>Fit score</span><input name="fitScore" type="number" min="0" max="100" value="70" /></label>
        <label class="span-two"><span>Personalization hook</span><textarea name="personalization" rows="3" placeholder="The specific observation that earns the DM…"></textarea></label>
        <label class="span-two"><span>Automation hypothesis</span><textarea name="automationIdea" rows="3" placeholder="A narrow workflow worth asking about—not a promised solution…"></textarea></label>
        <label class="span-two"><span>Notes</span><textarea name="notes" rows="4" placeholder="Context, source, or what to remember next time…"></textarea></label>
      </div>
      <footer><button type="button" data-close-dialog class="secondary-action">Cancel</button><button type="submit" class="primary-action">Add to pipeline</button></footer>
    </form>
  </dialog>

  <dialog id="import-dialog" class="crm-dialog import-dialog">
    <form id="import-form" method="dialog">
      <header><div><p>Private browser data</p><h2>Import contacts</h2></div><button type="button" data-close-import aria-label="Close">×</button></header>
      <p class="dialog-intro">Paste a JSON array. Imported prospects are merged by LinkedIn URL, email, or organization and name.</p>
      <label class="import-field"><span>Contact JSON</span><textarea id="import-json" rows="12" spellcheck="false" placeholder='[{"organization":"Example Realty","name":"Alex Rivera","email":"alex@example.com"}]'></textarea></label>
      <p id="import-error" class="import-error" role="alert"></p>
      <footer><button type="button" data-close-import class="secondary-action">Cancel</button><button type="submit" class="primary-action">Import and merge</button></footer>
    </form>
  </dialog>

  <div id="save-toast" class="save-toast" role="status" aria-live="polite">Saved in this browser</div>
</OpsShell>

<script>
  type ContactStatus = "Research" | "Ready to DM" | "Connected" | "DM sent" | "Follow-up due" | "Replied" | "Discovery booked" | "Free build" | "Nurture" | "Not a fit";
  type Contact = {
    id: string;
    organization: string;
    name: string;
    role: string;
    email: string;
    linkedinUrl: string;
    websiteUrl: string;
    sourceUrl: string;
    status: ContactStatus;
    fitScore: number;
    segment: string;
    lastContact: string;
    nextFollowUp: string;
    personalization: string;
    automationIdea: string;
    notes: string;
  };

  const storageKey = "ops:realtor-outreach:v2";
  const legacyStorageKey = "ops:outreach-crm:v1";
  const statuses: ContactStatus[] = ["Research", "Ready to DM", "Connected", "DM sent", "Follow-up due", "Replied", "Discovery booked", "Free build", "Nurture", "Not a fit"];
  const list = document.querySelector<HTMLDivElement>("#contact-list")!;
  const emptyState = document.querySelector<HTMLDivElement>("#empty-state")!;
  const searchInput = document.querySelector<HTMLInputElement>("#contact-search")!;
  const statusFilter = document.querySelector<HTMLSelectElement>("#status-filter")!;
  const contactDialog = document.querySelector<HTMLDialogElement>("#contact-dialog")!;
  const importDialog = document.querySelector<HTMLDialogElement>("#import-dialog")!;
  const contactForm = document.querySelector<HTMLFormElement>("#contact-form")!;
  const importForm = document.querySelector<HTMLFormElement>("#import-form")!;
  const importJson = document.querySelector<HTMLTextAreaElement>("#import-json")!;
  const importError = document.querySelector<HTMLParagraphElement>("#import-error")!;
  const toast = document.querySelector<HTMLDivElement>("#save-toast")!;
  let contacts: Contact[] = loadContacts();
  let toastTimer = 0;

  function loadContacts(): Contact[] {
    try {
      const stored = window.localStorage.getItem(storageKey);
      if (stored) return JSON.parse(stored).map(normalizeContact);
      const legacy = window.localStorage.getItem(legacyStorageKey);
      if (legacy) return JSON.parse(legacy).map(normalizeContact);
      const seed = document.querySelector<HTMLScriptElement>("#seed-contacts")?.textContent || "[]";
      return JSON.parse(seed).map(normalizeContact);
    } catch {
      return [];
    }
  }

  function makeId() {
    return typeof crypto.randomUUID === "function" ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(16).slice(2)}`;
  }

  function normalizeContact(value: Partial<Contact>): Contact {
    const legacyStatus = String(value.status || "");
    const mappedStatus = legacyStatus === "Emailed" ? "DM sent" : legacyStatus === "Meeting booked" ? "Discovery booked" : legacyStatus;
    const status = statuses.includes(mappedStatus as ContactStatus) ? mappedStatus as ContactStatus : "Research";
    return {
      id: value.id || makeId(),
      organization: String(value.organization || "").trim(),
      name: String(value.name || "").trim(),
      role: String(value.role || "").trim(),
      email: String(value.email || "").trim(),
      linkedinUrl: String(value.linkedinUrl || "").trim(),
      websiteUrl: String(value.websiteUrl || "").trim(),
      sourceUrl: String(value.sourceUrl || "").trim(),
      status,
      fitScore: Math.min(100, Math.max(0, Number(value.fitScore || 0))),
      segment: String(value.segment || "Unclassified").trim(),
      lastContact: String(value.lastContact || ""),
      nextFollowUp: String(value.nextFollowUp || ""),
      personalization: String(value.personalization || "").trim(),
      automationIdea: String(value.automationIdea || "").trim(),
      notes: String(value.notes || "").trim(),
    };
  }

  function mergeContacts(values: Partial<Contact>[]) {
    const incoming = values.map(normalizeContact).filter((contact) => contact.organization && contact.name);
    incoming.forEach((contact) => {
      const existingIndex = contacts.findIndex((item) =>
        (contact.linkedinUrl && item.linkedinUrl.toLowerCase() === contact.linkedinUrl.toLowerCase()) ||
        (contact.email && item.email.toLowerCase() === contact.email.toLowerCase()) ||
        (!contact.email && item.organization.toLowerCase() === contact.organization.toLowerCase() && item.name.toLowerCase() === contact.name.toLowerCase())
      );
      if (existingIndex >= 0) contacts[existingIndex] = { ...contacts[existingIndex], ...contact, id: contacts[existingIndex].id };
      else contacts.push(contact);
    });
    return incoming.length;
  }

  function importFromPrivateHash() {
    const prefix = "#contacts=";
    if (!window.location.hash.startsWith(prefix)) return;
    try {
      const encoded = window.location.hash.slice(prefix.length);
      const bytes = Uint8Array.from(window.atob(encoded), (character) => character.charCodeAt(0));
      const parsed = JSON.parse(new TextDecoder().decode(bytes));
      if (Array.isArray(parsed) && mergeContacts(parsed)) {
        window.localStorage.setItem(storageKey, JSON.stringify(contacts));
      }
    } catch {
      // Leave the existing browser-local records untouched if the private import is malformed.
    } finally {
      window.history.replaceState(null, "", `${window.location.pathname}${window.location.search}`);
    }
  }

  function saveContacts(message = "Saved in this browser") {
    window.localStorage.setItem(storageKey, JSON.stringify(contacts));
    toast.textContent = message;
    toast.classList.add("visible");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove("visible"), 1500);
    render();
  }

  function escapeHtml(value: string) {
    const element = document.createElement("span");
    element.textContent = value;
    return element.innerHTML;
  }

  function formatDate(value: string) {
    if (!value) return "Not set";
    return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(new Date(`${value}T00:00:00Z`));
  }

  function isDue(contact: Contact) {
    if (!contact.nextFollowUp || ["Discovery booked", "Free build", "Not a fit"].includes(contact.status)) return false;
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    return new Date(`${contact.nextFollowUp}T00:00:00`) <= today;
  }

  function filteredContacts() {
    const query = searchInput.value.trim().toLowerCase();
    return contacts
      .filter((contact) => statusFilter.value === "all" || contact.status === statusFilter.value)
      .filter((contact) => !query || [contact.name, contact.organization, contact.email, contact.role, contact.notes].join(" ").toLowerCase().includes(query))
      .sort((a, b) => {
        const actionRank = (contact: Contact) => isDue(contact) ? 0 : contact.status === "Ready to DM" ? 1 : contact.status === "Research" ? 2 : 3;
        const rankDifference = actionRank(a) - actionRank(b);
        if (rankDifference) return rankDifference;
        const aDate = a.nextFollowUp || "9999-12-31";
        const bDate = b.nextFollowUp || "9999-12-31";
        return aDate.localeCompare(bDate) || b.fitScore - a.fitScore || a.organization.localeCompare(b.organization);
      });
  }

  function render() {
    const visible = filteredContacts();
    const due = contacts.filter(isDue).length;
    const ready = contacts.filter((contact) => contact.status === "Ready to DM").length;
    const replies = contacts.filter((contact) => ["Replied", "Discovery booked", "Free build"].includes(contact.status)).length;
    const meetings = contacts.filter((contact) => contact.status === "Discovery booked").length;
    const sent = contacts.filter((contact) => ["DM sent", "Follow-up due", "Replied", "Discovery booked", "Free build", "Nurture"].includes(contact.status)).length;
    const builds = contacts.filter((contact) => contact.status === "Free build").length;
    document.querySelector("#attention-count")!.textContent = String(due + ready);
    document.querySelector("#priority-count")!.textContent = String(contacts.filter((contact) => contact.fitScore >= 88 && contact.status !== "Not a fit").length);
    document.querySelector("#sent-count")!.textContent = String(sent);
    document.querySelector("#reply-count")!.textContent = String(replies);
    document.querySelector("#build-count")!.textContent = String(builds);
    document.querySelector("#pipeline-summary")!.textContent = contacts.length
      ? `${contacts.length} targets · ${ready} ready to DM · ${due} follow-ups due · ${meetings} discovery calls`
      : "Add or import contacts to start the pipeline.";
    document.querySelector("#visible-count")!.textContent = `${visible.length} ${visible.length === 1 ? "contact" : "contacts"}`;
    emptyState.hidden = visible.length > 0;

    list.innerHTML = visible.map((contact) => {
      const dueClass = isDue(contact) ? " due" : "";
      const profile = contact.linkedinUrl
        ? `<a class="profile-link" href="${escapeHtml(contact.linkedinUrl)}" target="_blank" rel="noreferrer">Open LinkedIn ↗</a>`
        : `<span class="missing-email">LinkedIn not added</span>`;
      return `
        <article class="contact-row${dueClass}" data-contact-id="${escapeHtml(contact.id)}">
          <div class="contact-identity">
            <span class="contact-initial">${escapeHtml((contact.name || contact.organization).charAt(0).toUpperCase())}</span>
            <div><strong>${escapeHtml(contact.name)}</strong><p>${escapeHtml(contact.organization)}</p><small>${escapeHtml(contact.role)}</small>${profile}</div>
          </div>
          <div class="fit-score" aria-label="Fit score ${contact.fitScore} out of 100"><strong>${contact.fitScore}</strong><span>${escapeHtml(contact.segment)}</span></div>
          <label class="row-field status-field"><span>Status</span><select data-field="status">${statuses.map((status) => `<option value="${status}"${status === contact.status ? " selected" : ""}>${status}</option>`).join("")}</select></label>
          <label class="row-field${dueClass}"><span>Next move</span><input data-field="nextFollowUp" type="date" value="${escapeHtml(contact.nextFollowUp)}" /><small>${contact.status === "Ready to DM" ? "Send personalized DM" : isDue(contact) ? "Follow up now" : formatDate(contact.nextFollowUp)}</small></label>
          <details class="contact-more">
            <summary>Brief</summary>
            <div>
              <label><span>Role</span><input data-field="role" value="${escapeHtml(contact.role)}" /></label>
              <label><span>Email</span><input data-field="email" type="email" value="${escapeHtml(contact.email)}" /></label>
              <label><span>LinkedIn</span><input data-field="linkedinUrl" type="url" value="${escapeHtml(contact.linkedinUrl)}" /></label>
              <label><span>Fit score</span><input data-field="fitScore" type="number" min="0" max="100" value="${contact.fitScore}" /></label>
              <label class="notes-field"><span>Personalization hook</span><textarea data-field="personalization" rows="3">${escapeHtml(contact.personalization)}</textarea></label>
              <label class="notes-field"><span>Automation hypothesis</span><textarea data-field="automationIdea" rows="3">${escapeHtml(contact.automationIdea)}</textarea></label>
              <label class="notes-field"><span>Notes</span><textarea data-field="notes" rows="3">${escapeHtml(contact.notes)}</textarea></label>
              ${contact.sourceUrl ? `<a class="source-link" href="${escapeHtml(contact.sourceUrl)}" target="_blank" rel="noreferrer">Verify source ↗</a>` : ""}
              <button type="button" data-archive>Archive as not a fit</button>
            </div>
          </details>
        </article>`;
    }).join("");
  }

  function updateContact(id: string, field: keyof Contact, value: string) {
    const contact = contacts.find((item) => item.id === id);
    if (!contact) return;
    if (field === "fitScore") contact.fitScore = Math.min(100, Math.max(0, Number(value || 0)));
    else (contact[field] as string) = value;
    if (field === "status" && value === "DM sent") {
      const touched = new Date();
      const followUp = new Date(touched);
      followUp.setDate(followUp.getDate() + 5);
      contact.lastContact = touched.toISOString().slice(0, 10);
      contact.nextFollowUp = followUp.toISOString().slice(0, 10);
    }
    if (field === "status" && ["Replied", "Discovery booked", "Free build", "Not a fit"].includes(value)) contact.nextFollowUp = "";
    saveContacts();
  }

  list.addEventListener("change", (event) => {
    const target = event.target as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const row = target.closest<HTMLElement>("[data-contact-id]");
    const field = target.dataset.field as keyof Contact | undefined;
    if (row && field) updateContact(row.dataset.contactId!, field, target.value);
  });

  list.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-archive]");
    if (!button) return;
    const row = button.closest<HTMLElement>("[data-contact-id]");
    if (row) updateContact(row.dataset.contactId!, "status", "Not a fit");
  });

  searchInput.addEventListener("input", render);
  statusFilter.addEventListener("change", render);
  document.querySelector("#add-contact")!.addEventListener("click", () => {
    contactForm.reset();
    contactDialog.showModal();
    contactForm.querySelector<HTMLInputElement>("[name='organization']")?.focus();
  });
  document.querySelector("#import-contacts")!.addEventListener("click", () => {
    importError.textContent = "";
    importJson.value = "";
    importDialog.showModal();
    importJson.focus();
  });
  document.querySelectorAll("[data-close-dialog]").forEach((button) => button.addEventListener("click", () => contactDialog.close()));
  document.querySelectorAll("[data-close-import]").forEach((button) => button.addEventListener("click", () => importDialog.close()));

  contactForm.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(contactForm);
    contacts.push(normalizeContact({
      organization: String(data.get("organization") || ""),
      name: String(data.get("name") || ""),
      role: String(data.get("role") || ""),
      email: String(data.get("email") || ""),
      linkedinUrl: String(data.get("linkedinUrl") || ""),
      fitScore: Number(data.get("fitScore") || 70),
      personalization: String(data.get("personalization") || ""),
      automationIdea: String(data.get("automationIdea") || ""),
      notes: String(data.get("notes") || ""),
      status: "Research",
    }));
    contactDialog.close();
    saveContacts("Contact added");
  });

  importForm.addEventListener("submit", (event) => {
    event.preventDefault();
    try {
      const parsed = JSON.parse(importJson.value);
      if (!Array.isArray(parsed)) throw new Error("Paste a JSON array of contacts.");
      const importedCount = mergeContacts(parsed);
      if (!importedCount) throw new Error("No valid contacts were found.");
      importDialog.close();
      saveContacts(`${importedCount} contacts imported`);
    } catch (error) {
      importError.textContent = error instanceof Error ? error.message : "Could not import those contacts.";
    }
  });

  document.querySelector("#export-contacts")!.addEventListener("click", () => {
    const columns: (keyof Contact)[] = ["organization", "name", "role", "email", "linkedinUrl", "websiteUrl", "sourceUrl", "status", "fitScore", "segment", "lastContact", "nextFollowUp", "personalization", "automationIdea", "notes"];
    const quote = (value: string) => `"${value.replaceAll('"', '""')}"`;
    const csv = [columns.join(","), ...contacts.map((contact) => columns.map((column) => quote(String(contact[column] || ""))).join(","))].join("\n");
    const link = document.createElement("a");
    link.href = URL.createObjectURL(new Blob([csv], { type: "text/csv;charset=utf-8" }));
    link.download = `outreach-crm-${new Date().toISOString().slice(0, 10)}.csv`;
    link.click();
    URL.revokeObjectURL(link.href);
  });

  importFromPrivateHash();
  document.querySelectorAll<HTMLButtonElement>("[data-copy-target]").forEach((button) => button.addEventListener("click", async () => {
    const target = document.querySelector<HTMLElement>(`#${button.dataset.copyTarget}`);
    if (!target) return;
    await navigator.clipboard.writeText(target.textContent?.trim() || "");
    button.textContent = "Copied";
    window.setTimeout(() => { button.textContent = "Copy"; }, 1400);
  }));
  render();
</script>

<style is:global>
  .crm-status { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: end; border-block: 1px solid var(--ops-line-strong); padding: 2rem 0; }
  .crm-status > div > p, .crm-ledger > header p { color: var(--ops-deadline); font-size: .62rem; font-weight: 740; letter-spacing: .12em; text-transform: uppercase; }
  .crm-status h2 { margin-top: .5rem; font-family: "Anybody", sans-serif; font-size: clamp(1.7rem, 4vw, 3.1rem); font-weight: 690; line-height: 1; letter-spacing: -.04em; }
  .crm-status h2 span { color: var(--ops-deadline); font-variant-numeric: tabular-nums; }
  .crm-status > p { color: var(--ops-muted); font-size: .75rem; font-variant-numeric: tabular-nums; }

  .crm-scoreboard { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--ops-line-strong); }
  .crm-scoreboard article { min-width: 0; padding: 1.2rem 1.25rem 1.35rem 0; }
  .crm-scoreboard article + article { border-left: 1px solid var(--ops-line); padding-left: 1.25rem; }
  .crm-scoreboard span { display: block; color: var(--ops-faint); font-size: .58rem; font-weight: 720; letter-spacing: .1em; text-transform: uppercase; }
  .crm-scoreboard strong { display: block; margin-top: .45rem; font-family: "Anybody", sans-serif; font-size: 2rem; font-weight: 710; line-height: 1; font-variant-numeric: tabular-nums; }
