---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import profileImage from "../../danny.jpeg";

const work = [
  "AI-assisted products that improve customer decisions",
  "Workflow automations that remove repetitive work",
  "Internal tools for content, marketing, and product teams",
  "Prototypes that make early-stage ideas concrete",
  "Data cleanup, enrichment, and reporting systems",
  "Practical AI education for teams building real things",
];
---

<BaseLayout pageTitle="About Danny Sullivan" pageDescription="Danny Sullivan is a Raleigh-based AI Product Engineer, designer, and builder working across products, automation, content, and growth.">
  <div class="about-page">
    <header class="about-hero shell">
      <div class="hero-copy">
        <p class="kicker"><span></span> About the person making the things</p>
        <h1>Builder by trade.<br /><em>Curious by default.</em></h1>
        <p>I work where product, engineering, content, design, and growth overlap. The best projects usually begin as something vague, slow, disconnected, or harder than it should be.</p>
        <div><a class="button" href="/work-with-me/">Start something <span>↗</span></a><a class="text-link" href="/projects/">See the work ↗</a></div>
      </div>
      <figure>
        <Image src={profileImage} alt="Danny Sullivan" width={615} height={615} loading="eager" />
        <figcaption><strong>DANNY SULLIVAN</strong><span>AI Product Engineer<br />Raleigh, North Carolina</span></figcaption>
        <i>HUMAN, APPARENTLY</i>
      </figure>
    </header>

    <section class="now-section">
      <div class="shell now-grid">
        <div><p class="section-number">01 / RIGHT NOW</p><h2>Building for<br /><em>the live moment.</em></h2></div>
        <div class="now-copy">
          <p>At Gametime, I build AI product systems for live-event discovery. A lot of that work sits around image quality and decision-making: making venues, seats, and event experiences more useful before someone buys.</p>
          <p>Outside of that, I build tools, automations, websites, and prototypes for teams with good problems and imperfect processes.</p>
        </div>
      </div>
    </section>

    <section class="history shell">
      <div class="history-heading"><p class="section-number">02 / PREVIOUSLY ON</p><h2>The slightly<br /><em>nonlinear route.</em></h2></div>
      <ol>
        <li><span>NOW</span><strong>Gametime</strong><p>AI product systems for live-event discovery, venue imagery, and better buying decisions.</p></li>
        <li><span>BEFORE</span><strong>Pluralsight</strong><p>Generative AI education, content strategy, hands-on labs, and internal AI tools for content teams.</p></li>
        <li><span>EARLIER</span><strong>Software & growth</strong><p>Engineering, curriculum, healthcare, media, bootcamp education, marketing, and product work.</p></li>
        <li><span>ORIGIN STORY</span><strong>Baseball & special education</strong><p>Two excellent places to learn quickly, explain clearly, and keep improving the system around people.</p></li>
      </ol>
    </section>

    <section class="work-list">
      <div class="shell">
        <p class="section-number light">03 / GOOD PROBLEMS</p>
        <div class="work-heading"><h2>The kind of work<br /><em>I’ll lose track of time doing.</em></h2><p>Useful, ambiguous, cross-disciplinary work with a clear human on the other side.</p></div>
        <div class="items">{work.map((item,index)=><div><span>0{index+1}</span><strong>{item}</strong></div>)}</div>
      </div>
    </section>

    <section class="about-cta shell"><p>Want to compare notes?</p><a href="/work-with-me/">Tell me what’s stuck. <span>↗</span></a></section>
  </div>
</BaseLayout>

<style>
  .about-page { --ink:#11110f; --paper:#f0ebdd; --blue:#2947ff; --acid:#dcff45; color:var(--ink); overflow:hidden; }
  :global(.dark) .about-page { --ink:#f0ebdd; --paper:#11110f; }
  .shell { width:min(100% - 40px,1320px); margin-inline:auto; }
  .about-hero { min-height:calc(100svh - 90px); display:grid; grid-template-columns:1fr minmax(340px,.55fr); gap:clamp(3rem,8vw,8rem); align-items:center; padding:5rem 0; }
  .kicker,.section-number { display:flex; align-items:center; gap:.75rem; font-size:.67rem; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
  .kicker span { width:2.5rem; height:2px; background:#ff4b36; }
  h1,h2 { font-family:"Anybody"; text-transform:uppercase; }
  h1 { margin:1.5rem 0 2rem; font-size:clamp(4.4rem,8vw,8rem); font-weight:850; line-height:.8; letter-spacing:-.055em; }
  h1 em,h2 em { color:var(--blue); font-style:normal; }
  .hero-copy>p:not(.kicker) { max-width:43rem; font-size:1.05rem; line-height:1.65; }
  .hero-copy>div { display:flex; gap:1.5rem; align-items:center; margin-top:2rem; flex-wrap:wrap; }
  .button { display:flex; gap:3rem; padding:1rem; background:var(--blue); color:white; box-shadow:5px 5px 0 var(--ink); font-size:.7rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .text-link { padding-bottom:.3rem; border-bottom:1px solid currentColor; font-size:.7rem; font-weight:800; text-transform:uppercase; }
  figure { position:relative; padding:1rem; background:#fffdf5; color:#11110f; transform:rotate(2deg); box-shadow:16px 16px 0 #11110f24; }
  figure img { width:100%; aspect-ratio:1; object-fit:cover; filter:grayscale(1) contrast(1.08); }
  figcaption { display:flex; justify-content:space-between; gap:1rem; padding:.8rem .1rem .1rem; }
  figcaption strong { font-family:"Anybody"; font-size:1.6rem; }
  figcaption span { font-size:.58rem; font-weight:700; text-align:right; text-transform:uppercase; }
  figure i { position:absolute; right:-1rem; top:15%; padding:.5rem .8rem; background:var(--acid); font-size:.58rem; font-weight:850; font-style:normal; transform:rotate(5deg); }
  .now-section { padding:clamp(6rem,10vw,10rem) 0; background:var(--blue); color:white; }
  .now-grid { display:grid; grid-template-columns:.8fr 1fr; gap:clamp(4rem,10vw,10rem); }
  h2 { margin-top:1rem; font-size:clamp(3.3rem,7vw,7rem); font-weight:850; line-height:.85; letter-spacing:-.045em; }
  .now-section h2 em { color:var(--acid); }
  .now-copy { align-self:end; max-width:42rem; }
  .now-copy p { font-size:1.05rem; line-height:1.7; }
  .now-copy p+p { margin-top:1.5rem; color:#ffffffb3; }
  .history { display:grid; grid-template-columns:.7fr 1fr; gap:clamp(4rem,10vw,10rem); padding:clamp(7rem,11vw,11rem) 0; }
  .history ol { border-top:2px solid var(--ink); }
  .history li { display:grid; grid-template-columns:5rem .55fr 1fr; gap:1rem; padding:1.5rem 0; border-bottom:1px solid color-mix(in srgb,currentColor 35%,transparent); }
  .history li span { color:var(--blue); font-size:.6rem; font-weight:800; letter-spacing:.1em; }
  .history li strong { font-family:"Anybody"; font-size:1.55rem; text-transform:uppercase; }
  .history li p { font-size:.78rem; line-height:1.5; opacity:.65; }
  .work-list { padding:clamp(6rem,10vw,10rem) 0; background:#101114; color:#f0ebdd; }
  .section-number.light { color:var(--acid); }
  .work-heading { display:grid; grid-template-columns:1fr .3fr; gap:3rem; align-items:end; }
  .work-heading h2 em { color:var(--acid); }
  .work-heading p { color:#96948d; font-size:.8rem; line-height:1.5; }
  .items { margin-top:4rem; border-top:1px solid #ffffff35; }
  .items div { display:grid; grid-template-columns:4rem 1fr; gap:1rem; padding:1.25rem 0; border-bottom:1px solid #ffffff35; }
  .items span { color:#ff4b36; font-size:.65rem; font-weight:800; }
  .items strong { font-family:"Anybody"; font-size:clamp(1.5rem,3vw,3rem); line-height:1; text-transform:uppercase; }
  .about-cta { margin-block:7rem 3rem; padding:clamp(2rem,5vw,5rem); background:var(--blue); color:white; box-shadow:9px 9px 0 var(--ink); }
  .about-cta p { font-size:.7rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .about-cta a { display:block; margin-top:1.5rem; font-family:"Anybody"; font-size:clamp(3rem,7vw,7rem); font-weight:850; line-height:.86; text-transform:uppercase; }
  .about-cta a span { color:var(--acid); }
  @media(max-width:760px){.shell{width:min(100% - 28px,1320px)}.about-hero,.now-grid,.history,.work-heading{grid-template-columns:1fr}.about-hero{min-height:auto}.history li{grid-template-columns:4rem 1fr}.history li p{grid-column:2}.work-heading{gap:1rem}}
</style>
