---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import profileImage from "../../danny.jpeg";

const experience = [
  { label: "Now", title: "AI Product Engineer · Gametime", body: "I build production AI systems for live-event discovery, venue imagery, and the decisions people make before buying a ticket." },
  { label: "Previously", title: "AI education · Pluralsight", body: "For nearly five years, I created hands-on AI and machine-learning education, shaped content strategy, and built internal AI tools for content teams." },
  { label: "Also", title: "Small-business builder", body: "I have built, operated, and sold a Raleigh service business. I understand the difference between an interesting demo and something that earns its keep." },
];

const principles = [
  ["Start with the work", "A useful AI project begins with a real bottleneck, not a favorite tool."],
  ["Prefer the smallest answer", "If ordinary software or a better process solves the problem, that is the recommendation."],
  ["Keep a human accountable", "AI can prepare, organize, research, and draft. Judgment still belongs to someone."],
  ["Measure what changed", "Time saved, response time improved, revenue recovered, or quality increased. Otherwise it is theater."],
];
---

<BaseLayout
  pageTitle="About Danny Sullivan — Raleigh AI Product Engineer"
  pageDescription="Danny Sullivan is a Raleigh-based AI Product Engineer who helps small businesses find practical AI tools, improve workflows, and avoid expensive distractions."
>
  <div class="bg-white text-black dark:bg-base-950 dark:text-white">
    <section class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1fr_22rem] lg:items-center lg:py-28">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-base-500 dark:text-base-400">About Danny Sullivan · Raleigh, NC</p>
        <h1 class="mt-5 max-w-4xl font-sans text-4xl font-semibold leading-[1.04] tracking-[-0.04em] sm:text-6xl lg:text-7xl">I make AI useful for people who have a business to run.</h1>
        <p class="mt-7 max-w-2xl text-base leading-7 text-base-600 dark:text-base-300 sm:text-lg">I’m an AI product engineer, educator, and small-business builder. I help teams find the few AI opportunities worth acting on, choose tools that fit, and turn the useful ones into everyday workflows.</p>
        <div class="mt-8 flex flex-wrap items-center gap-5"><a href="/work-with-me/" class="inline-flex min-h-12 items-center bg-black px-6 text-sm font-medium text-white transition hover:bg-base-800 dark:bg-white dark:text-black">Apply for an AI assessment <span class="ml-3">→</span></a><a href="#experience" class="text-sm text-base-500 hover:text-black dark:text-base-400 dark:hover:text-white">See my experience ↓</a></div>
      </div>
      <figure class="border border-black/10 bg-base-50 p-3 dark:border-white/10 dark:bg-base-900"><Image src={profileImage} alt="Danny Sullivan" width={615} height={615} loading="eager" class="w-full grayscale" /><figcaption class="flex items-end justify-between gap-4 px-2 pb-1 pt-4"><strong class="text-sm font-medium">Danny Sullivan</strong><span class="text-right text-xs leading-5 text-base-500 dark:text-base-400">AI Product Engineer<br />Raleigh, North Carolina</span></figcaption></figure>
    </section>

    <section class="border-y border-black/10 bg-base-50 dark:border-white/10 dark:bg-base-900">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[18rem_1fr] lg:gap-24">
        <div><p class="text-xs font-medium uppercase tracking-wide text-base-500 dark:text-base-400">Why work with me</p><h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight">Technical depth without the technical performance.</h2></div>
        <div class="max-w-2xl space-y-5 text-base leading-7 text-base-600 dark:text-base-300"><p>I work with AI every day, but I do not believe every business needs custom software, an “AI transformation,” or another subscription.</p><p>My job is to understand how your business actually works, recognize where AI has leverage, and explain the recommendation clearly enough that you can make a confident decision. If AI is the wrong answer, I will say so.</p></div>
      </div>
    </section>

    <section id="experience" class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <div class="max-w-2xl"><p class="text-xs font-medium uppercase tracking-wide text-base-500 dark:text-base-400">Experience</p><h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight sm:text-4xl">I have seen AI from three useful angles.</h2></div>
      <div class="mt-12 divide-y divide-black/10 border-y border-black/10 dark:divide-white/10 dark:border-white/10">{experience.map((item) => <article class="grid gap-4 py-7 sm:grid-cols-[8rem_17rem_1fr] sm:gap-8"><span class="text-xs font-medium uppercase tracking-wide text-base-400">{item.label}</span><h3 class="font-sans text-lg font-semibold">{item.title}</h3><p class="max-w-xl text-sm leading-6 text-base-500 dark:text-base-400">{item.body}</p></article>)}</div>
    </section>

    <section class="border-y border-black/10 dark:border-white/10">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <div class="grid gap-10 lg:grid-cols-[18rem_1fr] lg:gap-24"><div><p class="text-xs font-medium uppercase tracking-wide text-base-500 dark:text-base-400">How I work</p><h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight">Practical by default.</h2></div><div class="grid gap-px overflow-hidden border border-black/10 bg-black/10 dark:border-white/10 dark:bg-white/10 sm:grid-cols-2">{principles.map(([title, body]) => <article class="bg-white p-6 dark:bg-base-950"><h3 class="font-sans text-base font-semibold">{title}</h3><p class="mt-3 text-sm leading-6 text-base-500 dark:text-base-400">{body}</p></article>)}</div></div>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-3">
      <article><p class="text-xs font-medium uppercase tracking-wide text-base-400">Start here</p><h2 class="mt-4 font-sans text-2xl font-semibold">AI Tools Assessment</h2><p class="mt-4 text-sm leading-6 text-base-500 dark:text-base-400">A fixed-price assessment that finds 3–7 tools and at least five hours of credible weekly opportunity.</p><a href="/work-with-me/" class="mt-5 inline-block text-sm font-medium">Apply for the assessment →</a></article>
      <article><p class="text-xs font-medium uppercase tracking-wide text-base-400">For teams</p><h2 class="mt-4 font-sans text-2xl font-semibold">Practical AI workshops</h2><p class="mt-4 text-sm leading-6 text-base-500 dark:text-base-400">A plain-English introduction to useful AI workflows, limitations, privacy, and better judgment.</p><a href="/ai-workshops/" class="mt-5 inline-block text-sm font-medium">See the workshop →</a></article>
      <article><p class="text-xs font-medium uppercase tracking-wide text-base-400">After the plan</p><h2 class="mt-4 font-sans text-2xl font-semibold">Implementation help</h2><p class="mt-4 text-sm leading-6 text-base-500 dark:text-base-400">Focused help redesigning a process, building a workflow, or teaching your team to use it well.</p><a href="/work-with-me/" class="mt-5 inline-block text-sm font-medium">Tell me what is stuck →</a></article>
    </section>

    <section class="bg-black text-white dark:bg-white dark:text-black"><div class="mx-auto max-w-3xl px-5 py-20 text-center sm:px-8 sm:py-24"><p class="text-xs font-medium uppercase tracking-wide text-white/50 dark:text-black/50">Based in Raleigh · Working with practical teams</p><h2 class="mt-5 text-balance font-sans text-3xl font-semibold tracking-tight sm:text-5xl">Bring me the process you wish would disappear.</h2><a href="/work-with-me/" class="mt-8 inline-flex min-h-12 items-center bg-[#ddff73] px-6 text-sm font-medium text-black">Apply for an AI assessment <span class="ml-3">→</span></a></div></section>
  </div>
</BaseLayout>
