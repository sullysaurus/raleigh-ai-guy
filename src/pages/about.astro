---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import profileImage from "../../danny.jpeg";

const experience = [
  ["Now", "AI Product Engineer · Gametime", "I build production AI systems for live-event discovery and venue imagery. The work has millions of dollars in GMV riding on it, so usefulness and reliability matter more than a good demo."],
  ["Previously", "AI education · Pluralsight", "For nearly five years, I created hands-on AI and machine-learning training and built internal tools for content teams."],
  ["Before Pluralsight", "Software developer · healthcare, fintech, and media", "I worked as a software developer across companies in healthcare, financial technology, and media, building digital products and learning how different organizations turn complex requirements into dependable software."],
  ["Earlier", "Teacher and professional baseball player", "I taught students with emotional disabilities and played professional baseball in the Tampa Bay Rays organization. Both taught me to prepare carefully, explain clearly, and keep improving."],
  ["Also", "Small-business builder", "I have built, operated, and sold a Raleigh service business. I understand the difference between an interesting idea and something that earns its keep."],
];
---

<BaseLayout
  pageTitle="About Danny Sullivan — Raleigh AI Guy"
  pageDescription="Danny Sullivan helps Raleigh businesses build practical AI systems and improve everyday workflows."
>
  <section>
    <Wrapper class="py-16 sm:py-24 lg:py-32">
      <p class="text-sm font-medium text-base-500">About</p>
      <div class="mt-8 grid gap-10 sm:grid-cols-[1fr_13rem] sm:items-start">
        <div>
          <h1 class="text-4xl font-medium leading-[1.08] tracking-[-0.045em] sm:text-5xl">I make AI useful for people with a business to run.</h1>
          <p class="mt-7 text-lg leading-8 text-base-500">I’m Danny Sullivan, an AI product engineer, educator, and small-business builder based in Raleigh, North Carolina.</p>
        </div>
        <Image src={profileImage} alt="Danny Sullivan" width={400} height={400} loading="eager" class="aspect-square w-full rounded-xl border border-black/10 object-cover grayscale" />
      </div>
    </Wrapper>
  </section>

  <section>
    <Wrapper class="py-12 sm:py-16">
      <div class="border-t border-black/10 pt-3">
        <h2 class="text-sm font-medium">How I work</h2>
        <div class="mt-8 space-y-5 text-base leading-7 text-base-500">
          <p>I start with the work itself: where time gets lost, what repeats, and what customers or employees are waiting on. Then I look for the smallest useful answer.</p>
          <p>Sometimes that answer involves AI. Sometimes ordinary software or a clearer process is better. My job is to tell the difference, build what is worth building, and explain it well enough that your team can use it confidently.</p>
          <p>You work directly with me from the first conversation through implementation. There is no handoff to a junior team.</p>
        </div>
      </div>
    </Wrapper>
  </section>

  <section id="experience">
    <Wrapper class="py-12 sm:py-20">
      <div class="border-t border-black/10 pt-3">
        <h2 class="text-sm font-medium">Experience</h2>
        <div class="mt-8 divide-y divide-black/10 border-y border-black/10">
          {experience.map(([label, title, body]) => (
            <article class="grid gap-3 py-6 sm:grid-cols-[7rem_14rem_1fr] sm:gap-6">
              <span class="text-xs font-medium uppercase tracking-[.08em] text-base-400">{label}</span>
              <h3 class="text-sm font-medium">{title}</h3>
              <p class="text-sm leading-6 text-base-500">{body}</p>
            </article>
          ))}
        </div>
      </div>
    </Wrapper>
  </section>

  <section>
    <Wrapper class="py-16 sm:py-24">
      <div class="border-t border-black/10 pt-8">
        <h2 class="text-3xl font-medium tracking-[-0.035em]">Tell me what is taking too much time.</h2>
        <p class="mt-5 max-w-xl text-base leading-7 text-base-500">I’ll give you an honest read on whether AI is the right tool for it.</p>
        <a href="mailto:hello@raleighaiguy.com" class="mt-7 inline-flex min-h-11 items-center rounded-lg bg-black px-4 text-sm font-medium text-white hover:bg-base-800">Email me</a>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
