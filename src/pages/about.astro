---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import EditorialList from "@/components/global/EditorialList.astro";
import ContactBand from "@/components/global/ContactBand.astro";
import profileImage from "../../danny.jpeg";

const experience = [
  { label: "Now", title: "AI Product Engineer · Gametime", body: "I build production AI systems for live-event discovery and venue imagery, with millions of dollars in GMV riding on their reliability." },
  { label: "Previously", title: "AI and software education · Pluralsight + 2U", body: "I created 28 Pluralsight courses and labs, developed curriculum, and taught software development at 2U." },
  { label: "Growth", title: "Growth marketing · Stash", body: "I worked where messaging, customer journeys, product decisions, and acquisition meet." },
  { label: "Before Pluralsight", title: "Software developer", body: "I built digital products across healthcare, financial technology, and media." },
  { label: "Education", title: "George Washington University + Flatiron School", body: "I earned an M.A. in Education and Human Development and a B.A. in Psychology at George Washington University, then studied web development at Flatiron School." },
  { label: "Earlier", title: "Teacher and professional baseball player", body: "I taught students with emotional disabilities and played professional baseball in the Tampa Bay Rays organization." },
  { label: "Also", title: "Small-business builder", body: "I built, operated, and sold a Raleigh service business. I know the difference between an interesting idea and something that earns its keep." },
];
---

<BaseLayout pageTitle="About Danny Sullivan — Raleigh AI Guy" pageDescription="Danny Sullivan helps Raleigh businesses build practical AI systems and improve everyday workflows.">
  <section>
    <Wrapper variant="wide" class="py-14 sm:py-20">
      <div class="grid items-center gap-10 border-t border-black/10 pt-6 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-9">
          <p class="field-label">About Danny Sullivan</p>
          <h1 class="font-editorial mt-5 max-w-5xl text-5xl font-medium leading-[.94] tracking-[-.045em] sm:text-7xl">I make AI useful for people with a business to run.</h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-base-600">I’m an AI product engineer, educator, and small-business builder based in Raleigh, North Carolina.</p>
        </div>
        <div class="relative w-40 lg:col-span-3 lg:w-full lg:max-w-[15rem] lg:justify-self-end"><div class="absolute -right-3 -top-3 h-full w-full bg-[var(--brand-orange)]" aria-hidden="true"></div><Image src={profileImage} alt="Danny Sullivan" widths={[160, 320, 480]} sizes="(min-width: 1024px) 240px, 160px" loading="eager" class="relative aspect-square w-full object-cover grayscale" /></div>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-surface-soft)]">
    <Wrapper variant="wide" class="py-14 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16"><div class="lg:col-span-4"><p class="field-label">How I work</p><h2 class="font-editorial mt-4 text-4xl leading-[1.02] sm:text-5xl">Start with the work itself.</h2></div><div class="space-y-5 text-base leading-7 text-base-600 lg:col-span-8"><p>I look for where time gets lost, what repeats, and what customers or employees are waiting on. Then I find the smallest useful answer.</p><p>Sometimes that answer involves AI. Sometimes ordinary software or a clearer process is better. My job is to tell the difference, build what is worth building, and explain it well enough that your team can use it confidently.</p><p>You work directly with me from the first conversation through implementation. There is no handoff to a junior team.</p></div></div>
    </Wrapper>
  </section>

  <EditorialList eyebrow="Experience" title="An unusual path. A practical point of view." items={experience} surface="paper" />
  <ContactBand eyebrow="Have a workflow in mind?" title="Tell me what is taking too much time." description="I’ll give you an honest read on whether AI is the right tool for it." />
</BaseLayout>
