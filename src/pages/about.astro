---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import profileImage from "../../danny.jpeg";

const experience = [
  { label: "Now", title: "AI Product Engineer · Gametime", body: "I build production AI systems at scale for live-event discovery and venue imagery. Shipping real systems has taught me what works beyond the demo." },
  { label: "Previously", title: "AI education · Pluralsight", body: "For nearly five years, I created hands-on AI and machine-learning training for teams at major companies including Amazon, Red Hat, and IBM, and built internal AI tools for content teams." },
  { label: "Education", title: "Education, psychology, and web development", body: "I earned an M.A. in Education and Human Development and a B.A. in Psychology from George Washington University, then studied web development at Flatiron School." },
  { label: "Earlier", title: "Special education teacher", body: "I taught students with emotional disabilities, where patience, clarity, preparation, and trust mattered every day. That experience still shapes how I explain difficult ideas and help people build confidence with new tools." },
  { label: "Before tech", title: "Professional baseball · Tampa Bay Rays organization", body: "I played professional baseball in the Tampa Bay Rays organization. The work taught me preparation, resilience, honest feedback, and how small improvements compound over time." },
  { label: "Also", title: "Small-business builder", body: "I have built, operated, and sold a Raleigh service business. I understand the difference between an interesting demo and something that earns its keep." },
];

const principles = [
  ["Start with the work", "A useful AI project begins with a real bottleneck, not a favorite tool."],
  ["Prefer the smallest answer", "If ordinary software or a better process solves the problem, that is the recommendation."],
  ["Keep a human accountable", "AI can prepare, organize, research, and draft. Judgment still belongs to someone."],
  ["Measure what changed", "Time saved, response time improved, revenue recovered, or quality increased. Otherwise it is theater."],
];
---

<BaseLayout
  pageTitle="About Danny Sullivan — Raleigh AI Guy"
  pageDescription="Danny Sullivan is Raleigh AI Guy, helping small businesses find practical AI tools, improve workflows, and avoid expensive distractions."
>
  <div class="brand-page">
    <section class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1fr_22rem] lg:items-center lg:py-28">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-base-500 dark:text-base-400">About Danny Sullivan · Raleigh, NC</p>
        <h1 class="mt-5 max-w-4xl font-sans text-4xl font-semibold leading-[1.04] tracking-[-0.04em] sm:text-6xl lg:text-7xl">I make AI useful for people who have a business to run.</h1>
        <p class="mt-7 max-w-2xl text-base leading-7 text-base-600 dark:text-base-300 sm:text-lg">I’m an AI product engineer, educator, and small-business builder. I help teams find the few AI opportunities worth acting on, choose tools that fit, and turn the useful ones into everyday workflows.</p>
        <div class="mt-8 flex flex-wrap items-center gap-5"><a href="/ai-answers/#ask" class="brand-button">Ask me an AI question <span class="ml-3">→</span></a><a href="#experience" class="text-sm text-base-500 hover:text-black dark:text-base-400 dark:hover:text-white">See my experience ↓</a></div>
      </div>
      <figure class="brand-panel p-3"><Image src={profileImage} alt="Danny Sullivan" width={615} height={615} loading="eager" class="w-full rounded-[calc(var(--brand-radius)-.5rem)]" /><figcaption class="flex items-end justify-between gap-4 px-2 pb-1 pt-4"><strong class="text-sm font-medium">Danny Sullivan</strong><span class="text-right text-xs leading-5 opacity-60">Raleigh AI Guy<br />Raleigh, North Carolina</span></figcaption></figure>
    </section>

    <section class="border-y border-[var(--brand-line)] bg-[var(--brand-surface-cool)]">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[18rem_1fr] lg:gap-24">
        <div><p class="text-xs font-medium uppercase tracking-wide text-base-500 dark:text-base-400">Why work with me</p><h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight">Technical depth, explained clearly.</h2></div>
        <div class="max-w-2xl space-y-5 text-base leading-7 text-base-600 dark:text-base-300"><p>I work with AI every day, but I do not believe every business needs custom software, an “AI transformation,” or another subscription.</p><p>Before moving into technology, I taught students with emotional disabilities and played professional baseball in the Tampa Bay Rays organization. Both experiences taught me to prepare carefully, communicate clearly, and keep improving when the path is not obvious.</p><p>My job is to understand how your business actually works, recognize where AI has leverage, and explain the recommendation clearly enough that you can make a confident decision. If AI is the wrong answer, I will say so.</p></div>
      </div>
    </section>

    <section id="experience" class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <div class="max-w-2xl"><p class="text-xs font-medium uppercase tracking-wide text-base-500 dark:text-base-400">Experience</p><h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight sm:text-4xl">Different careers. One practical way of working.</h2></div>
      <div class="mt-12 divide-y divide-black/10 border-y border-black/10 dark:divide-white/10 dark:border-white/10">{experience.map((item) => <article class="grid gap-4 py-7 lg:grid-cols-[8rem_17rem_1fr] lg:gap-8"><span class="text-xs font-medium uppercase tracking-wide text-base-400">{item.label}</span><h3 class="font-sans text-lg font-semibold">{item.title}</h3><p class="max-w-xl text-sm leading-6 text-base-500 dark:text-base-400">{item.body}</p></article>)}</div>
    </section>

    <section class="border-y border-[var(--brand-line)] bg-[var(--brand-surface-mint)]">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <div class="grid gap-10 lg:grid-cols-[18rem_1fr] lg:gap-24"><div><p class="brand-eyebrow">How I work</p><h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight">Practical by default.</h2></div><div class="grid gap-4 sm:grid-cols-2">{principles.map(([title, body]) => <article class="brand-panel p-6"><h3 class="font-sans text-base font-semibold">{title}</h3><p class="mt-3 text-sm leading-6 text-base-500 dark:text-base-400">{body}</p></article>)}</div></div>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-3">
      <article><p class="text-xs font-medium uppercase tracking-wide text-base-400">Start here</p><h2 class="mt-4 font-sans text-2xl font-semibold">Two-minute AI answer</h2><p class="mt-4 text-sm leading-6 text-base-500 dark:text-base-400">Send me the AI task, problem, or question that keeps stalling. I will record a personalized answer and send it directly to you.</p><a href="/ai-answers/#ask" class="mt-5 inline-block text-sm font-medium">Send me your question →</a></article>
      <article><p class="text-xs font-medium uppercase tracking-wide text-base-400">For teams</p><h2 class="mt-4 font-sans text-2xl font-semibold">Practical AI workshops</h2><p class="mt-4 text-sm leading-6 text-base-500 dark:text-base-400">A plain-English introduction to useful AI workflows, limitations, privacy, and better judgment.</p><a href="/ai-workshops/" class="mt-5 inline-block text-sm font-medium">See the workshop →</a></article>
      <article><p class="text-xs font-medium uppercase tracking-wide text-base-400">After the plan</p><h2 class="mt-4 font-sans text-2xl font-semibold">Implementation help</h2><p class="mt-4 text-sm leading-6 text-base-500 dark:text-base-400">Focused help redesigning a process, building a workflow, or teaching your team to use it well.</p><a href="/ai-answers/#ask" class="mt-5 inline-block text-sm font-medium">Tell me what is stuck →</a></article>
    </section>

    <section class="border-y border-[var(--brand-line)] bg-[var(--brand-surface-soft)] text-[var(--brand-text)]"><div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1fr_auto] lg:items-end"><div><p class="brand-eyebrow">A useful place to start</p><h2 class="mt-5 max-w-3xl text-balance font-sans text-3xl font-semibold tracking-tight sm:text-5xl">Bring me the AI problem you want unstuck.</h2></div><a href="/ai-answers/#ask" class="brand-button">Get a two-minute answer <span class="ml-3">→</span></a></div></section>
  </div>
</BaseLayout>
