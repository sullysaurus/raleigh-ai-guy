---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout
  pageTitle="About"
  pageDescription="About Danny Sullivan, a product engineer building AI tools, automations, and product systems."
>
  <section>
    <Wrapper variant="standard" class="pt-12 lg:py-32 xl:py-54">
      <Text
        tag="h1"
        variant="textBase"
        class="text-black dark:text-white font-medium"
      >
        About
      </Text>
    </Wrapper>
    <Wrapper variant="standard" class="py-12">
      <div class="border-t dark:border-white/10 border-black/10 pt-2">
        <Text
          tag="h2"
          variant="textBase"
          class="text-black dark:text-white font-medium"
        >
          I build practical systems for product and growth teams
        </Text>
        <Text
          tag="p"
          variant="textSM"
          class="2xl:text-base mt-8 dark:text-base-400 text-base-500"
        >
          I work at the intersection of AI, product, content, and automation.
          My background spans full-stack development, curriculum engineering,
          growth marketing, and product strategy, which means I tend to think
          about software as both a technical system and a business workflow.
        </Text>
        <Text
          tag="p"
          variant="textSM"
          class="2xl:text-base mt-6 dark:text-base-400 text-base-500"
        >
          At Gametime, I build AI tools and product systems for live event
          discovery. Before that, I spent nearly five years at Pluralsight
          across content strategy, generative AI education, and internal tooling
          for content teams.
        </Text>
        <Text
          tag="p"
          variant="textSM"
          class="2xl:text-base mt-6 dark:text-base-400 text-base-500"
        >
          I am based in Raleigh, NC, and I like helping teams turn ambiguous
          ideas and manual workflows into useful automations, tools, pipelines,
          and product features.
        </Text>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
