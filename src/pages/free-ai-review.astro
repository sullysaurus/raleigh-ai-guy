---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/global/PageIntro.astro";
import ContactBand from "@/components/global/ContactBand.astro";
---

<BaseLayout pageTitle="Workflow Review — Raleigh AI Guy" pageDescription="Bring one repetitive or frustrating workflow and get an honest read on the most useful next step.">
  <PageIntro eyebrow="Workflow review" title="Bring me one process you wish would disappear." description="Share what happens today, where it gets stuck, and who is involved. I’ll reply personally with the most useful next step I can offer." ctaHref="/contact/" ctaLabel="Describe the workflow" />
  <ContactBand eyebrow="One process is enough" title="Start small enough to learn something useful." ctaLabel="Request a review" />
</BaseLayout>
