---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import profileImage from "../../danny.jpeg";

const recommendations = [
  "The problem it solves in your business",
  "The exact tool or workflow I recommend",
  "What it costs and how hard it is to set up",
  "How much weekly time it could reasonably reclaim",
  "The first ten-minute action to take",
];

const faqs = [
  ["Do I need to know anything about AI?", "No. This is designed for business owners, not technical teams. I explain every recommendation in plain English."],
  ["Is this just a list of AI apps?", "No. We start with your work and your bottlenecks. Sometimes the best answer is ordinary software or a simpler process—not more AI."],
  ["Will you implement the recommendations?", "The assessment gives you a plan you can use yourself. If you want help afterward, we can scope that separately."],
];
---

<BaseLayout
  pageTitle="AI Tools Assessment for Raleigh Small Businesses"
  pageDescription="Find at least five hours of weekly time-saving opportunity in your Raleigh business with a practical, fixed-price AI Tools Assessment."
>
  <div class="min-h-svh bg-white text-black dark:bg-base-950 dark:text-white">
    <div>
      <section class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1fr_22rem] lg:items-center lg:py-32">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.14em] text-base-500 dark:text-base-400">AI Tools Assessment · Raleigh small businesses</p>
          <h1 class="mt-5 max-w-3xl text-balance font-sans text-4xl font-semibold leading-[1.04] tracking-[-0.04em] text-black dark:text-white sm:text-6xl lg:text-7xl">
            Find at least five hours hiding in your workweek.
          </h1>
          <p class="mt-7 max-w-2xl text-base leading-7 text-base-600 dark:text-base-300 sm:text-lg">
            I find the repetitive work slowing down your business and prescribe 3–7 practical AI or software tools that can give you time back—without changing everything about how your team works.
          </p>
          <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
            <a href="/work-with-me/" class="inline-flex min-h-12 items-center justify-center bg-black px-6 text-sm font-medium text-white transition hover:bg-base-800 dark:bg-white dark:text-black dark:hover:bg-base-200">Apply for the assessment <span class="ml-3">→</span></a>
            <span class="text-sm text-base-500 dark:text-base-400">Fixed price: $999</span>
          </div>
          <p class="mt-4 max-w-xl text-xs leading-5 text-base-500 dark:text-base-400">If I cannot identify at least five hours per week of credible opportunity, I refund the assessment.</p>
        </div>

        <aside class="border border-black/10 bg-base-50 p-6 dark:border-white/10 dark:bg-base-900 sm:p-8">
          <p class="text-xs font-medium uppercase tracking-wide text-base-500 dark:text-base-400">You receive</p>
          <ul class="mt-6 divide-y divide-black/10 border-y border-black/10 dark:divide-white/10 dark:border-white/10">
            <li class="flex gap-4 py-4"><span class="text-xs text-base-400">01</span><p class="text-sm font-medium">45-minute discovery call</p></li>
            <li class="flex gap-4 py-4"><span class="text-xs text-base-400">02</span><p class="text-sm font-medium">3–7 researched recommendations</p></li>
            <li class="flex gap-4 py-4"><span class="text-xs text-base-400">03</span><p class="text-sm font-medium">Four-day quick-start plan</p></li>
            <li class="flex gap-4 py-4"><span class="text-xs text-base-400">04</span><p class="text-sm font-medium">Time and financial impact estimate</p></li>
            <li class="flex gap-4 py-4"><span class="text-xs text-base-400">05</span><p class="text-sm font-medium">30-minute report review</p></li>
          </ul>
        </aside>
      </section>

      <section class="border-y border-black/10 bg-base-50 dark:border-white/10 dark:bg-base-900">
        <div class="mx-auto grid max-w-6xl divide-y divide-black/10 px-5 dark:divide-white/10 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-8">
          <div class="py-7 sm:pr-8"><strong class="block text-2xl font-semibold">$999</strong><span class="mt-1 block text-sm text-base-500 dark:text-base-400">One fixed price</span></div>
          <div class="py-7 sm:px-8"><strong class="block text-2xl font-semibold">3–7</strong><span class="mt-1 block text-sm text-base-500 dark:text-base-400">Vetted recommendations</span></div>
          <div class="py-7 sm:pl-8"><strong class="block text-2xl font-semibold">5+ hours</strong><span class="mt-1 block text-sm text-base-500 dark:text-base-400">Weekly opportunity guaranteed</span></div>
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <div class="grid gap-10 lg:grid-cols-[20rem_1fr] lg:gap-24">
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-base-500 dark:text-base-400">Why this exists</p>
            <h2 class="mt-4 font-sans text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">You do not need more AI news. You need a useful next move.</h2>
          </div>
          <div class="max-w-2xl space-y-5 text-base leading-7 text-base-600 dark:text-base-300">
            <p>You know AI is changing how businesses work. But you are also handling customers, email, estimates, follow-up, approvals, and a dozen other things that cannot wait while you research every new tool.</p>
            <p>The assessment does that sorting for you. We look at a real day in your business, find where time is leaking, and match the most expensive friction with the simplest credible solution.</p>
          </div>
        </div>
      </section>

      <section class="border-y border-black/10 dark:border-white/10">
        <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
          <div class="max-w-2xl">
            <p class="text-xs font-medium uppercase tracking-wide text-base-500 dark:text-base-400">How it works</p>
            <h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight sm:text-4xl">Two conversations. One clear plan.</h2>
          </div>
          <ol class="mt-12 grid gap-px overflow-hidden border border-black/10 bg-black/10 dark:border-white/10 dark:bg-white/10 lg:grid-cols-4">
            <li class="bg-white p-6 dark:bg-base-950"><span class="text-xs text-base-400">01</span><h3 class="mt-8 font-sans text-lg font-semibold">Discover</h3><p class="mt-3 text-sm leading-6 text-base-500 dark:text-base-400">A 45-minute recorded call about your day, your bottlenecks, and the work you wish would disappear.</p></li>
            <li class="bg-white p-6 dark:bg-base-950"><span class="text-xs text-base-400">02</span><h3 class="mt-8 font-sans text-lg font-semibold">Research</h3><p class="mt-3 text-sm leading-6 text-base-500 dark:text-base-400">I analyze the call, research the right-sized tools, verify the details, and calculate the opportunity.</p></li>
            <li class="bg-white p-6 dark:bg-base-950"><span class="text-xs text-base-400">03</span><h3 class="mt-8 font-sans text-lg font-semibold">Prescribe</h3><p class="mt-3 text-sm leading-6 text-base-500 dark:text-base-400">You receive a short report with priorities, recommendations, costs, expected impact, and a four-day plan.</p></li>
            <li class="bg-white p-6 dark:bg-base-950"><span class="text-xs text-base-400">04</span><h3 class="mt-8 font-sans text-lg font-semibold">Review</h3><p class="mt-3 text-sm leading-6 text-base-500 dark:text-base-400">We spend 30 minutes choosing the most urgent next move and answering every practical question.</p></li>
          </ol>
        </div>
      </section>

      <section class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-2 lg:gap-24">
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-base-500 dark:text-base-400">The deliverable</p>
          <h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight sm:text-4xl">Every recommendation answers the questions that matter.</h2>
          <ul class="mt-8 divide-y divide-black/10 border-y border-black/10 dark:divide-white/10 dark:border-white/10">
            {recommendations.map((item) => <li class="flex gap-3 py-4 text-sm"><span class="text-base-400">✓</span><span>{item}</span></li>)}
          </ul>
        </div>
        <div class="self-start bg-black p-7 text-white dark:bg-white dark:text-black sm:p-10">
          <p class="text-xs font-medium uppercase tracking-wide text-white/50 dark:text-black/50">The guarantee</p>
          <p class="mt-6 text-balance text-2xl font-medium leading-snug sm:text-3xl">If I cannot identify at least five hours of credible weekly opportunity, you get a full refund.</p>
          <p class="mt-6 text-sm leading-6 text-white/60 dark:text-black/60">Every estimate is tied to a workflow you described and a recommendation I can defend. Your only risk is the time we spend talking.</p>
        </div>
      </section>

      <section class="border-y border-black/10 bg-base-50 dark:border-white/10 dark:bg-base-900">
        <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[1fr_22rem] lg:items-center lg:gap-24">
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-base-500 dark:text-base-400">Who it is for</p>
            <h2 class="mt-4 max-w-2xl font-sans text-3xl font-semibold tracking-tight sm:text-4xl">Raleigh-area businesses where the owner or team is still doing too much by hand.</h2>
            <p class="mt-6 max-w-2xl text-base leading-7 text-base-600 dark:text-base-300">The sweet spot is an owner-led business with roughly 2–20 employees, repeatable operational work, and an appetite for practical improvement. No AI strategy or technical employee required.</p>
          </div>
          <div class="flex items-center gap-5 border-t border-black/10 pt-6 dark:border-white/10 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
            <Image src={profileImage} alt="Danny Sullivan" width={96} height={96} class="size-20 rounded-full object-cover grayscale" />
            <div><strong class="block text-sm">Danny Sullivan</strong><span class="mt-1 block text-sm leading-5 text-base-500 dark:text-base-400">AI Product Engineer<br />Raleigh, North Carolina</span></div>
          </div>
        </div>
      </section>

      <section class="mx-auto grid max-w-6xl gap-10 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[20rem_1fr] lg:gap-24">
        <div><p class="text-xs font-medium uppercase tracking-wide text-base-500 dark:text-base-400">Common questions</p><h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight">Before you apply.</h2></div>
        <div>{faqs.map(([question, answer]) => <details class="border-t border-black/10 py-5 last:border-b dark:border-white/10"><summary class="flex cursor-pointer list-none justify-between gap-6 text-sm font-medium">{question}<span class="text-base-400">+</span></summary><p class="mt-4 max-w-2xl pr-8 text-sm leading-6 text-base-500 dark:text-base-400">{answer}</p></details>)}</div>
      </section>

      <section class="bg-black text-white dark:bg-white dark:text-black">
        <div class="mx-auto max-w-3xl px-5 py-20 text-center sm:px-8 sm:py-28">
          <p class="text-xs font-medium uppercase tracking-wide text-white/50 dark:text-black/50">One assessment · $999</p>
          <h2 class="mt-5 text-balance font-sans text-3xl font-semibold tracking-tight sm:text-5xl">Let’s find five hours hiding in your workweek.</h2>
          <a href="/work-with-me/" class="mt-8 inline-flex min-h-12 items-center justify-center bg-[#ddff73] px-6 text-sm font-medium text-black transition hover:bg-[#e6ff95]">Apply for the assessment <span class="ml-3">→</span></a>
          <p class="mt-4 text-xs text-white/50 dark:text-black/50">Applying does not commit you to purchase.</p>
        </div>
      </section>
    </div>

  </div>
</BaseLayout>
