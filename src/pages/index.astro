---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Sections
import Hero from "@/components/landing/Hero.astro";
// Components
import BlogCard2 from "@/components/blog/BlogCard2.astro";
// Blog contet
import { getCollection } from "astro:content";
const allPosts = await getCollection("posts");
---

<BaseLayout pageDescription="I build products that streamline work and help companies grow revenue.">
  <Hero />
  <section>
    <Wrapper variant="standard" class="pt-8 pb-12 lg:pt-24 lg:pb-32">
      <div
        class="gap-2 sm:flex sm:items-center sm:justify-between border-t dark:border-white/10 border-black/10 pt-2"
      >
        <Text
          tag="h3"
          variant="textBase"
          class="text-black dark:text-white font-medium"
        >
          Latest blog posts
        </Text>
        <div class="">
          <Text
            tag="a"
            variant="textSM"
            href="/blog/"
            aria-label="See all blog posts"
            title="See all blog posts"
            class="text-base-500 hover:text-black dark:text-base-400 dark:hover:text-white font-medium"
          >
            &rarr; See all posts
          </Text>
        </div>
      </div>
      <div class="mt-8 flex flex-col">
        {allPosts.slice(0, 2).map((post) => <BlogCard2 post={post} />)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
