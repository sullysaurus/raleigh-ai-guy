---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import profileImage from "../../danny.jpeg";

const outcomes = [
  ["Make more", "Respond faster, follow up consistently, and create room for more customers."],
  ["Do less busywork", "Take repeated admin, handoffs, and copy-and-paste work off your plate."],
  ["Get time back", "Give yourself and your team more time for the work only people can do."],
];

const steps = [
  ["Find the bottleneck", "We identify where work gets stuck, repeated, or lost—and what fixing it would mean for the business."],
  ["Design the right system", "I map a practical solution around how your team actually works, using AI only where it creates a real advantage."],
  ["Build and improve it", "I create the system, measure its impact, and keep improving it as your business and team grow."],
];

const fitSignals = [
  "Repeated work is taking at least 5 hours a week",
  "Faster follow-up or more capacity could create real revenue",
  "You can give me access to understand and test the work",
  "You are ready to invest in a system that earns its keep",
];
---

<BaseLayout
  pageTitle="Custom AI Systems for Service Businesses — Raleigh AI Guy"
  pageDescription="Danny Sullivan turns scattered tools, manual follow-up, and owner-dependent workflows into practical AI systems for established service businesses."
>
  <section class="overflow-hidden">
    <Wrapper variant="wide" class="py-8 sm:py-14 lg:py-20">
      <div class="grid min-w-0 items-end gap-8 lg:grid-cols-12 lg:gap-14">
        <div class="field-reveal relative min-w-0 lg:col-span-9">
          <div class="hidden lg:block">
            <p class="field-label flex items-center gap-2 whitespace-nowrap"><span class="size-2 shrink-0 rounded-full bg-[var(--brand-orange)]" aria-hidden="true"></span>Danny Sullivan · Raleigh AI Guy</p>
            <p class="font-utility mt-2 text-[.6rem] uppercase tracking-[.1em] text-base-500">Custom AI systems for established service businesses</p>
          </div>

          <h1 class="font-editorial max-w-5xl text-[clamp(2.5rem,7vw,5.8rem)] font-medium leading-[.9] tracking-[-.05em] text-black lg:mt-6">
            Stop holding your<br />business together<br /><em class="font-normal text-[var(--brand-orange)]">by hand.</em>
          </h1>
          <div class="mt-6 max-w-2xl sm:mt-7 lg:mt-8">
            <div class="relative float-right mb-2 ml-4 w-16 sm:w-20 lg:hidden">
              <div class="absolute -right-1.5 -top-1.5 size-full bg-[var(--brand-orange)]" aria-hidden="true"></div>
              <Image src={profileImage} alt="Danny Sullivan" widths={[128, 192]} sizes="(min-width: 640px) 80px, 64px" loading="eager" class="relative aspect-square w-full object-cover grayscale" />
            </div>
            <p class="text-lg leading-7 text-base-600 sm:text-xl sm:leading-8">I turn scattered tools, manual follow-up, and owner-dependent workflows into practical systems that save time, protect revenue, and help your team run without constant intervention.</p>
          </div>
          <div class="mt-6 flex flex-col items-start gap-3 min-[420px]:flex-row min-[420px]:items-center sm:mt-7 sm:gap-5">
            <a href="/contact/" class="site-cta">Book a workflow strategy call →</a>
            <a href="/projects/" class="hidden text-sm font-semibold underline decoration-black/25 underline-offset-4 hover:decoration-black sm:block">See what I’ve built</a>
          </div>
          <p class="font-utility mt-4 max-w-full text-[.58rem] uppercase leading-4 tracking-[.08em] text-base-500 sm:mt-5 sm:text-[.64rem]">Raleigh-based · Built directly with Danny · No generic AI pitch</p>
        </div>

        <div class="field-reveal field-reveal-delay relative hidden w-full max-w-[17rem] lg:col-span-3 lg:block lg:justify-self-end">
          <div class="absolute -right-3 -top-3 h-full w-full bg-[var(--brand-orange)]" aria-hidden="true"></div>
          <Image src={profileImage} alt="Danny Sullivan" widths={[480, 720, 960]} sizes="(min-width: 1024px) 272px, 160px" loading="eager" class="relative aspect-square w-full object-cover grayscale" />
          <p class="font-utility absolute -bottom-4 left-3 whitespace-nowrap bg-[var(--brand-paper)] px-3 py-2 text-[.58rem] uppercase tracking-[.1em]">You run it. I improve it.</p>
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="border-y border-black/10 bg-[var(--brand-forest)] text-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-9 sm:py-11">
      <div class="grid gap-6 sm:grid-cols-3 sm:gap-px sm:bg-white/15">
        {outcomes.map(([title, body]) => (
          <div class="border-t border-white/15 pt-5 first:border-t-0 first:pt-0 sm:border-l sm:border-t-0 sm:px-7 sm:pt-0 sm:first:border-l-0 sm:first:pl-0 sm:last:pr-0">
            <p class="font-editorial text-3xl">{title}</p>
            <p class="mt-2 text-sm leading-6 text-white/55">{body}</p>
          </div>
        ))}
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-surface-soft)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5">
          <p class="field-label">Case study · Zim Zoom</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.95] tracking-[-.035em] sm:text-6xl">Four scattered systems. One clear command center.</h2>
          <p class="mt-6 text-base leading-7 text-base-600">Zim Zoom’s operational data was spread across VSCO, Superhuman Docs/Coda, Slack, and manual team workflows. The owner had to connect events, booth capacity, staffing, payments, metrics, and approvals by hand.</p>
          <p class="mt-5 text-base leading-7 text-base-600">I built an owner-focused command center in a matter of days. It is projected to return 350–800 hours per year—roughly $25,000–$120,000 in annual productivity value.</p>
          <a href="/projects/zimzoom-photo-booth/" class="mt-7 inline-flex text-sm font-semibold underline decoration-black/20 underline-offset-4">Read the Zim Zoom story →</a>
        </div>

        <div class="lg:col-span-7">
          <div class="border border-black/15 bg-white p-2 shadow-[12px_12px_0_var(--brand-orange)] sm:p-3">
            <img src="/case-study/01-owner-overview.png" alt="Demo of the Zim Zoom operations command center owner overview using simulated data" width="1440" height="1644" loading="lazy" class="aspect-[4/3] w-full object-cover object-top" />
          </div>
          <p class="font-utility mt-5 text-[.58rem] uppercase leading-4 tracking-[.08em] text-base-500">Command-center demo · Simulated records · No real customer or operational data shown</p>
        </div>
      </div>
    </Wrapper>
  </section>

  <section id="how-it-works" class="scroll-mt-6 bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="field-label">The offer</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.95] tracking-[-.035em] sm:text-6xl">From daily bottleneck to a system your team can run.</h2>
          <p class="mt-6 text-sm leading-6 text-base-600">You do not need an AI idea or a technical plan. Start with the work that keeps getting stuck.</p>
        </div>
        <ol class="border-t border-black/15 lg:col-span-8">
          {steps.map(([title, body], index) => (
            <li class="grid gap-4 border-b border-black/15 py-6 sm:grid-cols-[3rem_11rem_1fr] sm:gap-6">
              <span class="field-label text-[var(--brand-orange)]">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="font-semibold">{title}</h3>
              <p class="text-sm leading-6 text-base-600">{body}</p>
            </li>
          ))}
        </ol>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-surface-soft)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="field-label">A good fit</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.95] tracking-[-.035em] sm:text-6xl">The right system should earn its keep.</h2>
          <p class="mt-6 max-w-lg text-base leading-7 text-base-600">This work is for established businesses where fixing an important workflow can create measurable time, capacity, or revenue.</p>
        </div>
        <div class="lg:col-span-7">
          <ul class="border-t border-black/15">
            {fitSignals.map((signal) => <li class="grid grid-cols-[1.5rem_1fr] gap-4 border-b border-black/15 py-5 text-base font-semibold"><span class="text-[var(--brand-orange)]">✓</span><span>{signal}</span></li>)}
          </ul>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a href="/contact/" class="site-cta">Tell me what’s slowing you down →</a>
            <p class="max-w-sm text-xs leading-5 text-base-500">A short project brief, reviewed personally by me.</p>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-orange)]">
    <Wrapper variant="wide" class="py-14 sm:py-20">
      <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:items-end">
        <div><p class="field-label text-black/60">Make more without doing more</p><h2 class="font-editorial mt-4 max-w-4xl text-5xl leading-[.92] tracking-[-.045em] sm:text-7xl">Bring me the bottleneck.</h2><p class="mt-5 max-w-2xl text-sm leading-6 text-black/70">Tell me what keeps falling through the cracks, taking too long, or requiring your constant attention. We’ll find the right system to fix it.</p></div>
        <a href="/contact/" class="inline-flex min-h-12 items-center justify-center bg-[var(--brand-ink)] px-5 text-sm font-semibold text-[var(--brand-paper)] transition-transform hover:-translate-y-0.5">Book a workflow strategy call →</a>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
