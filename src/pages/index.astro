---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import profileImage from "../../danny.jpeg";
import seoDashboardImage from "@/images/projects/garden-art-seo-dashboard-live.png";
import zimZoomImage from "@/images/projects/zimzoom-homepage-live.png";
---

<BaseLayout
  pageTitle="Practical AI for Raleigh Businesses"
  pageDescription="Practical AI workflows that help Raleigh businesses spend less time on email, marketing, follow-up, and admin."
  socialImage="/raleigh-ai-guy.png"
  socialImageAlt="Raleigh AI Guy — AI help for small business, in plain English"
  socialImageWidth={1200}
  socialImageHeight={630}
  minimal={true}
>
  <div class="broadcast-page">
    <header class="broadcast-nav">
      <a class="broadcast-logo" href="/" aria-label="Raleigh AI Guy home">
        <span class="logo-bug">RAI</span>
        <span>Raleigh AI Guy</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#proof">Proof</a>
        <a href="#offers">Ways to work</a>
        <a href="/ai-workshops/">Workshops</a>
        <a href="/about/">About</a>
        <a href="/blog/">Blog</a>
      </nav>
      <a class="nav-cta" href="/ai-diagnosis/">Start here →</a>
    </header>

    <div class="news-ticker" aria-label="Raleigh AI Guy services">
      <div>
        <span>LOCAL AI, NO HYPE</span><i>✦</i><span>WORKFLOW DIAGNOSIS</span><i>✦</i><span>AUTOMATION BUILDS</span><i>✦</i><span>TEAM WORKSHOPS</span><i>✦</i><span>RALEIGH, NC</span><i>✦</i>
        <span aria-hidden="true">LOCAL AI, NO HYPE</span><i aria-hidden="true">✦</i><span aria-hidden="true">WORKFLOW DIAGNOSIS</span><i aria-hidden="true">✦</i><span aria-hidden="true">AUTOMATION BUILDS</span><i aria-hidden="true">✦</i><span aria-hidden="true">TEAM WORKSHOPS</span><i aria-hidden="true">✦</i><span aria-hidden="true">RALEIGH, NC</span><i aria-hidden="true">✦</i>
      </div>
    </div>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="channel-label"><span></span> Broadcasting practical AI from Raleigh, NC</p>
          <h1 id="hero-title">AI that does<br />the <em>boring</em><br /><strong>stuff.</strong></h1>
          <p class="hero-lede">Useful systems for local businesses that want less admin, better follow-through, and zero robot theater.</p>
          <div class="hero-actions">
            <a class="brutal-button primary" href="/ai-diagnosis/" data-posthog-event="ai_diagnosis_cta_clicked">Start with a $500 diagnosis <span>↗</span></a>
            <a class="brutal-button secondary" href="/ai-opportunity-scorecard/" data-posthog-event="ai_scorecard_cta_clicked">Take the free scorecard <span>→</span></a>
          </div>
          <div class="credential-bar">
            <span>BUILD</span><b>Production AI at Gametime</b>
            <span>TEACH</span><b>Former Pluralsight instructor</b>
          </div>
        </div>

        <aside class="hero-visual" aria-label="About Danny Sullivan">
          <div class="static-noise" aria-hidden="true"></div>
          <div class="portrait-frame">
            <Image src={profileImage} alt="Danny Sullivan" width={615} height={615} loading="eager" />
            <span class="live-bug"><i></i> LIVE</span>
          </div>
          <div class="name-card">
            <div><small>YOUR HOST / BUILDER</small><strong>DANNY<br />SULLIVAN</strong></div>
            <span>919</span>
          </div>
          <p class="tape-note">I study the work.<br />I build the system.<br />I help your team use it.</p>
          <span class="star-burst" aria-hidden="true">NO<br />HYPE!</span>
        </aside>
      </section>

      <div class="station-break" aria-hidden="true">
        <span>YOU ARE WATCHING</span><strong>RALEIGH AI GUY</strong><span>CH. 919</span>
      </div>

      <section id="proof" class="proof-section" aria-labelledby="proof-title">
        <header class="section-heading">
          <p>Season 01 / Recent work</p>
          <h2 id="proof-title">Proof, not<br /><em>promises.</em></h2>
          <span class="scribble">REAL WORK<br />IN THE WILD ↓</span>
        </header>

        <div class="proof-grid">
          <article class="case-card case-yellow">
            <div class="case-image"><Image src={seoDashboardImage} alt="Garden and Art Landscapes SEO dashboard" widths={[640, 960]} sizes="(min-width: 900px) 50vw, 100vw" /></div>
            <div class="case-copy">
              <span class="episode">EP. 01</span>
              <p>Automated SEO growth</p>
              <h3>One dashboard that researches, drafts, measures, and keeps moving.</h3>
              <ul><li>18 useful pages published</li><li>Live Analytics + Search Console</li><li>Early rankings at #4, #14, and #28</li></ul>
              <a href="https://www.landscapingraleigh.com/seo-dashboard/" target="_blank" rel="noreferrer">See the live system ↗</a>
            </div>
          </article>

          <article class="case-card case-orange">
            <div class="case-image"><Image src={zimZoomImage} alt="ZimZoom Photo Booth website" widths={[640, 960]} sizes="(min-width: 900px) 50vw, 100vw" /></div>
            <div class="case-copy">
              <span class="episode">EP. 02</span>
              <p>Custom Claude skills</p>
              <h3>Turning an overloaded inbox into a repeatable operating system.</h3>
              <ul><li>Lead and customer-message triage</li><li>Payment and follow-up priority</li><li>Hands-on team training</li></ul>
              <a href="/blog/posts/create-first-claude-skill-organize-inbox/">Build the inbox skill →</a>
            </div>
          </article>
        </div>
      </section>

      <section id="offers" class="offers-section" aria-labelledby="offers-title">
        <div class="offers-intro">
          <p>Choose your own adventure</p>
          <h2 id="offers-title">Three ways to make work run better.</h2>
        </div>
        <div class="offer-stack">
          <a href="/ai-opportunity-scorecard/" class="offer offer-yellow" data-posthog-event="ai_scorecard_cta_clicked">
            <span>00</span><div><small>FREE · 7 MINUTES</small><h3>Score one annoying workflow.</h3><p>See if the work is ready for AI before buying anything.</p></div><b>→</b>
          </a>
          <a href="/ai-diagnosis/" class="offer offer-orange" data-posthog-event="ai_diagnosis_cta_clicked">
            <span>01</span><div><small>$500 · ONE TIME</small><h3>Find the work worth fixing.</h3><p>A personal review, three ranked opportunities, and a 30-day roadmap.</p></div><b>→</b>
          </a>
          <a href="/ai-workshops/" class="offer offer-pink" data-posthog-event="ai_workshops_cta_clicked">
            <span>02</span><div><small>FOR REAL ESTATE TEAMS</small><h3>Book a free lunch-and-learn.</h3><p>Thirty practical minutes. No sales deck. Bring the repetitive work.</p></div><b>→</b>
          </a>
        </div>
      </section>

      <section class="closing-cta">
        <p>Transmission ends soon</p>
        <h2>Bring me the task<br />everyone <em>hates.</em></h2>
        <a class="brutal-button primary" href="/ai-diagnosis/" data-posthog-event="ai_diagnosis_cta_clicked">Let’s diagnose it <span>↗</span></a>
        <div class="closing-stamp">USEFUL<br />SINCE<br />2026</div>
      </section>
    </main>

    <footer class="broadcast-footer">
      <strong>RALEIGH AI GUY</strong>
      <span>Danny Sullivan · Raleigh, North Carolina</span>
      <nav aria-label="Footer navigation"><a href="/about/">About</a><a href="/blog/">Blog</a><a href="/privacy/">Privacy</a><a href="https://www.linkedin.com/in/danny-sullivan-raleigh/" target="_blank" rel="noreferrer">LinkedIn ↗</a></nav>
    </footer>
  </div>
</BaseLayout>


<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-posthog-event]').forEach(function (link) {
      link.addEventListener('click', function () {
        window.posthog?.capture(link.dataset.posthogEvent, { source: 'home_page_broadcast' });
      });
    });
  });
</script>
