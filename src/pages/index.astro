---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import gardenImage from "@/images/projects/case-study-landscaping-seo.png";
import inboxImage from "@/images/projects/case-study-inbox-triage.png";

const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);

const caseStudies = [
  {
    label: "Local growth system",
    title: "Raleigh landscaping SEO system",
    description: "A new website and practical SEO system that turns real expertise, project photos, and local search data into a repeatable path to new inquiries.",
    result: "18 useful pages published, live measurement in place, and early rankings moving into view.",
    href: "/projects/garden-art-landscapes/",
    image: gardenImage,
    alt: "Garden & Art Landscapes SEO reporting dashboard",
  },
  {
    label: "Operations workflow",
    title: "Inbox triage system",
    description: "A reusable workflow that reads incoming messages, applies the business owner’s own priorities, and prepares a short action list for review.",
    result: "Less time scanning the inbox, clearer follow-up, and a human approval step before anything changes.",
    href: "/projects/inbox-triage-workflow/",
    image: inboxImage,
    alt: "A simple inbox triage workflow",
  },
];
---

<BaseLayout
  pageTitle="Raleigh AI Guy — Practical AI systems for small businesses"
  pageDescription="Danny Sullivan helps Raleigh businesses find useful AI opportunities, improve workflows, and build practical systems without the hype."
>
  <section>
    <Wrapper class="py-16 sm:py-24 lg:py-32">
      <p class="text-sm font-medium text-base-500">Danny Sullivan · Raleigh, North Carolina</p>
      <h1 class="mt-6 max-w-3xl text-4xl font-medium leading-[1.05] tracking-[-0.045em] text-black sm:text-6xl">
        I help small businesses make AI useful.
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-8 text-base-500">
        I study how the work gets done, find the few opportunities worth acting on, and build practical systems that save time without creating more complexity.
      </p>
      <a href="mailto:hello@raleighaiguy.com" class="site-cta mt-8">Email me</a>
    </Wrapper>
  </section>

  <section>
    <Wrapper class="py-12 sm:py-16">
      <div class="border-t border-black/10 pt-3">
        <p class="text-sm font-medium text-black">What I do</p>
        <div class="mt-8 grid gap-8 sm:grid-cols-3">
          <div><h2 class="text-sm font-medium">Find the opportunity</h2><p class="mt-3 text-sm leading-6 text-base-500">Review the work, identify the bottleneck, and decide whether AI is actually the right answer.</p></div>
          <div><h2 class="text-sm font-medium">Build the workflow</h2><p class="mt-3 text-sm leading-6 text-base-500">Connect the tools you already use and turn a promising idea into something dependable.</p></div>
          <div><h2 class="text-sm font-medium">Help the team use it</h2><p class="mt-3 text-sm leading-6 text-base-500">Explain the system clearly, document it, and make sure it fits the people doing the work.</p></div>
        </div>
      </div>
    </Wrapper>
  </section>

  <section id="recent-work">
    <Wrapper class="py-12 sm:py-20">
      <div class="flex items-center justify-between gap-5 border-t border-black/10 pt-3">
        <h2 class="text-sm font-medium">Two case studies</h2>
        <a href="/projects/" class="text-sm text-base-500 hover:text-black">See all work →</a>
      </div>
      <div class="mt-10 space-y-16 sm:space-y-20">
        {caseStudies.map((study) => (
          <article>
            <a href={study.href} class="group block">
              <div class="overflow-hidden rounded-xl border border-black/10 bg-[var(--brand-surface)]">
                <Image src={study.image} alt={study.alt} widths={[640, 960, 1280]} sizes="(min-width: 768px) 768px, 100vw" loading="eager" class="aspect-[3/2] w-full object-cover transition duration-300 group-hover:scale-[1.01]" />
              </div>
              <div class="mt-5 grid gap-4 sm:grid-cols-[12rem_1fr]">
                <div><p class="accent-label text-xs font-medium uppercase tracking-[.08em]">{study.label}</p><h3 class="mt-2 text-lg font-medium tracking-tight">{study.title}</h3></div>
                <div><p class="text-sm leading-6 text-base-500">{study.description}</p><p class="mt-3 text-sm font-medium text-black">{study.result}</p><span class="mt-4 inline-flex text-sm text-base-500 group-hover:text-black">Read the case study →</span></div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </Wrapper>
  </section>

  <section>
    <Wrapper class="py-12 sm:py-20">
      <div class="flex items-center justify-between gap-5 border-t border-black/10 pt-3">
        <h2 class="text-sm font-medium">Latest writing</h2>
        <a href="/blog/" class="text-sm text-base-500 hover:text-black">See all writing →</a>
      </div>
      <div class="mt-7 divide-y divide-black/10 border-y border-black/10">
        {posts.map((post) => (
          <a href={`/blog/posts/${post.id}`} class="grid gap-2 py-5 sm:grid-cols-[1fr_12rem] sm:items-center">
            <span class="text-sm font-medium hover:text-base-500">{post.data.title}</span>
            <span class="text-sm text-base-400 sm:text-right">{post.data.pubDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}</span>
          </a>
        ))}
      </div>
    </Wrapper>
  </section>

  <section>
    <Wrapper class="py-16 sm:py-24">
      <div class="border-t border-black/10 pt-8">
        <h2 class="max-w-xl text-3xl font-medium leading-tight tracking-[-0.035em]">Have a repetitive process you wish would disappear?</h2>
        <p class="mt-5 max-w-xl text-base leading-7 text-base-500">Tell me what is getting in the way. I’ll give you an honest read on whether AI can help.</p>
        <a href="mailto:hello@raleighaiguy.com" class="site-cta mt-7">Email me</a>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
