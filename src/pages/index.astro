---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import profileImage from "../../danny.jpeg";

const services = [
  {
    title: "AI Concierge",
    description: "Ongoing, hands-on help choosing where AI belongs and improving how your team uses it.",
    cta: "Explore concierge",
    icon: "headset",
  },
  {
    title: "In-Person AI",
    description: "Raleigh workshops and working sessions built around your team’s real work.",
    cta: "Plan a session",
    icon: "people",
  },
  {
    title: "Custom Automations",
    description: "Done-for-you systems that connect tools, reduce manual work, and keep important work moving.",
    cta: "See what I build",
    icon: "workflow",
  },
];

const notesUrl = "/blog/";
---

<BaseLayout
  minimal
  pageTitle="Practical AI for Raleigh Businesses — Raleigh AI Guy"
  pageDescription="Danny Sullivan helps Raleigh business owners put AI to work through hands-on guidance, in-person sessions, and custom automations."
>
  <div class="poster-site">
    <header class="poster-header poster-shell">
      <a class="poster-brand" href="/" aria-label="Raleigh AI Guy home">
        <span>Raleigh</span>
        <span>AI Guy</span>
      </a>
      <span class="tape-note">Making AI useful</span>

      <nav class="desktop-nav" aria-label="Homepage navigation">
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#case-study">Case study</a>
        <a href="#notes">Writing</a>
        <a href="/contact/">Contact</a>
      </nav>

      <details class="mobile-nav">
        <summary>Menu</summary>
        <nav aria-label="Mobile homepage navigation">
          <a href="#about">About</a>
          <a href="#services">Services</a>
          <a href="#case-study">Case study</a>
          <a href="#notes">Writing</a>
          <a href="/contact/">Contact</a>
        </nav>
      </details>
    </header>

    <main>
      <section class="hero poster-shell" aria-labelledby="hero-title">
        <div class="hero-copy poster-reveal">
          <p class="utility-label">Raleigh, North Carolina · Working with real businesses</p>
          <h1 id="hero-title">Practical AI <br />for the people <br /><span>doing the work.</span></h1>
          <p class="hero-intro">I help Raleigh business owners put AI to work, improve how work gets done, and build useful systems—without becoming technical experts.</p>
          <div class="hero-actions">
            <a class="poster-button poster-button-yellow" href="#services">See ways to work together <span aria-hidden="true">→</span></a>
            <a class="text-link" href="/projects/">See what I’ve built <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="hero-portrait poster-reveal poster-reveal-delay">
          <div class="portrait-ink" aria-hidden="true"></div>
          <Image
            src={profileImage}
            alt="Danny Sullivan, Raleigh AI Guy"
            widths={[480, 720, 960]}
            sizes="(min-width: 900px) 42vw, 88vw"
            loading="eager"
            class="portrait-image"
          />
          <div class="local-badge"><span>Actual human in</span><strong>Raleigh, NC</strong></div>
        </div>
      </section>

      <section class="credential-strip poster-shell" aria-label="Experience">
        <span>AI product engineer</span><i aria-hidden="true"></i><span>Educator</span><i aria-hidden="true"></i><span>Former service-business owner</span>
      </section>

      <section id="about" class="about poster-shell poster-section">
        <div class="about-mark" aria-hidden="true">
          <svg viewBox="0 0 120 120" role="img">
            <path d="M75 102H29V76c0-8-7-12-12-18 0-28 18-45 43-45 27 0 44 18 44 42 0 14-6 23-15 29v18H75Z" />
            <circle cx="60" cy="51" r="16" />
            <path d="m60 28 3 8 8-3-2 9 9 2-7 6 6 7-9 1 1 9-9-4-4 8-4-9-8 3 2-9-9-2 7-6-6-7 9-1-1-9 9 4 4-8Z" />
          </svg>
        </div>
        <div>
          <p class="section-kicker">How I think about the work</p>
          <h2>AI should make the business easier to run.</h2>
          <p>I help you decide what is worth changing, choose the right approach, and make it useful for the people who actually do the work. Sometimes that means AI. Sometimes a clearer process or an ordinary tool is the better answer.</p>
          <a class="text-link" href="/about/">More about me <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section id="services" class="services poster-shell poster-section" aria-labelledby="services-title">
        <div class="section-rule-heading">
          <h2 id="services-title">Ways to work with me</h2>
          <span aria-hidden="true"></span>
        </div>

        <div class="service-grid">
          {services.map((service, index) => (
            <article class="service-card">
              <div class="service-number">0{index + 1}</div>
              <div class="service-icon" aria-hidden="true">
                {service.icon === "headset" && (
                  <svg viewBox="0 0 96 72"><path d="M19 41V34a29 29 0 0 1 58 0v7" /><path d="M19 38H9v22h14V38h-4Zm58 0h10v22H73V38h4Z" /><path d="M73 59c-3 8-10 10-21 10" /><circle cx="47" cy="69" r="3" /></svg>
                )}
                {service.icon === "people" && (
                  <svg viewBox="0 0 96 72"><circle cx="29" cy="24" r="10" /><circle cx="67" cy="24" r="10" /><path d="M10 65V52c0-10 8-18 19-18s19 8 19 18v13M48 65V52c0-10 8-18 19-18s19 8 19 18v13" /><path d="M38 50h20" /></svg>
                )}
                {service.icon === "workflow" && (
                  <svg viewBox="0 0 96 72"><rect x="6" y="7" width="27" height="19" /><rect x="63" y="7" width="27" height="19" /><rect x="6" y="46" width="27" height="19" /><rect x="63" y="46" width="27" height="19" /><path d="M33 16h30m-7-6 7 6-7 6M63 56H33m7 6-7-6 7-6" /></svg>
                )}
              </div>
              <h3><span>{service.title}</span></h3>
              <p>{service.description}</p>
              <a href="/contact/">{service.cta} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>

        <div class="secondary-offers" aria-label="Additional Raleigh AI Guy services">
          <p><span>Also in the notebook</span>Focused packages for businesses that need the growth fundamentals or a better way to recover existing demand.</p>
          <a href="/small-business-growth/"><small>Packaged service / 01</small><strong>Small Business Growth</strong><span>Website, brand, local visibility, Auto SEO, and follow-up. →</span></a>
          <a href="/lead-recovery/"><small>Revenue recovery / 02</small><strong>Lead Recovery with Mabel</strong><span>Re-engage old leads and return qualified opportunities to your team. →</span></a>
        </div>
      </section>

      <section id="case-study" class="case-study poster-shell" aria-labelledby="case-study-title">
        <div class="case-label">
          <p>Case study:</p>
          <h2 id="case-study-title">Zim Zoom</h2>
          <div class="pixel-computer" aria-hidden="true"><span>⌣</span></div>
        </div>
        <div class="case-metric">
          <p>Projected time savings</p>
          <strong>350–800</strong>
          <span>hours back per year</span>
        </div>
        <div class="case-action">
          <p>A custom command center turned scattered tools and manual handoffs into one clear operating view.</p>
          <a class="poster-button" href="/projects/zimzoom-photo-booth/">View case study <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section id="notes" class="notes poster-shell" aria-labelledby="notes-title">
        <div class="notes-icon" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        <div>
          <p class="section-kicker pink">From the field notes</p>
          <h2 id="notes-title">AI for real work</h2>
          <p>Notes on practical AI, better workflows, and systems that make businesses easier to run.</p>
        </div>
        <a class="poster-button poster-button-yellow" href={notesUrl}>Read the notes <span aria-hidden="true">→</span></a>
      </section>

      <section class="final-cta poster-shell" aria-labelledby="contact-title">
        <div>
          <p class="section-kicker">Start with the work itself</p>
          <h2 id="contact-title">Tell me what you’re trying to make easier.</h2>
        </div>
        <a class="poster-button poster-button-pink" href="/contact/">Work with Danny <span aria-hidden="true">→</span></a>
      </section>
    </main>

    <footer class="poster-footer poster-shell">
      <div>
        <strong>Raleigh AI Guy</strong>
        <p>Making AI useful for the people who run real businesses.</p>
      </div>
      <nav aria-label="Footer navigation">
        <a href="/contact/">Contact</a>
        <a href="/about/">About</a>
        <a href="/projects/">Work</a>
        <a href="/privacy/">Privacy</a>
      </nav>
      <p>© {new Date().getFullYear()} Danny Sullivan · Raleigh, NC</p>
    </footer>
  </div>
</BaseLayout>

<style>
  :global(body) { background: #eee8d6; }

  .poster-site {
    --poster-ink: #17130f;
    --poster-paper: #f1ecdc;
    --poster-yellow: #f0df55;
    --poster-pink: #f43e8d;
    --poster-line: rgb(23 19 15 / 74%);
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    color: var(--poster-ink);
    background-color: var(--poster-paper);
    background-image:
      radial-gradient(circle at 15% 9%, rgb(255 255 255 / 52%) 0 1px, transparent 1.5px),
      radial-gradient(circle at 75% 42%, rgb(23 19 15 / 7%) 0 .7px, transparent 1px),
      repeating-linear-gradient(97deg, transparent 0 97px, rgb(23 19 15 / 2.4%) 98px 99px);
    background-size: 19px 19px, 13px 13px, auto;
    font-family: "Courier Prime", "IBM Plex Mono", monospace;
  }

  .poster-site::before {
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(23 19 15 / 7%), transparent 1.4%, transparent 98.5%, rgb(23 19 15 / 8%)),
      linear-gradient(rgb(23 19 15 / 4%), transparent 1.2%, transparent 98.8%, rgb(23 19 15 / 7%));
    box-shadow: inset 0 0 90px rgb(23 19 15 / 8%);
    content: "";
    mix-blend-mode: multiply;
  }

  .poster-shell { width: min(calc(100% - 2.5rem), 72rem); margin-inline: auto; }

  .poster-header {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 2rem;
    padding-block: 2.1rem 1.2rem;
    border-bottom: 2px solid var(--poster-ink);
  }

  .poster-brand {
    color: inherit;
    font-family: "Instrument Sans", sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -.07em;
    line-height: .76;
    text-transform: uppercase;
  }
  .poster-brand span { display: block; }

  .tape-note {
    display: inline-block;
    max-width: 10rem;
    padding: .48rem .72rem .38rem;
    background: var(--poster-yellow);
    box-shadow: 1px 2px 0 rgb(23 19 15 / 18%);
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .06em;
    line-height: 1.35;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(-1.7deg);
  }

  .desktop-nav { display: flex; justify-content: flex-end; gap: 1.45rem; }
  .desktop-nav a, .mobile-nav a {
    color: inherit;
    font-family: "Instrument Sans", sans-serif;
    font-size: .68rem;
    font-weight: 750;
    letter-spacing: .04em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: .34rem;
    transition: text-decoration-color 140ms ease;
  }
  .desktop-nav a:hover { text-decoration-color: var(--poster-pink); }
  .mobile-nav { display: none; justify-self: end; }

  .hero {
    display: grid;
    min-height: 39rem;
    grid-template-columns: minmax(0, 1.05fr) minmax(22rem, .95fr);
    align-items: stretch;
    border-bottom: 2px solid var(--poster-ink);
  }

  .hero-copy { z-index: 2; align-self: center; padding: 4.5rem 2rem 4rem 0; }
  .utility-label, .section-kicker {
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .utility-label { margin-bottom: 1.4rem; }

  .hero h1, .poster-section h2, .final-cta h2, .notes h2 {
    font-family: "League Gothic", "Instrument Sans", sans-serif;
    font-weight: 400;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 46rem;
    font-size: clamp(4.7rem, 8.2vw, 8rem);
    letter-spacing: -.035em;
    line-height: .78;
  }
  .hero h1 span { color: var(--poster-pink); text-decoration: underline; text-decoration-thickness: .09em; text-underline-offset: .09em; }

  .hero-intro { max-width: 37rem; margin-top: 2.2rem; font-size: clamp(.96rem, 1.55vw, 1.2rem); font-weight: 700; line-height: 1.48; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 2rem; }

  .poster-button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border: 2px solid var(--poster-ink);
    padding: .75rem 1.15rem .62rem;
    color: inherit;
    background: var(--poster-paper);
    box-shadow: 4px 4px 0 var(--poster-ink);
    font-family: "Instrument Sans", sans-serif;
    font-size: .8rem;
    font-weight: 800;
    letter-spacing: .02em;
    text-transform: uppercase;
    transition: transform 130ms ease, box-shadow 130ms ease;
  }
  .poster-button:hover { transform: translate(2px, 2px) rotate(-.35deg); box-shadow: 2px 2px 0 var(--poster-ink); }
  .poster-button-yellow { background: var(--poster-yellow); }
  .poster-button-pink { background: var(--poster-pink); }

  .text-link { color: inherit; font-size: .76rem; font-weight: 700; text-decoration: underline; text-decoration-color: var(--poster-pink); text-decoration-thickness: 2px; text-underline-offset: .32rem; text-transform: uppercase; }

  .hero-portrait { position: relative; min-height: 34rem; align-self: end; overflow: hidden; }
  .portrait-ink { position: absolute; inset: 10% -10% -18% 0; background: radial-gradient(ellipse at 54% 44%, transparent 0 37%, rgb(23 19 15 / 9%) 64%, transparent 74%); transform: rotate(-4deg); }
  .portrait-image {
    position: absolute;
    right: -4%;
    bottom: -2%;
    width: min(112%, 42rem);
    height: auto;
    mix-blend-mode: multiply;
    -webkit-mask-image: radial-gradient(ellipse 74% 79% at 52% 48%, #000 0 63%, transparent 82%);
    mask-image: radial-gradient(ellipse 74% 79% at 52% 48%, #000 0 63%, transparent 82%);
  }
  .hero-portrait::after {
    position: absolute;
    right: 1%;
    bottom: 3%;
    width: 78%;
    height: 48%;
    pointer-events: none;
    background: repeating-radial-gradient(circle, transparent 0 2px, rgb(23 19 15 / 15%) 2px 3px);
    content: "";
    mix-blend-mode: multiply;
    -webkit-mask-image: linear-gradient(transparent, #000 70%);
    mask-image: linear-gradient(transparent, #000 70%);
  }

  .local-badge {
    position: absolute;
    right: 1.1rem;
    bottom: 4.2rem;
    z-index: 3;
    display: grid;
    width: 8.8rem;
    aspect-ratio: 1;
    place-content: center;
    padding: 1.3rem;
    background: var(--poster-pink);
    clip-path: polygon(50% 0, 59% 12%, 72% 4%, 78% 18%, 93% 17%, 91% 32%, 100% 42%, 87% 51%, 96% 64%, 81% 68%, 81% 84%, 65% 82%, 55% 96%, 45% 84%, 30% 96%, 24% 80%, 8% 82%, 10% 65%, 0 55%, 13% 45%, 4% 31%, 20% 27%, 20% 11%, 37% 16%);
    font-family: "Instrument Sans", sans-serif;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(8deg);
  }
  .local-badge span { font-size: .62rem; font-weight: 700; line-height: 1.1; }
  .local-badge strong { display: block; margin-top: .25rem; font-size: 1rem; line-height: .95; }

  .credential-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(.75rem, 2.5vw, 2rem);
    padding-block: 1.35rem;
    border-bottom: 2px solid var(--poster-ink);
    font-family: "Instrument Sans", sans-serif;
    font-size: clamp(.62rem, 1vw, .8rem);
    font-weight: 800;
    letter-spacing: .04em;
    text-align: center;
    text-transform: uppercase;
  }
  .credential-strip i { width: .42rem; height: .42rem; border-radius: 50%; background: var(--poster-pink); }

  .poster-section { padding-block: clamp(4.5rem, 8vw, 7rem); }
  .about { display: grid; grid-template-columns: minmax(12rem, .45fr) 1fr; align-items: center; gap: clamp(2rem, 7vw, 6rem); border-bottom: 2px solid var(--poster-ink); }
  .about-mark { display: grid; min-height: 15rem; place-items: center; border-right: 1.5px dashed var(--poster-line); }
  .about-mark svg { width: min(80%, 13rem); fill: none; stroke: var(--poster-ink); stroke-linecap: square; stroke-linejoin: bevel; stroke-width: 3.2; }
  .section-kicker { margin-bottom: .8rem; }
  .section-kicker.pink { color: var(--poster-pink); }
  .about h2 { max-width: 48rem; font-size: clamp(3.2rem, 6.2vw, 5.8rem); letter-spacing: -.025em; line-height: .86; }
  .about p:not(.section-kicker) { max-width: 46rem; margin-top: 1.5rem; font-size: 1rem; font-weight: 700; line-height: 1.58; }
  .about .text-link { display: inline-flex; margin-top: 1.5rem; }

  .services { border-bottom: 2px solid var(--poster-ink); }
  .section-rule-heading { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1.2rem; }
  .section-rule-heading h2 { font-size: clamp(3rem, 5.5vw, 5rem); letter-spacing: -.02em; line-height: .9; }
  .section-rule-heading span { height: 2px; background: var(--poster-ink); }

  .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 2.4rem; border-block: 2px solid var(--poster-ink); }
  .service-card { position: relative; display: flex; min-height: 27rem; flex-direction: column; padding: 2rem 1.8rem 1.7rem; }
  .service-card + .service-card { border-left: 1.5px dashed var(--poster-line); }
  .service-number { position: absolute; top: .8rem; right: 1rem; color: rgb(23 19 15 / 28%); font-family: "League Gothic", sans-serif; font-size: 2.5rem; }
  .service-icon { display: grid; min-height: 8.5rem; place-items: center; }
  .service-icon svg { width: 6.4rem; fill: none; stroke: var(--poster-ink); stroke-linecap: square; stroke-linejoin: miter; stroke-width: 2.5; }
  .service-card h3 { font-family: "Instrument Sans", sans-serif; font-size: 1rem; font-weight: 850; text-transform: uppercase; }
  .service-card h3 span { display: inline; padding: .26rem .48rem .2rem; background: var(--poster-yellow); box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .service-card p { margin-top: 1rem; font-size: .86rem; font-weight: 700; line-height: 1.48; }
  .service-card > a { margin-top: auto; padding-top: 1.5rem; color: var(--poster-pink); font-family: "Instrument Sans", sans-serif; font-size: .72rem; font-weight: 850; text-decoration: underline; text-underline-offset: .3rem; text-transform: uppercase; }

  .secondary-offers { display: grid; grid-template-columns: .8fr 1fr 1fr; border: 2px solid var(--poster-ink); margin-top: 2rem; background: var(--poster-ink); gap: 2px; }
  .secondary-offers > * { min-width: 0; padding: 1.4rem; background: var(--poster-paper); }
  .secondary-offers > p { margin: 0; font-size: .72rem; font-weight: 700; line-height: 1.55; }
  .secondary-offers > p span { display: block; margin-bottom: .65rem; color: var(--poster-pink); font-size: .6rem; text-transform: uppercase; }
  .secondary-offers > a { display: flex; min-height: 10rem; flex-direction: column; transition: background 150ms ease; }
  .secondary-offers > a:hover { background: var(--poster-yellow); }
  .secondary-offers small { font-size: .58rem; font-weight: 700; text-transform: uppercase; }
  .secondary-offers strong { margin-top: 1rem; font-family: "League Gothic", sans-serif; font-size: 2rem; font-weight: 400; line-height: .95; text-transform: uppercase; }
  .secondary-offers a span { margin-top: auto; padding-top: 1.25rem; font-size: .68rem; font-weight: 700; line-height: 1.4; }

  .case-study { display: grid; grid-template-columns: .6fr 1.25fr .9fr; border: 2px solid var(--poster-ink); margin-block: clamp(4rem, 7vw, 6rem) 1.5rem; box-shadow: 6px 6px 0 var(--poster-ink); }
  .case-label, .case-metric, .case-action { padding: clamp(1.5rem, 3vw, 2.4rem); }
  .case-metric, .case-action { border-left: 1.5px dashed var(--poster-line); }
  .case-label p, .case-label h2 { color: var(--poster-pink); font-family: "Instrument Sans", sans-serif; font-size: 1.1rem; font-weight: 850; line-height: 1; text-transform: uppercase; }
  .case-label h2 { font-size: 1.6rem; }
  .pixel-computer { position: relative; display: grid; width: 5.6rem; height: 4.8rem; margin-top: 2rem; place-items: center; border: 4px solid var(--poster-ink); box-shadow: inset 0 0 0 4px var(--poster-paper), 0 6px 0 -2px var(--poster-ink); font-size: 2rem; }
  .case-metric { display: grid; align-content: center; text-align: center; }
  .case-metric p { font-size: .65rem; font-weight: 700; text-transform: uppercase; }
  .case-metric strong { font-family: "League Gothic", sans-serif; font-size: clamp(5rem, 9vw, 8.4rem); font-weight: 400; letter-spacing: -.035em; line-height: .77; }
  .case-metric span { justify-self: center; padding: .28rem .6rem .2rem; background: var(--poster-yellow); font-family: "Instrument Sans", sans-serif; font-size: .9rem; font-weight: 850; text-transform: uppercase; transform: rotate(-.6deg); }
  .case-action { display: flex; flex-direction: column; justify-content: center; }
  .case-action p { font-size: .84rem; font-weight: 700; line-height: 1.5; }
  .case-action .poster-button { margin-top: 1.3rem; font-size: .7rem; }

  .notes { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.6rem; padding: 1.8rem; border: 2px solid var(--poster-ink); }
  .notes-icon { display: grid; width: 4.2rem; gap: .45rem; padding: .8rem; border: 2px solid var(--poster-ink); transform: rotate(-2deg); }
  .notes-icon span { display: block; height: 2px; background: var(--poster-ink); }
  .notes h2 { font-size: clamp(2.4rem, 4vw, 3.8rem); letter-spacing: -.02em; line-height: .85; }
  .notes p:not(.section-kicker) { max-width: 39rem; margin-top: .55rem; font-size: .8rem; font-weight: 700; line-height: 1.45; }

  .final-cta { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 2rem; padding-block: clamp(4.5rem, 8vw, 7rem); }
