---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import OfferLadder from "@/components/global/OfferLadder.astro";
import gardenImage from "@/images/projects/garden-art-proof-homepage.png";
import zimZoomImage from "@/images/projects/zimzoom-proof-homepage.png";
import backToTheStartImage from "@/images/projects/back-to-the-start-website.png";
import southernRevelryImage from "@/images/projects/southern-revelry-website.png";
import popstarWebsiteImage from "@/images/projects/popstar-photobooths-website.png";
import profileImage from "../../danny.jpeg";

const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);

const caseStudies = [
  {
    label: "Focused improvement",
    title: "Raleigh landscaping SEO system",
    description: "I built the company’s new website and an ongoing SEO system that turns real expertise, project photos, and local search data into a repeatable path to new inquiries.",
    result: "18 useful pages published, live measurement in place, and early rankings moving into view.",
    href: "/projects/garden-art-landscapes/",
    image: gardenImage,
    alt: "Garden & Art Landscapes homepage featuring a lush Raleigh garden and the headline Landscapes with a point of view.",
  },
  {
    label: "Ongoing AI partnership",
    title: "ZimZoom Photo Booth",
    description: "An ongoing partnership to find and fix operational friction—starting with inbox triage, then expanding into the website, customer journey, and day-to-day work.",
    result: "We work through one real bottleneck at a time, building useful systems and improving how the business runs.",
    href: "/projects/zimzoom-photo-booth/",
    secondaryHref: "/blog/posts/create-first-claude-skill-organize-inbox/",
    secondaryLabel: "See the inbox workflow",
    image: zimZoomImage,
    alt: "ZimZoom Photo Booth homepage featuring celebrating guests and the headline Extraordinary Photo Booth Experiences.",
  },
  {
    label: "Website + ongoing growth",
    title: "Back to the Start",
    description: "I built the website for this Coldplay tribute band and continue working with the team to drive qualified traffic and increase booking opportunities through useful content.",
    result: "A distinctive booking-focused site backed by an ongoing content and traffic partnership.",
    href: "https://backtothestart.band/",
    external: true,
    image: backToTheStartImage,
    alt: "Back to the Start website featuring the Coldplay tribute band performing on stage.",
  },
  {
    label: "Ongoing growth partnership",
    title: "Southern Revelry",
    description: "An ongoing partnership for a Texas photo booth company—streamlining how the business works while strengthening search visibility and building content that supports more qualified inquiries.",
    result: "Website, SEO, content, and operational improvements working together around growth and bookings.",
    href: "https://southernrevelrytx.com/",
    external: true,
    image: southernRevelryImage,
    alt: "Southern Revelry website featuring a group posing in front of a photo booth backdrop.",
  },
  {
    label: "Built, grown, and sold",
    title: "Popstar Photo Booths",
    description: "I built and operated this Raleigh service business using the same practical growth approach I bring to client work: a conversion-focused website, local SEO, useful content, and automations supporting Google Ads and day-to-day operations.",
    result: "A firsthand test of the systems—not a client experiment. I grew the business and ultimately sold it.",
    href: "https://popstarphotobooths.com/",
    external: true,
    image: popstarWebsiteImage,
    alt: "Popstar Photo Booths website featuring wedding guests celebrating in a photo booth.",
  },
];
---

<BaseLayout
  pageTitle="Raleigh AI Guy — Practical AI systems for small businesses"
  pageDescription="Danny Sullivan teaches Raleigh small businesses how to use AI in real work, then helps build the systems worth keeping."
>
  <section class="overflow-hidden">
    <Wrapper variant="wide" class="py-14 sm:py-20 lg:py-24">
      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="field-reveal lg:col-span-9">
          <p class="field-label">Danny Sullivan · Raleigh, NC</p>
          <h1 class="font-editorial mt-6 max-w-4xl text-[clamp(3.5rem,8vw,7.2rem)] font-medium leading-[.88] tracking-[-0.055em] text-black">
            Make AI useful.<br /><em class="font-normal text-[var(--brand-orange)]">Then make it yours.</em>
          </h1>
          <p class="mt-8 max-w-xl text-lg leading-8 text-base-600 sm:text-xl">
            Find where AI can recover meaningful time, improve customer response, or remove operational friction—then test the smallest solution worth keeping.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a href="/ai-opportunity-scorecard/" class="site-cta">What’s your AIQ? →</a>
            <a href="/services/" class="text-sm font-semibold underline decoration-black/25 underline-offset-4 hover:decoration-black">See how I help →</a>
          </div>
        </div>

        <div class="field-reveal field-reveal-delay relative w-40 lg:col-span-3 lg:w-full lg:max-w-[17rem] lg:justify-self-end">
          <div class="absolute -right-3 -top-3 h-full w-full bg-[var(--brand-orange)]" aria-hidden="true"></div>
          <Image
            src={profileImage}
            alt="Danny Sullivan"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 272px, 160px"
            loading="eager"
            class="relative aspect-square w-full object-cover grayscale"
          />
          <p class="font-utility absolute -bottom-4 left-3 whitespace-nowrap bg-[var(--brand-paper)] px-3 py-2 text-[.58rem] uppercase tracking-[.1em]">Teacher · Builder · Owner</p>
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="border-y border-black/10 bg-[var(--brand-surface-soft)]">
    <Wrapper variant="wide" class="py-14 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6">
          <p class="field-label">The real starting point</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.98] tracking-[-.04em] sm:text-6xl">You don’t need another list of AI tools.</h2>
          <p class="mt-6 max-w-xl text-base leading-7 text-base-600">You are busy running the business. The hard part is not finding more software—it is knowing which repeated task, delay, or customer handoff is valuable enough to improve first.</p>
        </div>
        <div class="lg:col-span-6">
          <ul class="border-t border-black/15">
            <li class="border-b border-black/15 py-5 text-base font-semibold">Work keeps piling up in the same place.</li>
            <li class="border-b border-black/15 py-5 text-base font-semibold">The team is experimenting, but results are inconsistent.</li>
            <li class="border-b border-black/15 py-5 text-base font-semibold">You cannot tell which AI idea is actually worth the effort.</li>
            <li class="border-b border-black/15 py-5 text-base font-semibold">You want progress without buying a complicated system too soon.</li>
          </ul>
          <div class="mt-7 flex flex-wrap items-center gap-5">
            <a href="/ai-opportunity-assessment/" class="site-cta">Start with the assessment →</a>
            <a href="/ai-opportunity-scorecard/" class="text-sm font-semibold underline decoration-black/20 underline-offset-4">Or check your AIQ →</a>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>

  <OfferLadder surface />

  <section id="selected-work" class="border-t border-black/10 bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="flex items-end justify-between gap-6">
        <div><p class="field-label">Selected work</p><h2 class="font-editorial mt-4 text-4xl leading-none sm:text-5xl">Proof over promises.</h2></div>
        <a href="/projects/" class="text-sm font-semibold underline decoration-black/20 underline-offset-4">See all work →</a>
      </div>
      <div class="mt-14 space-y-20 sm:space-y-28">
        {caseStudies.map((study, index) => (
          <article class="grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
            <a href={study.href} target={study.external ? "_blank" : undefined} rel={study.external ? "noreferrer" : undefined} class:list={["group block lg:col-span-7", index % 2 === 1 && "lg:order-2"]}>
              <div class="aspect-[36/25] overflow-hidden border border-black/10 bg-white">
                <Image src={study.image} alt={study.alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 650px, 100vw" loading="lazy" class="size-full object-cover object-top transition duration-500 group-hover:scale-[1.015]" />
              </div>
            </a>
            <div class:list={["lg:col-span-5", index % 2 === 1 && "lg:order-1"]}>
              <p class="field-label">0{index + 1} · {study.label}</p>
              <h3 class="font-editorial mt-5 text-4xl leading-[1.02] tracking-[-.025em] sm:text-5xl">{study.title}</h3>
              <p class="mt-5 text-base leading-7 text-base-600">{study.description}</p>
              <p class="mt-5 border-l-2 border-[var(--brand-orange)] pl-4 text-sm font-semibold leading-6">{study.result}</p>
              <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
                <a href={study.href} target={study.external ? "_blank" : undefined} rel={study.external ? "noreferrer" : undefined} class="inline-flex text-sm font-semibold underline decoration-black/20 underline-offset-4">{study.external ? "Visit the live site ↗" : "Read the case study →"}</a>
                {study.secondaryHref && <a href={study.secondaryHref} class="inline-flex text-sm font-semibold text-base-600 underline decoration-black/15 underline-offset-4 hover:text-black">{study.secondaryLabel} →</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </Wrapper>
  </section>

  <section class="border-b border-black/10 bg-[var(--brand-surface-soft)]">
    <Wrapper variant="wide" class="py-12 sm:py-16">
      <div class="grid gap-7 lg:grid-cols-[1fr_3fr] lg:items-start">
        <div><p class="field-label">Why Danny</p><h2 class="font-editorial mt-4 text-4xl leading-none">Builder, teacher, owner.</h2></div>
        <div class="grid gap-px border border-black/10 bg-black/10 sm:grid-cols-3">
          <p class="bg-[var(--brand-paper)] p-6 text-sm leading-6"><strong class="block text-base">Production AI</strong><span class="text-base-600">Systems with millions in GMV riding on their reliability.</span></p>
          <p class="bg-[var(--brand-paper)] p-6 text-sm leading-6"><strong class="block text-base">28 courses and labs</strong><span class="text-base-600">Experience turning technical work into practical instruction.</span></p>
          <p class="bg-[var(--brand-paper)] p-6 text-sm leading-6"><strong class="block text-base">Built and sold locally</strong><span class="text-base-600">Firsthand understanding of what has to earn its keep.</span></p>
        </div>
      </div>
      <a href="/about/" class="mt-6 inline-flex text-sm font-semibold underline decoration-black/20 underline-offset-4">Read my background →</a>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4"><p class="field-label">From the field notes</p><h2 class="font-editorial mt-4 text-4xl leading-none sm:text-5xl">Practical ideas for doing the work.</h2><a href="/blog/" class="mt-6 inline-flex text-sm font-semibold underline decoration-black/20 underline-offset-4">See all writing →</a></div>
        <div class="border-t border-black/15 lg:col-span-8">
          {posts.map((post, index) => (
            <a href={`/blog/posts/${post.id}`} class="group grid gap-3 border-b border-black/15 py-6 sm:grid-cols-[3rem_1fr_auto] sm:items-center">
              <span class="field-label text-[var(--brand-orange)]">0{index + 1}</span>
              <span class="text-lg font-semibold group-hover:text-[var(--brand-orange)]">{post.data.title}</span>
              <span class="font-utility text-[.62rem] uppercase tracking-[.08em] text-base-500">{post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}</span>
            </a>
          ))}
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-orange)]">
    <Wrapper variant="wide" class="py-14 sm:py-18">
      <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:items-end">
        <div><p class="field-label text-black/60">Not sure what you need?</p><h2 class="font-editorial mt-4 max-w-3xl text-5xl leading-[.95] tracking-[-.04em] sm:text-6xl">That is exactly what the assessment is for.</h2></div>
        <div class="flex flex-wrap gap-4 sm:justify-end"><a href="/ai-opportunity-assessment/" class="inline-flex min-h-12 items-center justify-center bg-[var(--brand-ink)] px-5 text-sm font-semibold text-[var(--brand-paper)] transition-transform hover:-translate-y-0.5">See the assessment →</a><a href="/ai-opportunity-scorecard/" class="inline-flex min-h-12 items-center text-sm font-semibold underline decoration-black/30 underline-offset-4">Check your AIQ →</a></div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
