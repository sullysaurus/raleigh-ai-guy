---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import gardenImage from "@/images/projects/garden-art-homepage.png";
import zimZoomImage from "@/images/projects/zimzoom-homepage.png";
import leadRecoveryImage from "@/images/projects/raleigh-lead-recovery-homepage.png";
import gametimeLogo from "@/images/brands/gametime.jpg";
import pluralsightLogo from "@/images/brands/pluralsight.png";
import twoULogo from "@/images/brands/2u.png";
import stashLogo from "@/images/brands/stash.png";
import popstarLogo from "@/images/brands/popstar.png";
import profileImage from "../../danny.jpeg";

const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);

const caseStudies = [
  {
    label: "Local growth system",
    title: "Raleigh landscaping SEO system",
    description: "A new website and practical SEO system that turns real expertise, project photos, and local search data into a repeatable path to new inquiries.",
    result: "18 useful pages published, live measurement in place, and early rankings moving into view.",
    href: "/projects/garden-art-landscapes/",
    image: gardenImage,
    alt: "Garden & Art Landscapes homepage featuring a lush Raleigh garden and the headline Landscapes with a point of view.",
  },
  {
    label: "Ongoing AI partnership",
    title: "ZimZoom Photo Booth",
    description: "An ongoing partnership to find and fix operational friction—starting with inbox triage, then expanding into the website, customer journey, and day-to-day work.",
    result: "We work through one real bottleneck at a time, building useful systems and improving how the business runs.",
    href: "/projects/zimzoom-photo-booth/",
    secondaryHref: "/blog/posts/create-first-claude-skill-organize-inbox/",
    secondaryLabel: "See the inbox workflow",
    image: zimZoomImage,
    alt: "ZimZoom Photo Booth homepage featuring celebrating guests and the headline Extraordinary Photo Booth Experiences.",
  },
];
---

<BaseLayout
  pageTitle="Raleigh AI Guy — Practical AI systems for small businesses"
  pageDescription="Danny Sullivan teaches Raleigh small businesses how to use AI in real work, then helps build the systems worth keeping."
>
  <section class="overflow-hidden">
    <Wrapper variant="wide" class="py-14 sm:py-20 lg:py-24">
      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="field-reveal lg:col-span-9">
          <p class="field-label">Danny Sullivan · Raleigh, NC</p>
          <h1 class="font-editorial mt-6 max-w-4xl text-[clamp(3.5rem,8vw,7.2rem)] font-medium leading-[.88] tracking-[-0.055em] text-black">
            Make AI useful.<br /><em class="font-normal text-[var(--brand-orange)]">Then make it yours.</em>
          </h1>
          <p class="mt-8 max-w-xl text-lg leading-8 text-base-600 sm:text-xl">
            I teach small-business teams to use AI in their real work, then build alongside them when the right system needs more than a prompt.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a href="/ai-opportunity-scorecard/" class="site-cta">Take the free AI scorecard →</a>
            <a href="/contact/" class="text-sm font-semibold underline decoration-black/25 underline-offset-4 hover:decoration-black">Work with me →</a>
          </div>
        </div>

        <div class="field-reveal field-reveal-delay relative w-40 lg:col-span-3 lg:w-full lg:max-w-[17rem] lg:justify-self-end">
          <div class="absolute -right-3 -top-3 h-full w-full bg-[var(--brand-orange)]" aria-hidden="true"></div>
          <Image
            src={profileImage}
            alt="Danny Sullivan"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 272px, 160px"
            loading="eager"
            class="relative aspect-square w-full object-cover grayscale"
          />
          <p class="font-utility absolute -bottom-4 left-3 whitespace-nowrap bg-[var(--brand-paper)] px-3 py-2 text-[.58rem] uppercase tracking-[.1em]">Teacher · Builder · Owner</p>
        </div>
      </div>
    </Wrapper>
  </section>

  <section id="experience" class="scroll-mt-6 border-y border-black/10 bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-12 sm:py-16">
      <div class="grid gap-5 border-b border-black/10 pb-8 sm:grid-cols-[1fr_auto] sm:items-end">
        <div><p class="field-label">Experience behind the work</p><h2 class="font-editorial mt-4 max-w-3xl text-4xl leading-[1.02] sm:text-5xl">I can build it, teach it, run it, and help it grow.</h2></div>
        <a href="/about/" class="text-sm font-semibold underline decoration-black/20 underline-offset-4">Read my background →</a>
      </div>
      <div class="mt-8 grid gap-px border border-black/10 bg-black/10 lg:grid-cols-2">
        <article class="grid min-h-64 gap-6 bg-[var(--brand-paper)] p-6 sm:grid-cols-[14rem_1fr] sm:p-8">
          <div><div class="flex h-16 items-center"><Image src={gametimeLogo} alt="Gametime" width={190} densities={[1, 2]} quality={95} loading="eager" class="h-auto w-[11.5rem] mix-blend-multiply" /></div><p class="field-label mt-7">Current work</p></div>
          <div class="sm:border-l sm:border-black/10 sm:pl-7"><h3 class="font-editorial text-3xl leading-none">Production AI</h3><p class="mt-4 max-w-sm text-sm leading-6 text-base-600">I build systems with millions in GMV riding on their reliability.</p></div>
        </article>
        <article class="grid min-h-64 gap-6 bg-[var(--brand-paper)] p-6 sm:grid-cols-[14rem_1fr] sm:p-8">
          <div><div class="flex h-16 items-center gap-3">
            <Image src={pluralsightLogo} alt="Pluralsight" width={110} densities={[1, 2]} quality={95} loading="eager" class="h-auto w-[6.875rem]" />
            <span class="h-8 w-px bg-black/10" aria-hidden="true"></span>
            <div class="relative h-16 w-20 shrink-0 overflow-hidden" role="img" aria-label="2U">
              <Image src={twoULogo} alt="" width={224} densities={[1, 2]} quality={95} loading="eager" class="absolute left-1/2 top-1/2 h-auto w-56 -translate-x-1/2 -translate-y-1/2" />
            </div>
          </div><p class="field-label mt-7">Educator</p></div>
          <div class="sm:border-l sm:border-black/10 sm:pl-7"><h3 class="font-editorial text-3xl leading-none">Built to teach</h3><p class="mt-4 max-w-sm text-sm leading-6 text-base-600">I created 28 Pluralsight courses and labs, developed curriculum, and taught software development at 2U.</p><a href="https://www.pluralsight.com/authors/danny-sullivan" target="_blank" rel="noreferrer" class="mt-5 inline-flex text-xs font-semibold underline decoration-black/20 underline-offset-4">View my courses ↗</a></div>
        </article>
        <article class="grid min-h-64 gap-6 bg-[var(--brand-paper)] p-6 sm:grid-cols-[14rem_1fr] sm:p-8">
          <div><div class="flex h-16 items-center"><Image src={popstarLogo} alt="Popstar Photo Booth" width={154} densities={[1, 2]} loading="eager" class="h-auto w-[9.625rem]" /></div><p class="field-label mt-7">Business owner</p></div>
          <div class="sm:border-l sm:border-black/10 sm:pl-7"><h3 class="font-editorial text-3xl leading-none">Built &amp; sold</h3><p class="mt-4 max-w-sm text-sm leading-6 text-base-600">I operated a Raleigh service business and learned that useful work has to earn its keep.</p></div>
        </article>
        <article class="grid min-h-64 gap-6 bg-[var(--brand-paper)] p-6 sm:grid-cols-[14rem_1fr] sm:p-8">
          <div><div class="flex h-16 items-center">
            <div class="relative h-12 w-[9.5rem] overflow-hidden" role="img" aria-label="Stash">
              <Image src={stashLogo} alt="" width={152} densities={[1, 2]} quality={95} loading="eager" class="absolute left-0 top-1/2 h-auto w-[9.5rem] -translate-y-1/2" />
            </div>
          </div><p class="field-label mt-7">Growth marketing</p></div>
          <div class="sm:border-l sm:border-black/10 sm:pl-7"><h3 class="font-editorial text-3xl leading-none">Growth-minded</h3><p class="mt-4 max-w-sm text-sm leading-6 text-base-600">At Stash, I learned how messaging, customer journeys, and product decisions connect to acquisition.</p></div>
        </article>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-surface-soft)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="field-label">The working philosophy</p>
          <h2 class="font-editorial mt-6 text-5xl leading-[.98] tracking-[-.04em] sm:text-6xl">The goal isn’t to depend on me.</h2>
          <p class="mt-6 max-w-md text-base leading-7 text-base-600">Your team should understand what was built, know how to use it, and feel confident improving it after I leave the room.</p>
        </div>
        <ol class="border-t border-black/15 lg:col-span-7">
          <li class="grid gap-4 border-b border-black/15 py-6 sm:grid-cols-[3rem_1fr]">
            <span class="field-label text-[var(--brand-orange)]">01</span><div><h3 class="text-xl font-semibold">Learn the work</h3><p class="mt-2 text-sm leading-6 text-base-600">We study how the job actually gets done and find the few opportunities worth acting on.</p></div>
          </li>
          <li class="grid gap-4 border-b border-black/15 py-6 sm:grid-cols-[3rem_1fr]">
            <span class="field-label text-[var(--brand-orange)]">02</span><div><h3 class="text-xl font-semibold">Teach the team</h3><p class="mt-2 text-sm leading-6 text-base-600">People practice with their own work, not generic demos, until the skill becomes repeatable.</p></div>
          </li>
          <li class="grid gap-4 border-b border-black/15 py-6 sm:grid-cols-[3rem_1fr]">
            <span class="field-label text-[var(--brand-orange)]">03</span><div><h3 class="text-xl font-semibold">Build what earns a place</h3><p class="mt-2 text-sm leading-6 text-base-600">When software is the right answer, I build a dependable system and make sure your team owns the knowledge.</p></div>
          </li>
        </ol>
      </div>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="flex items-end justify-between gap-6">
        <div><p class="field-label">Ways to work together</p><h2 class="font-editorial mt-4 text-4xl leading-none sm:text-5xl">Start with the work, not the tool.</h2></div>
        <a href="/contact/" class="hidden text-sm font-semibold underline decoration-black/20 underline-offset-4 sm:block">Tell me what’s stuck →</a>
      </div>
      <div class="mt-10 grid gap-4 lg:grid-cols-2">
        <article class="flex min-h-[22rem] flex-col bg-[var(--brand-orange)] p-7 sm:p-9">
          <div class="flex items-center justify-between gap-4"><p class="field-label text-black/60">Ongoing support</p><span class="font-utility text-[.62rem] uppercase tracking-[.1em]">Best fit</span></div>
          <h3 class="font-editorial mt-auto text-5xl leading-none sm:text-6xl">Ongoing AI Partner</h3>
          <p class="mt-5 max-w-lg text-base leading-7 text-black/70">A recurring working relationship to train your team, improve workflows, and build the systems that prove useful.</p>
          <a href="/contact/" class="mt-7 text-sm font-semibold underline decoration-black/30 underline-offset-4">Start here →</a>
        </article>
        <div class="grid gap-4">
          <article class="bg-[var(--brand-paper)] p-7 sm:p-9"><p class="field-label">Learn together</p><h3 class="font-editorial mt-4 text-4xl leading-none">Team AI Workshop</h3><p class="mt-4 text-sm leading-6 text-base-600">A hands-on session built around your real work so the team leaves with practical skills.</p><a href="/contact/" class="mt-5 inline-flex text-sm font-semibold underline decoration-black/20 underline-offset-4">Ask about it →</a></article>
          <article class="border border-black/15 p-7 sm:p-9"><p class="field-label">Focused build</p><h3 class="font-editorial mt-4 text-4xl leading-none">Custom AI System</h3><p class="mt-4 text-sm leading-6 text-base-600">A dependable workflow or product for a problem that deserves more than prompts.</p><a href="/contact/" class="mt-5 inline-flex text-sm font-semibold underline decoration-black/20 underline-offset-4">Tell me more →</a></article>
        </div>
      </div>
    </Wrapper>
  </section>

  <section id="selected-work" class="border-t border-black/10 bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="flex items-end justify-between gap-6">
        <div><p class="field-label">Selected work</p><h2 class="font-editorial mt-4 text-4xl leading-none sm:text-5xl">Proof over promises.</h2></div>
        <a href="/projects/" class="text-sm font-semibold underline decoration-black/20 underline-offset-4">See all work →</a>
      </div>
      <div class="mt-14 space-y-20 sm:space-y-28">
        {caseStudies.map((study, index) => (
          <article class="grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
            <a href={study.href} class:list={["group block lg:col-span-7", index % 2 === 1 && "lg:order-2"]}>
              <div class="overflow-hidden border border-black/10 bg-white">
                <Image src={study.image} alt={study.alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 650px, 100vw" loading="lazy" class="h-auto w-full object-contain transition duration-500 group-hover:scale-[1.015]" />
              </div>
            </a>
            <div class:list={["lg:col-span-5", index % 2 === 1 && "lg:order-1"]}>
              <p class="field-label">0{index + 1} · {study.label}</p>
              <h3 class="font-editorial mt-5 text-4xl leading-[1.02] tracking-[-.025em] sm:text-5xl">{study.title}</h3>
              <p class="mt-5 text-base leading-7 text-base-600">{study.description}</p>
              <p class="mt-5 border-l-2 border-[var(--brand-orange)] pl-4 text-sm font-semibold leading-6">{study.result}</p>
              <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
                <a href={study.href} class="inline-flex text-sm font-semibold underline decoration-black/20 underline-offset-4">Read the case study →</a>
                {study.secondaryHref && <a href={study.secondaryHref} class="inline-flex text-sm font-semibold text-base-600 underline decoration-black/15 underline-offset-4 hover:text-black">{study.secondaryLabel} →</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </Wrapper>
  </section>

  <section class="field-grid bg-[var(--brand-forest)] text-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5">
          <p class="field-label text-white/55"><span class="mr-2 inline-block size-2 animate-pulse rounded-full bg-[var(--brand-orange)]"></span>Building now · Beta testers wanted</p>
          <h2 class="font-editorial mt-6 text-5xl leading-[.98] tracking-[-.04em] sm:text-6xl">Miss the call.<br /><em class="font-normal text-[var(--brand-orange)]">Not the job.</em></h2>
          <p class="mt-6 text-base leading-7 text-white/65">I’m building Mabel, an automated call assistant for local service businesses. She answers missed calls, captures the important details, and puts a clean lead summary on your board.</p>
          <ul class="font-utility mt-7 space-y-3 text-[.66rem] uppercase tracking-[.08em] text-white/55"><li>✓ Keep your current number</li><li>✓ Only missed calls roll over</li><li>✓ Lead details arrive instantly</li></ul>
          <div class="mt-8 flex flex-wrap gap-5"><a href="https://raleighleadrecovery.com/signup" target="_blank" rel="noreferrer" class="site-cta">Join the beta ↗</a><a href="https://raleighleadrecovery.com" target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center text-sm font-semibold text-white/65 hover:text-white">See how it works ↗</a></div>
        </div>
        <a href="https://raleighleadrecovery.com" target="_blank" rel="noreferrer" class="group block bg-[var(--brand-paper)] p-3 lg:col-span-7" aria-label="Visit Raleigh Lead Recovery">
          <Image src={leadRecoveryImage} alt="Raleigh Lead Recovery homepage showing Mabel answering a missed customer call." widths={[640, 960, 1280]} sizes="(min-width: 1024px) 620px, 100vw" loading="lazy" class="h-auto w-full object-contain transition duration-500 group-hover:scale-[1.01]" />
        </a>
      </div>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4"><p class="field-label">From the field notes</p><h2 class="font-editorial mt-4 text-4xl leading-none sm:text-5xl">Practical ideas for doing the work.</h2><a href="/blog/" class="mt-6 inline-flex text-sm font-semibold underline decoration-black/20 underline-offset-4">See all writing →</a></div>
        <div class="border-t border-black/15 lg:col-span-8">
          {posts.map((post, index) => (
            <a href={`/blog/posts/${post.id}`} class="group grid gap-3 border-b border-black/15 py-6 sm:grid-cols-[3rem_1fr_auto] sm:items-center">
              <span class="field-label text-[var(--brand-orange)]">0{index + 1}</span>
              <span class="text-lg font-semibold group-hover:text-[var(--brand-orange)]">{post.data.title}</span>
              <span class="font-utility text-[.62rem] uppercase tracking-[.08em] text-base-500">{post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}</span>
            </a>
          ))}
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-orange)]">
    <Wrapper variant="wide" class="py-14 sm:py-18">
      <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:items-end">
        <div><p class="field-label text-black/60">Have something in mind?</p><h2 class="font-editorial mt-4 max-w-3xl text-5xl leading-[.95] tracking-[-.04em] sm:text-6xl">Tell me where AI should make the work better.</h2></div>
        <a href="/contact/" class="inline-flex min-h-12 items-center justify-center bg-[var(--brand-ink)] px-5 text-sm font-semibold text-[var(--brand-paper)] transition-transform hover:-translate-y-0.5">Start the conversation →</a>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
