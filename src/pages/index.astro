---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { homepageCaseStudy } from "@/data/homepageCaseStudy";
import profileImage from "../../danny.jpeg";

const services = [
  {
    number: "01",
    name: "AI Diagnosis",
    price: "$500 · one-time",
    tagline: "Find out what's actually worth doing.",
    description:
      "I find where time gets lost and give you a short, practical AI roadmap.",
    cta: "Start with a diagnosis",
    href: "mailto:hello@dannysullivan.ai?subject=AI%20Diagnosis",
    color: "bg-[var(--editorial-green)]",
  },
  {
    number: "02",
    name: "AI Partnership",
    price: "starting at $2,000/mo · based on scope",
    tagline: "I build it, run it, and improve it.",
    description:
      "We turn the diagnosis into working systems, then keep them useful as your business and the tools change.",
    footnote: "I take on a small number of ongoing clients.",
    cta: "Discuss a partnership",
    href: "mailto:hello@dannysullivan.ai?subject=AI%20Partnership",
    color: "bg-[var(--editorial-blue)]",
  },
];

---

<BaseLayout
  pageTitle="Practical AI for Raleigh Businesses"
  pageDescription="Practical AI workflows that help Raleigh businesses spend less time on email, marketing, follow-up, and admin."
  socialImage="/raleigh-ai-guy.png"
  socialImageAlt="Raleigh AI Guy — AI help for small business, in plain English"
  socialImageWidth={1840}
  socialImageHeight={1208}
>
  <div class="home-page bg-[var(--editorial-canvas)] text-[var(--editorial-ink)]  ">
    <section class="mx-auto max-w-6xl px-5 pb-16 pt-12 sm:px-8 sm:pb-24 sm:pt-20 lg:pb-28 lg:pt-24">
      <div>
        <p class="site-eyebrow">Raleigh AI Guy · Raleigh, North Carolina</p>
        <h1 class="mt-6 max-w-5xl font-sans text-[clamp(2.8rem,7vw,6rem)] font-semibold leading-[0.94] tracking-[-0.055em]">
          Practical AI for
          <span class="headline-highlight mt-2 block">Raleigh businesses.</span>
        </h1>
        <p class="mt-8 max-w-3xl text-lg font-medium leading-8 text-[var(--editorial-ink)] sm:text-xl sm:leading-9">
          Practical AI systems for service businesses and small teams that want less admin and better follow-through.
        </p>

        <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start lg:gap-16">
          <div>
            <div class="max-w-3xl text-base leading-7 text-base-600 dark:text-base-300 sm:text-lg sm:leading-8">
              <p>I build production AI systems at Gametime and previously taught AI at Pluralsight. Now I bring that experience to local businesses that want useful systems, not hype.</p>
            </div>
            <ul class="mt-8 flex flex-wrap gap-3" aria-label="Areas of expertise">
              <li class="rounded-full border border-[var(--site-line)] bg-[var(--editorial-lavender)] px-4 py-2 text-xs font-semibold uppercase tracking-[0.1em]">AI Systems Builder</li>
              <li class="rounded-full border border-[var(--site-line)] bg-[var(--editorial-green)] px-4 py-2 text-xs font-semibold uppercase tracking-[0.1em]">AI Educator</li>
            </ul>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="mailto:hello@dannysullivan.ai?subject=AI%20Diagnosis" class="editorial-button" data-posthog-event="ai_diagnosis_cta_clicked">Start with a $500 diagnosis <span class="ml-3">→</span></a>
              <a href="/ai-answers/#ask" class="social-chip bg-[var(--editorial-canvas)] text-[var(--editorial-ink)]" data-posthog-event="ai_question_cta_clicked">Ask a quick question <span class="ml-3">→</span></a>
            </div>
          </div>

          <aside class="brand-card bg-[var(--editorial-lavender)] p-4 text-[var(--editorial-ink)] sm:p-5">
            <Image src={profileImage} alt="Danny Sullivan" width={512} height={512} loading="eager" class="aspect-square w-full rounded-[1rem] object-cover" />
            <p class="mt-5 text-xs font-semibold uppercase tracking-[0.14em] text-black/60 dark:text-base-400">About Danny</p>
            <p class="mt-3 font-sans text-2xl font-semibold leading-tight">Work directly with me.</p>
            <p class="mt-3 text-sm leading-6 opacity-65">I review the workflow, build the system, and help you keep it useful.</p>
            <a href="/about/" class="home-text-link mt-5 inline-flex text-sm font-semibold">The longer story →</a>
          </aside>
        </div>
      </div>
    </section>

    <section id="recent-work" class="scroll-mt-6 border-y border-white/10 bg-[var(--brand-ink)] text-white">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1.45fr)_minmax(16rem,.55fr)] lg:gap-16">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em]">{homepageCaseStudy.eyebrow}</p>
            <h2 class="mt-4 max-w-4xl font-sans text-4xl font-semibold leading-[1] tracking-[-0.04em] sm:text-5xl">{homepageCaseStudy.heading}</h2>
            <div class="mt-8 max-w-3xl space-y-5 text-base leading-7 text-white/72">
              {homepageCaseStudy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              <p>
                {homepageCaseStudy.emailSkill.description}
                <a href={homepageCaseStudy.emailSkill.href} class="home-text-link ml-1 font-semibold">
                  {homepageCaseStudy.emailSkill.linkLabel} →
                </a>
              </p>
              <p>{homepageCaseStudy.roadmap}</p>
            </div>
          </div>
          <aside class="brand-card bg-white p-6 text-[var(--brand-ink)] sm:p-7">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-black/55">Anonymized case study</p>
            <p class="mt-8 font-sans text-2xl font-semibold leading-tight">{homepageCaseStudy.clientName || homepageCaseStudy.clientDescription}</p>
            {homepageCaseStudy.clientName && <p class="mt-2 text-sm leading-6 opacity-60">{homepageCaseStudy.clientDescription}</p>}
            <div class="mt-8 border-t-2 border-[var(--editorial-line-strong)] pt-6">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-black/55">In use now</p>
              <ul class="mt-4 space-y-3">
                {homepageCaseStudy.inUse.map((item) => (
                  <li class="grid grid-cols-[1rem_1fr] gap-3 text-sm font-semibold leading-5">
                    <span aria-hidden="true">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="mt-7 border-t border-current/20 pt-6">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-black/55">Building next</p>
              <ul class="mt-4 space-y-3">
                {homepageCaseStudy.buildingNext.map((item) => (
                  <li class="grid grid-cols-[1rem_1fr] gap-3 text-sm font-semibold leading-5">
                    <span aria-hidden="true">→</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            {homepageCaseStudy.quote && (
              <blockquote class="mt-8 border-t-2 border-[var(--editorial-line-strong)] pt-6">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-black/55">Client quote</p>
                <p class="mt-3 text-sm font-semibold leading-6">“{homepageCaseStudy.quote}”</p>
              </blockquote>
            )}
          </aside>
        </div>
      </div>
    </section>

    <section id="services" class="scroll-mt-6 bg-[var(--editorial-canvas)] text-[var(--editorial-ink)]">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-base-500 dark:text-base-400">Services</p>
        <div class="mt-4 grid gap-6 lg:grid-cols-[.85fr_1.15fr] lg:items-end">
          <h2 class="max-w-2xl font-sans text-4xl font-semibold leading-none tracking-[-0.04em] sm:text-5xl">Two ways to work together</h2>
          <p class="max-w-2xl text-base leading-7 text-base-600 dark:text-base-300">Start with a focused diagnosis. Continue with a hands-on partnership when there is something valuable to build.</p>
        </div>

        <div class="mt-12 grid gap-5 lg:grid-cols-2">
          {services.map((service) => (
            <article class:list={["brand-card flex min-h-full flex-col p-6 text-[var(--editorial-ink)] sm:p-7", service.color]}>
              <div class="flex items-start justify-between gap-4 text-xs font-semibold uppercase tracking-[0.14em] text-black/60 dark:text-base-400">
                <span>{service.name}</span>
                <span>{service.number}</span>
              </div>
              <p class="mt-8 text-sm font-semibold leading-5">{service.price}</p>
              <h3 class="mt-4 font-sans text-2xl font-semibold leading-tight">{service.tagline}</h3>
              <p class="mt-5 text-sm leading-6 opacity-70">{service.description}</p>
              <div class="mt-auto pt-7">
                {service.footnote && <p class="mb-5 border-t border-current/20 pt-5 text-xs font-semibold leading-5 opacity-65">{service.footnote}</p>}
                <a href={service.href} class="home-text-link inline-flex min-h-11 items-center text-sm font-semibold">{service.cta} →</a>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <section class="border-t-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-blue)] text-[var(--editorial-ink)]">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] opacity-55">The practical first step</p>
        <h2 class="mt-4 max-w-3xl font-sans text-4xl font-semibold leading-[1.03] tracking-[-0.04em] sm:text-5xl">Find the AI work worth paying for.</h2>
        <p class="mt-6 max-w-2xl text-base leading-7 opacity-70 sm:text-lg">The $500 diagnosis gives you a focused roadmap before you commit to a larger build.</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="mailto:hello@dannysullivan.ai?subject=AI%20Diagnosis" class="editorial-button" data-posthog-event="ai_diagnosis_cta_clicked">Start your diagnosis <span class="ml-3">→</span></a>
          <a href="/ai-answers/#ask" class="social-chip bg-[var(--editorial-canvas)] text-[var(--editorial-ink)]" data-posthog-event="ai_question_cta_clicked">Ask a quick question <span class="ml-3">→</span></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-posthog-event]').forEach(function (link) {
      link.addEventListener('click', function () {
        window.posthog?.capture(link.dataset.posthogEvent, { source: 'home_page' });
      });
    });
  });
</script>
