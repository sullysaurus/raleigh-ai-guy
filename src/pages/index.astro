---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import zimZoomImage from "@/images/projects/zimzoom-proof-homepage.png";
import profileImage from "../../danny.jpeg";

const outcomes = [
  ["Make more", "Respond faster, follow up consistently, and create room for more customers."],
  ["Do less busywork", "Take repeated admin, handoffs, and copy-and-paste work off your plate."],
  ["Get time back", "Give yourself and your team more time for the work only people can do."],
];

const steps = [
  ["Find the leverage", "On our first call, I learn how the business works and find the best place to save time or make money. You do not need to diagnose it first."],
  ["Build the proof", "If you qualify, I build a focused working version in one week—enough to show the opportunity before you make a larger investment."],
  ["See the return", "You see the system in action and what it saves or earns. Then you decide whether we keep improving it together each month."],
];

const fitSignals = [
  "Repeated work is taking at least 5 hours a week",
  "Faster follow-up or more capacity could create real revenue",
  "You can give me access to understand and test the work",
  "You are ready to invest monthly once the value is visible",
];
---

<BaseLayout
  pageTitle="Make More, Do Less Busywork, and Get Time Back — Raleigh AI Guy"
  pageDescription="Danny Sullivan builds practical business systems that increase capacity, reduce busywork, and give owners time back. See a working proof of value before you invest."
>
  <section class="overflow-hidden">
    <Wrapper variant="wide" class="py-8 sm:py-14 lg:py-20">
      <div class="grid min-w-0 items-end gap-8 lg:grid-cols-12 lg:gap-14">
        <div class="field-reveal relative min-w-0 lg:col-span-9">
          <div class="hidden lg:block">
            <p class="field-label flex items-center gap-2 whitespace-nowrap"><span class="size-2 shrink-0 rounded-full bg-[var(--brand-orange)]" aria-hidden="true"></span>Danny Sullivan · Raleigh AI Guy</p>
            <p class="font-utility mt-2 text-[.6rem] uppercase tracking-[.1em] text-base-500">Practical systems for small businesses</p>
          </div>

          <h1 class="font-editorial max-w-5xl text-[clamp(2.5rem,7vw,5.8rem)] font-medium leading-[.9] tracking-[-.05em] text-black lg:mt-6">
            Make more money.<br />Do less busywork.<br /><em class="font-normal text-[var(--brand-orange)]">Get your time back.</em>
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-7 text-base-600 sm:text-xl sm:leading-8 lg:mt-8">We find the best opportunity on our first call. If you qualify, I build a working proof in one week—with no upfront build fee. See what it saves, then decide whether to continue monthly.</p>
          <div class="mt-6 flex flex-col items-start gap-3 min-[420px]:flex-row min-[420px]:items-center sm:mt-7 sm:gap-5">
            <a href="/contact/" class="site-cta">See if your business qualifies →</a>
            <a href="#how-it-works" class="hidden text-sm font-semibold underline decoration-black/25 underline-offset-4 hover:decoration-black sm:block">How it works</a>
          </div>
          <p class="font-utility mt-4 max-w-full text-[.58rem] uppercase leading-4 tracking-[.08em] text-base-500 sm:mt-5 sm:text-[.64rem]">No upfront build fee · No obligation</p>
        </div>

        <div class="field-reveal field-reveal-delay relative hidden w-full max-w-[17rem] lg:col-span-3 lg:block lg:justify-self-end">
          <div class="absolute -right-3 -top-3 h-full w-full bg-[var(--brand-orange)]" aria-hidden="true"></div>
          <Image src={profileImage} alt="Danny Sullivan" widths={[480, 720, 960]} sizes="(min-width: 1024px) 272px, 160px" loading="eager" class="relative aspect-square w-full object-cover grayscale" />
          <p class="font-utility absolute -bottom-4 left-3 whitespace-nowrap bg-[var(--brand-paper)] px-3 py-2 text-[.58rem] uppercase tracking-[.1em]">You run it. I improve it.</p>
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="border-y border-black/10 bg-[var(--brand-forest)] text-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-9 sm:py-11">
      <div class="grid gap-6 sm:grid-cols-3 sm:gap-px sm:bg-white/15">
        {outcomes.map(([title, body]) => (
          <div class="border-t border-white/15 pt-5 first:border-t-0 first:pt-0 sm:border-l sm:border-t-0 sm:px-7 sm:pt-0 sm:first:border-l-0 sm:first:pl-0 sm:last:pr-0">
            <p class="font-editorial text-3xl">{title}</p>
            <p class="mt-2 text-sm leading-6 text-white/55">{body}</p>
          </div>
        ))}
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-surface-soft)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5">
          <p class="field-label">What this looks like · Zim Zoom</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.95] tracking-[-.035em] sm:text-6xl">Every system should show what it saves or earns.</h2>
          <p class="mt-6 text-base leading-7 text-base-600">Zim Zoom Photo Booth had valuable work spread across a busy inbox, repeated decisions, customer handoffs, and day-to-day admin. We started where better systems could create the clearest return.</p>
          <p class="mt-5 text-base leading-7 text-base-600">The owner dashboard connects each improvement to hours returned, estimated dollar value, and the work being handled. That makes the monthly value easy to see.</p>
          <a href="/projects/zimzoom-photo-booth/" class="mt-7 inline-flex text-sm font-semibold underline decoration-black/20 underline-offset-4">Read the Zim Zoom story →</a>
        </div>

        <div class="lg:col-span-7">
          <!-- Swap this framework for the approved live dashboard screenshot and verified metrics when supplied. -->
          <div class="border border-black/15 bg-[var(--brand-ink)] p-3 shadow-[12px_12px_0_var(--brand-orange)] sm:p-5">
            <div class="flex items-center justify-between gap-5 border-b border-white/15 pb-4">
              <div><p class="font-utility text-[.6rem] uppercase tracking-[.12em] text-white/45">Owner dashboard</p><p class="mt-1 text-sm font-semibold text-white">Zim Zoom · Value tracker</p></div>
              <span class="font-utility flex items-center gap-2 text-[.58rem] uppercase tracking-[.1em] text-white/50"><span class="size-2 rounded-full bg-[var(--brand-orange)]"></span>Measurement active</span>
            </div>
            <div class="grid gap-3 py-4 sm:grid-cols-3">
              <div class="border border-white/15 p-4"><p class="font-utility text-[.56rem] uppercase tracking-[.1em] text-white/40">Hours returned</p><p class="font-editorial mt-5 text-3xl text-white">Tracked</p><p class="mt-1 text-xs text-white/45">Against the old workflow</p></div>
              <div class="border border-white/15 p-4"><p class="font-utility text-[.56rem] uppercase tracking-[.1em] text-white/40">Value created</p><p class="font-editorial mt-5 text-3xl text-white">Visible</p><p class="mt-1 text-xs text-white/45">Using an agreed baseline</p></div>
              <div class="border border-white/15 p-4"><p class="font-utility text-[.56rem] uppercase tracking-[.1em] text-white/40">Next move</p><p class="font-editorial mt-5 text-3xl text-[var(--brand-orange)]">Clear</p><p class="mt-1 text-xs text-white/45">Every month</p></div>
            </div>
            <div class="overflow-hidden border border-white/15 bg-white"><Image src={zimZoomImage} alt="Zim Zoom Photo Booth website, one part of the ongoing customer and operations work" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 620px, 100vw" loading="lazy" class="aspect-[16/9] w-full object-cover object-top" /></div>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>

  <section id="how-it-works" class="scroll-mt-6 bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="field-label">The offer</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.95] tracking-[-.035em] sm:text-6xl">One call. One week. Clear value.</h2>
          <p class="mt-6 text-sm leading-6 text-base-600">You do not need an AI idea or a perfectly defined problem. That is what the first call is for.</p>
        </div>
        <ol class="border-t border-black/15 lg:col-span-8">
          {steps.map(([title, body], index) => (
            <li class="grid gap-4 border-b border-black/15 py-6 sm:grid-cols-[3rem_11rem_1fr] sm:gap-6">
              <span class="field-label text-[var(--brand-orange)]">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="font-semibold">{title}</h3>
              <p class="text-sm leading-6 text-base-600">{body}</p>
            </li>
          ))}
        </ol>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-surface-soft)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="field-label">Who qualifies</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.95] tracking-[-.035em] sm:text-6xl">Saving time should create real money.</h2>
          <p class="mt-6 max-w-lg text-base leading-7 text-base-600">I take on the risk of the first build only for businesses where a useful system can create clear ongoing value.</p>
        </div>
        <div class="lg:col-span-7">
          <ul class="border-t border-black/15">
            {fitSignals.map((signal) => <li class="grid grid-cols-[1.5rem_1fr] gap-4 border-b border-black/15 py-5 text-base font-semibold"><span class="text-[var(--brand-orange)]">✓</span><span>{signal}</span></li>)}
          </ul>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a href="/contact/" class="site-cta">See if you qualify →</a>
            <p class="max-w-sm text-xs leading-5 text-base-500">A short application. Mostly multiple choice. Reviewed personally by me.</p>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-orange)]">
    <Wrapper variant="wide" class="py-14 sm:py-20">
      <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:items-end">
        <div><p class="field-label text-black/60">Make more without doing more</p><h2 class="font-editorial mt-4 max-w-4xl text-5xl leading-[.92] tracking-[-.045em] sm:text-7xl">Let’s find the system that gives your business leverage.</h2><p class="mt-5 max-w-2xl text-sm leading-6 text-black/70">I build a focused proof of value in one week. You see what it can save or earn before investing in the full system and monthly partnership.</p></div>
        <a href="/contact/" class="inline-flex min-h-12 items-center justify-center bg-[var(--brand-ink)] px-5 text-sm font-semibold text-[var(--brand-paper)] transition-transform hover:-translate-y-0.5">Apply for a proof of value →</a>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
