---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import cineSponsor from "@/images/ventures/cinesponsor-marketplace.png";
import drumForFun from "@/images/ventures/drum-for-fun-concept.png";
import popstarPhotoBooths from "@/images/ventures/popstar-photo-booths-hero.png";
import prowl from "@/images/ventures/prowl-app-website.png";
import raleighLeadRecovery from "@/images/ventures/raleigh-lead-recovery-hero.png";

return Astro.redirect("/", 302);

const ideas = [
  { title: "Raleigh Lead Recovery", status: "Active", category: "Local service · AI · Automation", tagline: "Keep working. We’ll catch the call.", description: "A missed-call recovery service for busy Raleigh businesses. Dana answers calls that would have gone to voicemail, captures what the customer needs, and texts the opportunity to the team.", image: raleighLeadRecovery, alt: "Raleigh Lead Recovery website homepage", href: "https://raleighleadrecovery.com/", cta: "See the project" },
  { title: "Prowl.fm", status: "Building", category: "Mobile · Music · Discovery", tagline: "Find live music near you, right now.", description: "A real-time map for finding nearby live music while it is still happening. Fans and artists put the room on the map, listeners follow the signal, and the city becomes the lineup.", image: prowl, alt: "Prowl live music discovery app website", href: "https://prowl.fm/", cta: "See what I’m building" },
  { title: "Popstar Photo Booths", status: "Built & sold", category: "Events · Photography", tagline: "A party business built to perform.", description: "I built and operated this Raleigh event business, pairing studio-quality photography with a technology-forward guest experience, then sold it to a new owner.", image: popstarPhotoBooths, alt: "Popstar Photo Booths website homepage", href: "https://popstarphotobooths.com/", cta: "See the finished project" },
  { title: "Drum for Fun", status: "Concept", category: "Music · Membership", tagline: "Learn, restart, or just hit something in time.", description: "An early idea for a private drum studio built specifically for grown-ups: private rooms, ready-to-play gear, flexible memberships, and music people actually want to learn.", image: drumForFun, alt: "Drum for Fun adult drum studio concept website", href: "https://drumforfun.netlify.app/", cta: "Explore the concept" },
  { title: "CineSponsor", status: "Experiment", category: "Marketplace · Events · Local sponsorship", tagline: "Where local brands meet outdoor cinemas.", description: "A marketplace idea connecting pop-up cinema operators with local businesses. Organizers package sponsorships, brands find nearby audiences, and the deal moves through one focused platform.", image: cineSponsor, alt: "CineSponsor pop-up cinema sponsorship marketplace website", href: "https://www.cinesponsor.com/", cta: "Explore the experiment" },
];
---

<BaseLayout pageTitle="The Lab — Ideas, Experiments, and Side Projects" pageDescription="A creative outlet for ideas Danny Sullivan has built, tested, finished, paused, or is still figuring out.">
  <div class="editorial-page bg-[#fffdf8] text-[#151515] dark:bg-base-950 dark:text-white">
    <header class="border-b-2 border-[#151515] bg-[#dce8ff] dark:border-white dark:bg-[#17233c]"><div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1fr_22rem] lg:items-end lg:py-28"><div><p class="text-xs font-medium uppercase tracking-[0.14em] opacity-55">The Lab · Ideas in motion</p><h1 class="mt-5 max-w-3xl font-sans text-4xl font-semibold leading-[1.04] tracking-[-0.04em] sm:text-6xl lg:text-7xl">A home for ideas I wanted to see exist.</h1></div><div><p class="text-base leading-7 opacity-70">Some became businesses. Some are still experiments. Some are finished, paused, or waiting for another pass.</p><p class="mt-4 text-sm font-semibold">This is my creative outlet for finding out what an idea can become.</p></div></div></header>

    <section class="bg-[#f0e4ff] dark:bg-[#302341]">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        {ideas.map((idea, index) => (
          <article class="grid gap-8 border-b-2 border-[#151515] py-12 last:border-b-0 dark:border-white lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-16 lg:py-16">
            <a href={idea.href} target="_blank" rel="noreferrer" class:list={["block overflow-hidden border-2 border-[#151515] bg-white p-3 shadow-[6px_6px_0_#151515] dark:border-white dark:bg-base-950 dark:shadow-[6px_6px_0_#f4f1e8]", index % 2 === 1 && "lg:order-2"]}><Image src={idea.image} alt={idea.alt} width={idea.image.width} height={idea.image.height} class="aspect-[16/10] w-full object-contain object-center" loading={index < 2 ? "eager" : "lazy"} /></a>
            <div><div class="flex flex-wrap items-center gap-3"><span class="border-2 border-[#151515] bg-[#d7ef6f] px-2.5 py-1 text-[.65rem] font-semibold uppercase tracking-[.12em] text-[#151515] dark:border-white">{idea.status}</span><p class="text-xs font-medium uppercase tracking-wide text-base-400">{String(index + 1).padStart(2, "0")} · {idea.category}</p></div><h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight sm:text-4xl">{idea.title}</h2><strong class="mt-4 block text-base font-medium">{idea.tagline}</strong><p class="mt-4 max-w-xl text-sm leading-6 text-base-500 dark:text-base-400">{idea.description}</p><a href={idea.href} target="_blank" rel="noreferrer" class="mt-6 inline-block text-sm font-medium">{idea.cta} →</a></div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
