---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout
  pageTitle="Contact Danny Sullivan — Raleigh AI Guy"
  pageDescription="Get in touch with Danny Sullivan about custom automation, AI concierge support, in-person training, partnerships, speaking, or media."
>
  <section>
    <Wrapper variant="wide" class="py-14 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <p class="print-stamp mx-auto">Contact</p>
          <h1 class="font-editorial mt-6 text-6xl font-medium leading-[.9] tracking-[-.045em] sm:text-8xl">Get in touch.</h1>
          <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-base-600">Custom automation, AI concierge support, in-person training, partnerships, speaking, or media. If it feels like a strong fit, I’ll reply personally.</p>
        </div>

        <div class="print-panel mt-10 p-6 sm:p-9">
          <form name="contact" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="website">
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden"><label>Do not fill this out: <input name="website" /></label></p>

            <div class="grid gap-5 sm:grid-cols-2">
              <label class="intake-label sm:col-span-2">Name *<input class="intake-field" type="text" name="name" autocomplete="name" required /></label>
              <label class="intake-label">Email *<input class="intake-field" type="email" name="email" autocomplete="email" required /></label>
              <label class="intake-label">Company<input class="intake-field" type="text" name="company" autocomplete="organization" /></label>
            </div>

            <label class="intake-label mt-7">Reason *
              <select class="intake-field" name="reason" required>
                <option value="" selected disabled>Choose one</option>
                <option>Custom automation</option>
                <option>AI concierge support</option>
                <option>In-person training or workshop</option>
                <option>Partnership</option>
                <option>Speaking</option>
                <option>Media or press</option>
                <option>Something else</option>
              </select>
            </label>

            <label class="intake-label mt-7">Message *
              <textarea class="intake-field intake-textarea" name="message" rows="6" maxlength="2000" required></textarea>
            </label>

            <button type="submit" class="site-cta mt-7 w-full">Send message →</button>
            <p class="mt-5 text-center text-xs leading-5 text-base-500">One form for everything. I read every message myself.</p>
          </form>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
