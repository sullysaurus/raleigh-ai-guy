---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout
  pageTitle="Work with Danny Sullivan — Raleigh AI Guy"
  pageDescription="Tell Danny where AI could make your team's work better. Ask about ongoing AI support, team workshops, or a custom AI system."
>
  <section>
    <Wrapper variant="wide" class="py-16 sm:py-24 lg:py-28">
      <div class="border-t border-black/10 pt-6">
        <div class="grid gap-6 sm:grid-cols-[1fr_.75fr] sm:items-end sm:gap-12">
          <div>
            <p class="field-label flex items-center gap-2"><span class="size-2 rounded-full bg-[var(--brand-orange)]" aria-hidden="true"></span>Work with me</p>
            <h1 class="font-editorial mt-6 max-w-3xl text-5xl font-medium leading-[.95] tracking-[-0.045em] sm:text-7xl">What do you want your team to get better at?</h1>
          </div>
          <p class="max-w-lg text-sm leading-6 text-base-500 sm:pb-1">Tell me where you are trying to go. I’ll read it personally and reply with the most useful next step.</p>
        </div>

        <form name="work-with-me" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="website" class="mt-10 border-y border-black/10 py-7 sm:mt-12 sm:py-9">
          <input type="hidden" name="form-name" value="work-with-me" />
          <p class="hidden"><label>Do not fill this out: <input name="website" /></label></p>

          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            <label class="intake-label">Name<input class="intake-field" type="text" name="name" autocomplete="name" placeholder="Your name" required /></label>
            <label class="intake-label">Work email<input class="intake-field" type="email" name="email" autocomplete="email" placeholder="you@company.com" required /></label>
            <label class="intake-label sm:col-span-2 lg:col-span-1">Company <span class="font-normal text-base-400">(optional)</span><input class="intake-field" type="text" name="company" autocomplete="organization" placeholder="Business name" /></label>
          </div>

          <fieldset class="mt-8">
            <legend class="intake-label">How would you like to work together?</legend>
            <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
              <label class="intake-choice"><input class="peer sr-only" type="radio" name="service" value="Ongoing AI Partner" required /><span>Ongoing AI partner</span></label>
              <label class="intake-choice"><input class="peer sr-only" type="radio" name="service" value="Team AI Workshop" /><span>Team AI workshop</span></label>
              <label class="intake-choice"><input class="peer sr-only" type="radio" name="service" value="Custom AI System" /><span>Custom AI system</span></label>
              <label class="intake-choice"><input class="peer sr-only" type="radio" name="service" value="Not sure yet" /><span>Not sure yet</span></label>
            </div>
          </fieldset>

          <div class="mt-8 grid gap-5 lg:grid-cols-[1.35fr_.65fr]">
            <label class="intake-label">What should AI help your team do better?
              <textarea class="intake-field intake-textarea" name="goal" rows="4" maxlength="1800" placeholder="A process, bottleneck, or outcome you want to improve…" required></textarea>
            </label>
            <label class="intake-label">What have you tried? <span class="font-normal text-base-400">(optional)</span>
              <textarea class="intake-field intake-textarea" name="past_attempts" rows="4" maxlength="1200" placeholder="Tools, experiments, or nothing yet"></textarea>
            </label>
          </div>

          <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center">
            <button type="submit" class="site-cta">Start the conversation →</button>
            <p class="text-xs leading-5 text-base-400">No sales sequence. You’ll hear directly from me.</p>
          </div>
        </form>

        <p class="mt-6 text-sm text-base-500">Prefer email? <a href="mailto:hello@raleighaiguy.com" class="font-medium text-black underline decoration-black/20 underline-offset-4 hover:decoration-black">hello@raleighaiguy.com</a></p>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
