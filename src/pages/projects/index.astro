---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ProjectsEntries from "@/components/projects/ProjectsEntries.astro";
import { getCollection } from "astro:content";

const allProjects = (await getCollection("projects")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout pageTitle="Projects" pageDescription="Selected projects across AI, product, automation, content, and growth.">
  <section class="editorial-page bg-[var(--editorial-canvas)] text-[var(--editorial-ink)]  ">
    <div class="border-b-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-orange)]  "><Wrapper variant="standard" class="pt-12 lg:py-32 xl:py-44">
      <Text tag="h1" variant="displayXS" class="max-w-3xl text-balance font-medium text-black dark:text-white">Selected work across AI, product, and useful systems.</Text>
    </Wrapper></div>
    <Wrapper variant="standard" class="pb-20 pt-12">
      <div class="border-t border-black/10 pt-4 dark:border-white/10">
        <Text tag="p" variant="textSM" class="max-w-2xl text-base-500 dark:text-base-400 2xl:text-base">A few projects across AI, product, automation, content, and growth. These are the kinds of problems I like: messy discovery workflows, useful tools, and product surfaces that make a real behavior easier.</Text>
      </div>
      <div class="mt-8 flex flex-col divide-y divide-black/10 border-y border-black/10 dark:divide-white/10 dark:border-white/10">
        {allProjects.map((post) => <ProjectsEntries post={post} />)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
