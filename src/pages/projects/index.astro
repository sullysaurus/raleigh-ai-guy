---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ProjectsEntries from "@/components/projects/ProjectsEntries.astro";
import { getCollection } from "astro:content";

const projectOrder = ["garden-art-landscapes", "zimzoom-photo-booth", "inbox-triage-workflow"];
const allProjects = (await getCollection("projects")).sort(
  (a, b) => projectOrder.indexOf(a.id) - projectOrder.indexOf(b.id)
);
---

<BaseLayout pageTitle="Projects" pageDescription="Selected projects across AI, product, automation, content, and growth.">
  <section>
    <Wrapper variant="standard" class="py-16 sm:py-24 lg:py-32">
      <p class="text-sm font-medium text-base-500">Work</p>
      <h1 class="mt-6 text-4xl font-medium leading-[1.08] tracking-[-0.045em] text-black sm:text-5xl">Selected projects across AI, product, and useful systems.</h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-base-500">A few examples of turning messy workflows, real business knowledge, and good tools into something people can use.</p>
    </Wrapper>
    <Wrapper variant="standard" class="pb-20">
      <div class="border-t border-black/10 pt-4">
        <Text tag="p" variant="textSM" class="max-w-2xl text-base-500 2xl:text-base">Projects are shown with the problem, the decisions behind the work, and what changed.</Text>
      </div>
      <div class="mt-8 flex flex-col divide-y divide-black/10 border-y border-black/10">
        {allProjects.map((post) => <ProjectsEntries post={post} />)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
