---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/global/PageIntro.astro";
import ContactBand from "@/components/global/ContactBand.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ProjectsEntries from "@/components/projects/ProjectsEntries.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const projectOrder = ["zimzoom-photo-booth", "garden-art-landscapes"];
const allProjects = (await getCollection("projects"))
  .filter((project) => projectOrder.includes(project.id))
  .sort(
  (a, b) => projectOrder.indexOf(a.id) - projectOrder.indexOf(b.id)
  );
const featured = allProjects.find((project) => project.id === "zimzoom-photo-booth");
const remaining = allProjects.filter((project) => project.id !== featured?.id);
---

<BaseLayout pageTitle="Projects" pageDescription="Selected projects across AI, product, automation, content, and growth.">
  <PageIntro eyebrow="Selected work" title="Useful work has to earn its keep." description="Ongoing partnerships and focused projects that improve how a business operates, teaches its team, and serves its customers." />

  {featured && (
    <section class="border-y border-black/10 bg-[var(--brand-paper)]">
      <Wrapper variant="wide" class="py-12 sm:py-16">
        <a href={`/projects/${featured.id}`} class="group grid overflow-hidden border border-black/10 lg:grid-cols-12">
          <div class="flex flex-col bg-[var(--brand-forest)] p-7 text-[var(--brand-paper)] sm:p-10 lg:col-span-5">
            <div class="flex items-center justify-between gap-5"><p class="field-label text-white/55"><span class="mr-2 inline-block size-2 animate-pulse rounded-full bg-[var(--brand-orange)]"></span>Ongoing partnership</p><span class="font-utility text-[.62rem] uppercase tracking-[.08em] text-white/40">Working now</span></div>
            <h2 class="font-editorial mt-12 text-5xl leading-[.95] tracking-[-.04em] sm:text-6xl">{featured.data.title}</h2>
            <p class="mt-6 text-base leading-7 text-white/65">{featured.data.subtitle}</p>
            <span class="mt-10 text-sm font-semibold underline decoration-white/25 underline-offset-4 lg:mt-auto lg:pt-10">See how we work together →</span>
          </div>
          <div class="flex items-center bg-white p-3 lg:col-span-7">
            <Image src={featured.data.image.url} alt={featured.data.image.alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 650px, 100vw" loading="eager" class="h-auto w-full object-contain transition duration-500 group-hover:scale-[1.01]" />
          </div>
        </a>
      </Wrapper>
    </section>
  )}

  <section class="bg-[var(--brand-surface-soft)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-8 border-b border-black/10 pb-8 sm:grid-cols-[1fr_auto] sm:items-end"><div><p class="field-label">Focused projects</p><h2 class="font-editorial mt-4 text-4xl leading-none sm:text-5xl">One clear problem. One useful result.</h2></div><p class="max-w-sm text-sm leading-6 text-base-600">Smaller engagements that turn a specific bottleneck or growth opportunity into something practical.</p></div>
      <div class="mt-10 max-w-3xl">
        {remaining.map((post) => <ProjectsEntries post={post} />)}
      </div>
    </Wrapper>
  </section>
  <ContactBand eyebrow="Have a project in mind?" title="Start with the work that needs to get better." />
</BaseLayout>
