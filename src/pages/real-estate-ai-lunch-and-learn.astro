---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/global/PageIntro.astro";
import EditorialList from "@/components/global/EditorialList.astro";
import ContactBand from "@/components/global/ContactBand.astro";

const topics = [
  { title: "Useful work", body: "Where AI is genuinely useful in real-estate work." },
  { title: "Recognizable examples", body: "Practical applications for listings, follow-up, research, and content." },
  { title: "Good judgment", body: "Common privacy, accuracy, and review mistakes." },
  { title: "A first move", body: "How to choose one small workflow to improve first." },
];
---

<BaseLayout pageTitle="Practical AI for Real Estate Teams" pageDescription="A practical AI lunch-and-learn for real-estate teams and professional groups in Raleigh.">
  <PageIntro eyebrow="Real-estate lunch and learn" title="A practical AI conversation for real-estate teams." description="A clear, grounded session about the work agents and teams already do, without turning it into a tool demo or sales pitch." ctaHref="/contact/" ctaLabel="Ask about a session" />
  <EditorialList eyebrow="The conversation" title="Useful ideas, grounded in the work." items={topics} surface="soft" />
  <ContactBand eyebrow="Raleigh or remote" title="Shape the session around what your team needs to understand." ctaLabel="Plan a session" />
</BaseLayout>
