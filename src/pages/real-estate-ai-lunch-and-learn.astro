---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import profileImage from "../../danny.jpeg";

const workflows = [
  ["01", "Listing descriptions", "Turn verified property facts into a stronger first draft without inventing details."],
  ["02", "A month of social content", "Build a practical content plan from one listing, market update, or client question."],
  ["03", "Buyer and seller follow-up", "Transform rough notes into a warm email that still sounds personal."],
  ["04", "Open-house marketing", "Create the caption, carousel outline, email, and event reminder from one source."],
  ["05", "Market-update videos", "Turn approved market information into a short script agents can confidently record."],
  ["06", "Safer AI habits", "Know what to verify, what not to upload, and where human judgment still matters."],
];

const agenda = [
  ["00–07", "AI without the vocabulary lesson", "A plain-English map of Claude, Projects, prompts, and Claude Design."],
  ["07–22", "Live real-estate workflows", "See listing, follow-up, social, and market-update examples built from verified inputs."],
  ["22–35", "Try the main prompt", "Use one practical prompt and learn how to improve the result without starting over."],
  ["35–45", "Review + questions", "Check accuracy, discuss Fair Housing and privacy risks, and identify a useful next step."],
];

const resources = [
  {
    label: "Start here",
    title: "7 Practical Ways Real Estate Agents Can Use Claude",
    description: "The simplest Claude-first toolkit for everyday agent work.",
    href: "/blog/posts/ai-tools-for-real-estate-agents-2026/",
  },
  {
    label: "Content system",
    title: "Create a Month of Social Content With Claude",
    description: "A repeatable campaign workflow with one comprehensive prompt.",
    href: "/blog/posts/month-of-real-estate-social-content-with-ai/",
  },
  {
    label: "Listing workflow",
    title: "Write Better Listing Descriptions With Claude",
    description: "Draft, verify, revise, and repurpose a listing from approved facts.",
    href: "/blog/posts/write-real-estate-listing-descriptions-with-ai/",
  },
];

const fieldClass = "mt-2 w-full border-2 border-[#151515] bg-[#fffdf8] px-4 py-3 text-base text-black outline-none transition placeholder:text-base-400 focus:bg-white focus:shadow-[3px_3px_0_#151515]";
---

<BaseLayout
  pageTitle="Complimentary AI Lunch & Learn for Real Estate Offices"
  pageDescription="A practical, complimentary 45-minute AI Lunch & Learn for Raleigh-area real estate agents covering Claude, listing descriptions, social content, follow-up, market videos, and safer AI use."
>
  <div class="re-lunch-page bg-[var(--editorial-canvas)] text-[var(--editorial-ink)]  ">
    <section class="relative overflow-hidden border-b-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-orange)] text-[var(--editorial-ink)]   ">
      <div class="re-grid absolute inset-0 opacity-20" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1fr_22rem] lg:items-center lg:py-28">
        <div>
          <p class="inline-flex border-2 border-[var(--editorial-line-strong)] bg-[#d7ef6f] px-3 py-2 text-xs font-semibold uppercase tracking-[0.15em] shadow-[3px_3px_0_#151515]  dark:text-[#151515]">
            Complimentary for qualifying real estate offices
          </p>
          <h1 class="mt-7 max-w-4xl text-balance font-sans text-4xl font-semibold leading-[1.02] tracking-[-0.045em] sm:text-6xl lg:text-7xl">
            Give your agents AI workflows they can use before lunch is over.
          </h1>
          <p class="mt-7 max-w-2xl text-base leading-7 text-black/70 dark:text-white/75 sm:text-lg">
            A hands-on 45-minute session about listing copy, social content, client follow-up, market videos, and using Claude without losing the agent’s voice—or inventing the facts.
          </p>
          <div class="mt-9 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
            <a href="#request" class="editorial-button">Request a complimentary session <span class="ml-3">→</span></a>
            <span class="text-sm font-medium text-black/60 dark:text-white/65">Raleigh-area or remote · No obligation</span>
          </div>
        </div>

        <aside class="relative border-2 border-[var(--editorial-line-strong)] bg-[#fffdf8] p-7 text-[#151515] shadow-[9px_9px_0_var(--editorial-shadow)]   sm:p-8">
          <div class="absolute -right-3 -top-3 rotate-3 border-2 border-[var(--editorial-line-strong)] bg-[#2947ff] px-3 py-2 text-xs font-semibold text-white ">FIELD GUIDE</div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-base-500">The useful version</p>
          <p class="mt-4 font-sans text-6xl font-semibold tracking-[-0.06em]">45</p>
          <p class="-mt-2 text-sm font-semibold uppercase tracking-[0.18em]">minutes</p>
          <ul class="mt-7 divide-y-2 divide-[#151515] border-y-2 border-[#151515] text-sm">
            <li class="flex justify-between gap-5 py-3"><span>Format</span><strong>Live + Q&amp;A</strong></li>
            <li class="flex justify-between gap-5 py-3"><span>Audience</span><strong>Agents + staff</strong></li>
            <li class="flex justify-between gap-5 py-3"><span>Cost</span><strong>$0</strong></li>
            <li class="flex justify-between gap-5 py-3"><span>Pitch deck</span><strong>None</strong></li>
          </ul>
          <p class="mt-5 text-xs leading-5 text-base-500">Your office assembles the group. I bring the practical examples, prompts, and honest limitations.</p>
        </aside>
      </div>
    </section>

    <section class="border-b-2 border-[var(--editorial-line-strong)] ">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
        <div class="grid gap-8 lg:grid-cols-[18rem_1fr] lg:gap-16">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-base-500 dark:text-base-400">What agents will see</p>
            <h2 class="mt-4 text-balance font-sans text-3xl font-semibold tracking-tight sm:text-4xl">Real work. Real prompts. No robot theater.</h2>
            <p class="mt-5 text-sm leading-6 text-base-500 dark:text-base-400">The examples can adjust to the questions in the room, but the session stays focused enough to remain useful.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {workflows.map(([number, title, description], index) => (
              <article class:list={[
                "min-h-64 border-2 border-[var(--editorial-line-strong)] p-5 text-[var(--editorial-ink)] shadow-[5px_5px_0_var(--editorial-shadow)]   ",
                index % 3 === 0 ? "bg-[var(--editorial-blue)] " : index % 3 === 1 ? "bg-[var(--editorial-green)] " : "bg-[var(--editorial-purple)] ",
              ]}>
                <span class="text-xs font-semibold opacity-45">{number}</span>
                <h3 class="mt-12 font-sans text-xl font-semibold leading-tight">{title}</h3>
                <p class="mt-3 text-sm leading-6 opacity-65">{description}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-b-2 border-[var(--editorial-line-strong)] bg-[#151515] text-white  dark:bg-black">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[20rem_1fr] lg:gap-20">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/45">The agenda</p>
          <h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight sm:text-5xl">Forty-five minutes with a finish line.</h2>
          <p class="mt-5 text-sm leading-6 text-white/60">Agents leave knowing what to try first and what they still need to verify.</p>
        </div>
        <ol class="border-y-2 border-white">
          {agenda.map(([time, title, description]) => (
            <li class="grid gap-3 border-b border-white/25 py-6 last:border-b-0 sm:grid-cols-[5rem_1fr]">
              <span class="font-mono text-xs font-semibold text-[#d7ef6f]">{time}</span>
              <div>
                <h3 class="font-sans text-lg font-semibold">{title}</h3>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-white/60">{description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="border-b-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-lime)] text-[#151515]   dark:text-[#151515]">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] opacity-55">Try the material before we meet</p>
          <h2 class="mt-4 text-balance font-sans text-3xl font-semibold tracking-tight sm:text-5xl">Useful resources—not a brochure disguised as a blog.</h2>
          <p class="mt-5 max-w-2xl text-sm leading-6 opacity-70">Each guide includes a main or comprehensive prompt your agents can copy into Claude and test with approved information.</p>
        </div>
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {resources.map((resource) => (
            <a href={resource.href} class="group flex min-h-72 flex-col border-2 border-[#151515] bg-[#fffdf8] p-6 text-[#151515] shadow-[6px_6px_0_#151515] transition hover:-translate-y-1 hover:shadow-[9px_9px_0_#151515]">
              <span class="text-xs font-semibold uppercase tracking-[0.14em] text-base-400">{resource.label}</span>
              <h3 class="mt-8 font-sans text-2xl font-semibold leading-tight">{resource.title}</h3>
              <p class="mt-4 text-sm leading-6 text-base-500">{resource.description}</p>
              <span class="mt-auto pt-8 text-sm font-semibold">Read the guide <span class="inline-block transition group-hover:translate-x-1">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b-2 border-[var(--editorial-line-strong)] ">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-2 lg:gap-16">
        <div class="border-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-blue)] p-7 text-[var(--editorial-ink)] shadow-[6px_6px_0_var(--editorial-shadow)]     sm:p-9">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] opacity-50">Why it is complimentary</p>
          <h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight">Your office brings the audience. I bring the session.</h2>
          <p class="mt-5 text-sm leading-6 opacity-70">The introductory Lunch &amp; Learn uses a proven format with limited custom preparation. That keeps it practical for agents and sustainable for me to offer to qualifying local offices.</p>
          <ul class="mt-7 space-y-3 text-sm font-medium">
            <li>✓ No cost to the office</li>
            <li>✓ No purchase requirement</li>
            <li>✓ No attendee list required</li>
            <li>✓ Limited monthly availability</li>
          </ul>
        </div>
        <div class="border-l-4 border-[#ff6f4f] py-2 pl-7 sm:pl-10">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-base-500 dark:text-base-400">What happens afterward?</p>
          <h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight">Nothing—unless someone wants help.</h2>
          <p class="mt-5 text-sm leading-6 text-base-500 dark:text-base-400">Agents may use the free articles and prompts on their own. Anyone who wants help applying a workflow can request a separate conversation. Tailored private workshops and implementation are optional and scoped separately.</p>
          <p class="mt-6 text-sm font-semibold">The Lunch &amp; Learn remains useful even if nobody buys anything.</p>
        </div>
      </div>
    </section>

    <section class="border-b-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-canvas)]  ">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1fr_1fr] lg:gap-16">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-base-500 dark:text-base-400">A good fit</p>
          <h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight sm:text-4xl">The complimentary session works best when…</h2>
          <ul class="mt-7 space-y-4 text-sm leading-6 text-base-600 dark:text-base-300">
            <li class="grid grid-cols-[1.5rem_1fr] gap-3"><span class="font-semibold text-[#2947ff] dark:text-[#8ca0ff]">01</span><span>Your office expects at least eight agents, staff members, or leaders to attend.</span></li>
            <li class="grid grid-cols-[1.5rem_1fr] gap-3"><span class="font-semibold text-[#2947ff] dark:text-[#8ca0ff]">02</span><span>A broker, owner, team lead, office manager, or organizer is helping coordinate the session.</span></li>
            <li class="grid grid-cols-[1.5rem_1fr] gap-3"><span class="font-semibold text-[#2947ff] dark:text-[#8ca0ff]">03</span><span>The group wants practical education—not continuing-education credit or a product endorsement.</span></li>
            <li class="grid grid-cols-[1.5rem_1fr] gap-3"><span class="font-semibold text-[#2947ff] dark:text-[#8ca0ff]">04</span><span>Your office can provide the room or virtual meeting link and a screen for an in-person presentation.</span></li>
          </ul>
        </div>
        <aside class="border-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-rust)] p-7 text-[var(--editorial-ink)] shadow-[6px_6px_0_var(--editorial-shadow)]     sm:p-9">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] opacity-50">Probably a different conversation</p>
          <h3 class="mt-4 font-sans text-2xl font-semibold tracking-tight">You need something more tailored.</h3>
          <p class="mt-5 text-sm leading-6 opacity-70">A private workshop or implementation conversation may fit better if you need custom brokerage procedures, hands-on setup, software integration, one-on-one training, or help using sensitive internal information.</p>
          <p class="mt-6 text-sm font-semibold">Tell me that in the form. I’ll recommend the most appropriate next step instead of forcing the complimentary format.</p>
        </aside>
      </div>
    </section>

    <section class="border-b-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-purple)]  ">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-[1fr_20rem] lg:items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-base-500 dark:text-base-400">Your facilitator</p>
          <h2 class="mt-4 max-w-3xl font-sans text-3xl font-semibold tracking-tight sm:text-4xl">Taught by someone who builds AI products for a living.</h2>
          <p class="mt-5 max-w-2xl text-sm leading-6 text-base-600 dark:text-base-300">I’m Danny Sullivan, an AI Product Engineer at Gametime. I previously spent nearly five years creating AI education and internal tools at Pluralsight. I live in Raleigh and focus on practical adoption—not hype.</p>
        </div>
        <div class="flex items-center gap-5 border-t-2 border-black/10 pt-6 dark:border-white/10 lg:border-l-2 lg:border-t-0 lg:pl-8 lg:pt-0">
          <Image src={profileImage} alt="Danny Sullivan" width={112} height={112} class="size-24 rounded-full border-2 border-[var(--editorial-line-strong)] object-cover grayscale " />
          <div><strong class="block text-sm">Danny Sullivan</strong><span class="mt-1 block text-sm leading-5 text-base-500 dark:text-base-400">AI Product Engineer<br />Raleigh, NC</span></div>
        </div>
      </div>
    </section>

    <section class="border-b-2 border-[var(--editorial-line-strong)] ">
      <div class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-24">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-base-500 dark:text-base-400">Common questions</p>
        <h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight sm:text-5xl">Before you put it on the calendar.</h2>
        <div class="mt-10 divide-y-2 divide-[var(--editorial-line-strong)] border-y-2 border-[var(--editorial-line-strong)]  ">
          <details class="group py-5"><summary class="cursor-pointer list-none font-sans text-lg font-semibold">Is the session really free?<span class="float-right transition group-open:rotate-45">+</span></summary><p class="mt-4 max-w-2xl text-sm leading-6 text-base-500 dark:text-base-400">Yes. The introductory 45-minute session is complimentary for qualifying real estate offices and groups. Availability is limited, and your office assembles the audience.</p></details>
          <details class="group py-5"><summary class="cursor-pointer list-none font-sans text-lg font-semibold">Do agents need a paid Claude account?<span class="float-right transition group-open:rotate-45">+</span></summary><p class="mt-4 max-w-2xl text-sm leading-6 text-base-500 dark:text-base-400">No. Agents can follow the session without an account. Some features shown may require a particular Claude plan, but the core prompting and review practices apply broadly.</p></details>
          <details class="group py-5"><summary class="cursor-pointer list-none font-sans text-lg font-semibold">Is this approved continuing education?<span class="float-right transition group-open:rotate-45">+</span></summary><p class="mt-4 max-w-2xl text-sm leading-6 text-base-500 dark:text-base-400">No. This is an educational technology session, not licensed continuing education, legal guidance, or brokerage compliance training.</p></details>
          <details class="group py-5"><summary class="cursor-pointer list-none font-sans text-lg font-semibold">Can the session be customized?<span class="float-right transition group-open:rotate-45">+</span></summary><p class="mt-4 max-w-2xl text-sm leading-6 text-base-500 dark:text-base-400">The complimentary session can emphasize the questions most relevant to the room. A fully tailored workshop with custom examples, exercises, or implementation planning is a separate paid engagement.</p></details>
          <details class="group py-5"><summary class="cursor-pointer list-none font-sans text-lg font-semibold">Can we do it remotely?<span class="float-right transition group-open:rotate-45">+</span></summary><p class="mt-4 max-w-2xl text-sm leading-6 text-base-500 dark:text-base-400">Yes. Sessions can be held remotely or in person around Raleigh, depending on the group and schedule.</p></details>
        </div>
      </div>
    </section>

    <section id="request" class="scroll-mt-8 border-b-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-blue)] text-[var(--editorial-ink)]   ">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[20rem_1fr] lg:gap-24">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] opacity-50">Request a session</p>
          <h2 class="mt-4 text-balance font-sans text-3xl font-semibold tracking-tight sm:text-5xl">Bring the agents. I’ll bring the useful part.</h2>
          <p class="mt-5 max-w-xs text-sm leading-6 text-base-600 dark:text-base-300">Tell me about your office and preferred format. I’ll follow up personally about availability and fit.</p>
          <div class="mt-10 hidden h-3 w-32 -rotate-2 bg-[#ff6f4f] lg:block" aria-hidden="true"></div>
        </div>

        <form name="real-estate-ai-lunch-and-learn" method="POST" action="/workshop-thank-you/" data-netlify="true" data-netlify-honeypot="bot-field" class="border-2 border-[var(--editorial-line-strong)] bg-[#fffdf8] p-5 text-black shadow-[7px_7px_0_var(--editorial-shadow)]   sm:p-8">
          <input type="hidden" name="form-name" value="real-estate-ai-lunch-and-learn" />
          <input type="hidden" name="subject" data-remove-prefix value="New real estate AI Lunch & Learn request from %{formName}" />
          <p class="absolute -left-[10000px] size-px overflow-hidden" aria-hidden="true"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="text-sm font-medium">Your name <span class="text-base-400">*</span><input class={fieldClass} type="text" name="name" autocomplete="name" required placeholder="Jane Smith" /></label>
            <label class="text-sm font-medium">Work email <span class="text-base-400">*</span><input class={fieldClass} type="email" name="email" autocomplete="email" required placeholder="jane@brokerage.com" /></label>
            <label class="text-sm font-medium">Brokerage or organization <span class="text-base-400">*</span><input class={fieldClass} type="text" name="organization" autocomplete="organization" required placeholder="Your brokerage" /></label>
            <label class="text-sm font-medium">Your role <span class="text-base-400">*</span><select class={fieldClass} name="role" required><option value="">Choose one</option><option>Broker or owner</option><option>Office manager</option><option>Team lead</option><option>Training or marketing leader</option><option>Agent</option><option>Association or community organizer</option><option>Other</option></select></label>
            <label class="text-sm font-medium">Expected attendance <span class="text-base-400">*</span><input class={fieldClass} type="number" name="expected_attendance" min="1" max="500" required placeholder="About 15" /></label>
            <label class="text-sm font-medium">Preferred format <span class="text-base-400">*</span><select class={fieldClass} name="format" required><option value="">Choose one</option><option>In person — Raleigh area</option><option>Remote</option><option>Either works</option></select></label>
            <label class="text-sm font-medium">Preferred timing <span class="text-base-400">*</span><select class={fieldClass} name="timing" required><option value="">Choose one</option><option>Within the next 30 days</option><option>In 1–3 months</option><option>More than 3 months away</option><option>Just exploring</option></select></label>
            <label class="text-sm font-medium sm:col-span-2">What is your group most interested in? <span class="text-base-400">*</span><select class={fieldClass} name="primary_interest" required><option value="">Choose one</option><option>Practical introduction to Claude</option><option>Listing descriptions and property marketing</option><option>Social content and market-update videos</option><option>Buyer and seller follow-up</option><option>Brokerage workflows and implementation</option><option>Privacy, accuracy, and safer AI use</option><option>Not sure yet</option></select></label>
          </div>
          <label class="mt-5 block text-sm font-medium">What would make the session useful for your agents?<span class="mt-1 block font-normal leading-5 text-base-500">A sentence or two is plenty.</span><textarea class={fieldClass} name="goals" rows="5" maxlength="1200" placeholder="Our agents are especially interested in…"></textarea></label>
          <fieldset class="mt-5">
            <legend class="text-sm font-medium">If the session uncovers a useful opportunity, would you be open to discussing tailored follow-on help?<span class="mt-1 block font-normal leading-5 text-base-500">Optional. Your answer does not affect eligibility for the complimentary session.</span></legend>
            <div class="mt-3 flex flex-wrap gap-x-6 gap-y-3 text-sm">
              <label class="flex items-center gap-2"><input type="radio" name="follow_on_interest" value="yes" class="border-black text-black focus:ring-black" /> Yes</label>
              <label class="flex items-center gap-2"><input type="radio" name="follow_on_interest" value="maybe" class="border-black text-black focus:ring-black" /> Maybe</label>
              <label class="flex items-center gap-2"><input type="radio" name="follow_on_interest" value="no" class="border-black text-black focus:ring-black" /> Not right now</label>
            </div>
          </fieldset>
          <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
            <p class="max-w-sm text-xs leading-5 text-base-500">No mailing list. I’ll only use these details to respond to your request.</p>
            <button type="submit" class="editorial-button">Request session availability <span class="ml-3">→</span></button>
          </div>
        </form>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .re-grid {
    background-image:
      linear-gradient(to right, #151515 1px, transparent 1px),
      linear-gradient(to bottom, #151515 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: linear-gradient(to right, transparent, black 25%, black 75%, transparent);
  }

  summary::-webkit-details-marker {
    display: none;
  }
</style>
