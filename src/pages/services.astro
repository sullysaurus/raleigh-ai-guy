---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/global/PageIntro.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContactBand from "@/components/global/ContactBand.astro";

const process = [
  ["Find the bottleneck", "You show me where work gets stuck, repeated, or lost. I learn how the business operates and identify the strongest opportunity."],
  ["Design the right system", "We define the result, map the workflow, and choose the simplest technology that can produce it reliably."],
  ["Build it around your work", "I create the system around your real tools, people, and decisions—not a generic AI demo."],
  ["Measure and improve", "We track the time, capacity, or revenue it creates and keep improving the system as the business grows."],
];
---

<BaseLayout pageTitle="Custom AI Systems for Service Businesses — Raleigh AI Guy" pageDescription="Danny Sullivan designs and builds practical AI systems around the real workflows, tools, and teams of established service businesses.">
  <PageIntro eyebrow="Services" title="Your business has outgrown the way it works." description="I turn manual processes, disconnected tools, and knowledge trapped in the owner’s head into practical systems your team can use. Start with the bottleneck—not an AI shopping list." ctaHref="/contact/" ctaLabel="Get in touch" />

  <section class="bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4"><p class="field-label">The process</p><h2 class="font-editorial mt-5 text-5xl leading-[.96]">From daily friction to a system your team can run.</h2><p class="mt-6 text-sm leading-6 text-base-600">You are close enough to the work to know something is off. My job is to find the leverage and build the fix.</p></div>
        <ol class="border-t border-black/15 lg:col-span-8">
          {process.map(([title, body], index) => <li class="grid gap-4 border-b border-black/15 py-6 sm:grid-cols-[3rem_12rem_1fr] sm:gap-6"><span class="field-label text-[var(--brand-orange)]">{String(index + 1).padStart(2, "0")}</span><h3 class="font-semibold">{title}</h3><p class="text-sm leading-6 text-base-600">{body}</p></li>)}
        </ol>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-forest)] text-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5"><p class="field-label text-white/50">How the work grows</p><h2 class="font-editorial mt-5 text-5xl leading-[.96]">Start with the bottleneck that matters most.</h2></div>
        <div class="lg:col-span-7">
          <p class="text-base leading-7 text-white/65">We start with one important workflow, build it well, and measure what changes. From there, we can improve the system, connect the next workflow, train the team, or maintain the reporting that keeps the value visible.</p>
          <div class="mt-8 grid gap-px bg-white/15 sm:grid-cols-2">
            <div class="bg-[var(--brand-forest)] py-6 sm:pr-7"><p class="field-label text-white/45">Build when</p><p class="mt-3 text-sm font-semibold leading-6">The time returned, money protected, or new capacity makes the investment worthwhile.</p></div>
            <div class="border-t border-white/15 bg-[var(--brand-forest)] py-6 sm:border-l sm:border-t-0 sm:pl-7"><p class="field-label text-white/45">Simplify when</p><p class="mt-3 text-sm font-semibold leading-6">A process change or existing tool can solve the problem without custom software.</p></div>
          </div>
          <p class="mt-7 border-l-2 border-[var(--brand-orange)] pl-5 text-sm leading-6 text-white/65">I will recommend the simplest reliable answer—even when the right answer is a clearer process or an existing tool instead of a custom build.</p>
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="border-y-2 border-black bg-[var(--brand-yellow)]">
    <Wrapper variant="wide" class="py-16 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="print-stamp bg-[var(--brand-paper)]">Also available</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.9] sm:text-6xl">Need the fundamentals handled first?</h2>
        </div>
        <div class="grid gap-5 lg:col-span-8 sm:grid-cols-2">
          <a class="group border-2 border-black bg-[var(--brand-paper)] p-6 shadow-[6px_6px_0_var(--brand-ink)] transition hover:translate-x-1 hover:translate-y-1 hover:shadow-[2px_2px_0_var(--brand-ink)]" href="/small-business-growth/">
            <span class="field-label">Packaged services / 01</span>
            <h3 class="font-editorial mt-8 text-4xl leading-none">Small Business Growth</h3>
            <p class="mt-4 text-sm leading-6 text-base-600">Website, brand, local visibility, analytics, automated SEO, and follow-up infrastructure in three clear packages.</p>
            <strong class="mt-8 block text-sm uppercase">See the packages →</strong>
          </a>
          <a class="group border-2 border-black bg-[var(--brand-orange)] p-6 shadow-[6px_6px_0_var(--brand-ink)] transition hover:translate-x-1 hover:translate-y-1 hover:shadow-[2px_2px_0_var(--brand-ink)]" href="/lead-recovery/">
            <span class="field-label text-black/60">Revenue recovery / 02</span>
            <h3 class="font-editorial mt-8 text-4xl leading-none">Put Mabel on the old list.</h3>
            <p class="mt-4 text-sm leading-6 text-black/65">Re-engage eligible leads, qualify interest, and return real opportunities to the team that can close them.</p>
            <strong class="mt-8 block text-sm uppercase">Explore lead recovery →</strong>
          </a>
        </div>
      </div>
    </Wrapper>
  </section>

  <ContactBand eyebrow="Start with the work itself" title="Bring me the bottleneck." description="Tell me what keeps falling through the cracks, taking too long, or requiring your constant attention. We’ll decide what is worth fixing." ctaHref="/contact/" ctaLabel="Get in touch" />
</BaseLayout>
