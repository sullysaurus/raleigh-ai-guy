---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import profileImage from "../../../danny.jpeg";
import seoDashboardImage from "@/images/projects/garden-art-seo-dashboard-live.png";
import zimZoomImage from "@/images/projects/zimzoom-homepage-live.png";
---

<BaseLayout
  pageTitle="Homepage design lab: Raleigh public access"
  pageDescription="A private homepage design direction for Raleigh AI Guy."
  noindex={true}
  minimal={true}
>
  <div class="broadcast-page">
    <header class="broadcast-nav">
      <a class="broadcast-logo" href="/" aria-label="Raleigh AI Guy home">
        <span class="logo-bug">RAI</span>
        <span>Raleigh AI Guy</span>
      </a>
      <nav aria-label="Prototype navigation">
        <a href="#proof">Proof</a>
        <a href="#offers">Ways to work</a>
        <a href="/about/">About</a>
      </nav>
      <a class="nav-cta" href="/ai-diagnosis/">Start here →</a>
    </header>

    <div class="news-ticker" aria-label="Raleigh AI Guy services">
      <div>
        <span>LOCAL AI, NO HYPE</span><i>✦</i><span>WORKFLOW DIAGNOSIS</span><i>✦</i><span>AUTOMATION BUILDS</span><i>✦</i><span>TEAM WORKSHOPS</span><i>✦</i><span>RALEIGH, NC</span><i>✦</i>
        <span aria-hidden="true">LOCAL AI, NO HYPE</span><i aria-hidden="true">✦</i><span aria-hidden="true">WORKFLOW DIAGNOSIS</span><i aria-hidden="true">✦</i><span aria-hidden="true">AUTOMATION BUILDS</span><i aria-hidden="true">✦</i><span aria-hidden="true">TEAM WORKSHOPS</span><i aria-hidden="true">✦</i><span aria-hidden="true">RALEIGH, NC</span><i aria-hidden="true">✦</i>
      </div>
    </div>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="channel-label"><span></span> Broadcasting practical AI from Raleigh, NC</p>
          <h1 id="hero-title">AI that does<br />the <em>boring</em><br /><strong>stuff.</strong></h1>
          <p class="hero-lede">Useful systems for local businesses that want less admin, better follow-through, and zero robot theater.</p>
          <div class="hero-actions">
            <a class="brutal-button primary" href="/ai-diagnosis/">Start with a $500 diagnosis <span>↗</span></a>
            <a class="brutal-button secondary" href="/ai-opportunity-scorecard/">Take the free scorecard <span>→</span></a>
          </div>
          <div class="credential-bar">
            <span>BUILD</span><b>Production AI at Gametime</b>
            <span>TEACH</span><b>Former Pluralsight instructor</b>
          </div>
        </div>

        <aside class="hero-visual" aria-label="About Danny Sullivan">
          <div class="static-noise" aria-hidden="true"></div>
          <div class="portrait-frame">
            <Image src={profileImage} alt="Danny Sullivan" width={615} height={615} loading="eager" />
            <span class="live-bug"><i></i> LIVE</span>
          </div>
          <div class="name-card">
            <div><small>YOUR HOST / BUILDER</small><strong>DANNY<br />SULLIVAN</strong></div>
            <span>919</span>
          </div>
          <p class="tape-note">I study the work.<br />I build the system.<br />I help your team use it.</p>
          <span class="star-burst" aria-hidden="true">NO<br />HYPE!</span>
        </aside>
      </section>

      <div class="station-break" aria-hidden="true">
        <span>YOU ARE WATCHING</span><strong>RALEIGH AI GUY</strong><span>CH. 919</span>
      </div>

      <section id="proof" class="proof-section" aria-labelledby="proof-title">
        <header class="section-heading">
          <p>Season 01 / Recent work</p>
          <h2 id="proof-title">Proof, not<br /><em>promises.</em></h2>
          <span class="scribble">REAL WORK<br />IN THE WILD ↓</span>
        </header>

        <div class="proof-grid">
          <article class="case-card case-lime">
            <div class="case-image"><Image src={seoDashboardImage} alt="Garden and Art Landscapes SEO dashboard" widths={[640, 960]} sizes="(min-width: 900px) 50vw, 100vw" /></div>
            <div class="case-copy">
              <span class="episode">EP. 01</span>
              <p>Automated SEO growth</p>
              <h3>One dashboard that researches, drafts, measures, and keeps moving.</h3>
              <ul><li>18 useful pages published</li><li>Live Analytics + Search Console</li><li>Early rankings at #4, #14, and #28</li></ul>
              <a href="https://www.landscapingraleigh.com/seo-dashboard/" target="_blank" rel="noreferrer">See the live system ↗</a>
            </div>
          </article>

          <article class="case-card case-blue">
            <div class="case-image"><Image src={zimZoomImage} alt="ZimZoom Photo Booth website" widths={[640, 960]} sizes="(min-width: 900px) 50vw, 100vw" /></div>
            <div class="case-copy">
              <span class="episode">EP. 02</span>
              <p>Custom Claude skills</p>
              <h3>Turning an overloaded inbox into a repeatable operating system.</h3>
              <ul><li>Lead and customer-message triage</li><li>Payment and follow-up priority</li><li>Hands-on team training</li></ul>
              <a href="/blog/posts/create-first-claude-skill-organize-inbox/">Build the inbox skill →</a>
            </div>
          </article>
        </div>
      </section>

      <section id="offers" class="offers-section" aria-labelledby="offers-title">
        <div class="offers-intro">
          <p>Choose your own adventure</p>
          <h2 id="offers-title">Three ways to make work suck less.</h2>
        </div>
        <div class="offer-stack">
          <a href="/ai-opportunity-scorecard/" class="offer offer-yellow">
            <span>00</span><div><small>FREE · 7 MINUTES</small><h3>Score one annoying workflow.</h3><p>See if the work is ready for AI before buying anything.</p></div><b>→</b>
          </a>
          <a href="/ai-diagnosis/" class="offer offer-orange">
            <span>01</span><div><small>$500 · ONE TIME</small><h3>Find the work worth fixing.</h3><p>A personal review, three ranked opportunities, and a 30-day roadmap.</p></div><b>→</b>
          </a>
          <a href="/ai-workshops/" class="offer offer-pink">
            <span>02</span><div><small>FOR REAL ESTATE TEAMS</small><h3>Book a free lunch-and-learn.</h3><p>Thirty practical minutes. No sales deck. Bring the repetitive work.</p></div><b>→</b>
          </a>
        </div>
      </section>

      <section class="closing-cta">
        <p>Transmission ends soon</p>
        <h2>Bring me the task<br />everyone <em>hates.</em></h2>
        <a class="brutal-button primary" href="/ai-diagnosis/">Let’s diagnose it <span>↗</span></a>
        <div class="closing-stamp">USEFUL<br />SINCE<br />2026</div>
      </section>
    </main>

    <footer class="broadcast-footer">
      <strong>RALEIGH AI GUY</strong><span>Danny Sullivan · Raleigh, North Carolina</span><a href="/">Return to current homepage ↗</a>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  .broadcast-page {
    --ink: #171310;
    --cream: #f5efdc;
    --paper: #fff9e8;
    --acid: #dfff35;
    --orange: #ff542e;
    --blue: #3154ff;
    --pink: #ff8bb4;
    min-height: 100svh;
    overflow: hidden;
    color: var(--ink);
    background-color: var(--cream);
    background-image: radial-gradient(rgb(23 19 16 / 12%) .7px, transparent .7px);
    background-size: 6px 6px;
  }
  .broadcast-page * { box-sizing: border-box; }
  .broadcast-page a { color: inherit; text-decoration: none; }
  .broadcast-nav { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 5.75rem; border-bottom: 3px solid var(--ink); padding: 1rem clamp(1rem, 4vw, 4rem); background: var(--paper); }
  .broadcast-logo { display: flex; align-items: center; gap: .8rem; font-family: "Anybody", sans-serif; font-size: clamp(1rem, 2vw, 1.35rem); font-weight: 850; text-transform: uppercase; }
  .logo-bug { display: grid; width: 3.25rem; height: 3.25rem; place-items: center; border: 3px solid var(--ink); background: var(--orange); box-shadow: 4px 4px 0 var(--ink); font-size: .75rem; transform: rotate(-4deg); }
  .broadcast-nav nav { display: flex; gap: 2rem; font-size: .75rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .broadcast-nav nav a:hover { text-decoration: underline 3px var(--orange); text-underline-offset: 5px; }
  .nav-cta { justify-self: end; border: 3px solid var(--ink); padding: .75rem 1rem; background: var(--acid); box-shadow: 4px 4px 0 var(--ink); font-size: .75rem; font-weight: 850; text-transform: uppercase; transition: transform 120ms, box-shadow 120ms; }
  .nav-cta:hover, .brutal-button:hover { box-shadow: 1px 1px 0 var(--ink); transform: translate(3px, 3px); }

  .news-ticker { overflow: hidden; border-bottom: 3px solid var(--ink); background: var(--ink); color: var(--acid); }
  .news-ticker div { display: flex; width: max-content; align-items: center; gap: 2rem; padding: .65rem 0; animation: crawl 28s linear infinite; }
  .news-ticker span { font-family: "Anybody", sans-serif; font-size: .72rem; font-weight: 800; letter-spacing: .14em; }
  .news-ticker i { color: var(--orange); font-style: normal; }

  .hero { position: relative; display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(20rem, .75fr); min-height: calc(100svh - 8.5rem); border-bottom: 3px solid var(--ink); }
  .hero-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 6vw, 6.5rem); }
  .channel-label { display: flex; align-items: center; gap: .65rem; font-size: .7rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  .channel-label span { width: .65rem; height: .65rem; border-radius: 50%; background: var(--orange); animation: blink 1.4s steps(2) infinite; }
  .hero h1 { margin-top: 1.5rem; font-family: "Anybody", sans-serif; font-size: clamp(4rem, 9vw, 9.5rem); font-stretch: expanded; font-weight: 900; line-height: .72; letter-spacing: -.085em; text-transform: uppercase; }
  .hero h1 em { display: inline-block; padding: .05em .08em .12em; color: var(--paper); background: var(--blue); font-family: "Instrument Serif", serif; font-weight: 400; text-transform: none; transform: rotate(-2deg); text-shadow: 4px 4px 0 var(--ink); }
  .hero h1 strong { color: var(--orange); font-weight: 900; -webkit-text-stroke: 3px var(--ink); text-shadow: 6px 6px 0 var(--acid); }
  .hero-lede { max-width: 42rem; margin-top: 2.5rem; font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 700; line-height: 1.45; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  .brutal-button { display: inline-flex; min-height: 3.5rem; align-items: center; justify-content: space-between; gap: 2rem; border: 3px solid var(--ink); padding: .85rem 1.2rem; box-shadow: 5px 5px 0 var(--ink); font-size: .78rem; font-weight: 850; text-transform: uppercase; transition: transform 120ms, box-shadow 120ms; }
  .brutal-button.primary { background: var(--orange); }
  .brutal-button.secondary { background: var(--paper); }
  .credential-bar { display: flex; flex-wrap: wrap; gap: .5rem 1rem; max-width: 45rem; align-items: center; margin-top: 2.5rem; border-top: 3px solid var(--ink); padding-top: 1rem; font-size: .72rem; }
  .credential-bar span { padding: .2rem .4rem; color: var(--paper); background: var(--ink); font-weight: 900; }
  .credential-bar b { margin-right: 1rem; }

  .hero-visual { position: relative; min-height: 42rem; border-left: 3px solid var(--ink); padding: clamp(2rem, 4vw, 4rem); background: var(--pink); }
  .static-noise { position: absolute; inset: 0; opacity: .23; background-image: repeating-linear-gradient(0deg, transparent 0 3px, rgb(23 19 16 / 25%) 3px 4px); pointer-events: none; }
  .portrait-frame { position: relative; z-index: 1; border: 4px solid var(--ink); padding: .75rem; background: var(--paper); box-shadow: 10px 10px 0 var(--ink); transform: rotate(1.5deg); }
  .portrait-frame img { display: block; width: 100%; aspect-ratio: .86 / 1; object-fit: cover; object-position: 50% 38%; filter: grayscale(1) contrast(1.25); background: var(--ink); }
  .live-bug { position: absolute; top: 1.3rem; left: 1.3rem; display: flex; align-items: center; gap: .4rem; padding: .4rem .55rem; color: var(--paper); background: var(--ink); font-size: .65rem; font-weight: 900; letter-spacing: .12em; }
  .live-bug i { width: .55rem; height: .55rem; border-radius: 50%; background: var(--orange); }
  .name-card { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: end; margin: -1rem -1rem 0 1.5rem; border: 4px solid var(--ink); padding: 1.1rem 1.25rem; background: var(--acid); box-shadow: 7px 7px 0 var(--ink); transform: rotate(-2deg); }
  .name-card small { display: block; font-size: .57rem; font-weight: 900; letter-spacing: .13em; }
  .name-card strong { display: block; margin-top: .35rem; font-family: "Anybody", sans-serif; font-size: clamp(1.6rem, 3vw, 2.5rem); font-weight: 900; line-height: .8; }
  .name-card > span { font-family: "Anybody", sans-serif; font-size: 2rem; font-weight: 900; }
  .tape-note { position: relative; z-index: 3; width: max-content; max-width: 85%; margin: 2.25rem auto 0; padding: 1rem 1.4rem; background: #fff7b0; box-shadow: 3px 4px 0 rgb(23 19 16 / 28%); font-family: "Instrument Serif", serif; font-size: 1.25rem; font-style: italic; line-height: 1.25; transform: rotate(2deg); }
  .tape-note::before { position: absolute; top: -.55rem; left: 30%; width: 4.5rem; height: 1.2rem; background: rgb(255 255 255 / 65%); content: ""; transform: rotate(-4deg); }
  .star-burst { position: absolute; top: 2rem; right: 1rem; z-index: 4; display: grid; width: 6rem; height: 6rem; place-items: center; border: 3px solid var(--ink); border-radius: 50%; background: var(--orange); box-shadow: 4px 4px 0 var(--ink); font-size: .7rem; font-weight: 950; line-height: .9; text-align: center; transform: rotate(12deg); }

  .station-break { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 3px solid var(--ink); padding: 1.2rem clamp(1rem, 4vw, 4rem); color: var(--paper); background: var(--blue); font-size: .65rem; font-weight: 900; letter-spacing: .15em; }
  .station-break strong { padding: .3rem 1rem; color: var(--ink); background: var(--acid); font-family: "Anybody", sans-serif; font-size: clamp(1rem, 2.2vw, 2rem); letter-spacing: -.03em; transform: rotate(-1deg); }
  .station-break span:last-child { justify-self: end; }

  .proof-section { padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 5vw, 5rem); }
  .section-heading { position: relative; display: grid; grid-template-columns: .45fr 1fr .45fr; align-items: end; margin-bottom: 3rem; }
  .section-heading > p, .offers-intro > p, .closing-cta > p { font-size: .7rem; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; }
  .section-heading h2, .offers-intro h2, .closing-cta h2 { font-family: "Anybody", sans-serif; font-size: clamp(3.5rem, 8vw, 8rem); font-weight: 900; line-height: .8; letter-spacing: -.07em; text-transform: uppercase; }
  .section-heading h2 em, .closing-cta h2 em { color: var(--orange); font-family: "Instrument Serif", serif; font-weight: 400; text-transform: none; }
  .scribble { justify-self: end; font-family: "Instrument Serif", serif; font-size: 1.2rem; font-style: italic; line-height: 1.1; transform: rotate(-7deg); }
  .proof-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.25rem; }
  .case-card { position: relative; border: 4px solid var(--ink); box-shadow: 10px 10px 0 var(--ink); }
  .case-lime { background: var(--acid); transform: rotate(-.5deg); }
  .case-blue { background: var(--blue); color: var(--paper); transform: translateY(2.75rem) rotate(.7deg); }
  .case-image { overflow: hidden; border-bottom: 4px solid var(--ink); background: var(--paper); }
  .case-image img { display: block; width: 100%; aspect-ratio: 16/9; object-fit: cover; object-position: top; filter: saturate(.65) contrast(1.05); transition: transform 350ms; }
  .case-card:hover .case-image img { transform: scale(1.025); }
  .case-copy { position: relative; padding: clamp(1.4rem, 3vw, 2.5rem); }
  .episode { position: absolute; top: -2rem; right: 1rem; border: 3px solid var(--ink); padding: .5rem .7rem; color: var(--ink); background: var(--pink); box-shadow: 3px 3px 0 var(--ink); font-size: .65rem; font-weight: 900; transform: rotate(4deg); }
  .case-copy > p { font-size: .68rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
  .case-copy h3 { max-width: 38rem; margin-top: .8rem; font-size: clamp(1.8rem, 3.5vw, 3.25rem); font-weight: 900; line-height: .92; letter-spacing: -.045em; }
  .case-copy ul { display: grid; gap: .45rem; margin-top: 1.5rem; border-top: 3px solid currentColor; padding-top: 1rem; font-size: .78rem; font-weight: 700; }
  .case-copy li::before { content: "▶ "; }
  .case-copy a { display: inline-block; margin-top: 1.5rem; border-bottom: 3px solid currentColor; font-size: .78rem; font-weight: 900; text-transform: uppercase; }

  .offers-section { border-block: 3px solid var(--ink); padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 5vw, 5rem); background: var(--ink); color: var(--paper); }
  .offers-intro { display: grid; grid-template-columns: .5fr 1.5fr; gap: 2rem; align-items: start; margin-bottom: 3rem; }
  .offers-intro h2 { max-width: 70rem; color: var(--acid); }
  .offer-stack { display: grid; gap: 1rem; color: var(--ink); }
  .offer { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: clamp(1rem, 3vw, 3rem); align-items: center; border: 4px solid var(--paper); padding: clamp(1.25rem, 3vw, 2.25rem); box-shadow: 7px 7px 0 var(--paper); transition: transform 150ms; }
  .offer:hover { transform: translateX(8px); }
  .offer-yellow { background: var(--acid); }
  .offer-orange { background: var(--orange); }
  .offer-pink { background: var(--pink); }
  .offer > span { font-family: "Anybody", sans-serif; font-size: clamp(2rem, 5vw, 5rem); font-weight: 900; }
  .offer small { font-size: .64rem; font-weight: 900; letter-spacing: .12em; }
  .offer h3 { margin-top: .35rem; font-size: clamp(1.6rem, 3.5vw, 3.25rem); font-weight: 900; line-height: .95; letter-spacing: -.04em; }
  .offer p { max-width: 42rem; margin-top: .65rem; font-size: .85rem; font-weight: 650; }
  .offer > b { font-size: 2rem; }

  .closing-cta { position: relative; min-height: 38rem; padding: clamp(5rem, 10vw, 10rem) clamp(1rem, 7vw, 7rem); background: var(--paper); }
  .closing-cta h2 { max-width: 75rem; margin: 1.5rem 0 2.5rem; }
  .closing-stamp { position: absolute; right: 8%; bottom: 18%; display: grid; width: 8rem; height: 8rem; place-items: center; border: 4px solid var(--ink); border-radius: 50%; color: var(--paper); background: var(--blue); box-shadow: 6px 6px 0 var(--orange); font-size: .7rem; font-weight: 950; line-height: 1; text-align: center; transform: rotate(10deg); }
  .broadcast-footer { display: grid; grid-template-columns: 1fr auto 1fr; gap: 2rem; border-top: 3px solid var(--ink); padding: 2rem clamp(1rem, 4vw, 4rem); color: var(--paper); background: var(--ink); font-size: .7rem; }
  .broadcast-footer strong { font-family: "Anybody", sans-serif; font-size: 1.2rem; }
  .broadcast-footer a { justify-self: end; text-decoration: underline; }

  @keyframes crawl { to { transform: translateX(-50%); } }
  @keyframes blink { 50% { opacity: .25; } }

  @media (max-width: 900px) {
    .broadcast-nav { grid-template-columns: 1fr auto; }
    .broadcast-nav nav { display: none; }
    .hero { grid-template-columns: 1fr; }
    .hero-visual { min-height: auto; border-top: 3px solid var(--ink); border-left: 0; }
    .proof-grid { grid-template-columns: 1fr; }
    .case-blue { transform: rotate(.7deg); }
    .section-heading { grid-template-columns: 1fr; gap: 1.5rem; }
    .scribble { justify-self: start; }
    .offers-intro { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .broadcast-nav { min-height: 4.75rem; padding-inline: .8rem; }
    .logo-bug { width: 2.6rem; height: 2.6rem; box-shadow: 3px 3px 0 var(--ink); }
    .broadcast-logo > span:last-child { font-size: .85rem; }
    .nav-cta { padding: .65rem .7rem; font-size: .62rem; }
    .hero h1 { font-size: clamp(3.5rem, 19vw, 5.5rem); }
    .hero h1 strong { -webkit-text-stroke-width: 2px; text-shadow: 4px 4px 0 var(--acid); }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .credential-bar { align-items: flex-start; flex-direction: column; }
    .hero-visual { padding: 1.5rem; }
    .star-burst { top: .5rem; right: .35rem; width: 4.75rem; height: 4.75rem; }
    .station-break { grid-template-columns: 1fr auto; }
    .station-break span:first-child { display: none; }
    .section-heading h2, .offers-intro h2, .closing-cta h2 { font-size: clamp(3rem, 16vw, 5rem); }
    .offer { grid-template-columns: 3.5rem 1fr; }
    .offer > b { display: none; }
    .closing-stamp { position: static; margin-top: 3rem; }
    .broadcast-footer { grid-template-columns: 1fr; }
    .broadcast-footer a { justify-self: start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .news-ticker div, .channel-label span { animation: none; }
  }
</style>
