---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContactBand from "@/components/global/ContactBand.astro";

const deliverables = [
  ["Opportunity map", "Three to five places where better use of AI, automation, or process design could create meaningful value."],
  ["Business case", "The frequency, time, people, delays, and customer impact behind each opportunity."],
  ["Priority and risk", "A practical comparison of expected impact, implementation effort, human-review needs, and readiness."],
  ["Recommended first project", "The smallest useful improvement capable of proving value before the business expands."],
  ["What not to automate", "Work that is too unclear, too risky, or better solved with ordinary software or a clearer process."],
];
---

<BaseLayout
  pageTitle="AI Opportunity Assessment for Small Businesses"
  pageDescription="Find where AI can recover meaningful time, remove delays, and improve customer response before investing in tools or implementation."
>
  <section class="overflow-hidden border-b border-black/10">
    <Wrapper variant="wide" class="py-14 sm:py-20 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-16">
        <div class="field-reveal lg:col-span-8">
          <p class="field-label flex items-center gap-2"><span class="size-2 rounded-full bg-[var(--brand-orange)]" aria-hidden="true"></span>The first paid step</p>
          <h1 class="font-editorial mt-6 max-w-5xl text-[clamp(3.7rem,7vw,7rem)] font-medium leading-[.88] tracking-[-.055em]">Find the AI work<br /><em class="font-normal text-[var(--brand-orange)]">worth doing.</em></h1>
        </div>
        <div class="lg:col-span-4">
          <p class="text-base leading-7 text-base-600">You are too busy running the business to compare every tool, untangle every workflow, and calculate which ideas deserve investment. The assessment does that work before anyone starts building.</p>
          <p class="font-utility mt-5 text-xs font-semibold uppercase tracking-[.1em] text-[var(--brand-orange)]">$997 one-time</p>
          <a href="/contact/?service=assessment" class="site-cta mt-7">Request an assessment →</a>
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-14 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="field-label">Why start here</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.98]">The expensive mistake is solving the wrong problem.</h2>
        </div>
        <div class="space-y-5 text-base leading-7 text-base-600 lg:col-span-7">
          <p>Most owners already know there is repeated work, slow follow-up, or valuable knowledge trapped in someone’s head. What is harder to see from inside the business is which problem has enough value, clarity, and support to improve responsibly.</p>
          <p>Automating a broken process makes bad work happen faster. Buying a tool without ownership creates another subscription. Starting with the clearest, highest-value opportunity creates evidence the business can use.</p>
          <p>As a practical fit test, there should be reason to believe one recurring problem is consuming at least 5–10 hours a month or creating several thousand dollars a year in delay, rework, missed capacity, or revenue exposure.</p>
          <p class="border-l-2 border-[var(--brand-orange)] pl-5 font-semibold text-black">The assessment is a prescription—not a software shopping list.</p>
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-surface-soft)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="field-label">The value lens</p>
          <h2 class="font-editorial mt-5 text-5xl leading-[.98]">Anchor on what the work costs—not how long the fix takes.</h2>
          <p class="mt-6 text-sm leading-6 text-base-600">The assessment establishes a baseline before making savings claims. That keeps the recommendation honest and gives the business a way to judge the result.</p>
        </div>
        <div class="lg:col-span-8">
          <div class="border border-black/15 bg-[var(--brand-paper)] p-7 sm:p-10">
            <p class="field-label">A simple opportunity equation</p>
            <p class="font-editorial mt-7 text-4xl leading-[1.05] sm:text-6xl">Frequency × time × people<br /><span class="text-[var(--brand-orange)]">+ cost of delay</span></p>
            <div class="mt-10 grid gap-px bg-black/10 sm:grid-cols-2">
              <div class="bg-[var(--brand-paper)] py-5 sm:pr-7"><p class="field-label">Time value</p><p class="mt-2 text-sm leading-6 text-base-600">How often it happens, how long it takes, and whose time it consumes.</p></div>
              <div class="bg-[var(--brand-paper)] py-5 sm:pl-7"><p class="field-label">Business value</p><p class="mt-2 text-sm leading-6 text-base-600">What slow or inconsistent work costs in response, quality, capacity, customers, or revenue.</p></div>
            </div>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4"><p class="field-label">What you receive</p><h2 class="font-editorial mt-5 text-5xl leading-[.98]">Clarity before complexity.</h2></div>
        <ol class="border-t border-black/15 lg:col-span-8">
          {deliverables.map(([title, body], index) => (
            <li class="grid gap-4 border-b border-black/15 py-6 sm:grid-cols-[3rem_13rem_1fr] sm:gap-6"><span class="field-label text-[var(--brand-orange)]">{String(index + 1).padStart(2, "0")}</span><h3 class="font-semibold">{title}</h3><p class="text-sm leading-6 text-base-600">{body}</p></li>
          ))}
        </ol>
      </div>
    </Wrapper>
  </section>

  <section class="bg-[var(--brand-forest)] text-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-16 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5"><p class="field-label text-white/50">How it works</p><h2 class="font-editorial mt-5 text-5xl leading-[.98]">A focused conversation. A useful decision.</h2></div>
        <ol class="border-t border-white/15 lg:col-span-7">
          <li class="grid gap-4 border-b border-white/15 py-6 sm:grid-cols-[3rem_1fr]"><span class="field-label text-[var(--brand-orange)]">01</span><div><h3 class="font-semibold">Understand the business</h3><p class="mt-2 text-sm leading-6 text-white/60">We discuss goals, repeated work, delays, handoffs, customer friction, and what has already been tried.</p></div></li>
          <li class="grid gap-4 border-b border-white/15 py-6 sm:grid-cols-[3rem_1fr]"><span class="field-label text-[var(--brand-orange)]">02</span><div><h3 class="font-semibold">Quantify the opportunities</h3><p class="mt-2 text-sm leading-6 text-white/60">I examine the baseline, likely value, implementation difficulty, risk, and readiness.</p></div></li>
          <li class="grid gap-4 border-b border-white/15 py-6 sm:grid-cols-[3rem_1fr]"><span class="field-label text-[var(--brand-orange)]">03</span><div><h3 class="font-semibold">Choose the next move</h3><p class="mt-2 text-sm leading-6 text-white/60">You receive a prioritized roadmap you can use with me, your team, or another provider.</p></div></li>
        </ol>
      </div>
    </Wrapper>
  </section>

  <ContactBand eyebrow="$997 · One-time" title="Pay for clarity before paying for a build." description="If the numbers do not support further investment, I will say so. The roadmap is yours whether you implement it with me, your team, or someone else." ctaHref="/contact/?service=assessment" ctaLabel="Request an assessment" />
</BaseLayout>
