---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
---

<BaseLayout
  pageTitle="Project Brief Received"
  pageDescription="Thanks for sharing your project brief with Danny Sullivan."
  noindex={true}
>
  <Wrapper variant="standard" class="py-24 lg:py-40">
    <section class="border-t border-black/10 pt-6 dark:border-white/10">
      <Text tag="p" variant="textXS" class="font-medium uppercase tracking-wide text-base-500 dark:text-base-400">
        Brief received
      </Text>
      <Text tag="h1" variant="displayXS" class="mt-3 text-balance font-medium text-black dark:text-white">
        Thanks. I’ll take a close look.
      </Text>
      <Text tag="p" variant="textSM" class="mt-6 max-w-lg text-base-500 dark:text-base-400 2xl:text-base">
        Your project details are in. I’ll review the workflow, tools, and pain points you shared, then follow up by email with useful next steps.
      </Text>
      <div class="mt-8">
        <Button href="/" variant="muted" size="medium">Back home</Button>
      </div>
    </section>
  </Wrapper>
</BaseLayout>
