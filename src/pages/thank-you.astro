---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Assessment Application Received" pageDescription="Your AI Tools Assessment application has been received." noindex>
  <div class="grid min-h-[70svh] place-items-center bg-white px-5 text-black dark:bg-base-950 dark:text-white">
    <section class="w-full max-w-xl text-center">
      <span class="mx-auto grid size-12 place-items-center rounded-full bg-[#ddff73] text-xl text-black">✓</span>
      <p class="mt-7 text-xs font-medium uppercase tracking-[0.14em] text-base-500 dark:text-base-400">Application received</p>
      <h1 class="mt-4 font-sans text-4xl font-semibold tracking-tight sm:text-5xl">I’ll review it personally.</h1>
      <p class="mx-auto mt-6 max-w-lg text-base leading-7 text-base-500 dark:text-base-400">I’ll read through the workflows and time drains you shared, then follow up by email with the next step. If the assessment is not a strong fit, I’ll tell you.</p>
      <a href="/" class="mt-8 inline-flex min-h-11 items-center bg-black px-5 text-sm font-medium text-white dark:bg-white dark:text-black">Back to the assessment</a>
    </section>
  </div>
</BaseLayout>
