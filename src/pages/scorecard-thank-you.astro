---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Scorecard Received" pageDescription="Your AI opportunity scorecard has been received." noindex>
  <div class="grid min-h-[70svh] place-items-center bg-[var(--brand-bg)] px-5 text-[var(--brand-text)]">
    <section class="w-full max-w-2xl text-center">
      <span class="mx-auto grid size-12 place-items-center rounded-full bg-[var(--brand-orange)] text-xl text-[var(--brand-ink)]">✓</span>
      <p class="mt-7 text-xs font-bold uppercase tracking-[.16em] text-[var(--brand-orange)]">Scorecard received</p>
      <h1 class="mt-5 font-sans text-4xl font-bold tracking-[-.04em] sm:text-6xl">Your workflow is worth a closer look.</h1>
      <p class="mx-auto mt-6 max-w-xl text-base leading-7 text-[var(--brand-muted)]">If your browser could not display the instant result, Danny will still receive what you shared. You can also continue to the paid diagnosis for a personal review and written roadmap.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4"><a href="mailto:hello@raleighaiguy.com" class="brand-button">Email me →</a><a href="/" class="social-chip">Back home</a></div>
    </section>
  </div>
</BaseLayout>
