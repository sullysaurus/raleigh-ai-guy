---
// Fundations
import BlogLayout from "@/layouts/BlogLayout.astro";
// Content
import { getCollection, render } from "astro:content";
import readingTime from "reading-time";
import { publishedPosts } from "@/lib/publishing";
import { seoGuideProfiles } from "@/data/seoGuideProfiles";

export async function getStaticPaths() {
  const blogEntries = publishedPosts(await getCollection("posts"));
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
// Calculate reading time from the raw markdown body
const { Content } = await render(entry);
const scheduledProfile = entry.data.targetKeyword ? seoGuideProfiles[entry.data.targetKeyword] : undefined;
const stats = readingTime(scheduledProfile ? JSON.stringify(scheduledProfile) : (entry.body ?? ""));
---

<BlogLayout frontmatter={entry.data} readingTime={stats.text}>
  <Content />
</BlogLayout>

<script is:inline define:vars={{ postTitle: entry.data.title, postTags: entry.data.tags, postSlug: entry.id }}>
  document.addEventListener('DOMContentLoaded', function () {
    window.posthog?.capture('blog_post_viewed', {
      post_title: postTitle,
      post_slug: postSlug,
      post_tags: postTags
    });
  });
</script>
