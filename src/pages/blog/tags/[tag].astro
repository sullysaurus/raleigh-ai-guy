---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/global/PageIntro.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { publishedPosts } from "@/lib/publishing";

export async function getStaticPaths() {
  const all = publishedPosts(await getCollection("posts"));
  const tags = [...new Set(all.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: all.filter((post) => post.data.tags.includes(tag)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const label = tag === "ai" ? "AI" : tag ? tag.replaceAll("-", " ") : "Topic";
---

<BaseLayout pageTitle={`${label} Guides`} pageDescription={`Practical guides about ${tag} from Danny Sullivan.`} noindex>
  <PageIntro eyebrow="Writing · Topic" title={`${label} field notes.`} description={`${posts.length} practical ${posts.length === 1 ? "note" : "notes"} about ${label.toLowerCase()}.`} />
  <section class="border-y-[3px] border-black bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-12 sm:py-16">
      <div class="border-x-2 border-t-2 border-black">
        {posts.map((post, index) => (
          <a href={`/blog/posts/${post.id}`} class="group grid gap-5 border-b-2 border-black p-6 transition hover:bg-[var(--brand-yellow)] sm:grid-cols-[3rem_1fr_8rem] sm:items-start sm:gap-7 sm:p-8">
            <span class="print-stamp !bg-[var(--brand-orange)]">{String(index + 1).padStart(2, "0")}</span>
            <div><strong class="font-editorial block text-4xl font-normal leading-[.96] group-hover:translate-x-1">{post.data.title}</strong><p class="mt-4 max-w-2xl text-sm leading-6 text-base-600">{post.data.description}</p><span class="mt-5 inline-block text-xs font-black uppercase underline decoration-[var(--brand-orange)] decoration-2 underline-offset-4">Read the note →</span></div>
            <time class="font-utility text-[.62rem] uppercase tracking-[.06em] text-base-500 sm:text-right" datetime={post.data.pubDate.toISOString().slice(0, 10)}>{post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}</time>
          </a>
        ))}
      </div>
      <a class="site-cta mt-8" href="/blog/tags/">← Browse all topics</a>
    </Wrapper>
  </section>
</BaseLayout>
