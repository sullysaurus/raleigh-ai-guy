---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/global/PageIntro.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { publishedPosts } from "@/lib/publishing";

export async function getStaticPaths() {
  const all = publishedPosts(await getCollection("posts"));
  const tags = [...new Set(all.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: all.filter((post) => post.data.tags.includes(tag)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const label = tag === "ai" ? "AI" : tag ? tag.replaceAll("-", " ") : "Topic";
---

<BaseLayout pageTitle={`${label} Guides`} pageDescription={`Practical guides about ${tag} from Danny Sullivan.`} noindex>
  <PageIntro eyebrow="Field notes · Topic" title={`Guides about ${label}.`} description={`${posts.length} practical ${posts.length === 1 ? "note" : "notes"} from the field guide.`} />
  <section class="bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-12 sm:py-16">
      <div class="border-t border-black/15">
        {posts.map((post, index) => (
          <a href={`/blog/posts/${post.id}`} class="group grid gap-4 border-b border-black/15 py-7 sm:grid-cols-[3rem_1fr_8rem] sm:items-start sm:gap-7">
            <span class="field-label text-[var(--brand-orange)]">{String(index + 1).padStart(2, "0")}</span>
            <div><strong class="font-editorial block text-3xl font-normal leading-[1.03] group-hover:text-[var(--brand-orange)]">{post.data.title}</strong><p class="mt-3 max-w-2xl text-sm leading-6 text-base-600">{post.data.description}</p></div>
            <time class="font-utility text-[.62rem] uppercase tracking-[.06em] text-base-500 sm:text-right" datetime={post.data.pubDate.toISOString().slice(0, 10)}>{post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}</time>
          </a>
        ))}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
