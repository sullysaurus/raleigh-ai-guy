---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
const posts = await getCollection("posts");
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---
<BaseLayout pageTitle="Blog Topics" pageDescription="Browse practical AI guides by topic." noindex>
  <section class="brand-page min-h-[65svh]">
    <header class="brand-page-header">
      <div class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-24">
        <a href="/blog/" class="brand-back-link">← All guides</a>
        <h1 class="brand-display mt-8">Browse by topic.</h1>
        <p class="brand-copy mt-6">Choose a subject and jump straight to the practical guides.</p>
      </div>
    </header>
    <div class="mx-auto max-w-4xl px-5 py-12 sm:px-8 sm:py-16">
      <div class="flex flex-wrap gap-3">
        {tags.map((tag) => <a href={`/blog/tags/${tag}`} class="brand-chip">{tag.replaceAll("-", " ")}</a>)}
      </div>
    </div>
  </section>
</BaseLayout>
