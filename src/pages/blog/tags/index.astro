---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/global/PageIntro.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { publishedPosts } from "@/lib/publishing";

const posts = publishedPosts(await getCollection("posts"));
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout pageTitle="Writing Topics" pageDescription="Browse practical AI guides by topic." noindex>
  <PageIntro eyebrow="Writing · Topic index" title="Find the useful thread." description="Jump straight to the field notes that match the work, tool, or decision you are trying to improve." />
  <section class="border-y-[3px] border-black bg-[var(--brand-yellow)]">
    <Wrapper variant="wide" class="py-12 sm:py-16">
      <div class="grid border-l-2 border-t-2 border-black sm:grid-cols-2 lg:grid-cols-3">
        {tags.map((tag, index) => <a href={`/blog/tags/${tag}`} class:list={["group flex min-h-48 flex-col justify-between border-b-2 border-r-2 border-black p-6 transition hover:bg-[var(--brand-orange)]", index % 5 === 0 ? "bg-[var(--brand-paper)]" : "bg-[var(--brand-yellow)]"]}><span class="field-label">Topic / {String(index + 1).padStart(2, "0")}</span><strong class="font-editorial mt-8 text-4xl font-normal capitalize leading-none group-hover:translate-x-1">{tag.replaceAll("-", " ")} <span>→</span></strong></a>)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
