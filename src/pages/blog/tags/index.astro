---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/global/PageIntro.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const posts = await getCollection("posts");
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout pageTitle="Blog Topics" pageDescription="Browse practical AI guides by topic." noindex>
  <PageIntro eyebrow="Field notes · Topics" title="Browse by subject." description="Jump straight to the practical guides that match the work you are trying to improve." />
  <section class="bg-[var(--brand-paper)]">
    <Wrapper variant="wide" class="py-12 sm:py-16">
      <div class="grid gap-px border border-black/10 bg-black/10 sm:grid-cols-2 lg:grid-cols-3">
        {tags.map((tag, index) => <a href={`/blog/tags/${tag}`} class="group flex min-h-36 flex-col justify-between bg-[var(--brand-paper)] p-6"><span class="field-label text-[var(--brand-orange)]">{String(index + 1).padStart(2, "0")}</span><strong class="font-editorial mt-5 text-3xl font-normal capitalize group-hover:text-[var(--brand-orange)]">{tag.replaceAll("-", " ")} →</strong></a>)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
