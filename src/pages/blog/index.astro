---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import readingTime from "reading-time";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();
---

<BaseLayout pageTitle="Practical AI Guides" pageDescription="Plain-English guides to Claude, AI workflows, automation, and using AI well at work.">
  <div class="bg-white text-black dark:bg-base-950 dark:text-white">
    <header class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1fr_22rem] lg:items-end lg:py-28">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-base-500 dark:text-base-400">Practical AI field guide</p>
        <h1 class="mt-5 max-w-3xl font-sans text-4xl font-semibold leading-[1.04] tracking-[-0.04em] sm:text-6xl lg:text-7xl">Use AI to get real work done.</h1>
      </div>
      <p class="text-base leading-7 text-base-600 dark:text-base-300">Clear explanations and step-by-step workflows for people who want useful results—not a daily stream of AI hype.</p>
    </header>

    {tags.length > 0 && (
      <nav class="mx-auto flex max-w-6xl flex-wrap gap-2 border-t border-black/10 px-5 py-5 dark:border-white/10 sm:px-8" aria-label="Browse by topic">
        {tags.map((tag) => <a href={`/blog/tags/${tag}`} class="border border-black/10 px-3 py-2 text-xs text-base-500 transition hover:border-black hover:text-black dark:border-white/15 dark:text-base-400 dark:hover:border-white dark:hover:text-white">{tag}</a>)}
      </nav>
    )}

    <section class="border-y border-black/10 bg-base-50 dark:border-white/10 dark:bg-base-900" aria-label="All articles">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
        {posts.length > 0 ? (
          <div class="grid gap-px overflow-hidden border border-black/10 bg-black/10 dark:border-white/10 dark:bg-white/10 md:grid-cols-2">
            {posts.map((post, index) => {
              const date = post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
              const time = readingTime(post.body ?? "").text;
              return (
                <article class="group bg-white p-5 dark:bg-base-950 sm:p-7">
                  <a href={`/blog/posts/${post.id}`} class="block">
                    <div class="overflow-hidden border border-black/10 bg-black dark:border-white/10">
                      <Image src={post.data.image.url} alt={post.data.image.alt} width={post.data.image.url.width} height={post.data.image.url.height} class="aspect-[16/9] w-full object-cover transition duration-300 group-hover:scale-[1.02]" loading={index < 2 ? "eager" : "lazy"} />
                    </div>
                    <p class="mt-5 text-xs uppercase tracking-wide text-base-400">{date} · {time}</p>
                    <h2 class="mt-3 font-sans text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">{post.data.title}</h2>
                    <p class="mt-3 text-sm leading-6 text-base-500 dark:text-base-400">{post.data.description}</p>
                    <span class="mt-6 inline-block text-sm font-medium">Read the guide →</span>
                  </a>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="max-w-2xl py-12">
            <p class="text-xs font-medium uppercase tracking-wide text-base-400">New writing is coming</p>
            <h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight">The archive is intentionally empty.</h2>
            <p class="mt-5 text-base leading-7 text-base-500 dark:text-base-400">I’m rebuilding this collection around practical AI guides for business owners and teams. Check back soon.</p>
          </div>
        )}
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-8 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1fr_auto] lg:items-center">
      <div><p class="text-xs font-medium uppercase tracking-wide text-base-400">Need a recommendation for your business?</p><h2 class="mt-3 max-w-2xl font-sans text-2xl font-semibold tracking-tight sm:text-3xl">I’ll find the AI tools and workflows most likely to give you time back.</h2></div>
      <a href="/free-ai-review/" class="inline-flex min-h-12 items-center justify-center bg-black px-6 text-sm font-medium text-white dark:bg-white dark:text-black">Get a free AI workflow review →</a>
    </section>
  </div>
</BaseLayout>
