---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import BlogCard2 from "@/components/blog/BlogCard2.astro";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();
---

<BaseLayout pageTitle="Practical AI Guides" pageDescription="Plain-English AI guides for small businesses and teams that want useful results at work.">
  <section>
    <Wrapper class="py-16 sm:py-24 lg:py-32">
      <p class="text-sm font-medium text-base-500">Writing</p>
      <h1 class="mt-6 text-4xl font-medium leading-[1.08] tracking-[-0.045em] sm:text-5xl">Practical notes about using AI at work.</h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-base-500">Clear workflows, honest tool comparisons, and small systems you can actually put to use.</p>
    </Wrapper>
  </section>

  {tags.length > 0 && (
    <Wrapper class="pb-8">
      <nav class="flex flex-wrap gap-x-4 gap-y-2 border-t border-black/10 pt-4" aria-label="Browse writing by topic">
        {tags.map((tag) => <a href={`/blog/tags/${tag}`} class="text-sm text-base-500 hover:text-black">{tag.replaceAll("-", " ")}</a>)}
      </nav>
    </Wrapper>
  )}

  <section>
    <Wrapper class="pb-16 sm:pb-24">
      <div class="divide-y divide-black/10 border-y border-black/10">
        {posts.map((post) => <div class="py-3"><BlogCard2 post={post} /></div>)}
      </div>
    </Wrapper>
  </section>

  <section>
    <Wrapper class="pb-16 sm:pb-24">
      <div class="border-t border-black/10 pt-8">
        <h2 class="text-2xl font-medium tracking-tight">Have a question about AI and your work?</h2>
        <p class="mt-4 text-sm leading-6 text-base-500">Email me the situation and I’ll point you toward the most useful next step.</p>
        <a href="mailto:hello@raleighaiguy.com" class="site-cta mt-6">Email me</a>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
