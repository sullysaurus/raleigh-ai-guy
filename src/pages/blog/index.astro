---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Sections

import BlogCard1 from "@/components/blog/BlogCard1.astro";
// Components

// Import the collection of all blog posts
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
const sortedPosts = posts
  .slice()
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const sortedTags: string[] = [
  ...new Set(sortedPosts.flatMap((post) => post.data.tags || [])),
].sort((a, b) => a.localeCompare(b));
---

<BaseLayout
  pageTitle="Blog"
  pageDescription="Notes on AI automation, product work, and systems that help companies grow revenue."
>
  <section>
    <Wrapper variant="standard" class="pt-12 lg:py-32 xl:py-54">
      <Text
        tag="h1"
        variant="textBase"
        class="text-black dark:text-white font-medium"
      >
        Notes on AI automation and product work
      </Text>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="standard" class="py-12">
      <div class="mt-8 flex flex-wrap gap-1">
        {
          sortedTags.map((tag) => (
            <>
              <Button
                size="small"
                variant="muted"
                title={tag}
                aria-label={tag}
                href={`/blog/tags/${tag}`}
              >
                {tag}
              </Button>
            </>
          ))
        }
      </div>
      <div
        class="flex flex-col gap-8 mt-8 border-t dark:border-white/10 border-black/10 pt-4"
      >
        {sortedPosts.map((post) => <BlogCard1 post={post} />)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
