---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout pageTitle="Page Not Found" pageDescription="The page you were looking for does not exist." noindex>
  <section class="grid min-h-[65svh] place-items-center bg-[var(--editorial-purple)] px-5 text-center text-[var(--editorial-ink)]  "><div class="max-w-2xl"><p class="text-xs font-medium uppercase tracking-wide text-base-400">Error 404</p><h1 class="mt-5 font-sans text-4xl font-semibold tracking-tight sm:text-6xl">That page is not here.</h1><p class="mt-5 text-base leading-7 text-base-500 dark:text-base-400">The link may be old, or the page may have moved.</p><a href="/" class="editorial-button mt-8">Back home →</a></div></section>
</BaseLayout>
