---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout pageTitle="Page Not Found" pageDescription="The page you were looking for does not exist." noindex>
  <section class="utility-page">
    <div><p><span></span> Lost track · Error 404</p><h1>Wrong turn.<br /><em>Good recovery.</em></h1></div>
    <nav><a href="/">Go home ↗</a><a href="/projects/">See the work ↗</a><a href="/blog/">Read the notes ↗</a></nav>
  </section>
</BaseLayout>
<style>
  .utility-page{width:min(100% - 40px,1320px);min-height:75svh;margin:auto;display:grid;grid-template-columns:1fr auto;gap:4rem;align-items:center;color:#11110f}.dark .utility-page{color:#f0ebdd}.utility-page p{display:flex;align-items:center;gap:.7rem;font-size:.65rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.utility-page p span{width:2.5rem;height:2px;background:#ff4b36}.utility-page h1{margin-top:1.5rem;font-family:"Anybody";font-size:clamp(4.5rem,10vw,10rem);font-weight:850;line-height:.78;letter-spacing:-.06em;text-transform:uppercase}.utility-page h1 em{color:#2947ff;font-style:normal}.utility-page nav{display:flex;flex-direction:column;gap:1rem}.utility-page nav a{padding:.7rem 0;border-bottom:1px solid currentColor;font-size:.72rem;font-weight:800;text-transform:uppercase}@media(max-width:650px){.utility-page{width:min(100% - 28px,1320px);grid-template-columns:1fr;align-content:center}.utility-page nav{align-items:flex-start}}
</style>
