---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout pageTitle="Page Not Found" pageDescription="The page you were looking for does not exist." noindex>
  <section class="grid min-h-[65svh] place-items-center bg-[var(--brand-surface-soft)] px-5 text-center text-[var(--brand-text)]"><div class="max-w-2xl"><p class="brand-eyebrow">Error 404</p><h1 class="brand-section-title mt-5">That page is not here.</h1><p class="brand-copy mx-auto mt-5">The link may be old, or the page may have moved.</p><a href="/" class="brand-button mt-8">Back home →</a></div></section>
</BaseLayout>
