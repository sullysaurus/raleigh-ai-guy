---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout pageTitle="Page Not Found" pageDescription="The page you were looking for does not exist." noindex>
  <section class="grid min-h-[65svh] place-items-center bg-white px-5 text-center text-black dark:bg-base-950 dark:text-white"><div class="max-w-2xl"><p class="text-xs font-medium uppercase tracking-wide text-base-400">Error 404</p><h1 class="mt-5 font-sans text-4xl font-semibold tracking-tight sm:text-6xl">That page is not here.</h1><p class="mt-5 text-base leading-7 text-base-500 dark:text-base-400">The link may be old, or the page may have moved.</p><a href="/" class="mt-8 inline-flex min-h-12 items-center bg-black px-6 text-sm font-medium text-white dark:bg-white dark:text-black">Back home →</a></div></section>
</BaseLayout>
