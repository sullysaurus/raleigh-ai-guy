---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/global/PageIntro.astro";
import EditorialList from "@/components/global/EditorialList.astro";
import ContactBand from "@/components/global/ContactBand.astro";

const agenda = [
  { title: "AI without the hype", body: "What current tools do well, where they fail, and what still needs human judgment." },
  { title: "Useful examples", body: "Live workflows shaped around work your team recognizes." },
  { title: "Find the friction", body: "Identify one process worth improving first." },
  { title: "Questions and next steps", body: "Apply the ideas to your team, tools, and concerns." },
];
---

<BaseLayout pageTitle="Practical AI Workshops for Raleigh Teams" pageDescription="Practical AI workshops for teams that want clearer judgment and useful workflows without the hype.">
  <PageIntro eyebrow="Workshops · Raleigh or remote" title="Make AI useful for the work your team already does." description="A practical session built around honest questions, recognizable workflows, and a clear understanding of where AI helps and where it does not." ctaHref="/contact/" ctaLabel="Ask about a workshop" />
  <EditorialList eyebrow="A simple workshop outline" title="Learn it by using it." items={agenda} surface="soft" />
  <ContactBand eyebrow="Built around your team" title="Tell me what your team is trying to understand." description="I’ll reply personally about the audience, format, and whether I’m the right person for the session." ctaLabel="Plan a workshop" />
</BaseLayout>
