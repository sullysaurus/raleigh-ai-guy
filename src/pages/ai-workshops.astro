---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import profileImage from "../../danny.jpeg";

const outcomes = [
  ["See it clearly", "Understand where AI helps, where it fails, and what still needs human judgment."],
  ["Spot the opportunity", "Find the repetitive or messy work worth improving first."],
  ["Start responsibly", "Leave with a practical next step and safer habits for using AI at work."],
];

const agenda = [
  ["00–10", "AI without the hype", "What it does well, where it breaks, and what has changed."],
  ["10–30", "Useful examples", "Live workflows shaped around work your team recognizes."],
  ["30–45", "Find the friction", "Identify one process worth improving first."],
  ["45–60", "Questions + next step", "Apply the ideas to your team, tools, and concerns."],
];

const fieldClass = "mt-2 w-full border-2 border-[#151515] bg-[#fffdf8] px-4 py-3 text-base text-black outline-none transition placeholder:text-base-400 focus:bg-white focus:shadow-[3px_3px_0_#151515]";
---

<BaseLayout
  pageTitle="Practical AI Workshops for Raleigh Teams"
  pageDescription="A practical 60-minute AI workshop that helps Raleigh teams find useful workflows, understand the risks, and choose a clear first step."
>
  <div class="editorial-page bg-[var(--editorial-canvas)] text-[var(--editorial-ink)]  ">
    <section class="border-b-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-blue)]  "><div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1fr_21rem] lg:items-end lg:py-28">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-base-500 dark:text-base-400">Practical AI workshop · Raleigh or remote</p>
        <h1 class="mt-5 max-w-3xl text-balance font-sans text-4xl font-semibold leading-[1.04] tracking-[-0.04em] sm:text-6xl lg:text-7xl">
          Make AI useful for the work your team already does.
        </h1>
        <p class="mt-7 max-w-2xl text-base leading-7 text-base-600 dark:text-base-300 sm:text-lg">
          Bring the messy workflows and honest questions. In 60 minutes, your team will see what is useful, what is risky, and where to start.
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <a href="#request" class="editorial-button">Request a team workshop <span class="ml-3">→</span></a>
          <span class="text-sm text-base-500 dark:text-base-400">Private sessions start at $750</span>
        </div>
      </div>

      <aside class="border-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-purple)] p-6 shadow-[7px_7px_0_var(--editorial-shadow)]    sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-base-500 dark:text-base-400">At a glance</p>
        <ul class="mt-6 divide-y divide-black/10 border-y border-black/10 dark:divide-white/10 dark:border-white/10">
          <li class="flex items-baseline justify-between gap-5 py-4"><span class="text-sm text-base-500 dark:text-base-400">Length</span><strong class="text-sm font-medium">60 minutes</strong></li>
          <li class="flex items-baseline justify-between gap-5 py-4"><span class="text-sm text-base-500 dark:text-base-400">Format</span><strong class="text-sm font-medium">Live + Q&amp;A</strong></li>
          <li class="flex items-baseline justify-between gap-5 py-4"><span class="text-sm text-base-500 dark:text-base-400">Location</span><strong class="text-sm font-medium">Raleigh or remote</strong></li>
          <li class="flex items-baseline justify-between gap-5 py-4"><span class="text-sm text-base-500 dark:text-base-400">Private price</span><strong class="text-sm font-medium">From $750</strong></li>
        </ul>
        <p class="mt-5 text-xs leading-5 text-base-500 dark:text-base-400">Includes a short prep call, tailored examples, live Q&amp;A, and a takeaway guide.</p>
      </aside>
    </div></section>

    <section class="border-b-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-canvas)]  ">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-base-500 dark:text-base-400">What your team leaves with</p>
          <h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight sm:text-5xl">Less hype. More clarity.</h2>
        </div>
        <div class="mt-10 grid gap-4 lg:grid-cols-3">
          {outcomes.map(([title, description], index) => (
            <article class:list={["border-2 border-[var(--editorial-line-strong)] p-6 text-[var(--editorial-ink)] shadow-[5px_5px_0_var(--editorial-shadow)]   ", index === 0 ? "bg-[var(--editorial-green)] " : index === 1 ? "bg-[var(--editorial-rust)] " : "bg-[var(--editorial-purple)] "]}>
              <span class="text-xs font-semibold opacity-45">0{index + 1}</span>
              <h3 class="mt-10 font-sans text-xl font-semibold">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-base-500 dark:text-base-400">{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-orange)] text-[var(--editorial-ink)]   "><div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[18rem_1fr] lg:gap-20">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] opacity-55">The 60-minute plan</p>
        <h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight sm:text-4xl">One useful conversation.</h2>
        <p class="mt-5 text-sm leading-6 opacity-70">Examples adjust to your team’s work and questions.</p>
      </div>
      <ol class="divide-y-2 divide-[var(--editorial-line-strong)] border-y-2 border-[var(--editorial-line-strong)]  ">
        {agenda.map(([time, title, description]) => (
          <li class="grid gap-3 py-6 sm:grid-cols-[5rem_1fr]">
            <span class="text-xs font-semibold opacity-50">{time}</span>
            <div><h3 class="font-sans text-base font-semibold">{title}</h3><p class="mt-1 max-w-2xl text-sm leading-6 opacity-70">{description}</p></div>
          </li>
        ))}
      </ol>
    </div></section>

    <section class="mx-auto grid max-w-6xl gap-5 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-2">
      <article class="border-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-canvas)] p-7 shadow-[5px_5px_0_var(--editorial-shadow)]    sm:p-9">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-base-500 dark:text-base-400">For one organization</p>
        <h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight">Private team workshop</h2>
        <p class="mt-4 text-sm leading-6 text-base-500 dark:text-base-400">A tailored session for employees, leaders, nonprofits, or boards.</p>
        <p class="mt-7 text-sm font-semibold">From $750 · Up to 20 people</p>
      </article>
      <article class="border-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-green)] p-7 shadow-[5px_5px_0_var(--editorial-shadow)]    sm:p-9">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-base-500 dark:text-base-400">For Raleigh communities</p>
        <h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight">Community session</h2>
        <p class="mt-4 text-sm leading-6 text-base-500 dark:text-base-400">Limited complimentary sessions for business associations, professional groups, and coworking communities.</p>
        <p class="mt-7 text-sm font-semibold">Limited availability · Organizer provides the audience</p>
      </article>
    </section>

    <section class="border-y-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-purple)]  ">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:px-8 sm:py-16 lg:grid-cols-[1fr_20rem] lg:items-center lg:gap-20">
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-base-500 dark:text-base-400">Your facilitator</p>
          <h2 class="mt-4 max-w-2xl font-sans text-3xl font-semibold tracking-tight sm:text-4xl">Built by someone who teaches and ships AI.</h2>
          <p class="mt-5 max-w-2xl text-sm leading-6 text-base-600 dark:text-base-300">I’m Danny Sullivan, an AI Product Engineer at Gametime. I previously spent nearly five years creating AI education and internal tools at Pluralsight.</p>
        </div>
        <div class="flex items-center gap-5 border-t border-black/10 pt-6 dark:border-white/10 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
          <Image src={profileImage} alt="Danny Sullivan" width={96} height={96} class="size-20 rounded-full object-cover grayscale" />
          <div><strong class="block text-sm">Danny Sullivan</strong><span class="mt-1 block text-sm leading-5 text-base-500 dark:text-base-400">AI Product Engineer<br />Raleigh, North Carolina</span></div>
        </div>
      </div>
    </section>

    <section id="request" class="scroll-mt-8 border-b-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-blue)] text-[var(--editorial-ink)]   ">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[20rem_1fr] lg:gap-24">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] opacity-50">Request a workshop</p>
          <h2 class="mt-4 text-balance font-sans text-3xl font-semibold tracking-tight sm:text-5xl">Bring one messy workflow.</h2>
          <p class="mt-5 max-w-xs text-sm leading-6 text-base-600 dark:text-base-300">Tell me where your team gets stuck. I’ll follow up personally about availability and fit.</p>
          <div class="mt-10 hidden h-3 w-32 -rotate-2 bg-[#ff6f4f] lg:block" aria-hidden="true"></div>
        </div>

        <form name="ai-lunch-and-learn" method="POST" action="/workshop-thank-you/" data-netlify="true" data-netlify-honeypot="bot-field" class="border-2 border-[var(--editorial-line-strong)] bg-[#fffdf8] p-5 text-black shadow-[7px_7px_0_var(--editorial-shadow)]   sm:p-8">
          <input type="hidden" name="form-name" value="ai-lunch-and-learn" />
          <p class="absolute -left-[10000px] size-px overflow-hidden" aria-hidden="true"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="text-sm font-medium">Your name <span class="text-base-400">*</span><input class={fieldClass} type="text" name="name" autocomplete="name" required placeholder="Jane Smith" /></label>
            <label class="text-sm font-medium">Work email <span class="text-base-400">*</span><input class={fieldClass} type="email" name="email" autocomplete="email" required placeholder="jane@company.com" /></label>
            <label class="text-sm font-medium">Organization <span class="text-base-400">*</span><input class={fieldClass} type="text" name="organization" autocomplete="organization" required placeholder="Your company or nonprofit" /></label>
            <label class="text-sm font-medium">Approximate team size<input class={fieldClass} type="text" name="team_size" placeholder="About 12 people" /></label>
            <label class="text-sm font-medium sm:col-span-2">Workshop type <span class="text-base-400">*</span><select class={fieldClass} name="workshop_type" required><option value="">Choose one</option><option>Private team workshop — from $750</option><option>Community or professional group — complimentary request</option></select></label>
          </div>
          <label class="mt-5 block text-sm font-medium">What would make this useful for your team? <span class="text-base-400">*</span><textarea class={fieldClass} name="goals" rows="5" maxlength="1400" required placeholder="We are curious about AI, but our team needs help with…"></textarea></label>
          <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
            <p class="max-w-sm text-xs leading-5 text-base-500">No mailing list. I’ll only use these details to respond to your request.</p>
            <button type="submit" class="editorial-button">Request workshop availability <span class="ml-3">→</span></button>
          </div>
        </form>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener(‘DOMContentLoaded’, function () {
    var form = document.querySelector(‘form[name="ai-lunch-and-learn"]’);
    if (form) {
      form.addEventListener(‘submit’, function () {
        var workshopType = form.querySelector(‘[name="workshop_type"]’)?.value || ‘’;
        window.posthog?.capture(‘workshop_form_submitted’, {
          form_name: ‘ai-lunch-and-learn’,
          workshop_type: workshopType
        });
      });
    }
  });
</script>
