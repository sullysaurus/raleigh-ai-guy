---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/global/PageIntro.astro";
import EditorialList from "@/components/global/EditorialList.astro";
import ContactBand from "@/components/global/ContactBand.astro";

const deliverables = [
  { title: "Understand the workflow", body: "A focused conversation about the work, the people involved, and where time or opportunities are being lost." },
  { title: "Rank the opportunities", body: "A short list of the best places to use AI, automation, ordinary software, or a clearer process." },
  { title: "Review value and risk", body: "An honest view of what could improve, what still needs human judgment, and what could make the system fail." },
  { title: "Choose a next step", body: "A practical recommendation you can use with me, your team, or another provider." },
];
---

<BaseLayout pageTitle="AI Workflow Diagnosis — Raleigh AI Guy" pageDescription="A focused review of a business workflow to find the useful AI opportunities and avoid unnecessary complexity.">
  <PageIntro eyebrow="AI workflow diagnosis" title="Find the work worth improving." description="Before buying tools or commissioning a build, get a clear view of where AI can help, where it cannot, and what the smallest useful next step looks like." ctaHref="/contact/" ctaLabel="Bring me a workflow" />
  <EditorialList eyebrow="What we cover" title="Clarity before complexity." items={deliverables} surface="soft" />
  <ContactBand eyebrow="A better starting point" title="Bring a real workflow, not an AI shopping list." description="Repetitive work involving email, forms, documents, reporting, or customer follow-up is often a useful place to begin." ctaLabel="Start the diagnosis" />
</BaseLayout>
