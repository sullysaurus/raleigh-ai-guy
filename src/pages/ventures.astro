---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import cineSponsor from "@/images/ventures/cinesponsor-marketplace.png";
import drumForFun from "@/images/ventures/drum-for-fun-concept.png";
import popstarPhotoBooths from "@/images/ventures/popstar-photo-booths-hero.png";
import prowl from "@/images/ventures/prowl-app-website.png";
import raleighLeadRecovery from "@/images/ventures/raleigh-lead-recovery-hero.png";

const ventures = [
  { title: "Raleigh Lead Recovery", category: "Local service · AI · Automation", tagline: "Keep working. We’ll catch the call.", description: "A missed-call recovery service for busy Raleigh businesses. Dana answers calls that would have gone to voicemail, captures what the customer needs, and texts the opportunity to the team.", image: raleighLeadRecovery, alt: "Raleigh Lead Recovery website homepage", href: "https://raleighleadrecovery.com/", cta: "Visit Raleigh Lead Recovery" },
  { title: "Prowl.fm", category: "Mobile · Music · Discovery", tagline: "Find live music near you, right now.", description: "A real-time map for finding nearby live music while it is still happening. Fans and artists put the room on the map, listeners follow the signal, and the city becomes the lineup.", image: prowl, alt: "Prowl live music discovery app website", href: "https://prowl.fm/", cta: "Visit Prowl" },
  { title: "Popstar Photo Booths", category: "Events · Photography · Built and sold", tagline: "A party business built to perform.", description: "I built and operated this Raleigh event business, pairing studio-quality photography with a technology-forward guest experience, then sold it to a new owner.", image: popstarPhotoBooths, alt: "Popstar Photo Booths website homepage", href: "https://popstarphotobooths.com/", cta: "Visit Popstar Photo Booths" },
  { title: "Drum for Fun", category: "Concept · Music · Membership", tagline: "Learn, restart, or just hit something in time.", description: "An early concept for a private drum studio built specifically for grown-ups: private rooms, ready-to-play gear, flexible memberships, and music people actually want to learn.", image: drumForFun, alt: "Drum for Fun adult drum studio concept website", href: "https://drumforfun.netlify.app/", cta: "View the concept" },
  { title: "CineSponsor", category: "Marketplace · Events · Local sponsorship", tagline: "Where local brands meet outdoor cinemas.", description: "A marketplace connecting pop-up cinema operators with local businesses. Organizers package sponsorships, brands find nearby audiences, and the deal moves through one focused platform.", image: cineSponsor, alt: "CineSponsor pop-up cinema sponsorship marketplace website", href: "https://www.cinesponsor.com/", cta: "Visit CineSponsor" },
];
---

<BaseLayout pageTitle="Ventures" pageDescription="Independent businesses and useful experiments built by Danny Sullivan in Raleigh, North Carolina.">
  <div class="editorial-page bg-[#fffdf8] text-[#151515] dark:bg-base-950 dark:text-white">
    <header class="border-b-2 border-[#151515] bg-[#dce8ff] dark:border-white dark:bg-[#17233c]"><div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1fr_22rem] lg:items-end lg:py-28"><div><p class="text-xs font-medium uppercase tracking-[0.14em] opacity-55">Independent businesses · Raleigh, NC</p><h1 class="mt-5 max-w-3xl font-sans text-4xl font-semibold leading-[1.04] tracking-[-0.04em] sm:text-6xl lg:text-7xl">Ideas I have pushed into the real world.</h1></div><p class="text-base leading-7 opacity-70">Businesses and experiments I have built, operated, grown, and tested with real customers.</p></div></header>

    <section class="bg-[#f0e4ff] dark:bg-[#302341]">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        {ventures.map((venture, index) => (
          <article class="grid gap-8 border-b-2 border-[#151515] py-12 last:border-b-0 dark:border-white lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-16 lg:py-16">
            <a href={venture.href} target="_blank" rel="noreferrer" class:list={["block overflow-hidden border-2 border-[#151515] bg-white p-3 shadow-[6px_6px_0_#151515] dark:border-white dark:bg-base-950 dark:shadow-[6px_6px_0_#f4f1e8]", index % 2 === 1 && "lg:order-2"]}><Image src={venture.image} alt={venture.alt} width={venture.image.width} height={venture.image.height} class="aspect-[16/10] w-full object-contain object-center" loading={index < 2 ? "eager" : "lazy"} /></a>
            <div><p class="text-xs font-medium uppercase tracking-wide text-base-400">{String(index + 1).padStart(2, "0")} · {venture.category}</p><h2 class="mt-4 font-sans text-3xl font-semibold tracking-tight sm:text-4xl">{venture.title}</h2><strong class="mt-4 block text-base font-medium">{venture.tagline}</strong><p class="mt-4 max-w-xl text-sm leading-6 text-base-500 dark:text-base-400">{venture.description}</p><a href={venture.href} target="_blank" rel="noreferrer" class="mt-6 inline-block text-sm font-medium">{venture.cta} →</a></div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
