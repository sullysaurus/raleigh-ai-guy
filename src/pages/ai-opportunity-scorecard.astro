---
import BaseLayout from "@/layouts/BaseLayout.astro";

const questions = [
  {
    legend: "How often does this workflow happen?",
    name: "frequency",
    options: [["A few times a month", "1"], ["A few times a week", "2"], ["Every day", "3"]],
  },
  {
    legend: "How much team time does it consume each week?",
    name: "hours",
    options: [["Less than 2 hours", "1"], ["2–5 hours", "2"], ["More than 5 hours", "3"]],
  },
  {
    legend: "How consistent is the process?",
    name: "repeatability",
    options: [["It changes every time", "0"], ["Some steps repeat", "2"], ["Mostly the same steps", "3"]],
  },
  {
    legend: "Where does the information live?",
    name: "inputs",
    options: [["Mostly paper or conversations", "0"], ["A mix of places", "1"], ["Mostly email, forms, or software", "2"]],
  },
  {
    legend: "How easy would it be for a person to review the output?",
    name: "review",
    options: [["Difficult or high-risk", "0"], ["Possible with careful review", "1"], ["Quick and straightforward", "2"]],
  },
];
---

<BaseLayout
  pageTitle="Free AI Opportunity Scorecard for Service Businesses"
  pageDescription="Score one repetitive business workflow in under 10 minutes and see whether it is a strong candidate for AI, automation, or a better process."
>
  <div class="brand-page bg-[var(--brand-bg)] text-[var(--brand-text)]">
    <section class="border-b border-[var(--brand-line)]">
      <div class="mx-auto grid max-w-[96rem] gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[.85fr_1.15fr] lg:items-end lg:gap-20 lg:px-12">
        <div>
          <p class="inline-flex items-center gap-3 rounded-full border border-[var(--brand-line)] px-4 py-2 text-xs font-bold text-[var(--brand-muted)]"><span class="size-2 rounded-full bg-[var(--brand-orange)]"></span>Free · about 7 minutes</p>
          <h1 class="mt-8 max-w-4xl font-sans text-[clamp(3.25rem,6vw,6.4rem)] font-extrabold leading-[.91] tracking-[-.07em]">Is this work ready for <em class="font-serif font-normal text-[var(--brand-orange)]">AI?</em></h1>
        </div>
        <div class="max-w-2xl lg:pb-2">
          <div class="brand-card mb-10 bg-[var(--brand-surface)] p-5 sm:p-6" aria-hidden="true">
            <div class="flex items-center justify-between gap-4 border-b border-[var(--brand-line)] pb-4">
              <p class="text-[.65rem] font-bold uppercase tracking-[.18em] text-[var(--brand-orange)]">AI opportunity signal</p>
              <span class="rounded-full bg-[var(--brand-surface-soft)] px-3 py-1 text-[.62rem] font-bold uppercase tracking-[.12em] text-[var(--brand-muted)]">Example</span>
            </div>
            <div class="grid items-center gap-6 pt-5 sm:grid-cols-[9rem_1fr]">
              <div class="score-preview-ring relative mx-auto grid aspect-square w-32 place-items-center rounded-full">
                <div class="grid size-[6.2rem] place-items-center rounded-full bg-[var(--brand-surface)] text-center">
                  <div><strong class="block font-sans text-4xl font-extrabold leading-none tracking-[-.06em]">10</strong><span class="mt-1 block text-[.62rem] font-bold uppercase tracking-[.12em] text-[var(--brand-muted)]">of 13</span></div>
                </div>
              </div>
              <div class="space-y-4">
                <div><div class="flex justify-between text-xs font-bold"><span>Repeatable work</span><span class="text-[var(--brand-muted)]">High</span></div><div class="mt-2 h-2 overflow-hidden rounded-full bg-[var(--brand-surface-soft)]"><div class="h-full w-[88%] rounded-full bg-[var(--brand-orange)]"></div></div></div>
                <div><div class="flex justify-between text-xs font-bold"><span>Digital inputs</span><span class="text-[var(--brand-muted)]">Strong</span></div><div class="mt-2 h-2 overflow-hidden rounded-full bg-[var(--brand-surface-soft)]"><div class="h-full w-[76%] rounded-full bg-[var(--brand-ink)]"></div></div></div>
                <div><div class="flex justify-between text-xs font-bold"><span>Human review</span><span class="text-[var(--brand-muted)]">Easy</span></div><div class="mt-2 h-2 overflow-hidden rounded-full bg-[var(--brand-surface-soft)]"><div class="h-full w-[82%] rounded-full bg-[var(--brand-ink)]"></div></div></div>
              </div>
            </div>
            <div class="mt-5 flex items-center justify-between gap-4 rounded-xl bg-[var(--brand-ink)] px-4 py-3 text-white"><span class="text-xs font-bold">Promising workflow</span><span class="text-[var(--brand-orange)]">→</span></div>
          </div>
          <p class="text-lg font-semibold leading-8 sm:text-xl">Score one repetitive workflow before you buy another tool or commit to a build.</p>
          <p class="mt-5 text-base leading-7 text-[var(--brand-muted)]">You’ll see whether the work is a strong automation candidate, a promising workflow that needs definition, or a process to improve first.</p>
        </div>
      </div>
    </section>

    <section class="bg-[var(--brand-surface-soft)]">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[19rem_1fr] lg:gap-20">
        <aside>
          <p class="text-xs font-bold uppercase tracking-[.18em] text-[var(--brand-orange)]">What you get</p>
          <h2 class="mt-5 font-sans text-3xl font-bold leading-none tracking-[-.04em]">A useful answer, immediately.</h2>
          <ol class="mt-8 space-y-5 border-t border-[var(--brand-line)] pt-6 text-sm leading-6 text-[var(--brand-muted)]">
            <li><strong class="block text-[var(--brand-text)]">01 · Readiness score</strong>See how suitable the workflow is for responsible automation.</li>
            <li><strong class="block text-[var(--brand-text)]">02 · Best next move</strong>Know whether to clarify, test, or investigate the workflow.</li>
            <li><strong class="block text-[var(--brand-text)]">03 · No forced pitch</strong>If AI is not the answer yet, the result will say so.</li>
          </ol>
        </aside>

        <form id="scorecard-form" name="ai-opportunity-scorecard" method="POST" action="/scorecard-thank-you/" data-netlify="true" data-netlify-honeypot="bot-field" class="brand-form-panel p-5 sm:p-8">
          <input type="hidden" name="form-name" value="ai-opportunity-scorecard" />
          <input type="hidden" name="score" value="" />
          <input type="hidden" name="result" value="" />
          <p class="absolute -left-[10000px] size-px overflow-hidden" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="text-sm font-bold">First name <span class="text-[var(--brand-orange)]">*</span><input class="brand-field" type="text" name="first_name" autocomplete="given-name" required placeholder="Danny" /></label>
            <label class="text-sm font-bold">Work email <span class="text-[var(--brand-orange)]">*</span><input class="brand-field" type="email" name="email" autocomplete="email" required placeholder="you@company.com" /></label>
            <label class="text-sm font-bold sm:col-span-2">Business or organization <span class="font-normal text-[var(--brand-muted)]">(optional)</span><input class="brand-field" type="text" name="company" autocomplete="organization" placeholder="Your company" /></label>
            <label class="text-sm font-bold sm:col-span-2">What workflow are you scoring? <span class="text-[var(--brand-orange)]">*</span><span class="mt-1 block font-normal leading-5 text-[var(--brand-muted)]">For example: sorting leads, drafting estimates, following up after appointments, or preparing weekly reports.</span><textarea class="brand-field" name="workflow" rows="3" maxlength="500" required></textarea></label>
          </div>

          <div class="mt-9 space-y-8 border-t border-[var(--brand-line)] pt-8">
            {questions.map((question, questionIndex) => (
              <fieldset>
                <legend class="text-base font-bold"><span class="mr-3 text-xs text-[var(--brand-orange)]">0{questionIndex + 1}</span>{question.legend}</legend>
                <div class="mt-4 grid gap-3 sm:grid-cols-3">
                  {question.options.map(([label, value]) => (
                    <label class="flex min-h-16 cursor-pointer items-center gap-3 rounded-xl border border-black/15 bg-white px-4 py-3 text-sm font-medium transition-colors has-[:checked]:border-[var(--brand-orange)] has-[:checked]:bg-[#fff3ec]">
                      <input type="radio" name={question.name} value={value} required class="size-4 border-black/30 text-[var(--brand-orange)] focus:ring-[var(--brand-orange)]" />
                      <span>{label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}
          </div>

          <div class="mt-9 flex flex-col gap-4 border-t border-[var(--brand-line)] pt-7 sm:flex-row sm:items-center sm:justify-between">
            <p class="max-w-sm text-xs leading-5 text-[var(--brand-muted)]">Your result appears immediately. Danny may follow up personally if the workflow looks like a fit. No spam.</p>
            <button type="submit" class="brand-button shrink-0">See my opportunity score <span class="ml-3">→</span></button>
          </div>
          <p id="scorecard-status" class="mt-4 hidden text-sm text-[var(--brand-muted)]" role="status"></p>
        </form>
      </div>
    </section>

    <section id="scorecard-result" class="hidden border-y border-white/10 bg-[var(--brand-ink)] text-white" tabindex="-1">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[.65fr_1.35fr] lg:items-end lg:gap-20">
        <div>
          <p class="text-xs font-bold uppercase tracking-[.18em] text-[var(--brand-orange)]">Your result</p>
          <p class="mt-5 font-sans text-7xl font-extrabold tracking-[-.07em]"><span data-score>0</span><span class="text-3xl text-white/35">/13</span></p>
        </div>
        <div>
          <h2 data-result-title class="font-sans text-4xl font-bold leading-[.98] tracking-[-.05em] sm:text-5xl"></h2>
          <p data-result-copy class="mt-6 max-w-2xl text-base leading-7 text-white/65 sm:text-lg sm:leading-8"></p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/ai-diagnosis/" class="brand-button">Turn this into a practical roadmap <span class="ml-3">→</span></a>
            <button type="button" data-score-again class="social-chip border-white/35 text-white">Score another workflow</button>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('scorecard-form');
    var resultSection = document.getElementById('scorecard-result');
    var status = document.getElementById('scorecard-status');
    if (!form || !resultSection) return;

    var results = [
      {
        max: 6,
        title: 'Improve the process first.',
        copy: 'This workflow may still be valuable to improve, but it is not a strong automation candidate yet. Clarify the steps, move key information into a consistent place, and make human ownership explicit before adding AI.'
      },
      {
        max: 10,
        title: 'Promising—with a little definition.',
        copy: 'There is likely useful leverage here. A small test could help, but the workflow needs clearer inputs, review rules, or success measures before it becomes a dependable system.'
      },
      {
        max: 13,
        title: 'Strong automation candidate.',
        copy: 'This work happens often, follows repeatable steps, and can be reviewed by a person. It is a good candidate for a focused diagnosis and a small, measurable implementation.'
      }
    ];

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      if (!form.reportValidity()) return;

      var formData = new FormData(form);
      var score = ['frequency', 'hours', 'repeatability', 'inputs', 'review'].reduce(function (total, name) {
        return total + Number(formData.get(name) || 0);
      }, 0);
      var result = results.find(function (item) { return score <= item.max; }) || results[2];

      form.querySelector('[name="score"]').value = String(score);
      form.querySelector('[name="result"]').value = result.title;
      formData = new FormData(form);
      status.textContent = 'Calculating and saving your result…';
      status.classList.remove('hidden');

      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData).toString()
        });
        status.textContent = 'Your result is ready below.';
      } catch (error) {
        status.textContent = 'Your result is ready below. Your details may not save while viewing the site locally.';
      }

      resultSection.querySelector('[data-score]').textContent = String(score);
      resultSection.querySelector('[data-result-title]').textContent = result.title;
      resultSection.querySelector('[data-result-copy]').textContent = result.copy;
      resultSection.classList.remove('hidden');
      resultSection.focus({ preventScroll: true });
      resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.posthog?.capture('ai_scorecard_completed', { score: score, result: result.title });
    });

    resultSection.querySelector('[data-score-again]')?.addEventListener('click', function () {
      form.reset();
      resultSection.classList.add('hidden');
      status.classList.add('hidden');
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
