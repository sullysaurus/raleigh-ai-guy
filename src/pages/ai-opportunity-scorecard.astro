---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const checks = ["The work happens repeatedly.", "The current process takes meaningful time or causes delays.", "The inputs and desired output can be explained clearly.", "A person can review the result before it matters.", "Improvement can be measured in time, response speed, quality, or revenue."];
---

<BaseLayout pageTitle="AI Opportunity Checklist — Raleigh AI Guy" pageDescription="A short checklist for deciding whether a business workflow is a useful AI opportunity.">
  <section><Wrapper class="py-16 sm:py-24 lg:py-32"><p class="text-sm font-medium text-base-500">AI opportunity checklist</p><h1 class="mt-6 text-4xl font-medium leading-[1.08] tracking-[-0.045em] sm:text-5xl">Is this workflow worth improving?</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-base-500">A promising opportunity usually has most of these characteristics.</p><ul class="mt-10 divide-y divide-black/10 border-y border-black/10">{checks.map((check, index) => <li class="grid grid-cols-[2rem_1fr] gap-4 py-5"><span class="text-xs text-base-400">0{index + 1}</span><span class="text-sm font-medium">{check}</span></li>)}</ul><p class="mt-8 text-sm leading-6 text-base-500">If your workflow fits, email me a short description and I’ll give you an honest read.</p><a href="mailto:hello@raleighaiguy.com?subject=AI%20opportunity" class="mt-6 inline-flex min-h-11 items-center rounded-lg bg-black px-4 text-sm font-medium text-white hover:bg-base-800">Email me</a></Wrapper></section>
</BaseLayout>
