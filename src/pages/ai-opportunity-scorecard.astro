---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/global/PageIntro.astro";
import EditorialList from "@/components/global/EditorialList.astro";
import ContactBand from "@/components/global/ContactBand.astro";

const checks = [
  { title: "It repeats", body: "The work happens often enough for improvement to matter." },
  { title: "It costs something", body: "The current process takes meaningful time or causes delays." },
  { title: "It can be explained", body: "The inputs and desired output are clear enough to describe." },
  { title: "A person can review it", body: "Human judgment can catch problems before the result matters." },
  { title: "Progress is measurable", body: "You can see improvement in time, response speed, quality, or revenue." },
];
---

<BaseLayout pageTitle="AI Opportunity Checklist — Raleigh AI Guy" pageDescription="A short checklist for deciding whether a business workflow is a useful AI opportunity.">
  <PageIntro eyebrow="AI opportunity checklist" title="Is this workflow worth improving?" description="A promising opportunity usually has most of these characteristics." />
  <EditorialList eyebrow="Five useful signals" title="Look for work that can prove its value." items={checks} surface="soft" />
  <ContactBand eyebrow="Does your workflow fit?" title="Send me a short description and I’ll give you an honest read." ctaLabel="Describe the workflow" />
</BaseLayout>
