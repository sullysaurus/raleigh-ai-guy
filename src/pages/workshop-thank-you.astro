---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout pageTitle="AI Workshop Request Received" pageDescription="Thanks for requesting an AI lunch and learn with Danny Sullivan." noindex>
  <section class="received"><p><span></span> Request received · Class is forming</p><h1>Thanks.<br /><em>We’ll talk soon.</em></h1><div><p>I’ll review what you shared and follow up by email about the session, timing, and the questions that matter most to your team.</p><a href="/">Back home <span>↗</span></a></div></section>
</BaseLayout>
<style>
  .received{width:min(100% - 40px,1320px);min-height:75svh;margin:auto;display:grid;grid-template-columns:1fr minmax(260px,.35fr);gap:2rem 6rem;align-content:center;color:#11110f}.dark .received{color:#f0ebdd}.received>p{grid-column:1/-1;display:flex;align-items:center;gap:.7rem;font-size:.65rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.received>p span{width:2.5rem;height:2px;background:#ff4b36}.received h1{font-family:"Anybody";font-size:clamp(4rem,9vw,9rem);font-weight:850;line-height:.78;letter-spacing:-.06em;text-transform:uppercase}.received h1 em{color:#2947ff;font-style:normal}.received>div{align-self:end}.received>div p{line-height:1.6}.received a{display:flex;justify-content:space-between;margin-top:2rem;padding:1rem;background:#2947ff;color:white;box-shadow:5px 5px 0 #11110f;font-size:.7rem;font-weight:800;text-transform:uppercase}@media(max-width:650px){.received{width:min(100% - 28px,1320px);grid-template-columns:1fr;align-content:center}}
</style>
