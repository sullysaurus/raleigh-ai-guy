---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout pageTitle="AI Workshop Request Received" pageDescription="Thanks for requesting a practical AI workshop with Danny Sullivan." noindex>
  <section class="grid min-h-[65svh] place-items-center bg-[var(--editorial-blue)] px-5 text-center text-[var(--editorial-ink)]  "><div class="max-w-xl"><span class="mx-auto grid size-12 place-items-center border-2 border-[var(--editorial-line-strong)] bg-[#d7ef6f] text-xl text-black shadow-[3px_3px_0_var(--editorial-shadow)]  ">✓</span><p class="mt-7 text-xs font-medium uppercase tracking-wide text-base-400">Request received</p><h1 class="mt-4 font-sans text-4xl font-semibold tracking-tight sm:text-5xl">Thanks. We’ll talk soon.</h1><p class="mt-6 text-base leading-7 text-base-500 dark:text-base-400">I’ll review what you shared and follow up by email about the session, timing, and the questions that matter most to your team.</p><a href="/" class="editorial-button mt-8">Back home →</a></div></section>
</BaseLayout>
