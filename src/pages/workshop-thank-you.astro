<BaseLayout pageTitle="AI Workshop Request Received" pageDescription="Thanks for requesting a practical AI workshop with Danny Sullivan." noindex>
  <section class="grid min-h-[65svh] place-items-center bg-[var(--brand-surface-soft)] px-5 text-center text-[var(--brand-text)]"><div class="max-w-xl"><span class="mx-auto grid size-12 place-items-center rounded-full bg-[var(--brand-orange)] text-xl text-[var(--brand-ink)]">✓</span><p class="brand-eyebrow mt-7">Request received</p><h1 class="brand-section-title mt-4">Thanks. We’ll talk soon.</h1><p class="brand-copy mx-auto mt-6">I’ll review what you shared and follow up by email about the session, timing, and the questions that matter most to your team.</p><a href="/" class="brand-button mt-8">Back home →</a></div></section>
</BaseLayout>
