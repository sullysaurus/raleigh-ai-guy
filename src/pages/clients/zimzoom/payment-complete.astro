---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  pageTitle="Payment complete"
  pageDescription="Your ZimZoom consulting payment setup is complete."
  noindex
  minimal
>
  <div class="grid min-h-svh place-items-center bg-[#f2efe6] px-5 py-12 text-[#151515]">
    <main class="w-full max-w-xl border-2 border-[#151515] bg-[#fffdf8] p-7 text-center shadow-[8px_8px_0_#151515] sm:p-12">
      <span class="mx-auto grid size-12 place-items-center rounded-full bg-[#d7ef6f] text-xl font-bold" aria-hidden="true">✓</span>
      <p class="mt-7 text-xs font-semibold uppercase tracking-[0.14em] text-[#66645f]">Payment complete</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-[-.04em] sm:text-5xl">You’re all set.</h1>
      <p class="mx-auto mt-6 max-w-md text-base leading-7 text-[#54534f]">
        Stripe will email the payment receipt and billing details. I’ll follow up personally with the next consulting step.
      </p>
      <a href="mailto:hello@dannysullivan.ai" class="editorial-button mt-8">Contact Daniel</a>
    </main>
  </div>
</BaseLayout>
