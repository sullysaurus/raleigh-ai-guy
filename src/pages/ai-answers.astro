---
import AiQuestionForm from "@/components/global/AiQuestionForm.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const questions = [
  { category: "Choose", question: "Should I use ChatGPT or Claude for my business?" },
  { category: "Choose", question: "Which Claude model should I use?" },
  { category: "Choose", question: "Do I need more than one AI tool?" },
  { category: "Choose", question: "Is a paid AI plan worth it for a small business?" },
  { category: "Choose", question: "When should I use Claude Cowork instead of regular Claude?" },
  { category: "Improve", question: "Why does AI keep giving me generic answers?" },
  { category: "Improve", question: "How much context should I give Claude or ChatGPT?" },
  { category: "Improve", question: "How do I get AI to write in my voice?" },
  { category: "Improve", question: "How do I stop AI from making up information?" },
  { category: "Improve", question: "Should I create a master prompt for my business?" },
];
---

<BaseLayout
  pageTitle="Two-Minute AI Answers"
  pageDescription="Send Danny Sullivan your biggest AI bottleneck, problem, or question. Get a personalized two-minute video answer and browse practical answers for small businesses."
>
  <div class="brand-page">
    <section class="brand-dark-section border-b">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[minmax(0,1.15fr)_22rem] lg:items-end lg:gap-16">
        <div>
          <p class="brand-eyebrow">Two-Minute AI Answers</p>
          <h1 class="brand-display mt-5 max-w-4xl">One real AI problem. <span class="text-[var(--brand-orange)]">One useful answer.</span></h1>
          <p class="brand-copy brand-copy-lead mt-7">Tell me where AI is wasting your time, confusing you, or failing to deliver. I will record a personalized two-minute video today and send it directly to you.</p>
          <a href="#ask" class="brand-button mt-8">Ask your question <span class="ml-3">↓</span></a>
        </div>
        <aside class="brand-form-panel p-6">
          <p class="brand-eyebrow text-black/55">What you get</p>
          <ol class="mt-5 space-y-4">
            <li class="grid grid-cols-[2rem_1fr] gap-3 text-sm leading-6"><span class="font-semibold">01</span><span>A direct answer to your actual question</span></li>
            <li class="grid grid-cols-[2rem_1fr] gap-3 text-sm leading-6"><span class="font-semibold">02</span><span>A practical next step you can try</span></li>
            <li class="grid grid-cols-[2rem_1fr] gap-3 text-sm leading-6"><span class="font-semibold">03</span><span>A private video sent to your inbox</span></li>
          </ol>
        </aside>
      </div>
    </section>

    <section id="ask" class="brand-page-header scroll-mt-6">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[.78fr_1.22fr] lg:gap-16">
        <div>
          <p class="brand-eyebrow">Ask Danny</p>
          <h2 class="brand-section-title mt-4 max-w-xl">What is stopping you from getting useful work done with AI?</h2>
          <p class="brand-copy mt-6 max-w-lg">This is not a chatbot. Your question comes to me, I work through it, and I send you the clearest answer I can fit into two minutes.</p>
          <p class="mt-5 max-w-lg text-sm leading-6 text-[var(--brand-muted)]">Do not include passwords, customer records, private documents, medical information, financial details, or anything else that should not be submitted through a website form.</p>
        </div>
        <div class="brand-form-panel p-5 sm:p-8">
          <AiQuestionForm source="ai_answers_page" />
        </div>
      </div>
    </section>

    <section class="border-b-4 border-[var(--brand-ink)] bg-[var(--brand-pink)]">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[.65fr_1.35fr] lg:gap-16">
        <div>
          <p class="brand-eyebrow">The first recording queue</p>
          <h2 class="brand-section-title mt-4">Ten questions I hear all the time.</h2>
          <p class="brand-copy mt-6">I am recording these first. Submit your own question above if you want me to move your problem to the front of the queue.</p>
        </div>

        <ol class="grid gap-4 sm:grid-cols-2">
          {questions.map((item, index) => (
            <li class="brand-panel min-h-44 p-5 sm:p-6">
              <div class="flex items-start justify-between gap-4 text-xs font-semibold uppercase tracking-[0.12em] text-[var(--brand-muted)]">
                <span>{item.category}</span>
                <span>{String(index + 1).padStart(2, "0")}</span>
              </div>
              <p class="mt-8 font-sans text-xl font-semibold leading-tight">{item.question}</p>
              <p class="mt-5 text-xs font-semibold uppercase tracking-[0.1em] text-[var(--brand-muted)]">Video in production</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>
</BaseLayout>
