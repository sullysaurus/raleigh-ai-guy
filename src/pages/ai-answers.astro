---
import AiQuestionForm from "@/components/global/AiQuestionForm.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const questions = [
  { category: "Choose", question: "Should I use ChatGPT or Claude for my business?" },
  { category: "Choose", question: "Which Claude model should I use?" },
  { category: "Choose", question: "Do I need more than one AI tool?" },
  { category: "Choose", question: "Is a paid AI plan worth it for a small business?" },
  { category: "Choose", question: "When should I use Claude Cowork instead of regular Claude?" },
  { category: "Improve", question: "Why does AI keep giving me generic answers?" },
  { category: "Improve", question: "How much context should I give Claude or ChatGPT?" },
  { category: "Improve", question: "How do I get AI to write in my voice?" },
  { category: "Improve", question: "How do I stop AI from making up information?" },
  { category: "Improve", question: "Should I create a master prompt for my business?" },
];
---

<BaseLayout
  pageTitle="Two-Minute AI Answers"
  pageDescription="Send Danny Sullivan your biggest AI bottleneck, problem, or question. Get a personalized two-minute video answer and browse practical answers for small businesses."
>
  <div class="bg-[var(--editorial-canvas)] text-[var(--editorial-ink)]">
    <section class="border-b-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-lime)]">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[minmax(0,1.15fr)_22rem] lg:items-end lg:gap-16">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] opacity-55">Two-Minute AI Answers</p>
          <h1 class="mt-5 max-w-4xl text-balance font-sans text-5xl font-semibold leading-[.96] tracking-[-0.05em] sm:text-7xl">One real AI problem. One useful answer.</h1>
          <p class="mt-7 max-w-2xl text-lg font-medium leading-8 opacity-75">Tell me where AI is wasting your time, confusing you, or failing to deliver. I will record a personalized two-minute video today and send it directly to you.</p>
        </div>
        <aside class="rotate-1 border-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-canvas)] p-6 shadow-[7px_7px_0_var(--editorial-shadow)]">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] opacity-50">What you get</p>
          <ol class="mt-5 space-y-4">
            <li class="grid grid-cols-[2rem_1fr] gap-3 text-sm leading-6"><span class="font-semibold">01</span><span>A direct answer to your actual question</span></li>
            <li class="grid grid-cols-[2rem_1fr] gap-3 text-sm leading-6"><span class="font-semibold">02</span><span>A practical next step you can try</span></li>
            <li class="grid grid-cols-[2rem_1fr] gap-3 text-sm leading-6"><span class="font-semibold">03</span><span>A private video sent to your inbox</span></li>
          </ol>
        </aside>
      </div>
    </section>

    <section id="ask" class="scroll-mt-6 border-b-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-blue)]">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[.78fr_1.22fr] lg:gap-16">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] opacity-55">Ask Danny</p>
          <h2 class="mt-4 max-w-xl font-sans text-4xl font-semibold leading-[1.02] tracking-[-0.04em] sm:text-5xl">What is stopping you from getting useful work done with AI?</h2>
          <p class="mt-6 max-w-lg text-base leading-7 opacity-70">This is not a chatbot. Your question comes to me, I work through it, and I send you the clearest answer I can fit into two minutes.</p>
          <p class="mt-5 max-w-lg text-sm leading-6 opacity-60">Do not include passwords, customer records, private documents, medical information, financial details, or anything else that should not be submitted through a website form.</p>
        </div>
        <div class="border-2 border-[var(--editorial-line-strong)] bg-[#fffdf8] p-5 shadow-[7px_7px_0_var(--editorial-shadow)] sm:p-8">
          <AiQuestionForm source="ai_answers_page" />
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="grid gap-8 lg:grid-cols-[.65fr_1.35fr] lg:gap-16">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-base-500 dark:text-base-400">The first recording queue</p>
          <h2 class="mt-4 font-sans text-4xl font-semibold leading-[1.02] tracking-[-0.04em] sm:text-5xl">Ten questions I hear all the time.</h2>
          <p class="mt-6 text-base leading-7 text-base-600 dark:text-base-300">I am recording these first. Submit your own question above if you want me to move your problem to the front of the queue.</p>
        </div>

        <ol class="grid gap-px border-2 border-[var(--editorial-line-strong)] bg-[var(--editorial-line-strong)] sm:grid-cols-2">
          {questions.map((item, index) => (
            <li class:list={["min-h-44 p-5 text-[var(--editorial-ink)] sm:p-6", index % 4 === 0 ? "bg-[var(--editorial-purple)]" : index % 4 === 1 ? "bg-[var(--editorial-green)]" : index % 4 === 2 ? "bg-[var(--editorial-rust)]" : "bg-[var(--editorial-blue)]"]}>
              <div class="flex items-start justify-between gap-4 text-[.68rem] font-semibold uppercase tracking-[0.14em] opacity-50">
                <span>{item.category}</span>
                <span>{String(index + 1).padStart(2, "0")}</span>
              </div>
              <p class="mt-8 font-sans text-xl font-semibold leading-tight">{item.question}</p>
              <p class="mt-5 text-xs font-semibold uppercase tracking-[0.1em] opacity-45">Video in production</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>
</BaseLayout>
